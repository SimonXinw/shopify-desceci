{% comment %}
  Renders cart notification

  Accepts:
  - color_scheme: {String} sets the color scheme of the notification (optional)
  - desktop_menu_type: {String} passes the desktop menu type which allows us to use the right css class (optional)

  Usage:
  {% render 'cart-notification' %}
{% endcomment %}

<cart-notification>
  <div class="cart-notification-wrapper{% if desktop_menu_type != 'drawer' %} page-width{% endif %}">
    <div
      id="cart-notification"
      class="cart-notification focus-inset{% if color_scheme %} color-{{ color_scheme }} gradient{% endif %}"
      aria-modal="true"
      aria-label="{{ 'general.cart.item_added' | t }}"
      role="dialog"
      tabindex="-1"
    >
      <div class="cart-notification__header">
        <h2 class="cart-notification__heading caption-large text-body">
          {{- 'icon-checkmark.svg' | inline_asset_content -}}
          {{ 'general.cart.item_added' | t }}
        </h2>
        <button
          type="button"
          class="cart-notification__close modal__close-button link link--text focus-inset"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </span>
        </button>
      </div>
      <div id="cart-notification-product" class="cart-notification-product"></div>


<div class="desceci-cart-reward">

  <div class="reward-title">
    🎁 DESCECI Special Offer
  </div>

  <div class="reward-text">
    Spend more on DTF Transfers and save more!
  </div>

  <div class="reward-shipping">
    🚚 Free U.S. shipping on DTF Transfer orders $150+
  </div>

</div>

<div class="desceci-cart-reward">

{% assign cart_total = cart.total_price | divided_by: 100 %}

<div class="reward-title">
🎁 DTF Transfer Savings
</div>


{% if cart_total >= 300 %}

<div class="reward-text">
You've unlocked $30 OFF!
</div>


{% elsif cart_total >= 150 %}

<div class="reward-text">
You've unlocked $15 OFF!
</div>

<div class="reward-text">
Add ${{ 300 | minus: cart_total }} more to unlock $30 OFF
</div>


{% elsif cart_total >= 80 %}

<div class="reward-text">
You've unlocked $8 OFF!
</div>

<div class="reward-text">
Add ${{ 150 | minus: cart_total }} more to unlock $15 OFF
</div>


{% elsif cart_total >= 40 %}

<div class="reward-text">
You've unlocked $5 OFF!
</div>

<div class="reward-text">
Add ${{ 80 | minus: cart_total }} more to unlock $8 OFF
</div>


{% elsif cart_total >= 25 %}

<div class="reward-text">
You've unlocked $3 OFF!
</div>

<div class="reward-text">
Add ${{ 40 | minus: cart_total }} more to unlock $5 OFF
</div>


{% else %}

<div class="reward-text">
Add ${{ 25 | minus: cart_total }} more to unlock $3 OFF
</div>

{% endif %}


<div class="reward-list">

Rewards:

<br>
$25 → $3 OFF
<br>
$40 → $5 OFF
<br>
$80 → $8 OFF
<br>
$150 → $15 OFF
<br>
$300 → $30 OFF

</div>


<div class="reward-shipping">
🚚 Free shipping on orders $150+
</div>


</div>      <div class="cart-notification__links">
        <a
          href="{{ routes.cart_url }}"
          id="cart-notification-button"
          class="button button--secondary button--full-width"
        >
          {{- 'general.cart.view_empty_cart' | t -}}
        </a>
        <form action="{{ routes.cart_url }}" method="post" id="cart-notification-form">
          <button class="button button--primary button--full-width" name="checkout">
            {{ 'sections.cart.checkout' | t }}
          </button>
        </form>
        <button type="button" class="link button-label">{{ 'general.continue_shopping' | t }}</button>
      </div>
    </div>
  </div>
</cart-notification>
{% style %}
  .cart-notification {
    display: none;
  }
{% endstyle %}
