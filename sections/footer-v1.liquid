{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .footer_v1-{{ section.id }} {
    --footer-background: {{ section.settings.background_color }};
    --footer-heading-color: {{ section.settings.heading_color }};
    --footer-text-color: {{ section.settings.text_color }};
    --footer-link-hover-color: {{ section.settings.link_hover_color }};
    --footer-border-color: {{ section.settings.border_color }};
    --footer-margin-top: {{ section.settings.margin_top }}px;
    --footer-padding-top: {{ section.settings.mobile_padding_top }}px;
    --footer-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    --footer-column-gap: {{ section.settings.column_gap }}px;
  }

  @media screen and (min-width: 750px) {
    .footer_v1-{{ section.id }} {
      --footer-padding-top: {{ section.settings.padding_top }}px;
      --footer-padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<footer class="footer_v1 footer_v1-{{ section.id }}">
  <div class="page-width">
    {%- if section.blocks.size > 0 -%}
      <div class="columns">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'link_list' -%}
              <nav class="column menu_column" aria-labelledby="FooterHeading-{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2 class="column_heading" id="FooterHeading-{{ section.id }}-{{ block.id }}">
                    {{ block.settings.heading | escape }}
                  </h2>
                {%- endif -%}

                {%- if block.settings.menu != blank -%}
                  <ul class="link_list" role="list">
                    {%- for link in block.settings.menu.links -%}
                      <li>
                        <a
                          href="{{ link.url }}"
                          class="link{% if link.active %} active{% endif %}"
                          {% if link.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{ link.title | escape }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </nav>

            {%- when 'contact' -%}
              <div class="column contact_column" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2 class="column_heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}

                <div class="contact_list">
                  {%- if block.settings.address != blank -%}
                    <div class="contact_item">
                      {%- if block.settings.address_url != blank -%}
                        <a class="link address" href="{{ block.settings.address_url }}">
                          {{ block.settings.address | escape | newline_to_br }}
                        </a>
                      {%- else -%}
                        <div class="address">{{ block.settings.address | escape | newline_to_br }}</div>
                      {%- endif -%}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.email != blank -%}
                    <div class="contact_item">
                      <a class="link" href="mailto:{{ block.settings.email | escape }}">
                        {{ block.settings.email | escape }}
                      </a>
                    </div>
                  {%- endif -%}

                  {%- if block.settings.phone != blank -%}
                    {%- assign phone_href = block.settings.phone
                      | remove: ' '
                      | remove: '('
                      | remove: ')'
                      | remove: '-'
                    -%}
                    <div class="contact_item">
                      <a class="link" href="tel:{{ phone_href | escape }}">
                        {{ block.settings.phone | escape }}
                      </a>
                    </div>
                  {%- endif -%}

                  {%- if block.settings.extra_link_label != blank and block.settings.extra_link_url != blank -%}
                    <div class="contact_item">
                      <a class="link" href="{{ block.settings.extra_link_url }}">
                        {{ block.settings.extra_link_label | escape }}
                      </a>
                    </div>
                  {%- endif -%}
                </div>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="bottom">
      {%- if section.settings.show_social -%}
        <div class="social_row">
          {%- render 'social-icons', class: 'social_list' -%}
        </div>
      {%- endif -%}

      {%- if section.settings.enable_country_selector or section.settings.enable_language_selector -%}
        <div class="localization">
          {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
            <localization-form>
              {%- form 'localization', id: 'FooterCountryFormV1', class: 'localization-form' -%}
                <div>
                  <h2 class="visually-hidden" id="FooterCountryLabelV1">
                    {{ 'localization.country_label' | t }}
                  </h2>
                  {%- render 'country-localization', localPosition: 'FooterCountryV1' -%}
                </div>
              {%- endform -%}
            </localization-form>
          {%- endif -%}

          {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
            <localization-form>
              {%- form 'localization', id: 'FooterLanguageFormV1', class: 'localization-form' -%}
                <div>
                  <h2 class="visually-hidden" id="FooterLanguageLabelV1">
                    {{ 'localization.language_label' | t }}
                  </h2>
                  {%- render 'language-localization', localPosition: 'FooterLanguageV1' -%}
                </div>
              {%- endform -%}
            </localization-form>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="payment_area">
        {%- if section.settings.payment_image != blank -%}
          {%- assign payment_alt = section.settings.payment_image.alt | default: 'Payment methods' -%}
          {{
            section.settings.payment_image
            | image_url: width: 1000
            | image_tag:
              loading: 'lazy',
              widths: '200, 300, 400, 500, 750, 1000',
              sizes: '(min-width: 750px) 400px, 80vw',
              class: 'payment_image',
              alt: payment_alt,
              style: '--payment-image-width: ' | append: section.settings.payment_image_width | append: 'px;'
          }}
        {%- elsif shop.enabled_payment_types.size > 0 -%}
          <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
          <ul class="native_payment_list" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li>{{ type | payment_type_svg_tag: class: 'payment_icon' }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.show_copyright or section.settings.show_policy -%}
      <div class="legal">
        {%- if section.settings.show_copyright -%}
          <small>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</small>
        {%- endif -%}

        {%- if section.settings.show_policy -%}
          <ul class="policy_list" role="list">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li>
                  <a class="link" href="{{ policy.url }}">{{ policy.title | escape }}</a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</footer>

{% stylesheet %}
  .footer_v1 {
    margin-top: var(--footer-margin-top);
    padding: var(--footer-padding-top) 0 var(--footer-padding-bottom);
    background: var(--footer-background);
    color: var(--footer-text-color);
  }

  .footer_v1 .columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3.2rem;
  }

  .footer_v1 .column {
    min-width: 0;
  }

  .footer_v1 .column_heading {
    margin: 0 0 1.6rem;
    color: var(--footer-heading-color);
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1.3;
  }

  .footer_v1 .link_list,
  .footer_v1 .policy_list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer_v1 .link_list {
    display: grid;
    gap: 0.8rem;
  }

  .footer_v1 .link {
    color: var(--footer-text-color);
    text-decoration: none;
    font-size: 1.4rem;
    line-height: 1.5;
    transition: color 0.2s ease;
  }

  .footer_v1 .link:hover,
  .footer_v1 .link.active {
    color: var(--footer-link-hover-color);
  }

  .footer_v1 .contact_list {
    display: grid;
    gap: 1.6rem;
  }

  .footer_v1 .address {
    color: var(--footer-text-color);
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .footer_v1 .social_row {
    display: flex;
    max-width: 100%;
    margin: 0;
    justify-content: flex-start;
  }

  .footer_v1 .social_list {
    margin: 0;
    padding: 0;
  }

  .footer_v1 .social_list .list-social__link {
    color: var(--footer-text-color);
  }

  .footer_v1 .social_list .list-social__link:hover {
    color: var(--footer-link-hover-color);
  }

  .footer_v1 .bottom {
    display: flex;
    margin-top: 4.8rem;
    flex-flow: row wrap;
    align-items: center;
    gap: 2.4rem;
  }

  .footer_v1 .payment_area {
    max-width: 100%;
    min-height: 0.1rem;
  }

  .footer_v1 .payment_image {
    display: block;
    width: min(var(--payment-image-width), 100%);
    height: auto;
  }

  .footer_v1 .native_payment_list {
    display: flex;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem;
    list-style: none;
  }

  .footer_v1 .native_payment_list li,
  .footer_v1 .payment_icon {
    display: block;
    width: 3.8rem;
    height: 2.4rem;
  }

  .footer_v1 .localization {
    display: flex;
    max-width: 100%;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .footer_v1 .localization-form {
    margin: 0;
    padding: 0;
  }

  .footer_v1 .localization .disclosure__button {
    color: var(--footer-text-color);
    border-color: var(--footer-border-color);
    background: transparent;
  }

  .footer_v1 .legal {
    display: flex;
    margin-top: 3.2rem;
    padding-top: 2rem;
    border-top: 0.1rem solid var(--footer-border-color);
    flex-direction: column;
    color: var(--footer-text-color);
    gap: 1.2rem;
    font-size: 1.2rem;
  }

  .footer_v1 .policy_list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem 1.6rem;
  }

  .footer_v1 .policy_list .link {
    font-size: 1.2rem;
  }

  @media screen and (min-width: 750px) {
    .footer_v1 .columns {
      max-width: 78rem;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--footer-column-gap);
      row-gap: 4rem;
    }

    .footer_v1 .bottom {
      display: grid;
      grid-template-areas:
        "social social"
        "payment localization";
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
      gap: 3.2rem 4rem;
    }

    .footer_v1 .social_row {
      grid-area: social;
      max-width: 78rem;
      justify-content: center;
    }

    .footer_v1 .payment_area {
      grid-area: payment;
    }

    .footer_v1 .localization {
      grid-area: localization;
      justify-content: flex-end;
    }

    .footer_v1 .legal {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "页脚 V1",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "link_list",
      "name": "链接菜单",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "标题",
          "default": "Support"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "菜单"
        }
      ]
    },
    {
      "type": "contact",
      "name": "联系我们",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "标题",
          "default": "Contact Us"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "地址",
          "default": "903 N Bowser Rd\nSuite 250\nRichardson, TX 75081"
        },
        {
          "type": "url",
          "id": "address_url",
          "label": "地址跳转链接"
        },
        {
          "type": "text",
          "id": "email",
          "label": "邮箱",
          "default": "info@dtfdallas.com"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "电话",
          "default": "+1 (469) 769-8949"
        },
        {
          "type": "text",
          "id": "extra_link_label",
          "label": "额外链接文字"
        },
        {
          "type": "url",
          "id": "extra_link_url",
          "label": "额外跳转链接"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "颜色"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色",
      "default": "#001820"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "标题颜色",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "正文颜色",
      "default": "#d6e0e3"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "链接悬停颜色",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "分割线和选择器边框",
      "default": "#34505a"
    },
    {
      "type": "header",
      "content": "底部功能"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "显示社交媒体图标",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "payment_image",
      "label": "支付方式图片"
    },
    {
      "type": "range",
      "id": "payment_image_width",
      "min": 100,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "支付图片宽度",
      "default": 320
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "显示国家/地区选择器",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "label": "显示语言选择器",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_copyright",
      "label": "显示版权信息",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "label": "显示政策链接",
      "default": false
    },
    {
      "type": "header",
      "content": "间距"
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "PC 栏目间距",
      "default": 64
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "顶部外边距",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "PC 上内边距",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "PC 下内边距",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "移动端上内边距",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "移动端下内边距",
      "default": 32
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "link_list",
        "settings": {
          "heading": "Support"
        }
      },
      {
        "type": "link_list",
        "settings": {
          "heading": "Products"
        }
      },
      {
        "type": "contact"
      }
    ]
  }
}
{% endschema %}
