<div
  class="printing_service_showcase"
  style="
    --section-background: {{ section.settings.section_background }};
    --heading-color: {{ section.settings.heading_color }};
    --heading-size: {{ section.settings.heading_size }}px;
    --mobile-heading-size: {{ section.settings.mobile_heading_size }}px;
    --divider-color: {{ section.settings.divider_color }};
    --card-background: {{ section.settings.card_background }};
    --card-radius: {{ section.settings.card_radius }}px;
    --column-gap: {{ section.settings.column_gap }}px;
    --leading-icon-size: {{ section.settings.leading_icon_size }}px;
    --trailing-icon-size: {{ section.settings.trailing_icon_size }}px;
    --title-primary-size: {{ section.settings.title_primary_size }}px;
    --title-secondary-size: {{ section.settings.title_secondary_size }}px;
    --tagline-size: {{ section.settings.tagline_size }}px;
    --tagline-color: {{ section.settings.tagline_color }};
    --feature-size: {{ section.settings.feature_size }}px;
    --feature-color: {{ section.settings.feature_color }};
    --desktop-padding-top: {{ section.settings.padding_top }}px;
    --desktop-padding-bottom: {{ section.settings.padding_bottom }}px;
    --mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="heading_row">
        <span class="line" aria-hidden="true"></span>

        <h2 class="heading inline-richtext">{{ section.settings.heading }}</h2>

        <span class="line" aria-hidden="true"></span>
      </div>
    {%- endif -%}

    <div class="cards">
      {%- for block in section.blocks -%}
        <div
          class="advantage_card"
          style="
            --accent-color: {{ block.settings.accent_color }};
            --title-primary-color: {{ block.settings.title_primary_color }};
            --title-secondary-color: {{ block.settings.title_secondary_color }};
          "
          {{ block.shopify_attributes }}
        >
          <div class="head">
            {%- if block.settings.leading_icon != blank -%}
              {{
                block.settings.leading_icon
                | image_url: width: 240
                | image_tag: class: 'leading_icon', widths: '80, 120, 240', alt: ''
              }}
            {%- endif -%}

            <div class="head_text">
              {%- if block.settings.title_primary != blank -%}
                <p class="title_primary">{{ block.settings.title_primary }}</p>
              {%- endif -%}

              {%- if block.settings.title_secondary != blank -%}
                <p class="title_secondary">{{ block.settings.title_secondary }}</p>
              {%- endif -%}
            </div>

            {%- if block.settings.trailing_icon != blank -%}
              {{
                block.settings.trailing_icon
                | image_url: width: 240
                | image_tag: class: 'trailing_icon', widths: '80, 120, 240', alt: ''
              }}
            {%- endif -%}
          </div>

          {%- if block.settings.tagline != blank -%}
            <p class="tagline">{{ block.settings.tagline }}</p>
          {%- endif -%}

          {%- assign feature_lines = block.settings.feature_list | strip | newline_to_br | split: '<br />' -%}
          {%- if feature_lines.size > 0 -%}
            <ul class="feature_list" role="list">
              {%- for feature_line in feature_lines -%}
                {%- assign feature_text = feature_line | strip -%}
                {%- if feature_text != blank -%}
                  <li class="feature_item">{{ feature_text }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          <div class="card_media">
            {%- if block.settings.image != blank -%}
              {%- liquid
                assign image_alt = block.settings.image.alt
                if image_alt == blank
                  assign image_alt = block.settings.image_alt
                endif
                if image_alt == blank
                  assign image_alt = block.settings.title_primary
                endif
              -%}
              {{
                block.settings.image
                | image_url: width: 1600
                | image_tag:
                  class: 'card_image',
                  widths: '400, 600, 800, 1200, 1600',
                  sizes: '(min-width: 750px) 32vw, 100vw',
                  alt: image_alt
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'card_image placeholder' }}
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .printing_service_showcase {
    padding-top: var(--desktop-padding-top);
    padding-bottom: var(--desktop-padding-bottom);
    background: var(--section-background);
  }

  .printing_service_showcase .heading_row {
    display: flex;
    gap: 2.4rem;
    align-items: center;
    justify-content: center;
    margin-bottom: 3.2rem;
  }

  .printing_service_showcase .line {
    max-width: 20rem;
    height: 1px;
    flex: 1 1 auto;
    background: var(--divider-color);
  }

  .printing_service_showcase .heading {
    margin: 0;
    color: var(--heading-color);
    font-size: var(--heading-size);
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
  }

  .printing_service_showcase .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--column-gap);
  }

  .printing_service_showcase .advantage_card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 2.4rem;
    border-radius: var(--card-radius);
    background: var(--card-background);
  }

  .printing_service_showcase .head {
    display: flex;
    gap: 1.2rem;
    align-items: center;
  }

  .printing_service_showcase .leading_icon {
    width: var(--leading-icon-size);
    height: var(--leading-icon-size);
    flex: 0 0 auto;
    object-fit: contain;
  }

  .printing_service_showcase .trailing_icon {
    width: var(--trailing-icon-size);
    height: var(--trailing-icon-size);
    flex: 0 0 auto;
    margin-left: auto;
    object-fit: contain;
  }

  .printing_service_showcase .head_text {
    min-width: 0;
  }

  .printing_service_showcase .title_primary {
    margin: 0;
    color: var(--title-primary-color);
    font-size: var(--title-primary-size);
    font-weight: 800;
    line-height: 1.1;
  }

  .printing_service_showcase .title_secondary {
    margin: 0.4rem 0 0;
    color: var(--title-secondary-color);
    font-size: var(--title-secondary-size);
    font-weight: 800;
    line-height: 1.1;
  }

  .printing_service_showcase .tagline {
    margin: 2rem 0 0;
    padding: 0.8rem 1.2rem;
    color: var(--tagline-color);
    background: var(--accent-color);
    font-size: var(--tagline-size);
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.3;
  }

  .printing_service_showcase .feature_list {
    display: grid;
    gap: 1.2rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .printing_service_showcase .feature_item {
    position: relative;
    padding-left: 1.8rem;
    color: var(--feature-color);
    font-size: var(--feature-size);
    line-height: 1.5;
  }

  .printing_service_showcase .feature_item::before {
    position: absolute;
    top: 0.65em;
    left: 0;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--accent-color);
    content: "";
  }

  .printing_service_showcase .card_media {
    margin-top: 2.4rem;
    overflow: hidden;
    border-radius: calc(var(--card-radius) / 2);
  }

  .printing_service_showcase .card_image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 8 / 3;
    object-fit: cover;
  }

  @media screen and (max-width: 749px) {
    .printing_service_showcase {
      padding-top: var(--mobile-padding-top);
      padding-bottom: var(--mobile-padding-bottom);
    }

    .printing_service_showcase .heading_row {
      margin-bottom: 2.4rem;
    }

    .printing_service_showcase .line {
      display: none;
    }

    .printing_service_showcase .heading {
      font-size: var(--mobile-heading-size);
    }

    .printing_service_showcase .cards {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }

    .printing_service_showcase .advantage_card {
      padding: 2rem 1.6rem;
    }
  }
{% endstylesheet %}

