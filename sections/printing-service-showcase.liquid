<div
  class="printing_service_showcase"
  style="
    --section-background: {{ section.settings.section_background }};
    --text-color: {{ section.settings.text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --content-background: {{ section.settings.content_background }};
    --image-radius: {{ section.settings.image_radius }}px;
    --column-gap: {{ section.settings.column_gap }}px;
    --desktop-padding-top: {{ section.settings.padding_top }}px;
    --desktop-padding-bottom: {{ section.settings.padding_bottom }}px;
    --mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="heading inline-richtext">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="layout">
      <div class="media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 2400
            | image_tag:
              class: 'image',
              widths: '550, 750, 1100, 1500, 2000, 2400',
              sizes: '(min-width: 750px) 50vw, 100vw'
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
        {%- endif -%}
      </div>

      <div class="content">
        {%- if section.settings.content_title != blank -%}
          <h3 class="content_title inline-richtext">{{ section.settings.content_title }}</h3>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="text_list" role="list">
            {%- for block in section.blocks -%}
              <li class="text_item" {{ block.shopify_attributes }}>
                <span class="marker" aria-hidden="true"></span>
                <div class="text">{{ block.settings.text | newline_to_br }}</div>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .printing_service_showcase {
    padding-top: var(--desktop-padding-top);
    padding-bottom: var(--desktop-padding-bottom);
    color: var(--text-color);
    background: var(--section-background);
  }

  .printing_service_showcase .heading {
    margin: 0 0 4.8rem;
    color: inherit;
    font-size: clamp(3rem, 3vw, 4.8rem);
    font-weight: 700;
    line-height: 1.15;
    text-align: center;
  }

  .printing_service_showcase .layout {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--column-gap);
    align-items: stretch;
  }

  .printing_service_showcase .media {
    height: 600px;
    overflow: hidden;
    border-radius: var(--image-radius);
    background: var(--content-background);
  }

  .printing_service_showcase .media .image,
  .printing_service_showcase .media .placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .printing_service_showcase .content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2.4rem, 4vw, 6rem);
    border-radius: var(--image-radius);
  }

  .printing_service_showcase .content_title {
    margin: 0;
    color: inherit;
    font-size: clamp(2.6rem, 2.4vw, 4rem);
    font-weight: 700;
    line-height: 1.2;
  }

  .printing_service_showcase .content_title::after {
    display: block;
    width: 5.6rem;
    height: 0.3rem;
    margin-top: 1.6rem;
    border-radius: 999px;
    background: var(--accent-color);
    content: "";
  }

  .printing_service_showcase .text_list {
    display: grid;
    gap: 2.4rem;
    margin: 3.2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .printing_service_showcase .text_item {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    gap: 1.4rem;
    align-items: start;
  }

  .printing_service_showcase .marker {
    width: 0.8rem;
    height: 0.8rem;
    margin-top: 0.8rem;
    border-radius: 50%;
    background: var(--accent-color);
  }

  .printing_service_showcase .text {
    font-size: 1.6rem;
    line-height: 1.6;
  }

  .printing_service_showcase .text > * {
    margin-top: 0;
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    .printing_service_showcase {
      padding-top: var(--mobile-padding-top);
      padding-bottom: var(--mobile-padding-bottom);
    }

    .printing_service_showcase .heading {
      margin-bottom: 2.4rem;
      font-size: 3rem;
    }

    .printing_service_showcase .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.4rem;
    }

    .printing_service_showcase .media {
      width: 100%;
      height: auto;
    }

    .printing_service_showcase .media .image {
      width: 100%;
      height: auto;
    }

    .printing_service_showcase .media .placeholder {
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 3;
    }

    .printing_service_showcase .content {
      padding: 2.4rem 1.6rem;
    }

    .printing_service_showcase .content_title {
      font-size: 2.6rem;
    }

    .printing_service_showcase .text_list {
      gap: 1.8rem;
      margin-top: 2.4rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "打印服务图文",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "内容"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "模块标题",
      "default": "Our Printing Service"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "工厂实景图片"
    },
    {
      "type": "inline_richtext",
      "id": "content_title",
      "label": "文本容器标题",
      "default": "Printing Workshop"
    },
    {
      "type": "header",
      "content": "样式"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "模块背景颜色",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "content_background",
      "label": "文本容器背景颜色",
      "default": "#f7f8f8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文字颜色",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "强调色",
      "default": "#11a9a4"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "图片与文本容器圆角",
      "default": 12
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "PC 端两列间距",
      "default": 48
    },
    {
      "type": "header",
      "content": "区域间距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "PC 端顶部间距",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "PC 端底部间距",
      "default": 60
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "移动端顶部间距",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "移动端底部间距",
      "default": 20
    }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "text_item",
      "name": "文本行",
      "settings": [
        {
          "type": "textarea",
          "id": "text",
          "label": "文本",
          "default": "配置这一行的文本内容。"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "打印服务图文",
      "blocks": [
        {
          "type": "text_item",
          "settings": {
            "text": "下午两点之前下单，当天打印完成。如果你不在本地，将通过快递把货物送到你手里，当然你也可以自己上门提货。"
          }
        },
        {
          "type": "text_item",
          "settings": {
            "text": "没有最小起订量，一个也能打印。"
          }
        },
        {
          "type": "text_item",
          "settings": {
            "text": "爱普生高质量打印头，高品质管理。"
          }
        }
      ]
    }
  ]
}
{% endschema %}
