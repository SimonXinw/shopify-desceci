<div
  class="factory_scene_section{% if section.settings.layout_width == 'page' %} page-width{% endif %}"
  style="
    --desktop-height: {{ section.settings.desktop_height }}px;
    --mobile-image-height: {{ section.settings.mobile_image_height }}px;
    --content-width: {{ section.settings.content_width }}px;
    --desktop-text-align: {{ section.settings.desktop_text_alignment }};
    --mobile-text-align: {{ section.settings.mobile_text_alignment }};
    --eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --mobile-eyebrow-size: {{ section.settings.mobile_eyebrow_size }}px;
    --eyebrow-color: {{ section.settings.eyebrow_color }};
    --title-size: {{ section.settings.title_size }}px;
    --mobile-title-size: {{ section.settings.mobile_title_size }}px;
    --title-color: {{ section.settings.title_color }};
    --description-size: {{ section.settings.description_size }}px;
    --mobile-description-size: {{ section.settings.mobile_description_size }}px;
    --description-color: {{ section.settings.description_color }};
    --overlay-color: {{ section.settings.overlay_color }};
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --content-background: {{ section.settings.content_background }};
    --image-position: {{ section.settings.image_position }};
    --border-radius: {{ section.settings.border_radius }}px;
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  "
>
  <div class="banner">
    <div class="content">
      <div class="content_frame">
        <div class="copy">
          {%- if section.settings.eyebrow_text != blank -%}
            <p class="eyebrow">{{ section.settings.eyebrow_text }}</p>
          {%- endif -%}

          {%- if section.settings.title != blank -%}
            <h2 class="title inline-richtext">{{ section.settings.title }}</h2>
          {%- endif -%}

          {%- if section.settings.description != blank -%}
            <div class="description rte">{{ section.settings.description }}</div>
          {%- endif -%}
        </div>
      </div>
    </div>

    <div class="media">
      {%- if section.settings.image != blank or section.settings.mobile_image != blank -%}
        <picture>
          {%- if section.settings.mobile_image != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ section.settings.mobile_image | image_url: width: 750 }} 750w,
                {{ section.settings.mobile_image | image_url: width: 1100 }} 1100w,
                {{ section.settings.mobile_image | image_url: width: 1500 }} 1500w
              "
              sizes="100vw"
            >
          {%- endif -%}

          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 3840
              | image_tag:
                class: 'image',
                widths: '750, 1100, 1500, 1920, 2560, 3200, 3840',
                sizes: '100vw'
            }}
          {%- else -%}
            {{
              section.settings.mobile_image
              | image_url: width: 1500
              | image_tag:
                class: 'image',
                widths: '750, 1100, 1500',
                sizes: '100vw'
            }}
          {%- endif -%}
        </picture>
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}

      <div class="overlay" aria-hidden="true"></div>
    </div>
  </div>
</div>

{% stylesheet %}
  .factory_scene_section {
    padding-top: var(--padding-top);
    padding-bottom: var(--padding-bottom);
  }

  .factory_scene_section .banner {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--border-radius);
    background: var(--content-background);
  }

  .factory_scene_section .content {
    width: 100%;
    background: var(--content-background);
  }

  .factory_scene_section .content_frame {
    display: flex;
    justify-content: center;
    width: 100%;
    padding: 4rem 1.5rem 3.2rem;
  }

  .factory_scene_section .copy {
    width: min(100%, var(--content-width));
    text-align: var(--desktop-text-align);
  }

  .factory_scene_section .eyebrow {
    margin: 0 0 1.2rem;
    color: var(--eyebrow-color);
    font-size: var(--eyebrow-size);
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .factory_scene_section .title {
    margin: 0;
    color: var(--title-color);
    font-size: var(--title-size);
    font-weight: 700;
    line-height: 1.2;
  }

  .factory_scene_section .description {
    margin-top: 1.6rem;
    color: var(--description-color);
    font-size: var(--description-size);
    line-height: 1.5;
  }

  .factory_scene_section .description > * {
    margin-top: 0;
    margin-bottom: 0;
  }

  .factory_scene_section .media {
    position: relative;
    width: 100%;
    height: var(--desktop-height);
    overflow: hidden;
  }

  .factory_scene_section .media picture,
  .factory_scene_section .media .image,
  .factory_scene_section .media .placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }

  .factory_scene_section .media .image,
  .factory_scene_section .media .placeholder {
    object-fit: cover;
    object-position: var(--image-position);
  }

  .factory_scene_section .overlay {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: var(--overlay-color);
    opacity: var(--overlay-opacity);
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .factory_scene_section {
      padding-top: var(--mobile-padding-top);
      padding-bottom: var(--mobile-padding-bottom);
    }

    .factory_scene_section .banner {
      border-radius: 0;
    }

    .factory_scene_section .content_frame {
      padding: 2.4rem 1.5rem 2rem;
    }

    .factory_scene_section .copy {
      text-align: var(--mobile-text-align);
    }

    .factory_scene_section .eyebrow {
      margin-bottom: 1rem;
      font-size: var(--mobile-eyebrow-size);
    }

    .factory_scene_section .title {
      font-size: var(--mobile-title-size);
    }

    .factory_scene_section .description {
      margin-top: 1.2rem;
      font-size: var(--mobile-description-size);
    }

    .factory_scene_section .media {
      height: var(--mobile-image-height);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "工厂实景横幅",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "图片与尺寸"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "PC 端工厂实景图片"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "移动端工厂实景图片",
      "info": "不上传时，移动端沿用 PC 端图片"
    },
    {
      "type": "select",
      "id": "layout_width",
      "label": "区域宽度",
      "options": [
        {
          "value": "page",
          "label": "版心宽度"
        },
        {
          "value": "full",
          "label": "全屏宽度"
        }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 240,
      "max": 700,
      "step": 10,
      "unit": "px",
      "label": "PC 端图片高度",
      "default": 360
    },
    {
      "type": "range",
      "id": "mobile_image_height",
      "min": 180,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "移动端图片高度",
      "default": 240
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "图片焦点位置",
      "options": [
        {
          "value": "left center",
          "label": "左侧"
        },
        {
          "value": "center center",
          "label": "居中"
        },
        {
          "value": "right center",
          "label": "右侧"
        }
      ],
      "default": "center center"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "圆角",
      "default": 24
    },
    {
      "type": "header",
      "content": "文案"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "顶部小字",
      "default": "BUILT TO LAST. DELIVERED TO YOU."
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "PC 端顶部小字字号",
      "default": 14
    },
    {
      "type": "range",
      "id": "mobile_eyebrow_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "移动端顶部小字字号",
      "default": 12
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "顶部小字颜色",
      "default": "#1B878D"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "标题",
      "default": "Professional production, reliable delivery"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "PC 端标题字号",
      "default": 36
    },
    {
      "type": "range",
      "id": "mobile_title_size",
      "min": 20,
      "max": 44,
      "step": 2,
      "unit": "px",
      "label": "移动端标题字号",
      "default": 28
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "标题颜色",
      "default": "#121212"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "描述",
      "default": "<p>Explore our factory, production capabilities, quality standards, and fast turnaround service.</p>"
    },
    {
      "type": "range",
      "id": "description_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "PC 端描述字号",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_description_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "移动端描述字号",
      "default": 14
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "描述颜色",
      "default": "#353C42"
    },
    {
      "type": "text_alignment",
      "id": "desktop_text_alignment",
      "label": "PC 端文字对齐",
      "default": "center"
    },
    {
      "type": "text_alignment",
      "id": "mobile_text_alignment",
      "label": "移动端文字对齐",
      "default": "center"
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 300,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "文案最大宽度",
      "default": 760
    },
    {
      "type": "color",
      "id": "content_background",
      "label": "文案背景颜色",
      "default": "#F6F7F9"
    },
    {
      "type": "header",
      "content": "图片遮罩"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "遮罩颜色",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "遮罩透明度",
      "default": 0
    },
    {
      "type": "header",
      "content": "区域间距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "PC 端顶部间距",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "PC 端底部间距",
      "default": 60
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "移动端顶部间距",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "移动端底部间距",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "工厂实景横幅"
    }
  ]
}
{% endschema %}
