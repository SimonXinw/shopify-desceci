{%- liquid
  assign image_loading = 'lazy'
  assign fetch_priority = 'auto'

  if section.index == 1
    assign image_loading = 'eager'
    assign fetch_priority = 'high'
  endif

  assign feature_blocks = section.blocks | where: 'type', 'feature'
  assign bottom_blocks = section.blocks | where: 'type', 'bottom_item'

  assign eyebrow_classes = 'eyebrow'
  unless section.settings.eyebrow_show_desktop
    assign eyebrow_classes = eyebrow_classes | append: ' hidden_desktop'
  endunless
  unless section.settings.eyebrow_show_mobile
    assign eyebrow_classes = eyebrow_classes | append: ' hidden_mobile'
  endunless

  assign eyebrow_has_background = false
  if section.settings.eyebrow_background.alpha > 0
    assign eyebrow_has_background = true
  endif

  assign title_has_background = false
  if section.settings.title_background.alpha > 0
    assign title_has_background = true
  endif

  assign subtitle_has_background = false
  if section.settings.subtitle_background.alpha > 0
    assign subtitle_has_background = true
  endif

  assign description_has_background = false
  if section.settings.description_background.alpha > 0
    assign description_has_background = true
  endif
-%}

<div
  class="image_text_banner"
  style="
    --desktop-height: {{ section.settings.desktop_height }}px;
    --mobile-height: {{ section.settings.mobile_height }}px;
    --content-width: {{ section.settings.content_width }}%;
    --desktop-justify: {{ section.settings.desktop_horizontal_position }};
    --desktop-align: {{ section.settings.desktop_vertical_position }};
    --desktop-text-align: {{ section.settings.desktop_text_alignment }};
    --title-size: {{ section.settings.title_size }}px;
    --mobile-title-size: {{ section.settings.mobile_title_size }}px;
    --text-color: {{ section.settings.text_color }};
    --eyebrow-color: {{ section.settings.eyebrow_color }};
    --eyebrow-background: {{ section.settings.eyebrow_background }};
    --title-color: {{ section.settings.title_color }};
    --title-background: {{ section.settings.title_background }};
    --subtitle-size: {{ section.settings.subtitle_size }}px;
    --subtitle-color: {{ section.settings.subtitle_color }};
    --subtitle-background: {{ section.settings.subtitle_background }};
    --description-color: {{ section.settings.description_color }};
    --description-background: {{ section.settings.description_background }};
    --fallback-background: {{ section.settings.fallback_background }};
    --button-hover-background: {{ section.settings.button_hover_background }};
    --button-text-color: {{ section.settings.button_text_color }};
    --button-font-size: {{ section.settings.button_font_size }}px;
    --bottom-bar-background: {{ section.settings.bottom_bar_background }};
  "
>
  <div class="background">
    {%- if section.settings.background_image != blank -%}
      {{
        section.settings.background_image
        | image_url: width: 3840
        | image_tag:
          class: 'image',
          widths: '750, 1100, 1500, 1920, 2560, 3200, 3840',
          sizes: '100vw',
          loading: image_loading,
          fetchpriority: fetch_priority
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
    {%- endif -%}
  </div>

  <div class="container page-width">
    <div class="content">
      {%- if section.settings.eyebrow_text != blank -%}
        <div class="{{ eyebrow_classes }}">
          <span class="text inline-richtext{% if eyebrow_has_background %} has_background{% endif %}">
            {{- section.settings.eyebrow_text -}}
          </span>
        </div>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="title">
          <span class="text inline-richtext{% if title_has_background %} has_background{% endif %}">
            {{- section.settings.title -}}
          </span>
        </h2>
      {%- endif -%}

      {%- if section.settings.subtitle_text != blank -%}
        <div class="subtitle">
          <span class="text inline-richtext{% if subtitle_has_background %} has_background{% endif %}">
            {{- section.settings.subtitle_text -}}
          </span>
        </div>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="description">
          <div class="text rte{% if description_has_background %} has_background{% endif %}">
            {{- section.settings.description -}}
          </div>
        </div>
      {%- endif -%}

      {%- if feature_blocks.size > 0 -%}
        <div class="features">
          {%- for block in feature_blocks -%}
            <div class="feature" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                {{
                  block.settings.icon
                  | image_url: width: 160
                  | image_tag:
                    class: 'icon',
                    widths: '40, 80, 120, 160',
                    sizes: '48px',
                    loading: 'lazy'
                }}
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <div class="feature_text" style="--line-color: {{ block.settings.text_color }};">
                  {{- block.settings.text -}}
                </div>
              {%- endif -%}

              {%- if block.settings.text_2 != blank -%}
                <div class="feature_text" style="--line-color: {{ block.settings.text_2_color }};">
                  {{- block.settings.text_2 -}}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
        <div class="actions">
          {%- if section.settings.button_label_1 != blank -%}
            <a
              class="action"
              {% if section.settings.button_link_1 != blank %}
                href="{{ section.settings.button_link_1 }}"
              {% else %}
                role="link"
                aria-disabled="true"
              {% endif %}
            >
              <span class="inner">
                {%- if section.settings.button_icon_1 != blank -%}
                  {{
                    section.settings.button_icon_1
                    | image_url: width: 80
                    | image_tag: class: 'icon', widths: '20, 40, 60, 80', sizes: '20px', loading: 'lazy'
                  }}
                {%- endif -%}

                <span class="label">{{ section.settings.button_label_1 | escape }}</span>
              </span>
            </a>
          {%- endif -%}

          {%- if section.settings.button_label_2 != blank -%}
            <a
              class="action"
              {% if section.settings.button_link_2 != blank %}
                href="{{ section.settings.button_link_2 }}"
              {% else %}
                role="link"
                aria-disabled="true"
              {% endif %}
            >
              <span class="inner">
                {%- if section.settings.button_icon_2 != blank -%}
                  {{
                    section.settings.button_icon_2
                    | image_url: width: 80
                    | image_tag: class: 'icon', widths: '20, 40, 60, 80', sizes: '20px', loading: 'lazy'
                  }}
                {%- endif -%}

                <span class="label">{{ section.settings.button_label_2 | escape }}</span>
              </span>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}


    </div>
  </div>

  {%- if bottom_blocks.size > 0 -%}
    <div class="bottom_bar">
      <div class="inner page-width">
        {%- for block in bottom_blocks -%}
          <div class="item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              {{
                block.settings.icon
                | image_url: width: 128
                | image_tag:
                  class: 'icon',
                  widths: '48, 96, 128',
                  sizes: '48px',
                  loading: 'lazy'
              }}
            {%- endif -%}

            <div class="texts">
              {%- if block.settings.text_1 != blank -%}
                <div class="line line_top" style="--line-color: {{ block.settings.text_1_color }};">
                  {{- block.settings.text_1 -}}
                </div>
              {%- endif -%}

              {%- if block.settings.text_2 != blank -%}
                <div class="line line_bottom" style="--line-color: {{ block.settings.text_2_color }};">
                  {{- block.settings.text_2 -}}
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .image_text_banner {
    --content-padding-top: 60px;
    --button-skew: -10deg;
    --bottom-bar-divider: rgba(255, 255, 255, 0.22);

    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: var(--desktop-height);
    overflow: hidden;
    isolation: isolate;
    color: var(--text-color);
    background: var(--fallback-background);
  }

  .image_text_banner .background {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .image_text_banner .background .image,
  .image_text_banner .background .placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image_text_banner .container {
    position: relative;
    z-index: 1;
    display: flex;
    flex: 1 1 auto;
    align-items: var(--desktop-align);
    justify-content: var(--desktop-justify);
    width: 100%;
  }

  .image_text_banner .content {
    width: var(--content-width);
    max-width: 100%;
    padding-top: var(--content-padding-top);
    text-align: var(--desktop-text-align);
  }

  .image_text_banner .eyebrow {
    padding-bottom: 40px;
    color: var(--eyebrow-color);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.3;
  }

  .image_text_banner .eyebrow .text {
    display: inline-block;
    background: var(--eyebrow-background);
  }

  .image_text_banner .title {
    margin: 0;
    color: var(--title-color);
    font-size: var(--title-size);
    font-weight: 700;
    line-height: 1.08;
  }

  .image_text_banner .title .text {
    display: inline-block;
    background: var(--title-background);
  }

  .image_text_banner .subtitle {
    margin-top: 1.6rem;
  }

  .image_text_banner .subtitle .text {
    display: inline-block;
    color: var(--subtitle-color);
    background: var(--subtitle-background);
    font-size: var(--subtitle-size);
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.2;
  }

  .image_text_banner .subtitle .text.has_background {
    padding: 0.4rem 1.2rem;
  }

  .image_text_banner .description {
    margin-top: 1.6rem;
    color: var(--description-color);
    font-size: 1.6rem;
    line-height: 1.5;
  }

  .image_text_banner .description .text {
    background: var(--description-background);
  }

  .image_text_banner .description .text > * {
    margin-top: 0;
    margin-bottom: 0;
  }

  .image_text_banner .has_background {
    padding: 0.6rem 1.6rem;
  }

  .image_text_banner .description .text.has_background {
    display: inline-block;
  }

  .image_text_banner .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: var(--desktop-justify);
    gap: 1.6rem;
    margin-top: 2.4rem;
  }

  .image_text_banner .action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4.8rem;
    padding: 1rem 2.4rem;
    border: 2px solid currentcolor;
    border-radius: 14px 2px 14px 2px;
    color: var(--button-text-color);
    background: transparent;
    text-decoration: none;
    transform: skewX(var(--button-skew));
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }

  .image_text_banner .action .inner {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    transform: skewX(calc(var(--button-skew) * -1));
  }

  .image_text_banner .action .icon {
    width: 20px;
    height: 20px;
    flex: 0 0 20px;
    object-fit: contain;
  }

  .image_text_banner .action .label {
    font-size: var(--button-font-size);
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
  }

  .image_text_banner .action:hover {
    background: var(--button-hover-background);
    background-origin: border-box;
    border-color: transparent;
  }

  .image_text_banner .action[aria-disabled='true'] {
    cursor: not-allowed;
    opacity: 0.6;
  }

  .image_text_banner .features {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: var(--desktop-justify);
    gap: 2.4rem;
    margin-top: 2.4rem;
  }

  .image_text_banner .feature {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    min-width: 0;
    text-align: center;
  }

  .image_text_banner .feature .icon {
    width: 48px;
    height: 48px;
    flex: 0 0 48px;
    object-fit: contain;
  }

  .image_text_banner .feature_text {
    color: var(--line-color, inherit);
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.25;
    text-align: center;
  }

  .image_text_banner .bottom_bar {
    position: relative;
    z-index: 1;
    width: 100%;
    margin-top: auto;
    padding: 1.6rem 0;
    background: var(--bottom-bar-background);
  }

  .image_text_banner .bottom_bar .inner {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
  }

  .image_text_banner .bottom_bar .item {
    position: relative;
    display: flex;
    flex: 1 1 0;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    min-width: 0;
    padding: 0.4rem 1.6rem;
  }

  .image_text_banner .bottom_bar .item:not(:last-child)::after {
    position: absolute;
    top: 50%;
    right: 0;
    width: 1px;
    height: 2.8rem;
    background: var(--bottom-bar-divider);
    transform: translateY(-50%);
    content: '';
  }

  .image_text_banner .bottom_bar .icon {
    width: 48px;
    height: 48px;
    flex: 0 0 48px;
    object-fit: contain;
  }

  .image_text_banner .bottom_bar .texts {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .image_text_banner .bottom_bar .line {
    color: var(--line-color, inherit);
    font-size: 1.3rem;
    line-height: 1.25;
  }

  .image_text_banner .bottom_bar .line_top {
    font-weight: 700;
  }

  .image_text_banner .bottom_bar .line_bottom {
    font-weight: 500;
  }

  @media screen and (min-width: 750px) {
    .image_text_banner .hidden_desktop {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .image_text_banner {
      min-height: var(--mobile-height);
    }

    .image_text_banner .hidden_mobile {
      display: none;
    }

    .image_text_banner .container {
      align-items: center;
      justify-content: center;
    }

    .image_text_banner .content {
      width: 100%;
      text-align: center;
    }

    .image_text_banner .title {
      font-size: var(--mobile-title-size);
    }

    .image_text_banner .actions,
    .image_text_banner .features {
      justify-content: center;
    }

    .image_text_banner .bottom_bar .inner {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.2rem;
    }

    .image_text_banner .bottom_bar .item {
      justify-content: flex-start;
      padding: 0.4rem 0;
    }

    .image_text_banner .bottom_bar .item:not(:last-child)::after {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "图片文字横幅",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "背景"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "背景图片"
    },
    {
      "type": "color",
      "id": "fallback_background",
      "label": "无图片时的背景颜色",
      "default": "#f3f3f3"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 400,
      "max": 900,
      "step": 10,
      "unit": "px",
      "label": "PC 端高度",
      "default": 640
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 360,
      "max": 800,
      "step": 10,
      "unit": "px",
      "label": "移动端高度",
      "default": 560
    },
    {
      "type": "header",
      "content": "内容布局"
    },
    {
      "type": "select",
      "id": "desktop_horizontal_position",
      "label": "PC 端水平位置",
      "options": [
        {
          "value": "flex-start",
          "label": "左侧"
        },
        {
          "value": "center",
          "label": "居中"
        },
        {
          "value": "flex-end",
          "label": "右侧"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "desktop_vertical_position",
      "label": "PC 端垂直位置",
      "options": [
        {
          "value": "flex-start",
          "label": "顶部"
        },
        {
          "value": "center",
          "label": "居中"
        },
        {
          "value": "flex-end",
          "label": "底部"
        }
      ],
      "default": "center"
    },
    {
      "type": "text_alignment",
      "id": "desktop_text_alignment",
      "label": "PC 端文字对齐",
      "default": "left"
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 25,
      "max": 60,
      "step": 1,
      "unit": "%",
      "label": "PC 端内容宽度",
      "default": 35
    },
    {
      "type": "header",
      "content": "顶部小字行"
    },
    {
      "type": "inline_richtext",
      "id": "eyebrow_text",
      "label": "小字文案",
      "default": "— YOUR DESIGNS. OUR QUALITY. YOUR SUCCESS."
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "小字文案颜色",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "eyebrow_background",
      "label": "小字背景颜色",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "checkbox",
      "id": "eyebrow_show_desktop",
      "label": "PC 端显示小字行",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "eyebrow_show_mobile",
      "label": "移动端显示小字行",
      "default": true
    },
    {
      "type": "header",
      "content": "文字"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "标题",
      "default": "DTF Dallas | DTF Transfers & Custom Tshirt Printing"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "标题颜色",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "title_background",
      "label": "标题背景颜色",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "inline_richtext",
      "id": "subtitle_text",
      "label": "标题下方文案",
      "default": "UPLOAD. WE PRINT. YOU PRESS. YOU GROW."
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "min": 12,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "标题下方文案字号",
      "default": 20
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "标题下方文案颜色",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "subtitle_background",
      "label": "标题下方文案背景颜色",
      "default": "#000000"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "描述",
      "default": "<p>Professional quality Direct-to-Film transfers, custom t-shirts and UV stickers. Fast turnaround, unbeatable prices.</p>"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "描述颜色",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "description_background",
      "label": "描述背景颜色",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "整体文字颜色（未单独设置时生效）",
      "default": "#121212"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "PC 端标题字号",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_title_size",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "移动端标题字号",
      "default": 32
    },
    {
      "type": "header",
      "content": "按钮"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "按钮 1 文案",
      "default": "跳转 1"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "按钮 1 链接"
    },
    {
      "type": "image_picker",
      "id": "button_icon_1",
      "label": "按钮 1 图标"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "按钮 2 文案",
      "default": "跳转 2"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "按钮 2 链接"
    },
    {
      "type": "image_picker",
      "id": "button_icon_2",
      "label": "按钮 2 图标"
    },
    {
      "type": "text",
      "id": "button_hover_background",
      "label": "按钮 hover 渐变背景",
      "info": "支持颜色或渐变写法",
      "default": "linear-gradient(90deg, #bdf807, #14bffd)"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "按钮文字及边框颜色",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "min": 12,
