{% render 'swiper-assets' %}
<script src="{{ 'product-advantages.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .product_advantages-{{ section.id }} {
    --advantages-padding-top: {{ section.settings.mobile_padding_top }}px;
    --advantages-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    --advantages-section-bg: {{ section.settings.section_background }};
    --advantages-card-bg: {{ section.settings.card_background }};
    --advantages-title-color: {{ section.settings.title_color }};
    --advantages-item-title-color: {{ section.settings.item_title_color }};
    --advantages-text-color: {{ section.settings.text_color }};
    --advantages-divider-color: {{ section.settings.divider_color }};
    --advantages-card-radius: {{ section.settings.card_radius }}px;
    --advantages-card-shadow: {{ section.settings.card_shadow }};
  }

  @media screen and (min-width: 750px) {
    .product_advantages-{{ section.id }} {
      --advantages-padding-top: {{ section.settings.padding_top }}px;
      --advantages-padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  class="product_advantages product_advantages-{{ section.id }} color-{{ section.settings.color_scheme }}"
  id="ProductAdvantages-{{ section.id }}"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <product-advantages>
        <div class="carousel" data-advantages-swiper>
          <div class="swiper-wrapper">
            {%- for block in section.blocks -%}
              <div class="swiper-slide" {{ block.shopify_attributes }}>
                <article class="item">
                  <div class="icon_area">
                    {%- if block.settings.image != blank -%}
                      {%- assign advantage_image_alt = block.settings.image.alt | default: block.settings.item_title -%}
                      {{
                        block.settings.image
                        | image_url: width: 280
                        | image_tag:
                          loading: 'lazy',
                          widths: '140, 280',
                          sizes: '140px',
                          class: 'icon',
                          alt: advantage_image_alt
                      }}
                    {%- else -%}
                      <div class="icon placeholder">
                        {{ 'image' | placeholder_svg_tag }}
                      </div>
                    {%- endif -%}
                  </div>

                  <div class="content">
                    {%- if block.settings.item_title != blank -%}
                      <h3 class="item_title">{{ block.settings.item_title | escape }}</h3>
                    {%- endif -%}

                    {%- if block.settings.text != blank -%}
                      <p class="text">{{ block.settings.text | escape | newline_to_br }}</p>
                    {%- endif -%}
                  </div>
                </article>
              </div>
            {%- endfor -%}
          </div>

          <button
            type="button"
            class="nav_button previous"
            data-swiper-previous
            aria-label="{{ 'general.slider.previous_slide' | t }}"
          >
            <span aria-hidden="true">‹</span>
          </button>
          <button
            type="button"
            class="nav_button next"
            data-swiper-next
            aria-label="{{ 'general.slider.next_slide' | t }}"
          >
            <span aria-hidden="true">›</span>
          </button>
        </div>
      </product-advantages>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .product_advantages {
    padding: var(--advantages-padding-top) 0 var(--advantages-padding-bottom);
    background: var(--advantages-section-bg);
  }

  .product_advantages .heading {
    margin: 0 0 3.2rem;
    color: var(--advantages-title-color);
    text-align: center;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: calc(var(--font-heading-scale) * 2.4rem);
    line-height: 1.25;
    letter-spacing: calc(var(--font-heading-scale) * 0.04rem);
  }

  .product_advantages .carousel {
    position: relative;
    overflow: hidden;
  }

  .product_advantages .item {
    height: 100%;
    padding: 2.4rem;
    border-radius: var(--advantages-card-radius);
    background: var(--advantages-card-bg);
    box-shadow: var(--advantages-card-shadow);
  }

  .product_advantages .icon_area {
    width: 140px;
  }

  .product_advantages .icon_area::after {
    display: block;
    width: 100%;
    height: 0.1rem;
    margin: 4rem 0;
    background: var(--advantages-divider-color);
    content: '';
  }

  .product_advantages .icon {
    display: block;
    width: 14rem;
    height: 14rem;
    object-fit: contain;
    transition: transform 0.35s ease;
  }

  .product_advantages .icon.placeholder {
    color: rgba(18, 18, 18, 0.2);
    background: rgba(18, 18, 18, 0.04);
  }

  .product_advantages .icon.placeholder svg {
    width: 100%;
  }

  .product_advantages .item:hover .icon {
    transform: scale(1.08);
  }

  .product_advantages .item_title {
    margin: 0 0 0.8rem;
    color: var(--advantages-item-title-color);
    text-align: left;
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: calc(var(--font-heading-scale) * 1.8rem);
    line-height: 1.3;
  }

  .product_advantages .text {
    margin: 0;
    color: var(--advantages-text-color);
    text-align: left;
    font-size: 1.4rem;
    line-height: 1.6;
  }

  .product_advantages .nav_button {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.6rem;
    height: 3.6rem;
    padding: 0;
    border: 0.1rem solid rgba(18, 18, 18, 0.12);
    border-radius: 50%;
    background: #ffffff;
    color: #121212;
    font-size: 2.4rem;
    line-height: 1;
    cursor: pointer;
    transform: translateY(-50%);
    box-shadow: 0 0.4rem 1.2rem rgba(18, 18, 18, 0.08);
  }

  .product_advantages .nav_button.previous {
    left: 0.4rem;
  }

  .product_advantages .nav_button.next {
    right: 0.4rem;
  }

  .product_advantages .nav_button.swiper-button-disabled {
    opacity: 0.35;
    cursor: default;
  }

  @media screen and (min-width: 750px) {
    .product_advantages .swiper-wrapper {
      justify-content: center;
    }

    .product_advantages .swiper-slide {
      width: 36rem;
    }

    .product_advantages .heading {
      margin-bottom: 4rem;
      font-size: calc(var(--font-heading-scale) * 3.2rem);
    }

    .product_advantages .item {
      display: flex;
      width: 33rem;
      height: 36rem;
      padding: 2.8rem;
      box-sizing: border-box;
      flex-direction: column;
      justify-content: space-between;
    }
    .product_advantages .icon_area {
      width: 140px;
    }
 

    .product_advantages .content {
      width: 100%;
      min-height: 80px;
    }

    .product_advantages .nav_button {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "产品优势",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Why Choose Our DTF Transfers"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "样式"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "区块背景色",
      "default": "#f7f8f8"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "卡片背景色",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "标题颜色",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "item_title_color",
      "label": "条目标题颜色",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "正文颜色",
      "default": "#6b7280"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "分割线颜色",
      "default": "#e5e7eb"
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "卡片圆角",
      "default": 12
    },
    {
      "type": "text",
      "id": "card_shadow",
      "label": "卡片阴影",
      "default": "inset 0 0 0 1px rgba(18, 18, 18, 0.12)"
    },
    {
      "type": "header",
      "content": "间距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "PC 上内边距",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "PC 下内边距",
      "default": 60
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "移动端上内边距",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "移动端下内边距",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "advantage_item",
      "name": "优势条目",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "图标图片（140 x 140）"
        },
        {
          "type": "text",
          "id": "item_title",
          "label": "条目标题",
          "default": "颜色鲜艳"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "描述文本",
          "default": "水洗牢度好，水洗50次不变形。"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "产品优势",
      "blocks": [
        {
          "type": "advantage_item",
          "settings": {
            "item_title": "颜色鲜艳",
            "text": "水洗牢度好，水洗50次不变形。"
          }
        },
        {
          "type": "advantage_item",
          "settings": {
            "item_title": "适用多种面料",
            "text": "适用丁名科面料，衣服，帆布袋，帽子，帆布。"
          }
        },
        {
          "type": "advantage_item",
          "settings": {
            "item_title": "灵活定制",
            "text": "一件或多件定制，支持团队服装商业活动定制。"
          }
        }
      ]
    }
  ]
}
{% endschema %}
