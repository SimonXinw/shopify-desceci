{% render 'swiper-assets' %}
<script src="{{ 'product-advantages.js' | asset_url }}" defer="defer"></script>

<div
  class="product_advantages_section"
  style="
    --pa-section-background: {{ section.settings.section_background }};
    --pa-heading-color: {{ section.settings.heading_color }};
    --pa-heading-size: {{ section.settings.heading_size }}px;
    --pa-mobile-heading-size: {{ section.settings.mobile_heading_size }}px;
    --pa-description-color: {{ section.settings.description_color }};
    --pa-description-size: {{ section.settings.description_size }}px;
    --pa-card-background: {{ section.settings.card_background }};
    --pa-card-border-color: {{ section.settings.card_border_color }};
    --pa-card-radius: {{ section.settings.card_radius }}px;
    --pa-card-title-color: {{ section.settings.card_title_color }};
    --pa-card-title-size: {{ section.settings.card_title_size }}px;
    --pa-underline-color: {{ section.settings.title_underline_color }};
    --pa-card-description-color: {{ section.settings.card_description_color }};
    --pa-card-description-size: {{ section.settings.card_description_size }}px;
    --pa-icon-size: {{ section.settings.icon_size }}px;
    --pa-icon-label-color: {{ section.settings.icon_label_color }};
    --pa-icon-label-size: {{ section.settings.icon_label_size }}px;
    --pa-padding-top: {{ section.settings.padding_top }}px;
    --pa-padding-bottom: {{ section.settings.padding_bottom }}px;
    --pa-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --pa-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  "
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="pa_heading inline-richtext">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <p class="pa_description">{{ section.settings.description | escape }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <product-advantages>
        <div class="swiper pa_carousel" data-advantages-swiper>
          <div class="swiper-wrapper">
            {%- for block in section.blocks -%}
              <div class="swiper-slide" {{ block.shopify_attributes }}>
                <article class="pa_card">
                  {%- if block.settings.image != blank -%}
                    {%- assign card_image_alt = block.settings.image.alt | default: block.settings.item_title -%}
                    {{
                      block.settings.image
                      | image_url: width: 1200
                      | image_tag:
                        class: 'pa_card_image',
                        widths: '400, 600, 800, 1200',
                        sizes: '(min-width: 750px) 32vw, 90vw',
                        alt: card_image_alt
                    }}
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'pa_card_image pa_card_placeholder' }}
                  {%- endif -%}

                  <div class="pa_card_body">
                    {%- if block.settings.item_title != blank -%}
                      <h3 class="pa_card_title">{{ block.settings.item_title | escape }}</h3>
                    {%- endif -%}

                    {%- if block.settings.item_description != blank -%}
                      <p class="pa_card_description">
                        {{- block.settings.item_description | escape | newline_to_br -}}
                      </p>
                    {%- endif -%}

                    {%- capture icon_items -%}
                      {%- assign icon_indexes = '1,2,3,4' | split: ',' -%}
                      {%- for icon_index in icon_indexes -%}
                        {%- assign icon_key = 'icon_' | append: icon_index -%}
                        {%- assign icon_label_key = 'icon_label_' | append: icon_index -%}
                        {%- assign icon_image = block.settings[icon_key] -%}
                        {%- assign icon_label = block.settings[icon_label_key] -%}

                        {%- if icon_image != blank or icon_label != blank -%}
                          <li class="pa_icon_item">
                            {%- if icon_image != blank -%}
                              {{
                                icon_image
                                | image_url: width: 160
                                | image_tag: class: 'pa_icon', widths: '80, 160', alt: icon_label
                              }}
                            {%- endif -%}

                            {%- if icon_label != blank -%}
                              <span class="pa_icon_label">{{ icon_label | escape }}</span>
                            {%- endif -%}
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endcapture -%}

                    {%- if icon_items != blank -%}
                      <ul class="pa_icon_row" role="list">{{ icon_items }}</ul>
                    {%- endif -%}
                  </div>
                </article>
              </div>
            {%- endfor -%}
          </div>

          <button
            type="button"
            class="pa_nav_button previous"
            data-swiper-previous
            aria-label="{{ 'general.slider.previous_slide' | t }}"
          >
            <span aria-hidden="true">‹</span>
          </button>

          <button
            type="button"
            class="pa_nav_button next"
            data-swiper-next
            aria-label="{{ 'general.slider.next_slide' | t }}"
          >
            <span aria-hidden="true">›</span>
          </button>
        </div>
      </product-advantages>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .product_advantages_section {
    padding-top: var(--pa-mobile-padding-top);
    padding-bottom: var(--pa-mobile-padding-bottom);
    background: var(--pa-section-background);
  }

  .product_advantages_section .pa_heading {
    margin: 0;
    color: var(--pa-heading-color);
    font-size: var(--pa-mobile-heading-size);
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
  }

  .product_advantages_section .pa_description {
    margin: 1.2rem 0 0;
    color: var(--pa-description-color);
    font-size: var(--pa-description-size);
    letter-spacing: 0.06em;
    line-height: 1.5;
    text-align: center;
  }

  .product_advantages_section .pa_carousel {
    margin-top: 2.4rem;
  }

  .product_advantages_section .swiper-slide {
    display: flex;
    height: auto;
  }

  .product_advantages_section .pa_card {
    display: flex;
    width: 100%;
    flex-direction: column;
    overflow: hidden;
    border: 0.1rem solid var(--pa-card-border-color);
    border-radius: var(--pa-card-radius);
    background: var(--pa-card-background);
  }

  .product_advantages_section .pa_card_image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .product_advantages_section .pa_card_placeholder {
    background: rgba(18, 18, 18, 0.04);
  }

  .product_advantages_section .pa_card_body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    padding: 2.4rem 1.6rem;
    text-align: center;
  }

  .product_advantages_section .pa_card_title {
    margin: 0;
    color: var(--pa-card-title-color);
    font-size: var(--pa-card-title-size);
    font-weight: 700;
    line-height: 1.3;
  }

  .product_advantages_section .pa_card_title::after {
    display: block;
    width: 4rem;
    height: 0.2rem;
    margin: 1.2rem auto 0;
    border-radius: 999px;
    background: var(--pa-underline-color);
    content: "";
  }

  .product_advantages_section .pa_card_description {
    margin: 1.6rem 0 0;
    color: var(--pa-card-description-color);
    font-size: var(--pa-card-description-size);
    line-height: 1.6;
  }

  .product_advantages_section .pa_icon_row {
    display: flex;
    gap: 1.2rem;
    margin: auto 0 0;
    padding: 2.4rem 0 0;
    list-style: none;
  }

  .product_advantages_section .pa_icon_item {
    display: flex;
    min-width: 0;
    flex: 1 1 0;
    flex-direction: column;
    gap: 0.8rem;
    align-items: center;
  }

  .product_advantages_section .pa_icon {
    display: block;
    width: var(--pa-icon-size);
    height: var(--pa-icon-size);
    object-fit: contain;
  }

  .product_advantages_section .pa_icon_label {
    color: var(--pa-icon-label-color);
    font-size: var(--pa-icon-label-size);
    line-height: 1.4;
    text-align: center;
    overflow-wrap: anywhere;
  }

  .product_advantages_section .pa_nav_button {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: inline-flex;
    width: 3.6rem;
    height: 3.6rem;
    padding: 0;
    align-items: center;
    justify-content: center;
    border: 0.1rem solid rgba(18, 18, 18, 0.12);
    border-radius: 50%;
    background: #ffffff;
    color: #121212;
    font-size: 2.4rem;
    line-height: 1;
    cursor: pointer;
    transform: translateY(-50%);
    box-shadow: 0 0.4rem 1.2rem rgba(18, 18, 18, 0.08);
  }

  .product_advantages_section .pa_nav_button.previous {
    left: 0.4rem;
  }

  .product_advantages_section .pa_nav_button.next {
    right: 0.4rem;
  }

  .product_advantages_section .pa_nav_button.swiper-button-disabled {
    opacity: 0.35;
    cursor: default;
  }

  @media screen and (min-width: 750px) {
    .product_advantages_section {
      padding-top: var(--pa-padding-top);
      padding-bottom: var(--pa-padding-bottom);
    }

    .product_advantages_section .pa_heading {
      font-size: var(--pa-heading-size);
    }

    .product_advantages_section .pa_carousel {
      margin-top: 4rem;
    }

    .product_advantages_section .pa_card_body {
      padding: 2.8rem 2.4rem;
    }

    .product_advantages_section .pa_nav_button {
      display: none;
    }
  }
{% endstylesheet %}

