    "custom_liquid_LcM9Jy": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% assign supplies_blog = blogs['dtf-supplies'] %}\n\n<div class=\"desceci-blog-center\">\n\n  <!-- =========================\n       TOP CATEGORY NAV\n  ========================== -->\n\n  <nav class=\"desceci-blog-tabs\" aria-label=\"Blog categories\">\n\n    <a\n      href=\"{{ blog.url }}\"\n      class=\"desceci-blog-tab active\"\n    >\n      All Articles\n    </a>\n\n    <a\n      href=\"{{ blog.url }}\"\n      class=\"desceci-blog-tab\"\n    >\n      DTF Transfers\n    </a>\n\n    {% if supplies_blog != blank %}\n      <a\n        href=\"{{ supplies_blog.url }}\"\n        class=\"desceci-blog-tab\"\n      >\n        DTF Supplies\n      </a>\n    {% endif %}\n\n  </nav>\n\n\n  <!-- =========================\n       MAIN BLOG\n  ========================== -->\n\n  {% paginate blog.articles by 12 %}\n\n  <section class=\"desceci-main-blog\">\n\n    <div class=\"desceci-blog-heading\">\n\n      <span class=\"desceci-eyebrow\">\n        DESCECI DTF RESOURCES\n      </span>\n\n      <h1>{{ blog.title }}</h1>\n\n      <p>\n        Learn everything you need to know about DTF transfers,\n        heat pressing, application techniques, troubleshooting,\n        durability, gang sheets, and custom apparel printing.\n      </p>\n\n    </div>\n\n\n    {% if blog.articles.size > 0 %}\n\n      <div class=\"desceci-main-grid\">\n\n        {% for article in blog.articles %}\n\n          <article class=\"desceci-article-card\">\n\n            <a\n              href=\"{{ article.url }}\"\n              class=\"desceci-article-image-wrap\"\n              aria-label=\"{{ article.title | escape }}\"\n            >\n\n              {% if article.image %}\n\n                {{\n                  article.image\n                  | image_url: width: 1000\n                  | image_tag:\n                    loading: 'lazy',\n                    widths: '360, 540, 720, 900, 1000',\n                    sizes: '(max-width: 749px) 100vw, (max-width: 989px) 50vw, 33vw',\n                    class: 'desceci-article-image',\n                    alt: article.image.alt\n                }}\n\n              {% else %}\n\n                <div class=\"desceci-image-placeholder\">\n                  DESCECI DTF GUIDE\n                </div>\n\n              {% endif %}\n\n            </a>\n\n\n            <div class=\"desceci-article-content\">\n\n              <div class=\"desceci-article-date\">\n                {{ article.published_at | date: \"%B %d, %Y\" }}\n              </div>\n\n              <h2 class=\"desceci-article-title\">\n                <a href=\"{{ article.url }}\">\n                  {{ article.title }}\n                </a>\n              </h2>\n\n              <div class=\"desceci-article-excerpt\">\n\n                {% if article.excerpt != blank %}\n                  {{ article.excerpt | strip_html | truncatewords: 28 }}\n                {% else %}\n                  {{ article.content | strip_html | truncatewords: 28 }}\n                {% endif %}\n\n              </div>\n\n              <a\n                href=\"{{ article.url }}\"\n                class=\"desceci-read-more\"\n              >\n                Read More <span>→</span>\n              </a>\n\n            </div>\n\n          </article>\n\n        {% endfor %}\n\n      </div>\n\n\n      {% if paginate.pages > 1 %}\n\n        <nav\n          class=\"desceci-pagination\"\n          aria-label=\"Blog pagination\"\n        >\n\n          {% if paginate.previous %}\n            <a\n              href=\"{{ paginate.previous.url }}\"\n              class=\"desceci-pagination-arrow\"\n              aria-label=\"Previous page\"\n            >\n              ←\n            </a>\n          {% endif %}\n\n          {% for part in paginate.parts %}\n\n            {% if part.is_link %}\n\n              <a\n                href=\"{{ part.url }}\"\n                class=\"desceci-pagination-number\"\n              >\n                {{ part.title }}\n              </a>\n\n            {% else %}\n\n              {% if part.title == paginate.current_page %}\n\n                <span class=\"desceci-pagination-number active\">\n                  {{ part.title }}\n                </span>\n\n              {% else %}\n\n                <span class=\"desceci-pagination-dots\">\n                  {{ part.title }}\n                </span>\n\n              {% endif %}\n\n            {% endif %}\n\n          {% endfor %}\n\n          {% if paginate.next %}\n            <a\n              href=\"{{ paginate.next.url }}\"\n              class=\"desceci-pagination-arrow\"\n              aria-label=\"Next page\"\n            >\n              →\n            </a>\n          {% endif %}\n\n        </nav>\n\n      {% endif %}\n\n    {% endif %}\n\n  </section>\n\n  {% endpaginate %}\n\n\n  <!-- =========================\n       DTF SUPPLIES\n  ========================== -->\n\n  {% if supplies_blog != blank and supplies_blog.articles.size > 0 %}\n\n    <section class=\"desceci-supplies-section\">\n\n      <div class=\"desceci-supplies-heading\">\n\n        <div>\n\n          <span class=\"desceci-eyebrow\">\n            DTF PRINTING RESOURCES\n          </span>\n\n          <h2>DTF Supplies Guides</h2>\n\n          <p>\n            Explore expert guides on DTF ink, transfer film,\n            adhesive powder, Epson printheads, heat press equipment,\n            and other essential DTF printing supplies.\n          </p>\n\n        </div>\n\n        <a\n          href=\"{{ supplies_blog.url }}\"\n          class=\"desceci-view-all\"\n        >\n          View All Guides <span>→</span>\n        </a>\n\n      </div>\n\n\n      <div class=\"desceci-supplies-grid\">\n\n        {% for article in supplies_blog.articles limit: 4 %}\n\n          <article class=\"desceci-supply-card\">\n\n            <a\n              href=\"{{ article.url }}\"\n              class=\"desceci-supply-image-wrap\"\n              aria-label=\"{{ article.title | escape }}\"\n            >\n\n              {% if article.image %}\n\n                {{\n                  article.image\n                  | image_url: width: 800\n                  | image_tag:\n                    loading: 'lazy',\n                    widths: '360, 540, 720, 800',\n                    sizes: '(max-width: 749px) 100vw, (max-width: 989px) 50vw, 25vw',\n                    class: 'desceci-supply-image',\n                    alt: article.image.alt\n                }}\n\n              {% else %}\n\n                <div class=\"desceci-supply-placeholder\">\n                  DTF SUPPLIES GUIDE\n                </div>\n\n              {% endif %}\n\n            </a>\n\n            <div class=\"desceci-supply-content\">\n\n              <div class=\"desceci-supply-date\">\n                {{ article.published_at | date: \"%B %d, %Y\" }}\n              </div>\n\n              <h3>\n                <a href=\"{{ article.url }}\">\n                  {{ article.title }}\n                </a>\n              </h3>\n\n              <p>\n                {% if article.excerpt != blank %}\n                  {{ article.excerpt | strip_html | truncatewords: 22 }}\n                {% else %}\n                  {{ article.content | strip_html | truncatewords: 22 }}\n                {% endif %}\n              </p>\n\n              <a\n                href=\"{{ article.url }}\"\n                class=\"desceci-supply-read\"\n              >\n                Read Guide <span>→</span>\n              </a>\n\n            </div>\n\n          </article>\n\n        {% endfor %}\n\n      </div>\n\n    </section>\n\n  {% endif %}\n\n</div>\n\n\n<style>\n\n.desceci-blog-center {\n  width: 100%;\n  color: #1d1d1f;\n}\n\n.desceci-blog-tabs {\n  display: flex;\n  justify-content: center;\n  flex-wrap: wrap;\n  gap: 10px;\n  max-width: 1240px;\n  margin: 35px auto 10px;\n  padding: 0 20px;\n}\n\n.desceci-blog-tab {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 42px;\n  padding: 10px 18px;\n  border: 1px solid #dedede;\n  border-radius: 999px;\n  background: #fff;\n  color: #222 !important;\n  text-decoration: none !important;\n  font-size: 14px;\n  font-weight: 600;\n  transition: all .2s ease;\n}\n\n.desceci-blog-tab:hover {\n  border-color: #222;\n}\n\n.desceci-blog-tab.active {\n  background: #222;\n  border-color: #222;\n  color: #fff !important;\n}\n\n.desceci-main-blog,\n.desceci-supplies-section {\n  width: 100%;\n  max-width: 1240px;\n  margin-left: auto;\n  margin-right: auto;\n  box-sizing: border-box;\n}\n\n.desceci-main-blog {\n  padding: 45px 20px 70px;\n}\n\n.desceci-eyebrow {\n  display: block;\n  margin-bottom: 10px;\n  font-size: 11px;\n  line-height: 1.3;\n  font-weight: 700;\n  letter-spacing: 1.7px;\n  text-transform: uppercase;\n  color: #64706f;\n}\n\n.desceci-blog-heading {\n  max-width: 800px;\n  margin: 0 auto 48px;\n  text-align: center;\n}\n\n.desceci-blog-heading h1 {\n  margin: 0 0 15px;\n  font-size: 40px;\n  line-height: 1.2;\n  font-weight: 600;\n  color: #161616;\n}\n\n.desceci-blog-heading p {\n  margin: 0;\n  font-size: 16px;\n  line-height: 1.8;\n  color: #626262;\n}\n\n.desceci-main-grid {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 48px 28px;\n}\n\n.desceci-article-card {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n}\n\n.desceci-article-image-wrap,\n.desceci-supply-image-wrap {\n  display: block;\n  width: 100%;\n  aspect-ratio: 16 / 10;\n  overflow: hidden;\n  background: #f4f4f4;\n}\n\n.desceci-article-image-wrap {\n  border-radius: 9px;\n}\n\n.desceci-article-image,\n.desceci-supply-image {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  transition: transform .3s ease;\n}\n\n.desceci-article-card:hover .desceci-article-image,\n.desceci-supply-card:hover .desceci-supply-image {\n  transform: scale(1.025);\n}\n\n.desceci-image-placeholder,\n.desceci-supply-placeholder {\n  display: flex;\n  width: 100%;\n  height: 100%;\n  align-items: center;\n  justify-content: center;\n  padding: 20px;\n  box-sizing: border-box;\n  text-align: center;\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: 1.4px;\n  color: #777;\n  background: #f2f2f2;\n}\n\n.desceci-article-content {\n  display: flex;\n  flex: 1;\n  flex-direction: column;\n  padding: 19px 3px 0;\n}\n\n.desceci-article-date,\n.desceci-supply-date {\n  margin-bottom: 9px;\n  font-size: 10px;\n  font-weight: 600;\n  letter-spacing: 1px;\n  text-transform: uppercase;\n  color: #777;\n}\n\n.desceci-article-title {\n  margin: 0 0 12px;\n  font-size: 21px;\n  line-height: 1.4;\n  font-weight: 500;\n}\n\n.desceci-article-title a,\n.desceci-supply-content h3 a {\n  color: #171717 !important;\n  text-decoration: none !important;\n}\n\n.desceci-article-excerpt {\n  margin-bottom: 18px;\n  font-size: 14px;\n  line-height: 1.75;\n  color: #666;\n}\n\n.desceci-read-more,\n.desceci-supply-read,\n.desceci-view-all {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  margin-top: auto;\n  font-size: 13px;\n  font-weight: 600;\n  color: #222 !important;\n  text-decoration: none !important;\n}\n\n.desceci-pagination {\n  display: flex;\n  justify-content: center;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-top: 60px;\n}\n\n.desceci-pagination-number,\n.desceci-pagination-arrow {\n  display: inline-flex;\n  width: 42px;\n  height: 42px;\n  align-items: center;\n  justify-content: center;\n  border: 1px solid #ddd;\n  border-radius: 5px;\n  background: #fff;\n  color: #222 !important;\n  text-decoration: none !important;\n}\n\n.desceci-pagination-number.active {\n  background: #222;\n  border-color: #222;\n  color: #fff !important;\n}\n\n.desceci-supplies-section {\n  margin-bottom: 80px;\n  padding: 55px 35px;\n  border-radius: 12px;\n  background: #f6f7f7;\n}\n\n.desceci-supplies-heading {\n  display: flex;\n  align-items: flex-end;\n  justify-content: space-between;\n  gap: 40px;\n  margin-bottom: 35px;\n}\n\n.desceci-supplies-heading h2 {\n  margin: 0 0 10px;\n  font-size: 31px;\n  line-height: 1.25;\n  font-weight: 600;\n}\n\n.desceci-supplies-heading p {\n  max-width: 720px;\n  margin: 0;\n  font-size: 15px;\n  line-height: 1.75;\n  color: #626262;\n}\n\n.desceci-supplies-grid {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 22px;\n}\n\n.desceci-supply-card {\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  border: 1px solid #e5e5e5;\n  border-radius: 8px;\n  background: #fff;\n}\n\n.desceci-supply-content {\n  display: flex;\n  flex: 1;\n  flex-direction: column;\n  padding: 18px 18px 21px;\n}\n\n.desceci-supply-content h3 {\n  margin: 0 0 10px;\n  font-size: 18px;\n  line-height: 1.4;\n  font-weight: 500;\n}\n\n.desceci-supply-content p {\n  margin: 0 0 16px;\n  font-size: 13px;\n  line-height: 1.7;\n  color: #666;\n}\n\n@media screen and (max-width: 989px) {\n\n  .desceci-main-grid,\n  .desceci-supplies-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n}\n\n@media screen and (max-width: 749px) {\n\n  .desceci-blog-tabs {\n    justify-content: flex-start;\n    overflow-x: auto;\n    flex-wrap: nowrap;\n    padding-bottom: 5px;\n  }\n\n  .desceci-blog-tab {\n    flex-shrink: 0;\n  }\n\n  .desceci-main-blog {\n    padding: 35px 16px 55px;\n  }\n\n  .desceci-blog-heading h1 {\n    font-size: 30px;\n  }\n\n  .desceci-main-grid,\n  .desceci-supplies-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .desceci-supplies-section {\n    margin: 10px 16px 55px;\n    padding: 36px 18px;\n  }\n\n  .desceci-supplies-heading {\n    display: block;\n  }\n\n  .desceci-view-all {\n    margin-top: 18px;\n  }\n\n}\n</style>",
