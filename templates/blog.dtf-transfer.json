      "settings": {
        "custom_liquid": "{% paginate blog.articles by 12 %}\n\n<section class=\"desceci-blog-list\">\n\n  <div class=\"desceci-blog-header\">\n    <h1>{{ blog.title }}</h1>\n\n    {% if blog.metafields.custom.short_description != blank %}\n      <p>\n        {{ blog.metafields.custom.short_description }}\n      </p>\n    {% else %}\n      <p>\n        Explore DTF printing guides, transfer tips, heat press tutorials,\n        troubleshooting advice, and practical resources from DESCECI.\n      </p>\n    {% endif %}\n  </div>\n\n\n  {% if blog.articles.size > 0 %}\n\n    <div class=\"desceci-blog-grid\">\n\n      {% for article in blog.articles %}\n\n        <article class=\"desceci-blog-card\">\n\n          <a\n            href=\"{{ article.url }}\"\n            class=\"desceci-blog-image-link\"\n            aria-label=\"{{ article.title | escape }}\"\n          >\n\n            {% if article.image %}\n\n              {{\n                article.image\n                | image_url: width: 900\n                | image_tag:\n                  loading: 'lazy',\n                  widths: '360, 540, 720, 900',\n                  sizes: '(max-width: 749px) 100vw, (max-width: 989px) 50vw, 33vw',\n                  class: 'desceci-blog-image',\n                  alt: article.image.alt\n              }}\n\n            {% else %}\n\n              <div class=\"desceci-blog-placeholder\">\n                DESCECI DTF GUIDE\n              </div>\n\n            {% endif %}\n\n          </a>\n\n\n          <div class=\"desceci-blog-content\">\n\n            <div class=\"desceci-blog-date\">\n              {{ article.published_at | date: \"%B %d, %Y\" }}\n            </div>\n\n\n            <h2 class=\"desceci-blog-title\">\n\n              <a href=\"{{ article.url }}\">\n                {{ article.title }}\n              </a>\n\n            </h2>\n\n\n            <div class=\"desceci-blog-excerpt\">\n\n              {% if article.excerpt != blank %}\n\n                {{ article.excerpt | strip_html | truncatewords: 28 }}\n\n              {% else %}\n\n                {{ article.content | strip_html | truncatewords: 28 }}\n\n              {% endif %}\n\n            </div>\n\n\n            <a\n              href=\"{{ article.url }}\"\n              class=\"desceci-read-more\"\n            >\n              Read More →\n            </a>\n\n          </div>\n\n        </article>\n\n      {% endfor %}\n\n    </div>\n\n\n    {% if paginate.pages > 1 %}\n\n      <nav\n        class=\"desceci-pagination\"\n        aria-label=\"Blog pagination\"\n      >\n\n        {% if paginate.previous %}\n          <a\n            href=\"{{ paginate.previous.url }}\"\n            class=\"desceci-page-arrow\"\n          >\n            ←\n          </a>\n        {% endif %}\n\n\n        {% for part in paginate.parts %}\n\n          {% if part.is_link %}\n\n            <a\n              href=\"{{ part.url }}\"\n              class=\"desceci-page-number\"\n            >\n              {{ part.title }}\n            </a>\n\n          {% else %}\n\n            {% if part.title == paginate.current_page %}\n\n              <span class=\"desceci-page-number active\">\n                {{ part.title }}\n              </span>\n\n            {% else %}\n\n              <span class=\"desceci-page-dots\">\n                {{ part.title }}\n              </span>\n\n            {% endif %}\n\n          {% endif %}\n\n        {% endfor %}\n\n\n        {% if paginate.next %}\n          <a\n            href=\"{{ paginate.next.url }}\"\n            class=\"desceci-page-arrow\"\n          >\n            →\n          </a>\n        {% endif %}\n\n      </nav>\n\n    {% endif %}\n\n\n  {% else %}\n\n    <div class=\"desceci-no-posts\">\n      No articles have been published yet.\n    </div>\n\n  {% endif %}\n\n</section>\n\n{% endpaginate %}\n\n\n<style>\n\n.desceci-blog-list {\n  width: 100%;\n  max-width: 1240px;\n  margin: 0 auto;\n  padding: 45px 20px 70px;\n  box-sizing: border-box;\n}\n\n\n/* Header */\n\n.desceci-blog-header {\n  max-width: 780px;\n  margin: 0 auto 45px;\n  text-align: center;\n}\n\n.desceci-blog-header h1 {\n  margin: 0 0 14px;\n  font-size: 38px;\n  line-height: 1.2;\n  font-weight: 600;\n  color: #161616;\n}\n\n.desceci-blog-header p {\n  margin: 0;\n  font-size: 16px;\n  line-height: 1.8;\n  color: #666;\n}\n\n\n/* Grid */\n\n.desceci-blog-grid {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 42px 28px;\n}\n\n\n/* Card */\n\n.desceci-blog-card {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n}\n\n\n/* Image */\n\n.desceci-blog-image-link {\n  display: block;\n  width: 100%;\n  aspect-ratio: 16 / 10;\n  overflow: hidden;\n  border-radius: 8px;\n  background: #f5f5f5;\n  text-decoration: none;\n}\n\n.desceci-blog-image {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  transition: transform .3s ease;\n}\n\n.desceci-blog-card:hover .desceci-blog-image {\n  transform: scale(1.025);\n}\n\n.desceci-blog-placeholder {\n  display: flex;\n  width: 100%;\n  height: 100%;\n  align-items: center;\n  justify-content: center;\n  padding: 20px;\n  text-align: center;\n  font-size: 14px;\n  font-weight: 700;\n  letter-spacing: 1.5px;\n  color: #777;\n  box-sizing: border-box;\n}\n\n\n/* Content */\n\n.desceci-blog-content {\n  display: flex;\n  flex: 1;\n  flex-direction: column;\n  padding: 18px 3px 0;\n}\n\n.desceci-blog-date {\n  margin-bottom: 9px;\n  font-size: 11px;\n  line-height: 1.4;\n  font-weight: 600;\n  letter-spacing: 1px;\n  text-transform: uppercase;\n  color: #777;\n}\n\n.desceci-blog-title {\n  margin: 0 0 12px;\n  font-size: 21px;\n  line-height: 1.35;\n  font-weight: 500;\n}\n\n.desceci-blog-title a {\n  color: #171717 !important;\n  text-decoration: none !important;\n}\n\n.desceci-blog-title a:hover {\n  text-decoration: underline !important;\n  text-underline-offset: 4px;\n}\n\n.desceci-blog-excerpt {\n  margin-bottom: 16px;\n  font-size: 14px;\n  line-height: 1.75;\n  color: #666;\n}\n\n.desceci-read-more {\n  display: inline-block;\n  margin-top: auto;\n  font-size: 14px;\n  line-height: 1.4;\n  font-weight: 600;\n  color: #222 !important;\n  text-decoration: none !important;\n}\n\n.desceci-read-more:hover {\n  text-decoration: underline !important;\n  text-underline-offset: 4px;\n}\n\n\n/* Pagination */\n\n.desceci-pagination {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-top: 55px;\n}\n\n.desceci-page-number,\n.desceci-page-arrow {\n  display: inline-flex;\n  width: 40px;\n  height: 40px;\n  align-items: center;\n  justify-content: center;\n  border: 1px solid #dedede;\n  border-radius: 5px;\n  background: #fff;\n  color: #222 !important;\n  text-decoration: none !important;\n  font-size: 14px;\n}\n\n.desceci-page-number:hover,\n.desceci-page-arrow:hover {\n  border-color: #222;\n}\n\n.desceci-page-number.active {\n  border-color: #222;\n  background: #222;\n  color: #fff !important;\n}\n\n.desceci-page-dots {\n  padding: 0 5px;\n  color: #777;\n}\n\n\n/* Empty */\n\n.desceci-no-posts {\n  padding: 50px 20px;\n  text-align: center;\n  font-size: 16px;\n  color: #666;\n}\n\n\n/* Tablet */\n\n@media screen and (max-width: 989px) {\n\n  .desceci-blog-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n}\n\n\n/* Mobile */\n\n@media screen and (max-width: 749px) {\n\n  .desceci-blog-list {\n    padding: 35px 16px 55px;\n  }\n\n  .desceci-blog-header {\n    margin-bottom: 32px;\n  }\n\n  .desceci-blog-header h1 {\n    font-size: 29px;\n  }\n\n  .desceci-blog-header p {\n    font-size: 14px;\n  }\n\n  .desceci-blog-grid {\n    grid-template-columns: 1fr;\n    gap: 35px;\n  }\n\n  .desceci-blog-title {\n    font-size: 20px;\n  }\n\n}\n\n</style>{% assign supplies_blog = blogs['dtf-supplies-guides'] %}\n\n{% if supplies_blog != blank and supplies_blog.articles.size > 0 %}\n\n<section class=\"desceci-supplies-blog\">\n\n  <div class=\"desceci-supplies-header\">\n\n    <div>\n      <span class=\"desceci-supplies-eyebrow\">\n        DTF PRINTING RESOURCES\n      </span>\n\n      <h2>DTF Supplies Guides</h2>\n\n      <p>\n        Learn more about DTF ink, transfer film, adhesive powder,\n        printheads, and other essential DTF printing supplies.\n      </p>\n    </div>\n\n    <a href=\"{{ supplies_blog.url }}\" class=\"desceci-supplies-viewall\">\n      View All Guides →\n    </a>\n\n  </div>\n\n\n  <div class=\"desceci-supplies-grid\">\n\n    {% for article in supplies_blog.articles limit: 4 %}\n\n      <article class=\"desceci-supplies-card\">\n\n        <a\n          href=\"{{ article.url }}\"\n          class=\"desceci-supplies-image-link\"\n          aria-label=\"{{ article.title | escape }}\"\n        >\n\n          {% if article.image %}\n\n            {{\n              article.image\n              | image_url: width: 800\n              | image_tag:\n                loading: 'lazy',\n                widths: '360, 540, 720, 800',\n                sizes: '(max-width: 749px) 100vw, (max-width: 989px) 50vw, 25vw',\n                class: 'desceci-supplies-image',\n                alt: article.image.alt\n            }}\n\n          {% else %}\n\n            <div class=\"desceci-supplies-placeholder\">\n              DTF SUPPLIES GUIDE\n            </div>\n\n          {% endif %}\n\n        </a>\n\n\n        <div class=\"desceci-supplies-content\">\n\n          <div class=\"desceci-supplies-date\">\n            {{ article.published_at | date: \"%B %d, %Y\" }}\n          </div>\n\n          <h3>\n            <a href=\"{{ article.url }}\">\n              {{ article.title }}\n            </a>\n          </h3>\n\n          <p>\n            {% if article.excerpt != blank %}\n              {{ article.excerpt | strip_html | truncatewords: 22 }}\n            {% else %}\n              {{ article.content | strip_html | truncatewords: 22 }}\n            {% endif %}\n          </p>\n\n          <a href=\"{{ article.url }}\" class=\"desceci-supplies-readmore\">\n            Read Guide →\n          </a>\n\n        </div>\n\n      </article>\n\n    {% endfor %}\n\n  </div>\n\n</section>\n\n\n<style>\n\n.desceci-supplies-blog {\n  width: 100%;\n  max-width: 1240px;\n  margin: 30px auto 80px;\n  padding: 55px 20px;\n  box-sizing: border-box;\n  background: #f7f8f8;\n  border-radius: 12px;\n}\n\n\n/* Header */\n\n.desceci-supplies-header {\n  display: flex;\n  align-items: flex-end;\n  justify-content: space-between;\n  gap: 40px;\n  margin-bottom: 35px;\n}\n\n.desceci-supplies-eyebrow {\n  display: block;\n  margin-bottom: 8px;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 1.7px;\n  color: #666;\n}\n\n.desceci-supplies-header h2 {\n  margin: 0 0 10px;\n  font-size: 30px;\n  line-height: 1.25;\n  font-weight: 600;\n  color: #171717;\n}\n\n.desceci-supplies-header p {\n  max-width: 720px;\n  margin: 0;\n  font-size: 15px;\n  line-height: 1.75;\n  color: #666;\n}\n\n.desceci-supplies-viewall {\n  flex-shrink: 0;\n  color: #222 !important;\n  text-decoration: none !important;\n  font-size: 14px;\n  font-weight: 600;\n}\n\n.desceci-supplies-viewall:hover {\n  text-decoration: underline !important;\n  text-underline-offset: 4px;\n}\n\n\n/* Grid */\n\n.desceci-supplies-grid {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 22px;\n}\n\n\n/* Card */\n\n.desceci-supplies-card {\n  overflow: hidden;\n  background: #fff;\n  border: 1px solid #e7e7e7;\n  border-radius: 8px;\n}\n\n.desceci-supplies-image-link {\n  display: block;\n  width: 100%;\n  aspect-ratio: 16 / 10;\n  overflow: hidden;\n  background: #f3f3f3;\n}\n\n.desceci-supplies-image {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  transition: transform .3s ease;\n}\n\n.desceci-supplies-card:hover .desceci-supplies-image {\n  transform: scale(1.03);\n}\n\n.desceci-supplies-placeholder {\n  display: flex;\n  width: 100%;\n  height: 100%;\n  