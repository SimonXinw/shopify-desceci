    "rich_text_wnUr3N": {
      "type": "rich-text",
      "blocks": {
        "heading_KhNrHY": {
          "type": "heading",
          "settings": {
            "heading": "What Is a DTF Transfer?",
            "heading_size": "h1"
          }
        },
        "text_LJTQtk": {
          "type": "text",
          "settings": {
            "text": "<p>A <strong>DTF transfer</strong>, or Direct to Film transfer, is a printed design carried on a special PET film and designed to be transferred onto fabric with a heat press.</p>"
          }
        }
      },
