    "rich_text_nCh4Ty": {
      "type": "rich-text",
      "blocks": {
        "text_W36p8w": {
          "type": "text",
          "settings": {
            "text": "<p><strong>The artwork is printed onto the film, adhesive powder is applied to the printed area, and the transfer is cured. Once prepared, the finished transfer can be positioned on a garment and heat pressed.</strong></p><p><strong>After pressing and peeling the carrier film according to the transfer's application instructions, the printed design remains on the fabric.</strong></p><p><strong>The result is a full-color, detailed custom print that can work on a wide variety of apparel.</strong></p>"
          }
        }
      },
      "block_order": [
        "text_W36p8w"
      ],
