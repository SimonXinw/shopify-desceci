      "settings": {
        "custom_liquid": "<style>\n  .desceci-heatpress-page {\n    font-family: Helvetica, Arial, sans-serif;\n    color: #15243a;\n  }\n\n  .desceci-heatpress-page * {\n    box-sizing: border-box;\n  }\n\n  .desceci-heatpress-section {\n    width: 100%;\n    padding: 76px 20px;\n  }\n\n  .desceci-heatpress-white {\n    background: #ffffff;\n  }\n\n  .desceci-heatpress-gray {\n    background: #f7f9fc;\n  }\n\n  .desceci-heatpress-navy {\n    background: #15243a;\n  }\n\n  .desceci-heatpress-container {\n    max-width: 1120px;\n    margin: 0 auto;\n  }\n\n  .desceci-heatpress-heading {\n    max-width: 820px;\n    margin: 0 auto 42px;\n    text-align: center;\n  }\n\n  .desceci-heatpress-eyebrow {\n    margin: 0 0 13px;\n    color: #5c9143;\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 1.8px;\n    text-transform: uppercase;\n  }\n\n  .desceci-heatpress-heading h2 {\n    margin: 0 0 16px;\n    color: #15243a;\n    font-size: 36px;\n    line-height: 1.2;\n  }\n\n  .desceci-heatpress-heading p {\n    margin: 0;\n    color: #697586;\n    font-size: 16px;\n    line-height: 1.7;\n  }\n\n  /* Core Benefits */\n  .desceci-heatpress-benefits {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 16px;\n  }\n\n  .desceci-heatpress-benefit {\n    min-height: 205px;\n    padding: 27px 22px;\n    border: 1px solid #e1e7ed;\n    border-radius: 6px;\n    background: #f7f9fc;\n  }\n\n  .desceci-heatpress-benefit strong {\n    display: block;\n    margin-bottom: 18px;\n    color: #5c9143;\n    font-size: 26px;\n  }\n\n  .desceci-heatpress-benefit h3 {\n    margin: 0 0 10px;\n    color: #15243a;\n    font-size: 17px;\n    line-height: 1.35;\n  }\n\n  .desceci-heatpress-benefit p {\n    margin: 0;\n    color: #697586;\n    font-size: 14px;\n    line-height: 1.65;\n  }\n\n  .desceci-heatpress-note {\n    max-width: 900px;\n    margin: 30px auto 0;\n    padding: 18px 22px;\n    border-left: 4px solid #5c9143;\n    background: #f7f9fc;\n    color: #697586;\n    font-size: 14px;\n    line-height: 1.7;\n  }\n\n  .desceci-heatpress-note strong {\n    color: #15243a;\n  }\n\n  /* Product Workflow */\n  .desceci-heatpress-workflow {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 18px;\n  }\n\n  .desceci-heatpress-workflow-item {\n    padding: 26px 22px;\n    border-top: 4px solid #5c9143;\n    background: #ffffff;\n  }\n\n  .desceci-heatpress-workflow-number {\n    margin-bottom: 18px;\n    color: #5c9143;\n    font-size: 25px;\n    font-weight: 700;\n  }\n\n  .desceci-heatpress-workflow-item h3 {\n    margin: 0 0 10px;\n    font-size: 17px;\n  }\n\n  .desceci-heatpress-workflow-item p {\n    margin: 0;\n    color: #697586;\n    font-size: 14px;\n    line-height: 1.7;\n  }\n\n  /* Specifications */\n  .desceci-heatpress-table-wrap {\n    overflow-x: auto;\n    border: 1px solid #dfe5ec;\n    border-radius: 7px;\n    background: #ffffff;\n  }\n\n  .desceci-heatpress-table {\n    width: 100%;\n    min-width: 760px;\n    border-collapse: collapse;\n  }\n\n  .desceci-heatpress-table th,\n  .desceci-heatpress-table td {\n    padding: 17px 18px;\n    border-bottom: 1px solid #e6ebf0;\n    text-align: left;\n    font-size: 13px;\n    line-height: 1.5;\n  }\n\n  .desceci-heatpress-table th {\n    background: #eef3f7;\n    color: #15243a;\n    font-weight: 700;\n  }\n\n  .desceci-heatpress-table td {\n    color: #697586;\n  }\n\n  .desceci-heatpress-table tr:last-child th,\n  .desceci-heatpress-table tr:last-child td {\n    border-bottom: none;\n  }\n\n  .desceci-heatpress-highlight {\n    color: #5c9143 !important;\n    font-weight: 700;\n  }\n\n  /* Features */\n  .desceci-heatpress-features {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 18px;\n  }\n\n  .desceci-heatpress-feature {\n    padding: 28px 24px;\n    border: 1px solid rgba(255,255,255,.16);\n    border-radius: 6px;\n    background: rgba(255,255,255,.06);\n  }\n\n  .desceci-heatpress-feature-number {\n    display: flex;\n    width: 40px;\n    height: 40px;\n    align-items: center;\n    justify-content: center;\n    margin-bottom: 18px;\n    border-radius: 50%;\n    background: #5c9143;\n    color: #ffffff;\n    font-size: 14px;\n    font-weight: 700;\n  }\n\n  .desceci-heatpress-navy .desceci-heatpress-heading h2 {\n    color: #ffffff;\n  }\n\n  .desceci-heatpress-navy .desceci-heatpress-heading p {\n    color: #c7d1df;\n  }\n\n  .desceci-heatpress-feature h3 {\n    margin: 0 0 10px;\n    color: #ffffff;\n    font-size: 18px;\n  }\n\n  .desceci-heatpress-feature p {\n    margin: 0;\n    color: #c7d1df;\n    font-size: 14px;\n    line-height: 1.7;\n  }\n\n  /* FAQ */\n  .desceci-heatpress-faq {\n    max-width: 920px;\n    margin: 0 auto;\n  }\n\n  .desceci-heatpress-faq details {\n    border-top: 1px solid #dfe5ec;\n  }\n\n  .desceci-heatpress-faq details:last-child {\n    border-bottom: 1px solid #dfe5ec;\n  }\n\n  .desceci-heatpress-faq summary {\n    position: relative;\n    padding: 21px 38px 21px 0;\n    list-style: none;\n    cursor: pointer;\n    color: #15243a;\n    font-size: 16px;\n    font-weight: 700;\n  }\n\n  .desceci-heatpress-faq summary::-webkit-details-marker {\n    display: none;\n  }\n\n  .desceci-heatpress-faq summary::after {\n    content: \"+\";\n    position: absolute;\n    right: 3px;\n    color: #5c9143;\n    font-size: 24px;\n  }\n\n  .desceci-heatpress-faq details[open] summary::after {\n    content: \"−\";\n  }\n\n  .desceci-heatpress-faq details p {\n    margin: -3px 0 21px;\n    color: #697586;\n    font-size: 14px;\n    line-height: 1.75;\n  }\n\n  /* Contact CTA */\n  .desceci-heatpress-cta {\n    max-width: 1080px;\n    margin: 0 auto;\n    padding: 52px 35px;\n    border-radius: 8px;\n    background: #eef4f8;\n    text-align: center;\n  }\n\n  .desceci-heatpress-cta h2 {\n    margin: 0 0 16px;\n    color: #15243a;\n    font-size: 36px;\n    line-height: 1.2;\n  }\n\n  .desceci-heatpress-cta p {\n    max-width: 740px;\n    margin: 0 auto;\n    color: #697586;\n    font-size: 16px;\n    line-height: 1.7;\n  }\n\n  .desceci-heatpress-buttons {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: center;\n    gap: 13px;\n    margin-top: 28px;\n  }\n\n  .desceci-heatpress-button {\n    display: inline-flex;\n    min-height: 46px;\n    align-items: center;\n    justify-content: center;\n    padding: 0 23px;\n    border-radius: 4px;\n    background: #5c9143;\n    color: #ffffff;\n    font-size: 14px;\n    font-weight: 700;\n    text-decoration: none;\n  }\n\n  .desceci-heatpress-button:hover {\n    background: #15243a;\n    color: #ffffff;\n  }\n\n  .desceci-heatpress-button-secondary {\n    display: inline-flex;\n    min-height: 46px;\n    align-items: center;\n    justify-content: center;\n    padding: 0 23px;\n    border: 1px solid #15243a;\n    border-radius: 4px;\n    color: #15243a;\n    font-size: 14px;\n    font-weight: 700;\n    text-decoration: none;\n  }\n\n  .desceci-heatpress-button-secondary:hover {\n    background: #15243a;\n    color: #ffffff;\n  }\n\n  @media screen and (max-width: 850px) {\n    .desceci-heatpress-benefits,\n    .desceci-heatpress-workflow {\n      grid-template-columns: repeat(2, 1fr);\n    }\n\n    .desceci-heatpress-features {\n      grid-template-columns: 1fr;\n    }\n  }\n\n  @media screen and (max-width: 650px) {\n    .desceci-heatpress-section {\n      padding: 55px 16px;\n    }\n\n    .desceci-heatpress-heading h2,\n    .desceci-heatpress-cta h2 {\n      font-size: 29px;\n    }\n\n    .desceci-heatpress-benefits,\n    .desceci-heatpress-workflow {\n      grid-template-columns: 1fr;\n    }\n\n    .desceci-heatpress-buttons {\n      display: grid;\n    }\n\n    .desceci-heatpress-buttons a {\n      width: 100%;\n    }\n  }\n</style>\n\n<div class=\"desceci-heatpress-page\">\n\n  <!-- 1. Core Benefits -->\n  <section class=\"desceci-heatpress-section desceci-heatpress-white\">\n    <div class=\"desceci-heatpress-container\">\n\n      <div class=\"desceci-heatpress-heading\">\n        <p class=\"desceci-heatpress-eyebrow\">\n          PROFESSIONAL HEAT TRANSFER EQUIPMENT\n        </p>\n\n        <h2>\n          Semi-Automatic Double Station Hydraulic Heat Press Machine\n        </h2>\n\n        <p>\n          The DESCECI 6040(7BE) hydraulic heat press is designed for stable,\n          high-pressure heat transfer production with smooth operation,\n          low working noise, and efficient double-station workflow.\n        </p>\n      </div>\n\n      <div class=\"desceci-heatpress-benefits\">\n\n        <div class=\"desceci-heatpress-benefit\">\n          <strong>30 kg/cm²</strong>\n          <h3>High Pressing Pressure</h3>\n          <p>\n            Hydraulic pressure provides strong and consistent pressing force\n            for reliable heat transfer results.\n          </p>\n        </div>\n\n        <div class=\"desceci-heatpress-benefit\">\n          <strong>Double</strong>\n          <h3>Dual-Station Workflow</h3>\n          <p>\n            Two working stations help improve production efficiency and reduce\n            idle time during repeated pressing jobs.\n          </p>\n        </div>\n\n        <div class=\"desceci-heatpress-benefit\">\n          <strong>0–399°C</strong>\n          <h3>Wide Temperature Range</h3>\n          <p>\n            Adjustable temperature control supports different heat transfer\n            materials and production requirements.\n          </p>\n        </div>\n\n        <div class=\"desceci-heatpress-benefit\">\n          <strong>Low Noise</strong>\n          <h3>Hydraulic Operation</h3>\n          <p>\n            No air pump is required, helping create a quieter and more\n            comfortable working environment.\n          </p>\n        </div>\n\n      </div>\n\n      <div class=\"desceci-heatpress-note\">\n        <strong>Product Model:</strong>\n        6040(7BE) Semi-Automatic Double Station Hydraulic Heat Transfer Machine.\n        Please confirm the required voltage and pressing size before ordering.\n      </div>\n\n    </div>\n  </section>\n\n  <!-- 2. Workflow -->\n  <section class=\"desceci-heatpress-section desceci-heatpress-gray\">\n    <div class=\"desceci-heatpress-container\">\n\n      <div class=\"desceci-heatpress-heading\">\n        <p class=\"desceci-heatpress-eyebrow\">\n          BUILT FOR EFFICIENT PRODUCTION\n        </p>\n\n        <h2>\n          Designed to Keep Your Production Moving\n        </h2>\n\n        <p>\n          The double-station layout and hydraulic sliding structure make\n          daily heat transfer production more efficient and consistent.\n        </p>\n      </div>\n\n      <div class=\"desceci-heatpress-workflow\">\n\n        <div class=\"desceci-heatpress-workflow-item\">\n          <div class=\"desceci-heatpress-workflow-number\">01</div>\n          <h3>Load the Garment</h3>\n          <p>\n            Position the garment or transfer material on the working platform\n            before pressing.\n          </p>\n        </div>\n\n        <div class=\"desceci-heatpress-workflow-item\">\n          <div class=\"desceci-heatpress-workflow-number\">02</div>\n          <h3>Set the Parameters</h3>\n          <p>\n            Adjust temperature, pressing time, and pressure according to\n            the material and transfer requirements.\n          </p>\n        </div>\n\n        <div class=\"desceci-heatpress-workflow-item\">\n          <div class=\"desceci-heatpress-workflow-number\">03</div>\n          <h3>Hydraulic Pressing</h3>\n          <p>\n            The heating plate moves while the bottom platform remains stable,\n            helping prevent garment displacement.\n          </p>\n        </div>\n\n        <div class=\"desceci-heatpress-workflow-item\">\n          <div class=\"desceci-heatpress-workflow-number\">04</div>\n          <h3>Repeat Efficiently</h3>\n          <p>\n            Use the second station to prepare the next garment and maintain\n            a smoother production rhythm.\n          </p>\n        </div>\n\n      </div>\n\n    </div>\n  </section>\n\n  <!-- 3. Technical Specifications -->\n  <section class=\"desceci-heatpress-section desceci-heatpress-white\">\n    <div class=\"desceci-heatpress-container\">\n\n      <div class=\"desceci-heatpress-heading\">\n        <p class=\"desceci-heatpress-eyebrow\">\n          TECHNICAL DETAILS\n        </p>\n\n        <h2>\n          6040(7BE) Heat Press Specifications\n        </h2>\n\n        <p>\n          Select the pressing platform size that best matches your production\n          needs and available workspace.\n        </p>\n      </div>\n\n      <div class=\"desceci-heatpress-table-wrap\">\n        <table class=\"desceci-heatpress-table\">\n          <thead>\n            <tr>\n              <th>Specification</th>\n              <th>40×40 cm</th>\n              <th>40×50 cm</th>\n              <th>40×60 cm</th>\n              <th>50×70 cm</th>\n              <th>60×80 cm</th>\n            </tr>\n          </thead>\n\n          <tbody>\n            <tr>\n              <th>Model</th>\n              <td>6040(7BE)</td>\n              <td>6040(7BE)</td>\n              <td>6040(7BE)</td>\n              <td>6040(7BE)</td>\n              <td>6040(7BE)</td>\n            </tr>\n\n            <tr>\n              <th>Voltage</th>\n              <td colspan=\"5\">\n                220V 1 Phase / 220V 3 Phase / 380V 3 Phase\n              </td>\n            </tr>\n\n            <tr>\n              <th>Power</th>\n              <td>4.0 kW</td>\n              <td>4.3 kW</td>\n              <td>4.3 kW</td>\n              <td>6.2 kW</td>\n              <td>6.8 kW</td>\n            </tr>\n\n            <tr>\n              <th>Temperature Range</th>\n              <td colspan=\"5\" class=\"desceci-heatpress-highlight\">\n                0–399°C\n              </td>\n            </tr>\n\n            <tr>\n              <th>Time Range</th>\n              <td colspan=\"5\" class=\"desceci-heatpress-highlight\">\n                0–999 seconds\n              </td>\n            </tr>\n\n            <tr>\n              <th>Machine Weight</th>\n              <td>120 kg</td>\n              <td>122 kg</td>\n              <td>124 kg</td>\n              <td>150 kg</td>\n              <td>180 kg</td>\n            </tr>\n\n            <tr>\n              <th>Packing Size</th>\n              <td>120×78×145 cm</td>\n              <td>125×78×145 cm</td>\n              <td>135×78×145 cm</td>\n              <td>150×85×160 cm</td>\n              <td>178×102×160 cm</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n\n      <div class=\"desceci-heatpress-note\">\n        <strong>Electrical Notice:</strong>\n        Please confirm the required voltage, phase type, power capacity,\n        installation space, and local electrical requirements before ordering.\n      </div>\n\n    </div>\n  </section>\n\n  <!-- 4. Product Features -->\n  <section class=\"desceci-heatpress-section desceci-heatpress-navy\">\n    <div class=\"desceci-heatpress-container\">\n\n      <div class=\"desceci-heatpress-heading\">\n        <p class=\"desceci-heatpress-eyebrow\">\n          ENGINEERED FOR DAILY USE\n        </p>\n\n        <h2>\n          Practical Features for Professional Workflows\n        </h2>\n\n        <p>\n          Every part of the machine is designed to improve stability,\n          efficiency, and ease of operation.\n        </p>\n      </div>\n\n      <div class=\"desceci-heatpress-features\">\n\n        <div class=\"desceci-heatpress-feature\">\n          <div class=\"desceci-heatpress-feature-number\">01</div>\n          <h3>Linear Bearing Sliding System</h3>\n          <p>\n            The heating plate moves smoothly while the bottom platform remains\n            stable, helping prevent garments from shifting.\n          </p>\n        </div>\n\n        <div class=\"desceci-heatpress-feature\">\n          <div class=\"desceci-heatpress-feature-number\">02</div>\n          <h3>Hydraulic Pressure System</h3>\n          <p>\n            No air pump is required. The hydraulic system provides strong,\n            stable pressure for demanding transfer applications.\n          </p>\n        </div>\n\n        <div class=\"desceci-heatpress-feature\">\n          <div class=\"desceci-heatpress-feature-number\">03</div>\n          <h3>Clear Parameter Control</h3>\n          <p>\n            The thermometer and parameter display screen make temperature\n            and time settings easier to monitor.\n          </p>\n        </div>\n\n        <div class=\"desceci-heatpress-feature\">\n          <div class=\"desceci-heatpress-feature-number\">04</div>\n          <h3>Emergency Stop Function</h3>\n          <p>\n            The emergency stop button provides an additional safety control\n            during machine operation.\n          </p>\n        </div>\n\n        <div class=\"desceci-heatpress-feature\">\n          <div class=\"desceci-heatpress-feature-number\">05</div>\n          <h3>Double Working Stations</h3>\n          <p>\n            Prepare the next item while the current pressing cycle is being\n            completed to support a more efficient workflow.\n          </p>\n        </div>\n\n        <div class=\"desceci-heatpress-feature\">\n          <div class=\"desceci-heatpress-feature-number\">06</div>\n          <h3>Lower Working Noise</h3>\n          <p>\n            The machine does not require an air pump, making it suitable for\n            working environments where noise control matters.\n          </p>\n        </div>\n\n      </div>\n\n    </div>\n  </section>\n\n  <!-- 5. Application and Setup -->\n  <section class=\"desceci-heatpress-section desceci-heatpress-gray\">\n    <div class=\"desceci-heatpress-container\">\n\n      <div class=\"desceci-heatpress-heading\">\n        <p class=\"desceci-heatpress-eyebrow\">\n          BEFORE INSTALLATION\n        </p>\n\n        <h2>\n          Prepare Your Workspace Before Delivery\n        </h2>\n\n        <p>\n          Because this is heavy industrial equipment, proper planning is\n          important before installation and operation.\n        </p>\n      </div>\n\n      <div class=\"desceci-heatpress-benefits\">\n\n        <div class=\"desceci-heatpress-benefit\">\n          <strong>01</strong>\n          <h3>Confirm Electrical Supply</h3>\n          <p>\n            Verify whether your location supports 220V single-phase,\n            220V three-phase, or 380V three-phase power.\n          </p>\n        </div>\n\n        <div class=\"desceci-heatpress-benefit\">\n          <strong>02</strong>\n          <h3>Reserve Enough Space</h3>\n          <p>\n            Allow sufficient operating and maintenance space around the machine\n            according to the selected model size.\n          </p>\n        </div>\n\n        <div class=\"desceci-heatpress-benefit\">\n          <strong>03</strong>\n          <h3>Use a Stable Floor</h3>\n          <p>\n            The machine weighs approximately 120–180 kg, so it should be placed\n            on a stable, level, load-bearing floor.\n          </p>\n        </div>\n\n        <div class=\"desceci-heatpress-benefit\">\n          <strong>04</strong>\n          <h3>Professional Setup</h3>\n          <p>\n            Electrical connection, installation, testing, and calibration\n            should be completed by qualified personnel.\n          </p>\n        </div>\n\n      </div>\n\n    </div>\n  </section>\n\n  <!-- 6. FAQ -->\n  <section class=\"desceci-heatpress-section desceci-heatpress-white\">\n    <div class=\"desceci-heatpress-container\">\n\n      <div class=\"desceci-heatpress-heading\">\n        <p class=\"desceci-heatpress-eyebrow\">\n          HEAT PRESS SUPPORT\n        </p>\n\n        <h2>\n          Frequently Asked Questions\n        </h2>\n\n        <p>\n          Helpful information before choosing and installing the 6040(7BE)\n          hydraulic heat press machine.\n        </p>\n      </div>\n\n      <div class=\"desceci-heatpress-faq\">\n\n        <details>\n          <summary>\n            What is the 6040(7BE) heat press designed for?\n          </summary>\n\n          <p>\n            It is a semi-automatic double-station hydraulic heat press designed\n            for professional heat transfer and apparel production workflows.\n          </p>\n        </details>\n\n        <details>\n          <summary>\n            Does this machine require an air pump?\n          </summary>\n\n          <p>\n            No. The hydraulic system provides the pressing force without requiring\n            a separate air pump.\n          </p>\n        </details>\n\n        <details>\n          <summary>\n            What is the maximum temperature?\n          </summary>\n\n          <p>\n            The temperature range is 0–399°C. Actual operating temperature should\n            be selected according to the transfer material and garment.\n          </p>\n        </details>\n\n        <details>\n          <summary>\n            What pressing sizes are available?\n          </summary>\n\n          <p>\n            Available pressing sizes include 40×40 cm, 40×50 cm, 40×60 cm,\n            50×70 cm, and 60×80 cm.\n          </p>\n        </details>\n\n        <details>\n          <summary>\n            Which voltage should I choose?\n          </summary>\n\n          <p>\n            The available electrical configurations are 220V single-phase,\n            220V three-phase, and 380V three-phase. Please confirm your local\n            electrical supply before ordering.\n          </p>\n        </details>\n\n        <details>\n          <summary>\n            Can I install the machine myself?\n          </summary>\n\n          <p>\n            Professional installation is recommended because the machine is heavy\n            industrial equipment and requires correct electrical connection,\n            setup, and testing.\n          </p>\n        </details>\n\n        <details>\n          <summary>\n            How can I confirm the correct configuration?\n          </summary>\n\n          <p>\n            Send us your preferred pressing size, local voltage, phase type,\n            and shipping location. Our team can help confirm the suitable model.\n          </p>\n        </details>\n\n      </div>\n\n    </div>\n  </section>\n\n  <!-- 7. Final CTA -->\n  <section class=\"desceci-heatpress-section desceci-heatpress-white\">\n    <div class=\"desceci-heatpress-cta\">\n\n      <p class=\"desceci-heatpress-eyebrow\">\n        READY TO UPGRADE YOUR PRODUCTION?\n      </p>\n\n      <h2>\n        Choose the Right Hydraulic Heat Press for Your Business\n      </h2>\n\n      <p>\n        Tell us your preferred pressing size, voltage, phase type, and shipping\n        location. We will help you confirm the correct 6040(7BE) configuration\n        before ordering.\n      </p>\n\n      <div class=\"desceci-heatpress-buttons\">\n\n        <a\n          href=\"mailto:desceci@outloonk.com?subject=6040%207BE%20Heat%20Press%20Configuration%20Question\"\n          class=\"desceci-heatpress-button\">\n          Contact Us for Configuration\n        </a>\n\n        <a\n          href=\"#\"\n          class=\"desceci-heatpress-button-secondary\"\n          onclick=\"window.scrollTo({top: 0, behavior: 'smooth'}); return false;\">\n          Back to Top ↑\n        </a>\n\n      </div>\n\n    </div>\n  </section>\n\n</div>",
