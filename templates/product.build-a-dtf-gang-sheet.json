    "custom_liquid_pDYbWp": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n/* ================================\n   DESCECI DTF Gang Sheet Page\n   Scoped styles - Build Gang Sheet\n================================ */\n\n.des-gs {\n  --des-green: #16a34a;\n  --des-green-dark: #12823d;\n  --des-black: #151515;\n  --des-text: #4b5563;\n  --des-light: #f7f8f8;\n  --des-border: #e5e7eb;\n  --des-white: #ffffff;\n\n  max-width: 1240px;\n  margin: 0 auto;\n  padding: 0 24px;\n  color: var(--des-black);\n  font-family: inherit;\n}\n\n.des-gs * {\n  box-sizing: border-box;\n}\n\n.des-gs-section {\n  padding: 72px 0;\n}\n\n.des-gs-section + .des-gs-section {\n  border-top: 1px solid var(--des-border);\n}\n\n.des-gs-heading {\n  max-width: 760px;\n  margin: 0 auto 42px;\n  text-align: center;\n}\n\n.des-gs-eyebrow {\n  display: inline-block;\n  margin-bottom: 10px;\n  color: var(--des-green);\n  font-size: 13px;\n  font-weight: 700;\n  letter-spacing: 1.4px;\n  text-transform: uppercase;\n}\n\n.des-gs h2 {\n  margin: 0 0 14px;\n  color: var(--des-black);\n  font-size: clamp(28px, 3vw, 40px);\n  line-height: 1.15;\n  font-weight: 700;\n}\n\n.des-gs h3 {\n  margin: 0 0 9px;\n  color: var(--des-black);\n  font-size: 18px;\n  line-height: 1.3;\n  font-weight: 700;\n}\n\n.des-gs p {\n  margin: 0;\n  color: var(--des-text);\n  font-size: 15px;\n  line-height: 1.7;\n}\n\n.des-gs-lead {\n  font-size: 16px !important;\n  line-height: 1.75 !important;\n}\n\n/* HOW TO ORDER */\n.des-gs-steps {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  border: 1px solid var(--des-border);\n  border-radius: 14px;\n  overflow: hidden;\n  background: var(--des-white);\n}\n\n.des-gs-step {\n  min-height: 190px;\n  padding: 28px 24px;\n  border-right: 1px solid var(--des-border);\n}\n\n.des-gs-step:last-child {\n  border-right: 0;\n}\n\n.des-gs-step-num {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 38px;\n  height: 38px;\n  margin-bottom: 20px;\n  border-radius: 50%;\n  background: var(--des-black);\n  color: #fff;\n  font-size: 13px;\n  font-weight: 700;\n}\n\n/* WHAT IS */\n.des-gs-info {\n  max-width: 900px;\n  margin: 0 auto;\n  padding: 42px;\n  border-radius: 16px;\n  background: var(--des-light);\n}\n\n.des-gs-info p + p {\n  margin-top: 18px;\n}\n\n/* BENEFITS */\n.des-gs-grid-4 {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 18px;\n}\n\n.des-gs-card {\n  height: 100%;\n  padding: 26px;\n  border: 1px solid var(--des-border);\n  border-radius: 14px;\n  background: var(--des-white);\n}\n\n.des-gs-icon {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 46px;\n  height: 46px;\n  margin-bottom: 20px;\n  border-radius: 10px;\n  background: #ecf8f0;\n  color: var(--des-green);\n  font-size: 21px;\n  font-weight: 700;\n}\n\n/* SIZE GUIDE */\n.des-gs-size-wrap {\n  overflow: hidden;\n  border: 1px solid var(--des-border);\n  border-radius: 14px;\n}\n\n.des-gs-size-row {\n  display: grid;\n  grid-template-columns: 1fr 2fr;\n  border-bottom: 1px solid var(--des-border);\n}\n\n.des-gs-size-row:last-child {\n  border-bottom: 0;\n}\n\n.des-gs-size-row > div {\n  padding: 17px 22px;\n}\n\n.des-gs-size-row > div:first-child {\n  font-weight: 700;\n  color: var(--des-black);\n  background: var(--des-light);\n}\n\n/* ARTWORK */\n.des-gs-artwork {\n  display: grid;\n  grid-template-columns: 1.05fr .95fr;\n  gap: 30px;\n  align-items: stretch;\n}\n\n.des-gs-artwork-box {\n  padding: 34px;\n  border-radius: 16px;\n  background: var(--des-light);\n}\n\n.des-gs-checks {\n  display: grid;\n  gap: 14px;\n  margin-top: 24px;\n}\n\n.des-gs-check {\n  display: flex;\n  gap: 12px;\n  align-items: flex-start;\n  color: var(--des-text);\n  font-size: 15px;\n  line-height: 1.5;\n}\n\n.des-gs-check-mark {\n  flex: 0 0 24px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 24px;\n  height: 24px;\n  border-radius: 50%;\n  background: #e9f8ee;\n  color: var(--des-green);\n  font-size: 13px;\n  font-weight: 800;\n}\n\n.des-gs-warning {\n  padding: 34px;\n  border: 1px solid var(--des-border);\n  border-radius: 16px;\n}\n\n.des-gs-warning-label {\n  display: inline-block;\n  margin-bottom: 15px;\n  padding: 6px 10px;\n  border-radius: 6px;\n  background: var(--des-black);\n  color: #fff;\n  font-size: 12px;\n  font-weight: 700;\n}\n\n/* SPECS */\n.des-gs-specs {\n  display: grid;\n  grid-template-columns: repeat(6, 1fr);\n  gap: 12px;\n}\n\n.des-gs-spec {\n  padding: 24px 12px;\n  border: 1px solid var(--des-border);\n  border-radius: 12px;\n  text-align: center;\n}\n\n.des-gs-spec strong {\n  display: block;\n  margin-bottom: 7px;\n  font-size: 17px;\n  color: var(--des-black);\n}\n\n.des-gs-spec span {\n  color: var(--des-text);\n  font-size: 13px;\n}\n\n/* SHIPPING */\n.des-gs-shipping {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  overflow: hidden;\n  border-radius: 18px;\n  background: var(--des-black);\n}\n\n.des-gs-shipping-copy {\n  padding: 48px;\n}\n\n.des-gs-shipping-copy h2,\n.des-gs-shipping-copy p {\n  color: #fff;\n}\n\n.des-gs-shipping-copy p {\n  opacity: .82;\n}\n\n.des-gs-shipping-detail {\n  padding: 48px;\n  background: #202020;\n}\n\n.des-gs-shipping-detail strong {\n  display: block;\n  margin-bottom: 7px;\n  color: #fff;\n}\n\n.des-gs-shipping-detail p {\n  color: #d1d5db;\n}\n\n.des-gs-shipping-detail p + strong {\n  margin-top: 22px;\n}\n\n/* GUARANTEE */\n.des-gs-guarantee {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 22px;\n}\n\n.des-gs-guarantee-box {\n  padding: 32px;\n  border: 1px solid var(--des-border);\n  border-radius: 14px;\n}\n\n.des-gs-mini-list {\n  margin: 20px 0 0;\n  padding: 0;\n  list-style: none;\n}\n\n.des-gs-mini-list li {\n  margin: 9px 0;\n  color: var(--des-text);\n  font-size: 14px;\n}\n\n/* FAQ */\n.des-gs-faq {\n  max-width: 900px;\n  margin: 0 auto;\n  border-top: 1px solid var(--des-border);\n}\n\n.des-gs-faq details {\n  border-bottom: 1px solid var(--des-border);\n}\n\n.des-gs-faq summary {\n  position: relative;\n  padding: 21px 40px 21px 0;\n  cursor: pointer;\n  list-style: none;\n  color: var(--des-black);\n  font-size: 16px;\n  font-weight: 700;\n}\n\n.des-gs-faq summary::-webkit-details-marker {\n  display: none;\n}\n\n.des-gs-faq summary:after {\n  content: \"+\";\n  position: absolute;\n  right: 4px;\n  top: 16px;\n  font-size: 25px;\n  font-weight: 400;\n}\n\n.des-gs-faq details[open] summary:after {\n  content: \"−\";\n}\n\n.des-gs-faq details p {\n  padding: 0 40px 22px 0;\n}\n\n/* CTA */\n.des-gs-cta {\n  margin: 72px 0;\n  padding: 54px 30px;\n  border-radius: 18px;\n  background: var(--des-light);\n  text-align: center;\n}\n\n.des-gs-cta p {\n  max-width: 650px;\n  margin: 0 auto 24px;\n}\n\n.des-gs-btn {\n  display: inline-block;\n  padding: 14px 28px;\n  border-radius: 7px;\n  background: var(--des-green);\n  color: #fff !important;\n  text-decoration: none;\n  font-size: 15px;\n  font-weight: 700;\n  transition: .2s ease;\n}\n\n.des-gs-btn:hover {\n  background: var(--des-green-dark);\n  transform: translateY(-1px);\n}\n\n/* MOBILE */\n@media (max-width: 989px) {\n  .des-gs-grid-4 {\n    grid-template-columns: repeat(2, 1fr);\n  }\n\n  .des-gs-steps {\n    grid-template-columns: repeat(2, 1fr);\n  }\n\n  .des-gs-step:nth-child(2) {\n    border-right: 0;\n  }\n\n  .des-gs-step:nth-child(-n+2) {\n    border-bottom: 1px solid var(--des-border);\n  }\n\n  .des-gs-specs {\n    grid-template-columns: repeat(3, 1fr);\n  }\n\n  .des-gs-artwork,\n  .des-gs-shipping {\n    grid-template-columns: 1fr;\n  }\n}\n\n@media (max-width: 749px) {\n  .des-gs {\n    padding: 0 16px;\n  }\n\n  .des-gs-section {\n    padding: 48px 0;\n  }\n\n  .des-gs-heading {\n    margin-bottom: 28px;\n  }\n\n  .des-gs-steps,\n  .des-gs-grid-4,\n  .des-gs-guarantee {\n    grid-template-columns: 1fr;\n  }\n\n  .des-gs-step {\n    min-height: auto;\n    border-right: 0;\n    border-bottom: 1px solid var(--des-border);\n  }\n\n  .des-gs-step:nth-child(3) {\n    border-bottom: 1px solid var(--des-border);\n  }\n\n  .des-gs-step:last-child {\n    border-bottom: 0;\n  }\n\n  .des-gs-info,\n  .des-gs-artwork-box,\n  .des-gs-warning,\n  .des-gs-shipping-copy,\n  .des-gs-shipping-detail {\n    padding: 26px 22px;\n  }\n\n  .des-gs-size-row {\n    grid-template-columns: 1fr;\n  }\n\n  .des-gs-size-row > div:first-child {\n    padding-bottom: 6px;\n  }\n\n  .des-gs-size-row > div:last-child {\n    padding-top: 6px;\n  }\n\n  .des-gs-specs {\n    grid-template-columns: repeat(2, 1fr);\n  }\n\n  .des-gs-cta {\n    margin: 48px 0;\n    padding: 40px 20px;\n  }\n}\n</style>\n\n\n<div class=\"des-gs\">\n\n  <!-- HOW TO ORDER -->\n  <section class=\"des-gs-section\">\n    <div class=\"des-gs-heading\">\n      <span class=\"des-gs-eyebrow\">Simple Online Builder</span>\n      <h2>How to Build Your DTF Gang Sheet</h2>\n      <p>Choose your sheet size, upload your artwork, arrange your designs, and send your finished gang sheet directly to print.</p>\n    </div>\n\n    <div class=\"des-gs-steps\">\n      <div class=\"des-gs-step\">\n        <span class=\"des-gs-step-num\">01</span>\n        <h3>Choose Your Gang Sheet Size</h3>\n        <p>Select the 22\" gang sheet length that best fits your order.</p>\n      </div>\n\n      <div class=\"des-gs-step\">\n        <span class=\"des-gs-step-num\">02</span>\n        <h3>Open the Gang Sheet Builder</h3>\n        <p>Click “Create a Gang Sheet” to open our online builder.</p>\n      </div>\n\n      <div class=\"des-gs-step\">\n        <span class=\"des-gs-step-num\">03</span>\n        <h3>Upload & Arrange Designs</h3>\n        <p>Upload, resize, duplicate, rotate, and arrange your artwork on the sheet.</p>\n      </div>\n\n      <div class=\"des-gs-step\">\n        <span class=\"des-gs-step-num\">04</span>\n        <h3>Add to Cart & We Print</h3>\n        <p>Review your layout, add it to cart, and we'll print your custom DTF gang sheet.</p>\n      </div>\n    </div>\n  </section>\n\n\n  <!-- WHAT IS A GANG SHEET -->\n  <section class=\"des-gs-section\">\n    <div class=\"des-gs-heading\">\n      <span class=\"des-gs-eyebrow\">DTF Gang Sheets Explained</span>\n      <h2>What Is a DTF Gang Sheet?</h2>\n    </div>\n\n    <div class=\"des-gs-info\">\n      <p class=\"des-gs-lead\">\n        A DTF gang sheet combines multiple designs, logos, or graphics onto one larger transfer sheet. Instead of ordering every transfer separately, you can organize multiple designs or copies together and make better use of your available printing space.\n      </p>\n\n      <p>\n        With the DESCECI online DTF Gang Sheet Builder, you don't need to prepare a complete gang sheet before ordering. Upload your artwork, set the size of each design, duplicate designs as needed, and arrange everything directly in the builder.\n      </p>\n\n      <p>\n        Custom DTF gang sheets are ideal for apparel businesses, print shops, clothing brands, teams, events, and anyone producing multiple heat transfers at once.\n      </p>\n    </div>\n  </section>\n\n\n  <!-- BENEFITS -->\n  <section class=\"des-gs-section\">\n    <div class=\"des-gs-heading\">\n      <span class=\"des-gs-eyebrow\">Build Smarter</span>\n      <h2>Why Use Our DTF Gang Sheet Builder?</h2>\n      <p>Create a production-ready layout without building the entire sheet in separate design software.</p>\n    </div>\n\n    <div class=\"des-gs-grid-4\">\n      <div class=\"des-gs-card\">\n        <div class=\"des-gs-icon\">01</div>\n        <h3>Fit More Designs</h3>\n        <p>Combine multiple logos, graphics, and transfer sizes on one gang sheet.</p>\n      </div>\n\n      <div class=\"des-gs-card\">\n        <div class=\"des-gs-icon\">02</div>\n        <h3>Resize & Duplicate</h3>\n        <p>Set your desired transfer dimensions and quickly duplicate designs for larger quantities.</p>\n      </div>\n\n      <div class=\"des-gs-card\">\n        <div class=\"des-gs-icon\">03</div>\n        <h3>No Pre-Made Sheet Needed</h3>\n        <p>Upload individual artwork files and create your layout directly in our online builder.</p>\n      </div>\n\n      <div class=\"des-gs-card\">\n        <div class=\"des-gs-icon\">04</div>\n        <h3>Ready for Printing</h3>\n        <p>Submit your completed layout directly with your order for DTF production.</p>\n      </div>\n    </div>\n  </section>\n\n\n  <!-- SIZE GUIDE -->\n  <section class=\"des-gs-section\">\n    <div class=\"des-gs-heading\">\n      <span class=\"des-gs-eyebrow\">22-Inch Gang Sheets</span>\n      <h2>Choose the Right Gang Sheet Size</h2>\n      <p>All DESCECI gang sheets are 22 inches wide. Choose the sheet length based on the number and size of designs you need.</p>\n    </div>\n\n    <div class=\"des-gs-size-wrap\">\n      <div class=\"des-gs-size-row\">\n        <div>22\" × 12\"</div>\n        <div>Great for test prints, small orders, and a few individual transfers.</div>\n      </div>\n\n      <div class=\"des-gs-size-row\">\n        <div>22\" × 24\"</div>\n        <div>Ideal for small apparel orders and several standard-size designs.</div>\n      </div>\n\n      <div class=\"des-gs-size-row\">\n        <div>22\" × 36\"</div>\n        <div>A versatile choice for multiple logos, shirt fronts, or mixed designs.</div>\n      </div>\n\n      <div class=\"des-gs-size-row\">\n        <div>22\" × 48\"–72\"</div>\n        <div>Designed for medium production runs and growing custom apparel orders.</div>\n      </div>\n\n      <div class=\"des-gs-size-row\">\n        <div>22\" × 84\"–120\"</div>\n        <div>More space for bulk orders, multiple customers, or larger artwork collections.</div>\n      </div>\n\n      <div class=\"des-gs-size-row\">\n        <div>22\" × 144\"–240\"</div>\n        <div>Best suited for high-volume production, apparel brands, and print shops.</div>\n      </div>\n    </div>\n  </section>\n\n\n  <!-- ARTWORK -->\n  <section class=\"des-gs-section\">\n    <div class=\"des-gs-heading\">\n      <span class=\"des-gs-eyebrow\">Before You Build</span>\n      <h2>Artwork Requirements</h2>\n      <p>Start with high-quality artwork for cleaner edges, sharper details, and better DTF print results.</p>\n    </div>\n\n    <div class=\"des-gs-artwork\">\n      <div class=\"des-gs-artwork-box\">\n        <h3>Recommended Artwork Setup</h3>\n\n        <div class=\"des-gs-checks\">\n          <div class=\"des-gs-check\">\n            <span class=\"des-gs-check-mark\">✓</span>\n            <span><strong>Resolution:</strong> 300 DPI recommended at final print size.</span>\n          </div>\n\n          <div class=\"des-gs-check\">\n            <span class=\"des-gs-check-mark\">✓</span>\n            <span><strong>Background:</strong> Transparent background preferred when appropriate.</span>\n          </div>\n\n          <div class=\"des-gs-check\">\n            <span class=\"des-gs-check-mark\">✓</span>\n            <span><strong>Color:</strong> RGB artwork recommended.</span>\n          </div>\n\n          <div class=\"des-gs-check\">\n            <span class=\"des-gs-check-mark\">✓</span>\n            <span><strong>Accepted Files:</strong> PNG, JPG, PDF, SVG, AI and EPS.</span>\n          </div>\n\n          <div class=\"des-gs-check\">\n            <span class=\"des-gs-check-mark\">✓</span>\n            <span><strong>Final Size:</strong> Verify each design's width and height inside the builder.</span>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"des-gs-warning\">\n        <span class=\"des-gs-warning-label\">IMPORTANT</span>\n        <h3>Review Your Layout Before Submitting</h3>\n        <p>\n          Your gang sheet will be produced based on the artwork, sizing, and layout submitted through the builder. Please review image quality, spelling, dimensions, transparency, and placement before adding your finished gang sheet to cart.\n        </p>\n      </div>\n    </div>\n  </section>\n\n\n  <!-- SPECS -->\n  <section class=\"des-gs-section\">\n    <div class=\"des-gs-heading\">\n      <span class=\"des-gs-eyebrow\">Ready to Press</span>\n      <h2>Professional DTF Transfer Specs</h2>\n      <p>Designed for vibrant color, flexible feel, and dependable application across popular apparel fabrics.</p>\n    </div>\n\n    <div class=\"des-gs-specs\">\n      <div class=\"des-gs-spec\">\n        <strong>300–320°F</strong>\n        <span>Temperature</span>\n      </div>\n\n      <div class=\"des-gs-spec\">\n        <strong>8–10 Sec</strong>\n        <span>Press Time</span>\n      </div>\n\n      <div class=\"des-gs-spec\">\n        <strong>Medium</strong>\n        <span>Pressure</span>\n      </div>\n\n      <div class=\"des-gs-spec\">\n        <strong>Hot Peel</strong>\n        <span>Peel Method</span>\n      </div>\n\n      <div class=\"des-gs-spec\">\n        <strong>Versatile</strong>\n        <span>Cotton / Poly / Blends</span>\n      </div>\n\n      <div class=\"des-gs-spec\">\n        <strong>Soft</strong>\n        <span>Flexible Finish</span>\n      </div>\n    </div>\n  </section>\n\n\n  <!-- PERFECT FOR -->\n  <section class=\"des-gs-section\">\n    <div class=\"des-gs-heading\">\n      <span class=\"des-gs-eyebrow\">Made for Production</span>\n      <h2>Perfect for Custom Apparel Businesses</h2>\n    </div>\n\n    <div class=\"des-gs-grid-4\">\n      <div class=\"des-gs-card\">\n        <h3>T-Shirt Businesses</h3>\n        <p>Build sheets with multiple transfer sizes for everyday apparel orders.</p>\n      </div>\n\n      <div class=\"des-gs-card\">\n        <h3>Print Shops</h3>\n        <p>Organize multiple designs efficiently for ongoing DTF production.</p>\n      </div>\n\n      <div class=\"des-gs-card\">\n        <h3>Clothing Brands</h3>\n        <p>Combine front graphics, logos, neck labels, and other artwork on one sheet.</p>\n      </div>\n\n      <div class=\"des-gs-card\">\n        <h3>Teams & Events</h3>\n        <p>Produce multiple graphics and designs for group apparel and event merchandise.</p>\n      </div>\n    </div>\n  </section>\n\n\n  <!-- SHIPPING -->\n  <section class=\"des-gs-section\">\n    <div class=\"des-gs-shipping\">\n      <div class=\"des-gs-shipping-copy\">\n        <span class=\"des-gs-eyebrow\">California Fulfillment</span>\n        <h2>Fast U.S. Production & Shipping</h2>\n        <p>\n          Your custom DTF gang sheets are produced from the layout submitted with your order and shipped from our Anaheim, California location.\n        </p>\n      </div>\n\n      <div class=\"des-gs-shipping-detail\">\n        <strong>Ship From</strong>\n        <p>\n          4420 E Miraloma Ave, Suite G<br>\n          Anaheim, CA 92807, USA\n        </p>\n\n        <strong>Production & Shipping</strong>\n        <p>\n          Orders placed before 2 PM local time are generally scheduled to ship the same day. Orders placed after 2 PM are generally scheduled to ship the next business day.\n        </p>\n\n        <strong>Local Pickup</strong>\n        <p>\n          Local pickup is available. Final delivery time depends on the selected carrier and destination.\n        </p>\n      </div>\n    </div>\n  </section>\n\n\n  <!-- GUARANTEE -->\n  <section class=\"des-gs-section\">\n    <div class=\"des-gs-heading\">\n      <span class=\"des-gs-eyebrow\">DESCECI Quality Support</span>\n      <h2>We'll Make It Right</h2>\n      <p>If there is a production-related issue with your order, contact us with your order number and photos so our team can review it.</p>\n    </div>\n\n    <div class=\"des-gs-guarantee\">\n      <div class=\"des-gs-guarantee-box\">\n        <h3>Production Issues We Review</h3>\n        <ul class=\"des-gs-mini-list\">\n          <li>✓ Printing defects</li>\n          <li>✓ Damaged transfers</li>\n          <li>✓ Missing items</li>\n          <li>✓ Wrong transfer received</li>\n          <li>✓ Production errors</li>\n        </ul>\n      </div>\n\n      <div class=\"des-gs-guarantee-box\">\n        <h3>Customer-Submitted Artwork Issues</h3>\n        <ul class=\"des-gs-mini-list\">\n          <li>× Incorrect artwork submitted</li>\n          <li>× Incorrect sizing or layout</li>\n          <li>× Spelling errors in artwork</li>\n          <li>× Low-resolution artwork</li>\n          <li>× Changes requested after production begins</li>\n        </ul>\n      </div>\n    </div>\n  </section>\n\n\n  <!-- FAQ -->\n  <section class=\"des-gs-section\">\n    <div class=\"des-gs-heading\">\n      <span class=\"des-gs-eyebrow\">Questions & Answers</span>\n      <h2>DTF Gang Sheet FAQ</h2>\n    </div>\n\n    <div class=\"des-gs-faq\">\n\n      <details>\n        <summary>What is a DTF gang sheet?</summary>\n        <p>\n          A DTF gang sheet combines multiple designs or copies onto one larger transfer sheet. This makes it easy to organize different graphics and use the available printing space efficiently.\n        </p>\n      </details>\n\n      <details>\n        <summary>Do I need to create my gang sheet before ordering?</summary>\n        <p>\n          No. Choose your gang sheet size and click “Create a Gang Sheet.” Our online builder lets you upload, resize, duplicate, and arrange your designs before adding the finished sheet to cart.\n        </p>\n      </details>\n\n      <details>\n        <summary>Can I put different designs on the same gang sheet?</summary>\n        <p>\n          Yes. You can combine different logos, graphics, and artwork on the same sheet as long as everything fits within the selected gang sheet dimensions.\n        </p>\n      </details>\n\n      <details>\n        <summary>Can I duplicate the same design?</summary>\n        <p>\n          Yes. You can duplicate artwork inside the builder and arrange multiple copies on the same sheet.\n        </p>\n      </details>\n\n      <details>\n        <summary>What resolution should my artwork be?</summary>\n        <p>\n          We recommend high-resolution artwork at approximately 300 DPI at the intended print size whenever possible.\n        </p>\n      </details>\n\n      <details>\n        <summary>Can I resize my artwork in the builder?</summary>\n        <p>\n          Yes. You can adjust the width and height of your artwork in the builder. Always verify the final dimensions before submitting your layout.\n        </p>\n      </details>\n\n      <details>\n        <summary>What file types can I upload?</summary>\n        <p>\n          The Gang Sheet Builder supports PNG, JPG, PDF, SVG, AI, and EPS artwork files.\n        </p>\n      </details>\n\n      <details>\n        <summary>What if I already have a finished gang sheet?</summary>\n        <p>\n          If your entire gang sheet is already arranged and print-ready, use our Upload Your Gang Sheet option instead of rebuilding the layout in the online builder.\n        </p>\n      </details>\n\n    </div>\n  </section>\n\n\n  <!-- FINAL CTA -->\n  <div class=\"des-gs-cta\">\n    <span class=\"des-gs-eyebrow\">Ready to Print?</span>\n    <h2>Build Your DTF Gang Sheet</h2>\n    <p>\n      Choose your sheet size above, open the online builder, upload your artwork, and create your custom gang sheet.\n    </p>\n\n    <a class=\"des-gs-btn\" href=\"#MainContent\">\n      Create Your Gang Sheet ↑\n    </a>\n  </div>\n\n</div>",
