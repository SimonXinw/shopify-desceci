    "custom_liquid_pDYbWp": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n/* =========================================\n   DESCECI DTF GANG SHEET BUILDER\n   FINAL PRODUCT PAGE SECTION\n========================================= */\n\n.des-gang-page{\n  --green:#16823d;\n  --green-dark:#106b31;\n  --green-light:#eaf5ed;\n  --black:#151515;\n  --text:#555;\n  --light:#f7f8f7;\n  --border:#e8e8e8;\n\n  max-width:1200px;\n  margin:0 auto;\n  padding:20px 20px 70px;\n  color:var(--black);\n}\n\n.des-gang-page *{\n  box-sizing:border-box;\n}\n\n.des-gang-page h2,\n.des-gang-page h3,\n.des-gang-page p{\n  margin-top:0;\n}\n\n.des-section{\n  padding:60px 0;\n  border-bottom:1px solid var(--border);\n}\n\n.des-heading{\n  text-align:center;\n  max-width:780px;\n  margin:0 auto 38px;\n}\n\n.des-eyebrow{\n  color:var(--green);\n  font-size:13px;\n  font-weight:700;\n  letter-spacing:1.4px;\n  text-transform:uppercase;\n  margin-bottom:10px;\n}\n\n.des-heading h2{\n  font-size:36px;\n  line-height:1.15;\n  margin-bottom:12px;\n  letter-spacing:-0.5px;\n}\n\n.des-heading p{\n  color:var(--text);\n  font-size:16px;\n  line-height:1.65;\n  margin-bottom:0;\n}\n\n\n/* =========================================\n   HOW IT WORKS\n========================================= */\n\n.des-steps{\n  display:grid;\n  grid-template-columns:repeat(4,1fr);\n  border:1px solid var(--border);\n  border-radius:14px;\n  overflow:hidden;\n  background:#fff;\n}\n\n.des-step{\n  padding:30px 24px;\n  border-right:1px solid var(--border);\n}\n\n.des-step:last-child{\n  border-right:0;\n}\n\n.des-num{\n  width:36px;\n  height:36px;\n  border-radius:50%;\n  background:var(--black);\n  color:#fff;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  font-size:12px;\n  font-weight:700;\n  margin-bottom:18px;\n}\n\n.des-step h3{\n  font-size:18px;\n  margin-bottom:8px;\n}\n\n.des-step p{\n  color:var(--text);\n  font-size:14px;\n  line-height:1.6;\n  margin:0;\n}\n\n\n/* =========================================\n   BENEFITS\n========================================= */\n\n.des-benefits{\n  display:grid;\n  grid-template-columns:repeat(3,1fr);\n  gap:18px;\n}\n\n.des-benefit{\n  background:var(--light);\n  border:1px solid transparent;\n  border-radius:14px;\n  padding:30px;\n  transition:\n    transform .2s ease,\n    border-color .2s ease,\n    box-shadow .2s ease;\n}\n\n.des-benefit:hover{\n  border-color:#d6e8db;\n  transform:translateY(-3px);\n  box-shadow:0 8px 24px rgba(0,0,0,.04);\n}\n\n.des-icon{\n  width:48px;\n  height:48px;\n  background:var(--green-light);\n  color:var(--green);\n  border-radius:50%;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  margin-bottom:18px;\n}\n\n.des-icon svg{\n  width:24px;\n  height:24px;\n  display:block;\n  fill:none;\n  stroke:currentColor;\n  stroke-width:1.8;\n  stroke-linecap:round;\n  stroke-linejoin:round;\n}\n\n.des-benefit h3{\n  font-size:18px;\n  margin-bottom:8px;\n}\n\n.des-benefit p{\n  color:var(--text);\n  font-size:14px;\n  line-height:1.6;\n  margin:0;\n}\n\n\n/* =========================================\n   CLICKABLE VARIANT SIZES\n========================================= */\n\n.des-sizes{\n  display:flex;\n  flex-wrap:wrap;\n  justify-content:center;\n  gap:10px;\n  max-width:950px;\n  margin:0 auto;\n}\n\n.des-size{\n  display:inline-flex;\n  align-items:center;\n  justify-content:center;\n  border:1px solid #d8d8d8;\n  border-radius:30px;\n  padding:11px 18px;\n  font-size:14px;\n  font-weight:500;\n  background:#fff;\n  white-space:nowrap;\n  text-decoration:none !important;\n  color:#151515 !important;\n  transition:all .2s ease;\n  cursor:pointer;\n}\n\n.des-size:hover{\n  border-color:var(--green);\n  color:var(--green) !important;\n  background:#f4faf6;\n  transform:translateY(-2px);\n  box-shadow:0 4px 12px rgba(0,0,0,.05);\n}\n\n\n/* =========================================\n   ARTWORK / APPLICATION\n========================================= */\n\n.des-info-grid{\n  display:grid;\n  grid-template-columns:1fr 1fr;\n  gap:20px;\n}\n\n.des-info{\n  border:1px solid var(--border);\n  border-radius:14px;\n  padding:32px;\n  background:#fff;\n}\n\n.des-info h3{\n  font-size:23px;\n  margin-bottom:18px;\n}\n\n.des-info ul{\n  margin:0;\n  padding:0;\n  list-style:none;\n}\n\n.des-info li{\n  padding:10px 0;\n  color:var(--text);\n  font-size:15px;\n  border-bottom:1px solid #f0f0f0;\n}\n\n.des-info li:last-child{\n  border-bottom:0;\n}\n\n.des-check{\n  color:var(--green);\n  font-weight:700;\n  margin-right:8px;\n}\n\n\n/* =========================================\n   PRESS SETTINGS\n========================================= */\n\n.des-press{\n  display:grid;\n  grid-template-columns:repeat(4,1fr);\n  gap:12px;\n}\n\n.des-press-item{\n  text-align:center;\n  padding:27px 12px;\n  background:var(--light);\n  border-radius:12px;\n}\n\n.des-press-item strong{\n  display:block;\n  font-size:20px;\n  margin-bottom:6px;\n}\n\n.des-press-item span{\n  color:var(--text);\n  font-size:13px;\n}\n\n\n/* =========================================\n   FAQ\n========================================= */\n\n.des-faq{\n  max-width:900px;\n  margin:0 auto;\n}\n\n.des-faq details{\n  border-bottom:1px solid var(--border);\n  padding:19px 0;\n}\n\n.des-faq summary{\n  cursor:pointer;\n  font-weight:700;\n  font-size:16px;\n  list-style:none;\n}\n\n.des-faq summary::-webkit-details-marker{\n  display:none;\n}\n\n.des-faq summary:after{\n  content:\"+\";\n  float:right;\n  font-size:21px;\n  font-weight:400;\n}\n\n.des-faq details[open] summary:after{\n  content:\"–\";\n}\n\n.des-faq p{\n  color:var(--text);\n  line-height:1.65;\n  font-size:14px;\n  padding-top:12px;\n  margin-bottom:0;\n}\n\n\n/* =========================================\n   RELATED PRODUCTS\n========================================= */\n\n.des-related{\n  display:grid;\n  grid-template-columns:repeat(3,1fr);\n  gap:18px;\n}\n\n.des-related-card{\n  display:block;\n  padding:28px;\n  border:1px solid var(--border);\n  border-radius:14px;\n  text-decoration:none !important;\n  color:var(--black) !important;\n  background:#fff;\n  transition:.2s ease;\n}\n\n.des-related-card:hover{\n  border-color:var(--green);\n  transform:translateY(-2px);\n  box-shadow:0 8px 24px rgba(0,0,0,.04);\n}\n\n.des-related-label{\n  color:var(--green);\n  font-size:12px;\n  font-weight:700;\n  text-transform:uppercase;\n  letter-spacing:1px;\n  margin-bottom:10px;\n}\n\n.des-related-card h3{\n  font-size:19px;\n  margin-bottom:8px;\n}\n\n.des-related-card p{\n  color:var(--text);\n  font-size:14px;\n  line-height:1.6;\n  margin-bottom:16px;\n}\n\n.des-related-link{\n  color:var(--green);\n  font-size:14px;\n  font-weight:700;\n}\n\n\n/* =========================================\n   FINAL CTA\n========================================= */\n\n.des-final{\n  text-align:center;\n  background:var(--black);\n  color:#fff;\n  border-radius:16px;\n  padding:52px 25px;\n  margin-top:60px;\n}\n\n.des-final h2{\n  color:#fff;\n  font-size:32px;\n  margin-bottom:10px;\n}\n\n.des-final p{\n  color:#d8d8d8;\n  margin-bottom:24px;\n  font-size:15px;\n}\n\n.des-builder-button{\n  appearance:none;\n  border:0;\n  cursor:pointer;\n  display:inline-block;\n  background:var(--green);\n  color:#fff;\n  font:inherit;\n  font-weight:700;\n  padding:15px 30px;\n  border-radius:6px;\n  transition:.2s ease;\n}\n\n.des-builder-button:hover{\n  background:var(--green-dark);\n  transform:translateY(-1px);\n}\n\n\n/* =========================================\n   MOBILE\n========================================= */\n\n@media(max-width:749px){\n\n  .des-gang-page{\n    padding:10px 16px 45px;\n  }\n\n  .des-section{\n    padding:42px 0;\n  }\n\n  .des-heading{\n    margin-bottom:28px;\n  }\n\n  .des-heading h2{\n    font-size:28px;\n  }\n\n  .des-heading p{\n    font-size:15px;\n  }\n\n  .des-steps,\n  .des-benefits,\n  .des-info-grid,\n  .des-related{\n    grid-template-columns:1fr;\n  }\n\n  .des-step{\n    border-right:0;\n    border-bottom:1px solid var(--border);\n  }\n\n  .des-step:last-child{\n    border-bottom:0;\n  }\n\n  .des-benefit,\n  .des-related-card{\n    padding:22px;\n  }\n\n  .des-icon{\n    width:44px;\n    height:44px;\n  }\n\n  .des-icon svg{\n    width:22px;\n    height:22px;\n  }\n\n  .des-info{\n    padding:24px;\n  }\n\n  .des-press{\n    grid-template-columns:1fr 1fr;\n  }\n\n  .des-sizes{\n    gap:8px;\n  }\n\n  .des-size{\n    padding:9px 14px;\n    font-size:13px;\n  }\n\n  .des-final{\n    margin-top:42px;\n    padding:40px 20px;\n  }\n\n  .des-final h2{\n    font-size:27px;\n  }\n\n  .des-builder-button{\n    width:100%;\n    max-width:340px;\n  }\n}\n</style>\n\n\n<div class=\"des-gang-page\">\n\n\n<!-- =====================================\n     HOW IT WORKS\n===================================== -->\n\n<section class=\"des-section\">\n\n  <div class=\"des-heading\">\n\n    <div class=\"des-eyebrow\">\n      Simple Online Builder\n    </div>\n\n    <h2>\n      How to Build Your DTF Gang Sheet\n    </h2>\n\n    <p>\n      Choose your sheet size, upload your artwork, arrange your designs,\n      and send your finished gang sheet directly to print.\n    </p>\n\n  </div>\n\n\n  <div class=\"des-steps\">\n\n    <div class=\"des-step\">\n\n      <div class=\"des-num\">01</div>\n\n      <h3>Choose Your Size</h3>\n\n      <p>\n        Select the gang sheet size that works best for your artwork\n        and order.\n      </p>\n\n    </div>\n\n\n    <div class=\"des-step\">\n\n      <div class=\"des-num\">02</div>\n\n      <h3>Upload Artwork</h3>\n\n      <p>\n        Upload PNG, JPG, PDF, SVG, AI or EPS artwork.\n        300 DPI is recommended.\n      </p>\n\n    </div>\n\n\n    <div class=\"des-step\">\n\n      <div class=\"des-num\">03</div>\n\n      <h3>Arrange Designs</h3>\n\n      <p>\n        Resize, duplicate and arrange multiple designs to maximize\n        your available sheet space.\n      </p>\n\n    </div>\n\n\n    <div class=\"des-step\">\n\n      <div class=\"des-num\">04</div>\n\n      <h3>We Print &amp; Ship</h3>\n\n      <p>\n        Submit your finished layout and we'll produce your\n        ready-to-press DTF transfers.\n      </p>\n\n    </div>\n\n  </div>\n\n</section>\n\n\n<!-- =====================================\n     WHY DESCECI\n===================================== -->\n\n<section class=\"des-section\">\n\n  <div class=\"des-heading\">\n\n    <div class=\"des-eyebrow\">\n      Made for Custom Apparel\n    </div>\n\n    <h2>\n      Why Choose DESCECI DTF Gang Sheets?\n    </h2>\n\n    <p>\n      Build custom DTF gang sheets online and make efficient use\n      of your available printing space.\n    </p>\n\n  </div>\n\n\n  <div class=\"des-benefits\">\n\n\n    <!-- VIBRANT FULL COLOR -->\n\n    <div class=\"des-benefit\">\n\n      <div class=\"des-icon\">\n\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n          <path d=\"M12 3a9 9 0 1 0 0 18h1.2a2 2 0 0 0 1.8-2.8l-.4-.9a2 2 0 0 1 1.8-2.8H18a3 3 0 0 0 3-3C21 6.8 17 3 12 3z\"></path>\n          <circle cx=\"7.5\" cy=\"10\" r=\".8\"></circle>\n          <circle cx=\"10\" cy=\"6.8\" r=\".8\"></circle>\n          <circle cx=\"14\" cy=\"6.8\" r=\".8\"></circle>\n          <circle cx=\"17\" cy=\"9.5\" r=\".8\"></circle>\n        </svg>\n\n      </div>\n\n      <h3>Vibrant Full Color</h3>\n\n      <p>\n        Detailed full-color DTF printing for logos,\n        graphics and custom apparel designs.\n      </p>\n\n    </div>\n\n\n    <!-- MULTIPLE DESIGNS -->\n\n    <div class=\"des-benefit\">\n\n      <div class=\"des-icon\">\n\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n          <path d=\"M12 3 3 8l9 5 9-5-9-5z\"></path>\n          <path d=\"m3 12 9 5 9-5\"></path>\n          <path d=\"m3 16 9 5 9-5\"></path>\n        </svg>\n\n      </div>\n\n      <h3>Multiple Designs</h3>\n\n      <p>\n        Combine different logos, graphics and design\n        sizes on one custom gang sheet.\n      </p>\n\n    </div>\n\n\n    <!-- READY TO PRESS -->\n\n    <div class=\"des-benefit\">\n\n      <div class=\"des-icon\">\n\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n          <path d=\"M12 3 20 6v6c0 5-3.4 8-8 9-4.6-1-8-4-8-9V6l8-3z\"></path>\n          <path d=\"m8.5 12 2.2 2.2 4.8-5\"></path>\n        </svg>\n\n      </div>\n\n      <h3>Ready to Press</h3>\n\n      <p>\n        Your finished gang sheet arrives ready for heat\n        pressing onto compatible garments.\n      </p>\n\n    </div>\n\n\n    <!-- EASY ONLINE BUILDER -->\n\n    <div class=\"des-benefit\">\n\n      <div class=\"des-icon\">\n\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n          <rect x=\"3\" y=\"4\" width=\"18\" height=\"14\" rx=\"2\"></rect>\n          <path d=\"M8 21h8\"></path>\n          <path d=\"M12 18v3\"></path>\n          <path d=\"m9 11 2 2 4-5\"></path>\n        </svg>\n\n      </div>\n\n      <h3>Easy Online Builder</h3>\n\n      <p>\n        Upload, resize, duplicate and arrange your\n        artwork directly in the browser.\n      </p>\n\n    </div>\n\n\n    <!-- SOFT & FLEXIBLE -->\n\n    <div class=\"des-benefit\">\n\n      <div class=\"des-icon\">\n\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n          <path d=\"M8 4 4 6l2 5 3-1v10h6V10l3 1 2-5-4-2c-1 2-2.5 3-4 3S9 6 8 4z\"></path>\n        </svg>\n\n      </div>\n\n      <h3>Soft &amp; Flexible</h3>\n\n      <p>\n        DTF transfers provide a flexible finish suitable\n        for everyday custom apparel.\n      </p>\n\n    </div>\n\n\n    <!-- ORDER FROM 1 SHEET -->\n\n    <div class=\"des-benefit\">\n\n      <div class=\"des-icon\">\n\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n          <rect x=\"6\" y=\"3\" width=\"12\" height=\"18\" rx=\"2\"></rect>\n          <path d=\"M9 8h6\"></path>\n          <path d=\"M9 12h6\"></path>\n          <path d=\"M9 16h4\"></path>\n        </svg>\n\n      </div>\n\n      <h3>Order From 1 Sheet</h3>\n\n      <p>\n        Start with one gang sheet for small orders,\n        samples or growing apparel businesses.\n      </p>\n\n    </div>\n\n  </div>\n\n</section>\n\n\n<!-- =====================================\n     CLICKABLE GANG SHEET SIZES\n===================================== -->\n\n<section class=\"des-section\">\n\n  <div class=\"des-heading\">\n\n    <div class=\"des-eyebrow\">\n      Choose Your Sheet\n    </div>\n\n    <h2>\n      Available DTF Gang Sheet Sizes\n    </h2>\n\n    <p>\n      All sheets are 22 inches wide. Choose a size below to open\n      the corresponding gang sheet option and start building.\n    </p>\n\n  </div>\n\n\n  <div class=\"des-sizes\">\n\n    {% for variant in product.variants %}\n\n      {% unless variant.title == 'Default Title' %}\n\n        <a\n          class=\"des-size\"\n          href=\"{{ product.url }}?variant={{ variant.id }}\"\n          title=\"Build a {{ variant.title | escape }} DTF Gang Sheet\"\n        >\n          {{ variant.title }}\n        </a>\n\n      {% endunless %}\n\n    {% endfor %}\n\n  </div>\n\n</section>\n\n\n<!-- =====================================\n     ARTWORK\n===================================== -->\n\n<section class=\"des-section\">\n\n  <div class=\"des-info-grid\">\n\n\n    <div class=\"des-info\">\n\n      <h3>Artwork Requirements</h3>\n\n      <ul>\n\n        <li>\n          <span class=\"des-check\">✓</span>\n          300 DPI recommended\n        </li>\n\n        <li>\n          <span class=\"des-check\">✓</span>\n          Transparent background recommended\n        </li>\n\n        <li>\n          <span class=\"des-check\">✓</span>\n          PNG, JPG, PDF, SVG, AI &amp; EPS\n        </li>\n\n        <li>\n          <span class=\"des-check\">✓</span>\n          Upload multiple designs\n        </li>\n\n        <li>\n          <span class=\"des-check\">✓</span>\n          Review artwork and spelling before submitting\n        </li>\n\n      </ul>\n\n    </div>\n\n\n    <div class=\"des-info\">\n\n      <h3>Great for Custom Apparel</h3>\n\n      <ul>\n\n        <li>\n          <span class=\"des-check\">✓</span>\n          T-Shirts\n        </li>\n\n        <li>\n          <span class=\"des-check\">✓</span>\n          Hoodies &amp; Sweatshirts\n        </li>\n\n        <li>\n          <span class=\"des-check\">✓</span>\n          Tote Bags\n        </li>\n\n        <li>\n          <span class=\"des-check\">✓</span>\n          Team &amp; Event Apparel\n        </li>\n\n        <li>\n          <span class=\"des-check\">✓</span>\n          Clothing Brands &amp; Print Shops\n        </li>\n\n      </ul>\n\n    </div>\n\n  </div>\n\n</section>\n\n\n<!-- =====================================\n     PRESS SETTINGS\n===================================== -->\n\n<section class=\"des-section\">\n\n  <div class=\"des-heading\">\n\n    <div class=\"des-eyebrow\">\n      Ready to Press\n    </div>\n\n    <h2>\n      Recommended Heat Press Settings\n    </h2>\n\n    <p>\n      Use these settings as a starting point.\n      Heat presses and fabrics can vary.\n    </p>\n\n  </div>\n\n\n  <div class=\"des-press\">\n\n    <div class=\"des-press-item\">\n      <strong>300–320°F</strong>\n      <span>Temperature</span>\n    </div>\n\n    <div class=\"des-press-item\">\n      <strong>8–10 Sec</strong>\n      <span>Press Time</span>\n    </div>\n\n    <div class=\"des-press-item\">\n      <strong>Medium</strong>\n      <span>Pressure</span>\n    </div>\n\n    <div class=\"des-press-item\">\n      <strong>Hot Peel</strong>\n      <span>Peel Method</span>\n    </div>\n\n  </div>\n\n</section>\n\n\n<!-- =====================================\n     FAQ\n===================================== -->\n\n<section class=\"des-section\">\n\n  <div class=\"des-heading\">\n\n    <div class=\"des-eyebrow\">\n      Questions &amp; Answers\n    </div>\n\n    <h2>\n      DTF Gang Sheet FAQ\n    </h2>\n\n  </div>\n\n\n  <div class=\"des-faq\">\n\n\n    <details>\n\n      <summary>\n        What is a DTF gang sheet?\n      </summary>\n\n      <p>\n        A DTF gang sheet combines multiple graphics, logos or\n        different-sized designs onto one larger transfer sheet.\n        This helps you use available sheet space efficiently.\n      </p>\n\n    </details>\n\n\n    <details>\n\n      <summary>\n        How do I build a DTF gang sheet online?\n      </summary>\n\n      <p>\n        Choose your sheet size, click Create a Gang Sheet,\n        upload your artwork, resize and arrange your designs,\n        then add the completed sheet to your cart.\n      </p>\n\n    </details>\n\n\n    <details>\n\n      <summary>\n        Can I put multiple designs on one gang sheet?\n      </summary>\n\n      <p>\n        Yes. You can combine multiple logos, graphics and\n        different design sizes on the same DTF gang sheet.\n      </p>\n\n    </details>\n\n\n    <details>\n\n      <summary>\n        What artwork files can I upload?\n      </summary>\n\n      <p>\n        The online gang sheet builder supports PNG, JPG, PDF,\n        SVG, AI and EPS artwork formats.\n      </p>\n\n    </details>\n\n\n    <details>\n\n      <summary>\n        What resolution should my artwork be?\n      </summary>\n\n      <p>\n        We recommend 300 DPI whenever possible for sharp,\n        detailed DTF printing.\n      </p>\n\n    </details>\n\n\n    <details>\n\n      <summary>\n        What fabrics work with DTF transfers?\n      </summary>\n\n      <p>\n        DTF transfers are commonly used on cotton, polyester\n        and many cotton/polyester blends.\n      </p>\n\n    </details>\n\n  </div>\n\n</section>\n\n\n<!-- =====================================\n     RELATED PRODUCTS\n===================================== -->\n\n<section class=\"des-section\">\n\n  <div class=\"des-heading\">\n\n    <div class=\"des-eyebrow\">\n      More Ways to Order\n    </div>\n\n    <h2>\n      Shop DESCECI DTF Transfers\n    </h2>\n\n    <p>\n      Choose the ordering method that works best for your artwork\n      and production needs.\n    </p>\n\n  </div>\n\n\n  <div class=\"des-related\">\n\n\n    <a\n      class=\"des-related-card\"\n      href=\"/products/products-custom-dtf-transfers-by-size\"\n    >\n\n      <div class=\"des-related-label\">\n        Order by Size\n      </div>\n\n      <h3>\n        Custom DTF Transfers by Size\n      </h3>\n\n      <p>\n        Upload an individual design, choose your transfer size\n        and order the quantity you need.\n      </p>\n\n      <span class=\"des-related-link\">\n        Shop DTF Transfers by Size →\n      </span>\n\n    </a>\n\n\n    <a\n      class=\"des-related-card\"\n      href=\"/collections/dtf-transfer\"\n    >\n\n      <div class=\"des-related-label\">\n        DTF Transfers\n      </div>\n\n      <h3>\n        Shop DTF Transfers\n      </h3>\n\n      <p>\n        Explore DESCECI custom DTF transfer options for apparel,\n        brands and print shops.\n      </p>\n\n      <span class=\"des-related-link\">\n        Explore DTF Transfers →\n      </span>\n\n    </a>\n\n\n    <a\n      class=\"des-related-card\"\n      href=\"/collections/dtf-consumables\"\n    >\n\n      <div class=\"des-related-label\">\n        Printing Supplies\n      </div>\n\n      <h3>\n        DTF Consumables\n      </h3>\n\n      <p>\n        Shop DTF ink, film, powder and related supplies\n        for your DTF printing workflow.\n      </p>\n\n      <span class=\"des-related-link\">\n        Shop DTF Supplies →\n      </span>\n\n    </a>\n\n  </div>\n\n</section>\n\n\n<!-- =====================================\n     FINAL CTA\n===================================== -->\n\n<div class=\"des-final\">\n\n  <h2>\n    Ready to Build Your DTF Gang Sheet?\n  </h2>\n\n  <p>\n    Choose your sheet size and start arranging your artwork online.\n  </p>\n\n  <button\n    type=\"button\"\n    class=\"des-builder-button\"\n    id=\"des-scroll-builder\"\n  >\n    Start Building Your Gang Sheet ↑\n  </button>\n\n</div>\n\n\n</div>\n\n\n<script>\ndocument.addEventListener('DOMContentLoaded', function () {\n\n  var scrollButton = document.getElementById('des-scroll-builder');\n\n  if (!scrollButton) return;\n\n\n  scrollButton.addEventListener('click', function () {\n\n    var elements = Array.from(\n      document.querySelectorAll('button, a')\n    );\n\n\n    var builderButton = elements.find(function(el) {\n\n      var text = (el.innerText || el.textContent || '')\n        .trim()\n        .toLowerCase();\n\n      return text.indexOf('create a gang sheet') !== -1;\n\n    });\n\n\n    if (builderButton) {\n\n      builderButton.scrollIntoView({\n        behavior:'smooth',\n        block:'center'\n      });\n\n\n      setTimeout(function () {\n\n        builderButton.style.transition =\n          'box-shadow .25s ease';\n\n        builderButton.style.boxShadow =\n          '0 0 0 4px rgba(22,130,61,.20)';\n\n\n        setTimeout(function () {\n\n          builderButton.style.boxShadow = '';\n\n        },1400);\n\n      },500);\n\n\n    } else {\n\n      window.scrollTo({\n        top:0,\n        behavior:'smooth'\n      });\n\n    }\n\n  });\n\n});\n</script>",
