    "custom_liquid_pDYbWp": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n.des-gang-page{\n  --green:#16823d;\n  --black:#151515;\n  --text:#555;\n  --light:#f7f8f7;\n  --border:#e8e8e8;\n  max-width:1200px;\n  margin:0 auto;\n  padding:20px 20px 70px;\n  color:var(--black);\n}\n.des-gang-page *{box-sizing:border-box}\n.des-gang-page h2,\n.des-gang-page h3,\n.des-gang-page p{margin-top:0}\n\n.des-section{\n  padding:60px 0;\n  border-bottom:1px solid var(--border);\n}\n\n.des-heading{\n  text-align:center;\n  max-width:760px;\n  margin:0 auto 38px;\n}\n.des-eyebrow{\n  color:var(--green);\n  font-size:13px;\n  font-weight:700;\n  letter-spacing:1.4px;\n  text-transform:uppercase;\n  margin-bottom:10px;\n}\n.des-heading h2{\n  font-size:36px;\n  line-height:1.15;\n  margin-bottom:12px;\n}\n.des-heading p{\n  color:var(--text);\n  font-size:16px;\n  line-height:1.65;\n}\n\n/* HOW IT WORKS */\n.des-steps{\n  display:grid;\n  grid-template-columns:repeat(4,1fr);\n  border:1px solid var(--border);\n  border-radius:14px;\n  overflow:hidden;\n  background:#fff;\n}\n.des-step{\n  padding:30px 24px;\n  border-right:1px solid var(--border);\n}\n.des-step:last-child{border-right:0}\n.des-num{\n  width:34px;\n  height:34px;\n  border-radius:50%;\n  background:var(--black);\n  color:#fff;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  font-size:12px;\n  font-weight:700;\n  margin-bottom:18px;\n}\n.des-step h3{\n  font-size:18px;\n  margin-bottom:8px;\n}\n.des-step p{\n  color:var(--text);\n  font-size:14px;\n  line-height:1.6;\n  margin:0;\n}\n\n/* BENEFITS */\n.des-benefits{\n  display:grid;\n  grid-template-columns:repeat(3,1fr);\n  gap:18px;\n}\n.des-benefit{\n  background:var(--light);\n  border-radius:12px;\n  padding:28px;\n}\n.des-icon{\n  font-size:25px;\n  margin-bottom:15px;\n}\n.des-benefit h3{\n  font-size:18px;\n  margin-bottom:8px;\n}\n.des-benefit p{\n  color:var(--text);\n  font-size:14px;\n  line-height:1.6;\n  margin:0;\n}\n\n/* SIZES */\n.des-sizes{\n  display:flex;\n  flex-wrap:wrap;\n  justify-content:center;\n  gap:10px;\n  max-width:900px;\n  margin:0 auto;\n}\n.des-size{\n  border:1px solid #d8d8d8;\n  border-radius:30px;\n  padding:10px 17px;\n  font-size:14px;\n  background:#fff;\n}\n\n/* TWO COLUMN INFO */\n.des-info-grid{\n  display:grid;\n  grid-template-columns:1fr 1fr;\n  gap:20px;\n}\n.des-info{\n  border:1px solid var(--border);\n  border-radius:14px;\n  padding:32px;\n}\n.des-info h3{\n  font-size:23px;\n  margin-bottom:18px;\n}\n.des-info ul{\n  margin:0;\n  padding:0;\n  list-style:none;\n}\n.des-info li{\n  padding:9px 0;\n  color:var(--text);\n  font-size:15px;\n  border-bottom:1px solid #f0f0f0;\n}\n.des-info li:last-child{border-bottom:0}\n.des-check{\n  color:var(--green);\n  font-weight:700;\n  margin-right:8px;\n}\n\n/* PRESS SETTINGS */\n.des-press{\n  display:grid;\n  grid-template-columns:repeat(4,1fr);\n  gap:12px;\n}\n.des-press-item{\n  text-align:center;\n  padding:25px 12px;\n  background:var(--light);\n  border-radius:12px;\n}\n.des-press-item strong{\n  display:block;\n  font-size:20px;\n  margin-bottom:6px;\n}\n.des-press-item span{\n  color:var(--text);\n  font-size:13px;\n}\n\n/* FAQ */\n.des-faq{\n  max-width:900px;\n  margin:0 auto;\n}\n.des-faq details{\n  border-bottom:1px solid var(--border);\n  padding:19px 0;\n}\n.des-faq summary{\n  cursor:pointer;\n  font-weight:700;\n  font-size:16px;\n  list-style:none;\n}\n.des-faq summary::-webkit-details-marker{display:none}\n.des-faq summary:after{\n  content:\"+\";\n  float:right;\n  font-size:21px;\n  font-weight:400;\n}\n.des-faq details[open] summary:after{content:\"–\"}\n.des-faq p{\n  color:var(--text);\n  line-height:1.65;\n  font-size:14px;\n  padding-top:12px;\n  margin-bottom:0;\n}\n\n/* FINAL CTA */\n.des-final{\n  text-align:center;\n  background:var(--black);\n  color:#fff;\n  border-radius:16px;\n  padding:50px 25px;\n  margin-top:60px;\n}\n.des-final h2{\n  font-size:32px;\n  margin-bottom:10px;\n}\n.des-final p{\n  color:#ddd;\n  margin-bottom:22px;\n}\n.des-final a{\n  display:inline-block;\n  background:var(--green);\n  color:#fff;\n  text-decoration:none;\n  font-weight:700;\n  padding:14px 28px;\n  border-radius:5px;\n}\n\n@media(max-width:749px){\n  .des-gang-page{padding:10px 16px 45px}\n  .des-section{padding:42px 0}\n  .des-heading h2{font-size:28px}\n  .des-steps,\n  .des-benefits,\n  .des-info-grid,\n  .des-press{\n    grid-template-columns:1fr;\n  }\n  .des-step{\n    border-right:0;\n    border-bottom:1px solid var(--border);\n  }\n  .des-step:last-child{border-bottom:0}\n  .des-benefit{padding:22px}\n  .des-info{padding:24px}\n  .des-press{\n    grid-template-columns:1fr 1fr;\n  }\n  .des-final h2{font-size:27px}\n}\n</style>\n\n<div class=\"des-gang-page\">\n\n  <!-- HOW IT WORKS -->\n  <section class=\"des-section\">\n    <div class=\"des-heading\">\n      <div class=\"des-eyebrow\">Simple Online Builder</div>\n      <h2>How to Build Your DTF Gang Sheet</h2>\n      <p>Choose your sheet size, upload your artwork, arrange your designs, and send your finished gang sheet directly to print.</p>\n    </div>\n\n    <div class=\"des-steps\">\n      <div class=\"des-step\">\n        <div class=\"des-num\">01</div>\n        <h3>Choose Your Size</h3>\n        <p>Select the gang sheet size that works best for your artwork and order.</p>\n      </div>\n\n      <div class=\"des-step\">\n        <div class=\"des-num\">02</div>\n        <h3>Upload Artwork</h3>\n        <p>Upload PNG, JPG, PDF, SVG, AI or EPS artwork. 300 DPI is recommended.</p>\n      </div>\n\n      <div class=\"des-step\">\n        <div class=\"des-num\">03</div>\n        <h3>Arrange Designs</h3>\n        <p>Resize, duplicate and arrange multiple designs to maximize your sheet space.</p>\n      </div>\n\n      <div class=\"des-step\">\n        <div class=\"des-num\">04</div>\n        <h3>We Print & Ship</h3>\n        <p>Submit your finished layout and we'll produce your ready-to-press DTF transfers.</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- WHY DESCECI -->\n  <section class=\"des-section\">\n    <div class=\"des-heading\">\n      <div class=\"des-eyebrow\">Made for Custom Apparel</div>\n      <h2>Why Choose DESCECI DTF Gang Sheets?</h2>\n      <p>Build custom gang sheets online while getting more usable print space from every sheet.</p>\n    </div>\n\n    <div class=\"des-benefits\">\n      <div class=\"des-benefit\">\n        <div class=\"des-icon\">✦</div>\n        <h3>Vibrant Full Color</h3>\n        <p>Detailed, full-color DTF printing designed for clean and vibrant apparel graphics.</p>\n      </div>\n\n      <div class=\"des-benefit\">\n        <div class=\"des-icon\">↔</div>\n        <h3>Multiple Designs</h3>\n        <p>Place different logos, graphics and sizes together on one custom DTF gang sheet.</p>\n      </div>\n\n      <div class=\"des-benefit\">\n        <div class=\"des-icon\">✓</div>\n        <h3>Ready to Press</h3>\n        <p>Your finished gang sheet arrives ready for heat pressing onto compatible garments.</p>\n      </div>\n\n      <div class=\"des-benefit\">\n        <div class=\"des-icon\">⚡</div>\n        <h3>Fast Production</h3>\n        <p>A streamlined online builder helps move your artwork from upload to production quickly.</p>\n      </div>\n\n      <div class=\"des-benefit\">\n        <div class=\"des-icon\">◈</div>\n        <h3>Soft & Flexible</h3>\n        <p>DTF transfers provide a flexible finish suitable for everyday custom apparel.</p>\n      </div>\n\n      <div class=\"des-benefit\">\n        <div class=\"des-icon\">1</div>\n        <h3>No Large Minimum</h3>\n        <p>Order from one gang sheet, making it practical for small businesses and growing brands.</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- SIZES -->\n  <section class=\"des-section\">\n    <div class=\"des-heading\">\n      <div class=\"des-eyebrow\">Choose Your Sheet</div>\n      <h2>Available DTF Gang Sheet Sizes</h2>\n      <p>All sheets are 22 inches wide. Choose the length that fits the number and size of designs you need.</p>\n    </div>\n\n    <div class=\"des-sizes\">\n      <span class=\"des-size\">22\" × 12\"</span>\n      <span class=\"des-size\">22\" × 24\"</span>\n      <span class=\"des-size\">22\" × 36\"</span>\n      <span class=\"des-size\">22\" × 48\"</span>\n      <span class=\"des-size\">22\" × 60\"</span>\n      <span class=\"des-size\">22\" × 72\"</span>\n      <span class=\"des-size\">22\" × 84\"</span>\n      <span class=\"des-size\">22\" × 96\"</span>\n      <span class=\"des-size\">22\" × 120\"</span>\n      <span class=\"des-size\">22\" × 144\"</span>\n      <span class=\"des-size\">22\" × 180\"</span>\n      <span class=\"des-size\">22\" × 240\"</span>\n    </div>\n  </section>\n\n  <!-- ARTWORK + APPLICATION -->\n  <section class=\"des-section\">\n    <div class=\"des-info-grid\">\n\n      <div class=\"des-info\">\n        <h3>Artwork Requirements</h3>\n        <ul>\n          <li><span class=\"des-check\">✓</span>300 DPI recommended</li>\n          <li><span class=\"des-check\">✓</span>Transparent background recommended</li>\n          <li><span class=\"des-check\">✓</span>PNG, JPG, PDF, SVG, AI & EPS</li>\n          <li><span class=\"des-check\">✓</span>Upload multiple designs</li>\n          <li><span class=\"des-check\">✓</span>Check spelling and artwork before submitting</li>\n        </ul>\n      </div>\n\n      <div class=\"des-info\">\n        <h3>Great for Custom Apparel</h3>\n        <ul>\n          <li><span class=\"des-check\">✓</span>T-Shirts</li>\n          <li><span class=\"des-check\">✓</span>Hoodies & Sweatshirts</li>\n          <li><span class=\"des-check\">✓</span>Tote Bags</li>\n          <li><span class=\"des-check\">✓</span>Team & Event Apparel</li>\n          <li><span class=\"des-check\">✓</span>Clothing Brands & Print Shops</li>\n        </ul>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- PRESS -->\n  <section class=\"des-section\">\n    <div class=\"des-heading\">\n      <div class=\"des-eyebrow\">Ready to Press</div>\n      <h2>Recommended Heat Press Settings</h2>\n      <p>Use these settings as a starting point. Heat presses and fabrics can vary.</p>\n    </div>\n\n    <div class=\"des-press\">\n      <div class=\"des-press-item\">\n        <strong>300–320°F</strong>\n        <span>Temperature</span>\n      </div>\n      <div class=\"des-press-item\">\n        <strong>8–10 Sec</strong>\n        <span>Press Time</span>\n      </div>\n      <div class=\"des-press-item\">\n        <strong>Medium</strong>\n        <span>Pressure</span>\n      </div>\n      <div class=\"des-press-item\">\n        <strong>Hot Peel</strong>\n        <span>Peel Method</span>\n      </div>\n    </div>\n  </section>\n\n  <!-- FAQ -->\n  <section class=\"des-section\">\n    <div class=\"des-heading\">\n      <div class=\"des-eyebrow\">Questions & Answers</div>\n      <h2>DTF Gang Sheet FAQ</h2>\n    </div>\n\n    <div class=\"des-faq\">\n\n      <details>\n        <summary>What is a DTF gang sheet?</summary>\n        <p>A DTF gang sheet combines multiple graphics, logos or different-sized designs onto one larger transfer sheet. This helps you use available sheet space efficiently.</p>\n      </details>\n\n      <details>\n        <summary>How do I build a DTF gang sheet online?</summary>\n        <p>Choose a sheet size above, select Create a Gang Sheet, upload your artwork, resize and arrange your designs, then add the completed sheet to your cart.</p>\n      </details>\n\n      <details>\n        <summary>What artwork files can I upload?</summary>\n        <p>The online gang sheet builder supports common artwork formats including PNG, JPG, PDF, SVG, AI and EPS. For best results, use high-resolution artwork.</p>\n      </details>\n\n      <details>\n        <summary>What resolution should my artwork be?</summary>\n        <p>We recommend 300 DPI whenever possible for sharp, detailed DTF printing.</p>\n      </details>\n\n      <details>\n        <summary>Can I put different designs on one gang sheet?</summary>\n        <p>Yes. You can upload and arrange multiple logos, graphics and different design sizes on the same gang sheet.</p>\n      </details>\n\n      <details>\n        <summary>What fabrics work with DTF transfers?</summary>\n        <p>DTF transfers are commonly used on cotton, polyester and many cotton/polyester blends.</p>\n      </details>\n\n    </div>\n  </section>\n\n  <!-- CTA -->\n  <div class=\"des-final\">\n    <h2>Ready to Build Your Gang Sheet?</h2>\n    <p>Choose your sheet size above and start arranging your artwork online.</p>\n    <a href=\"#MainContent\">Start Building Your Gang Sheet ↑</a>\n  </div>\n\n</div>",
