    "collapsible_content_zcXCxJ": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_6cUGb9": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What is a DTF transfer?",
            "icon": "check_mark",
            "row_content": "<p><br/>DTF transfers are full-color designs printed onto specialized film and prepared for heat application onto garments and other compatible fabrics.<br/><br/></p>",
            "page": ""
          }
        },
        "collapsible_row_irrWNf": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What fabrics can I use DTF transfers on?",
            "icon": "check_mark",
            "row_content": "<p>DTF transfers can be used on many common apparel fabrics, including cotton, polyester, and cotton/poly blends.<br/></p>",
            "page": ""
          }
        },
        "collapsible_row_QAkMhD": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Do I need a heat press?",
            "icon": "check_mark",
            "row_content": "<p>For the most consistent results, we recommend using a heat press.</p>",
            "page": ""
          }
        },
        "collapsible_row_DFgG3t": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What file format should I upload?",
            "icon": "check_mark",
            "row_content": "<p>Use a high-resolution, print-ready file with a transparent background whenever possible. PNG is commonly recommended for raster artwork.</p>",
            "page": ""
          }
        },
        "collapsible_row_AUkNfU": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What's the difference between Gang Sheets and Transfers by Size?",
            "icon": "check_mark",
            "row_content": "<p>Gang Sheets allow you to arrange multiple designs on a larger sheet, while Transfers by Size are convenient when you want individual designs in specific dimensions.<br/><br/></p>",
            "page": ""
          }
        },
        "collapsible_row_pV3wHg": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How should I wash garments with DTF transfers?",
            "icon": "check_mark",
            "row_content": "<p>Follow the recommended application and garment-care instructions for the best long-term results.<br/></p>",
            "page": ""
          }
        }
      },
