        "custom_liquid": "<style>\n  /* ==============================\n     DESCECI - DTF APPLICATIONS\n     ============================== */\n\n  .desceci-applications {\n    background: #f7f8f7;\n    padding: 72px 24px;\n    font-family: inherit;\n  }\n\n  .desceci-applications-inner {\n    max-width: 1280px;\n    margin: 0 auto;\n  }\n\n  .desceci-applications-header {\n    max-width: 760px;\n    margin: 0 auto 40px;\n    text-align: center;\n  }\n\n  .desceci-applications-eyebrow {\n    margin-bottom: 10px;\n    color: #4d8f2f;\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: .1em;\n    text-transform: uppercase;\n  }\n\n  .desceci-applications-header h2 {\n    margin: 0 0 14px;\n    color: #111;\n    font-size: 32px;\n    line-height: 1.25;\n    font-weight: 600;\n  }\n\n  .desceci-applications-header p {\n    max-width: 700px;\n    margin: 0 auto;\n    color: #666;\n    font-size: 15.5px;\n    line-height: 1.7;\n  }\n\n  /* GRID */\n  .desceci-applications-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 18px;\n  }\n\n  .desceci-application-card {\n    overflow: hidden;\n    background: #fff;\n    border: 1px solid #e5e5e5;\n    border-radius: 8px;\n    transition:\n      transform .2s ease,\n      box-shadow .2s ease;\n  }\n\n  .desceci-application-card:hover {\n    transform: translateY(-4px);\n    box-shadow: 0 12px 28px rgba(0,0,0,.07);\n  }\n\n  /* IMAGE */\n  .desceci-application-image {\n    position: relative;\n    overflow: hidden;\n    width: 100%;\n    aspect-ratio: 4 / 3;\n    background: #eee;\n  }\n\n  .desceci-application-image img {\n    display: block;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    transition: transform .35s ease;\n  }\n\n  .desceci-application-card:hover img {\n    transform: scale(1.03);\n  }\n\n  /* CONTENT */\n  .desceci-application-content {\n    padding: 22px 20px 24px;\n  }\n\n  .desceci-application-content h3 {\n    margin: 0 0 8px;\n    color: #111;\n    font-size: 19px;\n    line-height: 1.3;\n    font-weight: 600;\n  }\n\n  .desceci-application-content p {\n    margin: 0;\n    color: #666;\n    font-size: 14px;\n    line-height: 1.65;\n  }\n\n  /* BOTTOM TEXT */\n  .desceci-applications-bottom {\n    max-width: 850px;\n    margin: 34px auto 0;\n    text-align: center;\n  }\n\n  .desceci-applications-bottom p {\n    margin: 0;\n    color: #555;\n    font-size: 14.5px;\n    line-height: 1.7;\n  }\n\n  /* TABLET */\n  @media screen and (max-width: 990px) {\n    .desceci-applications-grid {\n      grid-template-columns: repeat(2, 1fr);\n    }\n  }\n\n  /* MOBILE */\n  @media screen and (max-width: 749px) {\n    .desceci-applications {\n      padding: 50px 16px;\n    }\n\n    .desceci-applications-header {\n      margin-bottom: 28px;\n    }\n\n    .desceci-applications-header h2 {\n      font-size: 27px;\n    }\n\n    .desceci-applications-header p {\n      font-size: 15px;\n    }\n\n    .desceci-applications-grid {\n      grid-template-columns: 1fr;\n      gap: 14px;\n    }\n\n    .desceci-application-content {\n      padding: 20px;\n    }\n  }\n</style>\n\n\n<section class=\"desceci-applications\">\n\n  <div class=\"desceci-applications-inner\">\n\n    <!-- HEADER -->\n    <div class=\"desceci-applications-header\">\n\n      <div class=\"desceci-applications-eyebrow\">\n        MADE FOR CUSTOM APPAREL\n      </div>\n\n      <h2>\n        DTF Transfers for Custom Apparel\n      </h2>\n\n      <p>\n        Create vibrant custom apparel for brands, businesses,\n        events, teams, and everyday projects with ready-to-press DTF transfers.\n      </p>\n\n    </div>\n\n\n    <!-- APPLICATION GRID -->\n    <div class=\"desceci-applications-grid\">\n\n\n      <!-- T-SHIRTS -->\n      <div class=\"desceci-application-card\">\n\n        <div class=\"desceci-application-image\">\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/1030/0420/9521/files/605bc5cf-5acc-4c6c-8d7c-a73db87aebc3.png?v=1789714070\"\n            alt=\"Custom T-shirt printed with a colorful DTF transfer\"\n            loading=\"lazy\"\n            width=\"500\"\n            height=\"375\">\n        </div>\n\n        <div class=\"desceci-application-content\">\n          <h3>T-Shirts</h3>\n          <p>\n            Create full-color custom tees for brands,\n            events, merch, and everyday apparel.\n          </p>\n        </div>\n\n      </div>\n\n\n      <!-- HOODIES -->\n      <div class=\"desceci-application-card\">\n\n        <div class=\"desceci-application-image\">\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/1030/0420/9521/files/fee50c46-b415-4b6a-bea5-0e13ff905c0d.png?v=1789714069\"\n            alt=\"Custom hoodie decorated with a vibrant DTF transfer\"\n            loading=\"lazy\"\n            width=\"500\"\n            height=\"375\">\n        </div>\n\n        <div class=\"desceci-application-content\">\n          <h3>Hoodies & Sweatshirts</h3>\n          <p>\n            Add bold artwork and detailed graphics\n            to hoodies, sweatshirts, and casual apparel.\n          </p>\n        </div>\n\n      </div>\n\n\n      <!-- TOTE BAGS -->\n      <div class=\"desceci-application-card\">\n\n        <div class=\"desceci-application-image\">\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/1030/0420/9521/files/bca2c759-166f-4258-92fd-01e2a2fa49dc.png?v=1789714070\"\n            alt=\"Custom tote bag decorated with a DTF heat transfer\"\n            loading=\"lazy\"\n            width=\"500\"\n            height=\"375\">\n        </div>\n\n        <div class=\"desceci-application-content\">\n          <h3>Tote Bags</h3>\n          <p>\n            Turn compatible fabric bags into custom\n            merchandise, promotional products, and gifts.\n          </p>\n        </div>\n\n      </div>\n\n\n      <!-- WORKWEAR -->\n      <div class=\"desceci-application-card\">\n\n        <div class=\"desceci-application-image\">\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/1030/0420/9521/files/d34f94ef-767f-488a-b888-922c96b1d122.png?v=1789714069\"\n            alt=\"Custom workwear and team apparel made with DTF transfers\"\n            loading=\"lazy\"\n            width=\"500\"\n            height=\"375\">\n        </div>\n\n        <div class=\"desceci-application-content\">\n          <h3>Workwear & Team Apparel</h3>\n          <p>\n            Produce branded uniforms, team apparel,\n            staff shirts, and event clothing.\n          </p>\n        </div>\n\n      </div>\n\n\n    </div>\n\n\n    <!-- SEO SUPPORTING COPY -->\n    <div class=\"desceci-applications-bottom\">\n\n      <p>\n        DESCECI custom DTF transfers are suitable for many common\n        cotton, polyester, and cotton-blend apparel applications.\n        Always test unfamiliar fabrics before full production.\n      </p>\n\n    </div>\n\n  </div>\n\n</section>",
