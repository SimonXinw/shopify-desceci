      "settings": {
        "custom_liquid": "<style>\n  /* =========================\n     DESCECI - DTF ORDER GUIDE\n     ========================= */\n\n  .desceci-order-guide {\n    max-width: 1280px;\n    margin: 0 auto;\n    padding: 64px 24px;\n    font-family: inherit;\n  }\n\n  /* Header */\n  .desceci-order-header {\n    max-width: 820px;\n    margin: 0 auto 42px;\n    text-align: center;\n  }\n\n  .desceci-order-header h2 {\n    margin: 0 0 14px;\n    font-size: 32px;\n    line-height: 1.25;\n    font-weight: 600;\n    color: #111111;\n  }\n\n  .desceci-order-header p {\n    margin: 0 auto;\n    max-width: 760px;\n    font-size: 16px;\n    line-height: 1.7;\n    color: #666666;\n  }\n\n  /* 3-column grid */\n  .desceci-order-grid {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 22px;\n    align-items: stretch;\n  }\n\n  /* Cards */\n  .desceci-order-card {\n    display: flex;\n    flex-direction: column;\n    height: 100%;\n    box-sizing: border-box;\n    padding: 32px 28px;\n    background: #ffffff;\n    border: 1px solid #e6e6e6;\n    border-radius: 8px;\n    transition:\n      transform 0.2s ease,\n      box-shadow 0.2s ease,\n      border-color 0.2s ease;\n  }\n\n  .desceci-order-card:hover {\n    transform: translateY(-4px);\n    border-color: #d5d5d5;\n    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.07);\n  }\n\n  /* Step number */\n  .desceci-order-number {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 42px;\n    height: 42px;\n    margin-bottom: 22px;\n    flex: 0 0 42px;\n    border-radius: 50%;\n    background: #111111;\n    color: #ffffff;\n    font-size: 14px;\n    font-weight: 600;\n    line-height: 1;\n  }\n\n  /* Green descriptor */\n  .desceci-order-tag {\n    margin: 0 0 9px;\n    color: #4d8f2f;\n    font-size: 12px;\n    line-height: 1.4;\n    font-weight: 700;\n    letter-spacing: 0.07em;\n    text-transform: uppercase;\n  }\n\n  /* Card title */\n  .desceci-order-card h3 {\n    margin: 0 0 14px;\n    color: #111111;\n    font-size: 23px;\n    line-height: 1.3;\n    font-weight: 600;\n  }\n\n  /* Description */\n  .desceci-order-card p {\n    margin: 0 0 28px;\n    color: #666666;\n    font-size: 15px;\n    line-height: 1.7;\n  }\n\n  /* CTA */\n  .desceci-order-button {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 100%;\n    min-height: 54px;\n    box-sizing: border-box;\n    margin-top: auto;\n    padding: 14px 18px;\n    background: #111111;\n    border: 1px solid #111111;\n    color: #ffffff !important;\n    text-align: center;\n    text-decoration: none !important;\n    font-size: 13px;\n    line-height: 1.3;\n    font-weight: 600;\n    letter-spacing: 0.035em;\n    text-transform: uppercase;\n    transition:\n      background 0.2s ease,\n      color 0.2s ease;\n  }\n\n  .desceci-order-button:hover {\n    background: #ffffff;\n    color: #111111 !important;\n  }\n\n  .desceci-order-button:focus-visible {\n    outline: 2px solid #4d8f2f;\n    outline-offset: 3px;\n  }\n\n  /* Tablet */\n  @media screen and (max-width: 990px) {\n    .desceci-order-guide {\n      padding: 56px 22px;\n    }\n\n    .desceci-order-grid {\n      grid-template-columns: 1fr;\n      max-width: 680px;\n      margin: 0 auto;\n      gap: 16px;\n    }\n\n    .desceci-order-card {\n      min-height: auto;\n    }\n  }\n\n  /* Mobile */\n  @media screen and (max-width: 749px) {\n    .desceci-order-guide {\n      padding: 44px 16px;\n    }\n\n    .desceci-order-header {\n      margin-bottom: 28px;\n    }\n\n    .desceci-order-header h2 {\n      font-size: 27px;\n      line-height: 1.25;\n    }\n\n    .desceci-order-header p {\n      font-size: 15px;\n      line-height: 1.65;\n    }\n\n    .desceci-order-card {\n      padding: 26px 22px;\n      border-radius: 6px;\n    }\n\n    .desceci-order-number {\n      width: 38px;\n      height: 38px;\n      flex-basis: 38px;\n      margin-bottom: 18px;\n      font-size: 13px;\n    }\n\n    .desceci-order-card h3 {\n      font-size: 21px;\n    }\n\n    .desceci-order-card p {\n      font-size: 14.5px;\n      margin-bottom: 24px;\n    }\n\n    .desceci-order-button {\n      min-height: 50px;\n      font-size: 12.5px;\n    }\n  }\n</style>\n\n\n<section class=\"desceci-order-guide\">\n\n  <!-- SECTION HEADER -->\n  <div class=\"desceci-order-header\">\n\n    <h2>Which DTF Transfer Option Is Right for You?</h2>\n\n    <p>\n      Choose the easiest way to order based on how your artwork is prepared.\n      Whether you have one design or a complete gang sheet,\n      DESCECI makes ordering simple.\n    </p>\n\n  </div>\n\n\n  <!-- 3 ORDER OPTIONS -->\n  <div class=\"desceci-order-grid\">\n\n\n    <!-- OPTION 01 -->\n    <div class=\"desceci-order-card\">\n\n      <div class=\"desceci-order-number\">\n        01\n      </div>\n\n      <div class=\"desceci-order-tag\">\n        Best for Single Designs\n      </div>\n\n      <h3>\n        DTF Transfers by Size\n      </h3>\n\n      <p>\n        Have one design ready to print? Choose your transfer size,\n        upload your artwork, select the quantity you need,\n        and we'll take care of the rest.\n      </p>\n\n      <a\n        class=\"desceci-order-button\"\n        href=\"/products/products-custom-dtf-transfers-by-size\"\n        aria-label=\"Shop DTF Transfers by Size\">\n        Shop by Size →\n      </a>\n\n    </div>\n\n\n    <!-- OPTION 02 -->\n    <div class=\"desceci-order-card\">\n\n      <div class=\"desceci-order-number\">\n        02\n      </div>\n\n      <div class=\"desceci-order-tag\">\n        Best for Ready-Made Gang Sheets\n      </div>\n\n      <h3>\n        Upload Your Gang Sheet\n      </h3>\n\n      <p>\n        Already have a complete gang sheet? Choose the matching\n        22.7-inch sheet size and upload your ready-to-print file\n        for production.\n      </p>\n\n      <a\n        class=\"desceci-order-button\"\n        href=\"/products/custom-dtf-transfers\"\n        