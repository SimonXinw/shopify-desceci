      "settings": {
        "custom_liquid": "<style>\n  /* ==============================\n     DESCECI - WHAT ARE DTF TRANSFERS\n     ============================== */\n\n  .desceci-what-dtf {\n    max-width: 1280px;\n    margin: 0 auto;\n    padding: 72px 24px;\n    font-family: inherit;\n  }\n\n  .desceci-what-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 64px;\n    align-items: center;\n  }\n\n  /* IMAGE */\n  .desceci-what-image {\n    position: relative;\n    overflow: hidden;\n    min-height: 520px;\n    background: #f5f5f5;\n    border-radius: 8px;\n  }\n\n  .desceci-what-image img {\n    display: block;\n    width: 100%;\n    height: 100%;\n    min-height: 520px;\n    object-fit: cover;\n  }\n\n  .desceci-what-badge {\n    position: absolute;\n    left: 22px;\n    bottom: 22px;\n    padding: 11px 16px;\n    background: #111;\n    color: #fff;\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: .06em;\n    text-transform: uppercase;\n  }\n\n  /* CONTENT */\n  .desceci-what-content {\n    max-width: 590px;\n  }\n\n  .desceci-what-eyebrow {\n    margin-bottom: 10px;\n    color: #4d8f2f;\n    font-size: 12px;\n    line-height: 1.4;\n    font-weight: 700;\n    letter-spacing: .1em;\n    text-transform: uppercase;\n  }\n\n  .desceci-what-content h2 {\n    margin: 0 0 20px;\n    color: #111;\n    font-size: 34px;\n    line-height: 1.2;\n    font-weight: 600;\n  }\n\n  .desceci-what-content > p {\n    margin: 0 0 16px;\n    color: #606060;\n    font-size: 15.5px;\n    line-height: 1.75;\n  }\n\n  /* FEATURES */\n  .desceci-what-features {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 14px;\n    margin: 28px 0 30px;\n  }\n\n  .desceci-what-feature {\n    display: flex;\n    align-items: center;\n    gap: 11px;\n    min-height: 48px;\n    padding: 11px 13px;\n    background: #f7f8f7;\n    border: 1px solid #ededed;\n    color: #222;\n    font-size: 13.5px;\n    font-weight: 600;\n  }\n\n  .desceci-what-check {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex: 0 0 25px;\n    width: 25px;\n    height: 25px;\n    border-radius: 50%;\n    background: #e8f4e2;\n    color: #4d8f2f;\n    font-size: 13px;\n    font-weight: 800;\n  }\n\n  /* CTA */\n  .desceci-what-button {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 50px;\n    padding: 0 25px;\n    background: #111;\n    border: 1px solid #111;\n    color: #fff !important;\n    text-decoration: none !important;\n    font-size: 13px;\n    font-weight: 600;\n    letter-spacing: .04em;\n    text-transform: uppercase;\n    transition: all .2s ease;\n  }\n\n  .desceci-what-button:hover {\n    background: #fff;\n    color: #111 !important;\n  }\n\n  /* TABLET */\n  @media screen and (max-width: 990px) {\n    .desceci-what-grid {\n      grid-template-columns: 1fr;\n      gap: 38px;\n    }\n\n    .desceci-what-content {\n      max-width: 100%;\n    }\n\n    .desceci-what-image {\n      min-height: 450px;\n    }\n\n    .desceci-what-image img {\n      min-height: 450px;\n    }\n  }\n\n  /* MOBILE */\n  @media screen and (max-width: 749px) {\n    .desceci-what-dtf {\n      padding: 50px 16px;\n    }\n\n    .desceci-what-grid {\n      gap: 30px;\n    }\n\n    .desceci-what-image {\n      min-height: 330px;\n      border-radius: 6px;\n    }\n\n    .desceci-what-image img {\n      min-height: 330px;\n    }\n\n    .desceci-what-content h2 {\n      font-size: 27px;\n    }\n\n    .desceci-what-content > p {\n      font-size: 15px;\n      line-height: 1.7;\n    }\n\n    .desceci-what-features {\n      grid-template-columns: 1fr;\n      margin: 24px 0 26px;\n      gap: 10px;\n    }\n\n    .desceci-what-badge {\n      left: 15px;\n      bottom: 15px;\n    }\n\n    .desceci-what-button {\n      width: 100%;\n      box-sizing: border-box;\n    }\n  }\n</style>\n\n\n<section class=\"desceci-what-dtf\">\n\n  <div class=\"desceci-what-grid\">\n\n    <!-- LEFT IMAGE -->\n    <div class=\"desceci-what-image\">\n\n      <img\n        src=\"YOUR-IMAGE-URL-HERE\"\n        alt=\"Custom DTF transfers printed and ready to press for custom apparel\"\n        loading=\"lazy\"\n        width=\"700\"\n        height=\"700\">\n\n      <div class=\"desceci-what-badge\">\n        Ready-to-Press DTF Transfers\n      </div>\n\n    </div>\n\n\n    <!-- RIGHT CONTENT -->\n    <div class=\"desceci-what-content\">\n\n      <div class=\"desceci-what-eyebrow\">\n        DTF TRANSFER GUIDE\n      </div>\n\n      <h2>\n        What Are DTF Transfers?\n      </h2>\n\n      <p>\n        DTF transfers, or Direct-to-Film transfers, are full-color\n        heat transfers used to apply custom artwork to apparel and\n        other compatible fabric products.\n      </p>\n\n      <p>\n        Your design is printed onto transfer film, prepared with\n        adhesive powder, and cured before application. The finished\n        transfer can then be positioned on the garment and applied\n        using a heat press.\n      </p>\n\n      <p>\n        Custom DTF transfers are a practical option for T-shirts,\n        hoodies, sweatshirts, tote bags, uniforms, team apparel,\n        and many other custom printing projects.\n      </p>\n\n\n      <!-- FEATURES -->\n      <div class=\"desceci-what-features\">\n\n        <div class=\"desceci-what-feature\">\n          <span class=\"desceci-what-check\">✓</span>\n          Full-Color Artwork\n        </div>\n\n        <div class=\"desceci-what-feature\">\n          <span class=\"desceci-what-check\">✓</span>\n          No Weeding Required\n        </div>\n\n        <div class=\"desceci-what-feature\">\n          <span class=\"desceci-what-check\">✓</span>\n          Ready to Heat Press\n        </div>\n\n        <div class=\"desceci-what-feature\">\n          <span class=\"desceci-what-check\">✓</span>\n          Great for Custom Apparel\n        </div>\n\n      </div>\n\n\n      <!-- INTERNAL LINK -->\n      <a\n        class=\"desceci-what-button\"\n        href=\"/blogs/news/what-is-dtf-transfer-a-complete-guide-to-direct-to-film-printing-for-custom-apparel\">\n        Learn More About DTF Transfers →\n      </a>\n\n    </div>\n\n  </div>\n\n</section>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
    },
