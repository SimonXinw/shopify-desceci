        },
        "text_jr4mNd": {
          "type": "text",
          "settings": {
            "text": "<p><strong>Same-Day Shipping</strong><br/><br/>Order before 2 PM local time for same-day shipping.*</p><p><strong>Ships from Anaheim, CA</strong><br/><br/>Your custom DTF transfers are produced and shipped from our California location.</p><p><strong>Local Pickup Available</strong><br/><br/>Skip shipping and pick up your order directly from our Anaheim location.</p><p></p><p></p><p></p><p><br/>*Orders placed after 2 PM typically ship the next business day. Delivery times vary by carrier and destination. Same-day shipping applies to eligible orders without artwork or production issues.<br/><br/></p>"
          }
