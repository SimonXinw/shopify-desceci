          }
        },
        "collapsible_row_irrWNf": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What fabrics can I use DTF transfers on?",
            "icon": "check_mark",
            "row_content": "<p>DTF transfers can be used on many common apparel fabrics, including cotton, polyester, and cotton/poly blends.<br/></p>",
