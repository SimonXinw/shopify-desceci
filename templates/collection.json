    "custom_liquid_9MDjF3": {
      "type": "custom-liquid",
      "name": "产品展示",
      "settings": {
        "custom_liquid": "<style>\n  /* =========================================\n     DESCECI - SHOP DTF TRANSFERS\n     ========================================= */\n\n  .desceci-products {\n    max-width: 1280px;\n    margin: 0 auto;\n    padding: 72px 24px;\n    font-family: inherit;\n  }\n\n  .desceci-products-header {\n    max-width: 760px;\n    margin: 0 auto 42px;\n    text-align: center;\n  }\n\n  .desceci-products-eyebrow {\n    margin-bottom: 10px;\n    color: #4d8f2f;\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: .1em;\n    text-transform: uppercase;\n  }\n\n  .desceci-products-header h2 {\n    margin: 0 0 14px;\n    color: #111;\n    font-size: 34px;\n    line-height: 1.2;\n    font-weight: 600;\n  }\n\n  .desceci-products-header p {\n    max-width: 650px;\n    margin: 0 auto;\n    color: #666;\n    font-size: 15.5px;\n    line-height: 1.7;\n  }\n\n  /* GRID */\n  .desceci-products-grid {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 22px;\n    align-items: stretch;\n  }\n\n  /* CARD */\n  .desceci-product-card {\n    display: flex;\n    flex-direction: column;\n    min-width: 0;\n    overflow: hidden;\n    background: #fff;\n    border: 1px solid #e2e2e2;\n    transition:\n      transform .25s ease,\n      box-shadow .25s ease,\n      border-color .25s ease;\n  }\n\n  .desceci-product-card:hover {\n    transform: translateY(-4px);\n    border-color: #c9c9c9;\n    box-shadow: 0 12px 30px rgba(0,0,0,.07);\n  }\n\n  /* IMAGE */\n  .desceci-product-image-link {\n    display: block;\n    position: relative;\n    overflow: hidden;\n    background: #f7f7f7;\n    aspect-ratio: 1 / 1;\n  }\n\n  .desceci-product-image-link img {\n    display: block;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    transition: transform .35s ease;\n  }\n\n  .desceci-product-card:hover\n  .desceci-product-image-link img {\n    transform: scale(1.025);\n  }\n\n  /* NUMBER */\n  .desceci-product-number {\n    position: absolute;\n    top: 16px;\n    left: 16px;\n    z-index: 2;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    width: 38px;\n    height: 38px;\n\n    background: #111;\n    color: #fff;\n\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: .05em;\n  }\n\n  /* CONTENT */\n  .desceci-product-content {\n    display: flex;\n    flex-direction: column;\n    flex: 1;\n    padding: 27px 25px 25px;\n  }\n\n  .desceci-product-best {\n    margin-bottom: 9px;\n    color: #4d8f2f;\n    font-size: 11px;\n    line-height: 1.4;\n    font-weight: 700;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n  }\n\n  .desceci-product-title {\n    margin: 0 0 12px;\n    color: #111;\n    font-size: 22px;\n    line-height: 1.3;\n    font-weight: 600;\n  }\n\n  .desceci-product-title a {\n    color: inherit;\n    text-decoration: none;\n  }\n\n  .desceci-product-description {\n    margin: 0 0 20px;\n    color: #666;\n    font-size: 14px;\n    line-height: 1.65;\n  }\n\n  /* FEATURES */\n  .desceci-product-features {\n    margin: 0 0 25px;\n    padding: 0;\n    list-style: none;\n  }\n\n  .desceci-product-features li {\n    position: relative;\n    margin-bottom: 9px;\n    padding-left: 21px;\n\n    color: #333;\n    font-size: 13.5px;\n    line-height: 1.5;\n  }\n\n  .desceci-product-features li:last-child {\n    margin-bottom: 0;\n  }\n\n  .desceci-product-features li::before {\n    content: \"✓\";\n    position: absolute;\n    left: 0;\n    top: 0;\n\n    color: #4d8f2f;\n    font-weight: 700;\n  }\n\n  /* BUTTON */\n  .desceci-product-button {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    width: 100%;\n    min-height: 50px;\n    margin-top: auto;\n    padding: 12px 18px;\n\n    box-sizing: border-box;\n\n    background: #111;\n    border: 1px solid #111;\n\n    color: #fff !important;\n    text-decoration: none !important;\n\n    font-size: 11.5px;\n    line-height: 1.3;\n    font-weight: 700;\n    letter-spacing: .045em;\n    text-transform: uppercase;\n\n    transition:\n      background .2s ease,\n      color .2s ease;\n  }\n\n  .desceci-product-button:hover {\n    background: #fff;\n    color: #111 !important;\n  }\n\n  /* BOTTOM TRUST BAR */\n  .desceci-products-trust {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-wrap: wrap;\n\n    gap: 0;\n\n    margin-top: 34px;\n    padding: 18px 20px;\n\n    background: #f6f7f6;\n  }\n\n  .desceci-products-trust span {\n    position: relative;\n\n    padding: 0 24px;\n\n    color: #333;\n    font-size: 12px;\n    line-height: 1.5;\n    font-weight: 600;\n  }\n\n  .desceci-products-trust span:not(:last-child)::after {\n    content: \"\";\n    position: absolute;\n    right: 0;\n    top: 50%;\n\n    width: 1px;\n    height: 15px;\n\n    background: #ccc;\n    transform: translateY(-50%);\n  }\n\n  /* TABLET */\n  @media screen and (max-width: 990px) {\n\n    .desceci-products-grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n    }\n\n    .desceci-product-card:last-child {\n      grid-column: 1 / -1;\n      max-width: calc(50% - 11px);\n      width: 100%;\n      margin: 0 auto;\n    }\n  }\n\n  /* MOBILE */\n  @media screen and (max-width: 749px) {\n\n    .desceci-products {\n      padding: 50px 16px;\n    }\n\n    .desceci-products-header {\n      margin-bottom: 30px;\n    }\n\n    .desceci-products-header h2 {\n      font-size: 28px;\n    }\n\n    .desceci-products-header p {\n      font-size: 15px;\n    }\n\n    .desceci-products-grid {\n      grid-template-columns: 1fr;\n      gap: 18px;\n    }\n\n    .desceci-product-card:last-child {\n      grid-column: auto;\n      max-width: none;\n    }\n\n    .desceci-product-content {\n      padding: 23px 20px 21px;\n    }\n\n    .desceci-product-title {\n      font-size: 20px;\n    }\n\n    .desceci-products-trust {\n      align-items: flex-start;\n      justify-content: flex-start;\n      gap: 9px 16px;\n      padding: 17px 18px;\n    }\n\n    .desceci-products-trust span {\n      width: calc(50% - 8px);\n      padding: 0;\n      box-sizing: border-box;\n      font-size: 11.5px;\n    }\n\n    .desceci-products-trust span::after {\n      display: none;\n    }\n  }\n</style>\n\n\n{% assign by_size_product = all_products['products-custom-dtf-transfers-by-size'] %}\n{% assign upload_product = all_products['custom-dtf-transfers'] %}\n{% assign builder_product = all_products['products-dtf-gang-sheet-builder'] %}\n\n\n<section class=\"desceci-products\">\n\n  <!-- HEADER -->\n  <div class=\"desceci-products-header\">\n\n    <div class=\"desceci-products-eyebrow\">\n      CHOOSE YOUR ORDERING METHOD\n    </div>\n\n    <h2>Shop DTF Transfers</h2>\n\n    <p>\n      Choose the ordering method that works best for your artwork\n      and production workflow. From individual designs to complete\n      gang sheets, DESCECI makes ordering custom DTF transfers simple.\n    </p>\n\n  </div>\n\n\n  <!-- PRODUCT GRID -->\n  <div class=\"desceci-products-grid\">\n\n\n    <!-- =====================================\n         PRODUCT 1 - BY SIZE\n         ===================================== -->\n    <article class=\"desceci-product-card\">\n\n      <a\n        href=\"/products/products-custom-dtf-transfers-by-size\"\n        class=\"desceci-product-image-link\"\n        aria-label=\"Shop DTF Transfers by Size\">\n\n        <div class=\"desceci-product-number\">\n          01\n        </div>\n\n        {% if by_size_product.featured_image %}\n\n          {{\n            by_size_product.featured_image\n            | image_url: width: 900\n            | image_tag:\n              loading: 'lazy',\n              widths: '400, 600, 800, 900',\n              sizes: '(max-width: 749px) 100vw, 33vw',\n              alt: 'Custom DTF transfers by size ready to press for T-shirts and apparel'\n          }}\n\n        {% else %}\n\n          {{ 'product-1' | placeholder_svg_tag }}\n\n        {% endif %}\n\n      </a>\n\n\n      <div class=\"desceci-product-content\">\n\n        <div class=\"desceci-product-best\">\n          Best for Single Designs\n        </div>\n\n        <h3 class=\"desceci-product-title\">\n          <a href=\"/products/products-custom-dtf-transfers-by-size\">\n            DTF Transfers by Size\n          </a>\n        </h3>\n\n        <p class=\"desceci-product-description\">\n          Upload an individual design, choose your transfer size\n          and quantity, and we'll take care of the rest.\n        </p>\n\n        <ul class=\"desceci-product-features\">\n          <li>Simple size-based ordering</li>\n          <li>Great for logos & individual designs</li>\n          <li>No minimum order</li>\n          <li>Ready to heat press</li>\n        </ul>\n\n        <a\n          href=\"/products/products-custom-dtf-transfers-by-size\"\n          class=\"desceci-product-button\">\n          Shop by Size →\n        </a>\n\n      </div>\n\n    </article>\n\n\n    <!-- =====================================\n         PRODUCT 2 - UPLOAD GANG SHEET\n         ===================================== -->\n    <article class=\"desceci-product-card\">\n\n      <a\n        href=\"/products/custom-dtf-transfers\"\n        class=\"desceci-product-image-link\"\n        aria-label=\"Upload your ready-to-print DTF gang sheet\">\n\n        <div class=\"desceci-product-number\">\n          02\n        </div>\n\n        {% if upload_product.featured_image %}\n\n          {{\n            upload_product.featured_image\n            | image_url: width: 900\n            | image_tag:\n              loading: 'lazy',\n              widths: '400, 600, 800, 900',\n              sizes: '(max-width: 749px) 100vw, 33vw',\n              alt: 'Custom DTF gang sheet printing from uploaded ready-to-print artwork'\n          }}\n\n        {% else %}\n\n          {{ 'product-2' | placeholder_svg_tag }}\n\n        {% endif %}\n\n      </a>\n\n\n      <div class=\"desceci-product-content\">\n\n        <div class=\"desceci-product-best\">\n          Best for Print-Ready Files\n        </div>\n\n        <h3 class=\"desceci-product-title\">\n          <a href=\"/products/custom-dtf-transfers\">\n            Upload Your Gang Sheet\n          </a>\n        </h3>\n\n        <p class=\"desceci-product-description\">\n          Already have a completed gang sheet? Choose the matching\n          22.7-inch sheet size and upload your ready-to-print artwork.\n        </p>\n\n        <ul class=\"desceci-product-features\">\n          <li>Upload your completed gang sheet</li>\n          <li>22.7-inch sheet width</li>\n          <li>Multiple sheet lengths available</li>\n          <li>Ready to heat press</li>\n        </ul>\n\n        <a\n          href=\"/products/custom-dtf-transfers\"\n          class=\"desceci-product-button\">\n          Upload Your Gang Sheet →\n        </a>\n\n      </div>\n\n    </article>\n\n\n    <!-- =====================================\n         PRODUCT 3 - BUILDER\n         ===================================== -->\n    <article class=\"desceci-product-card\">\n\n      <a\n        href=\"/products/products-dtf-gang-sheet-builder\"\n        class=\"desceci-product-image-link\"\n        aria-label=\"Build a custom DTF gang sheet online\">\n\n        <div class=\"desceci-product-number\">\n          03\n        </div>\n\n        {% if builder_product.featured_image %}\n\n          {{\n            builder_product.featured_image\n            | image_url: width: 900\n            | image_tag:\n              loading: 'lazy',\n              widths: '400, 600, 800, 900',\n              sizes: '(max-width: 749px) 100vw, 33vw',\n              alt: 'Build a custom DTF gang sheet online with DESCECI Gang Sheet Builder'\n          }}\n\n        {% else %}\n\n          {{ 'product-3' | placeholder_svg_tag }}\n\n        {% endif %}\n\n      </a>\n\n\n      <div class=\"desceci-product-content\">\n\n        <div class=\"desceci-product-best\">\n          Best for Multiple Designs\n        </div>\n\n        <h3 class=\"desceci-product-title\">\n          <a href=\"/products/products-dtf-gang-sheet-builder\">\n            Build a Gang Sheet Online\n          </a>\n        </h3>\n\n        <p class=\"desceci-product-description\">\n          Upload multiple designs and arrange them directly in our\n          online Gang Sheet Builder before placing your order.\n        </p>\n\n        <ul class=\"desceci-product-features\">\n          <li>Easy online gang sheet builder</li>\n          <li>Arrange multiple designs</li>\n          <li>Maximize your sheet space</li>\n          <li>Simple print-ready workflow</li>\n        </ul>\n\n        <a\n          href=\"/products/products-dtf-gang-sheet-builder\"\n          class=\"desceci-product-button\">\n          Build a Gang Sheet →\n        </a>\n\n      </div>\n\n    </article>\n\n  </div>\n\n\n  <!-- TRUST BAR -->\n  <div class=\"desceci-products-trust\">\n\n    <span>✓ No Minimum Order</span>\n    <span>✓ Ready to Press</span>\n    <span>✓ Full-Color Printing</span>\n    <span>✓ Fast U.S. Fulfillment</span>\n\n  </div>\n\n</section>",
