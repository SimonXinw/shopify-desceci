    "custom_liquid_EfULiz": {
      "type": "custom-liquid",
      "name": "DTF Transfers for Custom Apparel",
      "settings": {
        "custom_liquid": "<style>\n  .desceci-faq {\n    max-width: 1000px;\n    margin: 0 auto;\n    padding: 72px 24px;\n    font-family: inherit;\n  }\n\n  .desceci-faq-header {\n    max-width: 720px;\n    margin: 0 auto 38px;\n    text-align: center;\n  }\n\n  .desceci-faq-eyebrow {\n    margin-bottom: 10px;\n    color: #4d8f2f;\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: .1em;\n    text-transform: uppercase;\n  }\n\n  .desceci-faq-header h2 {\n    margin: 0 0 14px;\n    color: #111;\n    font-size: 32px;\n    line-height: 1.25;\n    font-weight: 600;\n  }\n\n  .desceci-faq-header p {\n    margin: 0;\n    color: #666;\n    font-size: 15.5px;\n    line-height: 1.7;\n  }\n\n  .desceci-faq-list {\n    border-top: 1px solid #dedede;\n  }\n\n  .desceci-faq-item {\n    border-bottom: 1px solid #dedede;\n  }\n\n  .desceci-faq-item summary {\n    position: relative;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 20px;\n    padding: 22px 50px 22px 0;\n    cursor: pointer;\n    list-style: none;\n    color: #111;\n    font-size: 17px;\n    line-height: 1.4;\n    font-weight: 600;\n  }\n\n  .desceci-faq-item summary::-webkit-details-marker {\n    display: none;\n  }\n\n  .desceci-faq-item summary::before,\n  .desceci-faq-item summary::after {\n    content: \"\";\n    position: absolute;\n    right: 10px;\n    top: 50%;\n    width: 15px;\n    height: 1.5px;\n    background: #111;\n    transition: transform .2s ease;\n  }\n\n  .desceci-faq-item summary::after {\n    transform: rotate(90deg);\n  }\n\n  .desceci-faq-item[open] summary::after {\n    transform: rotate(0deg);\n  }\n\n  .desceci-faq-answer {\n    max-width: 850px;\n    padding: 0 50px 22px 0;\n    color: #606060;\n    font-size: 14.5px;\n    line-height: 1.75;\n  }\n\n  .desceci-faq-answer p {\n    margin: 0;\n  }\n\n  .desceci-faq-answer strong {\n    color: #222;\n    font-weight: 600;\n  }\n\n  .desceci-faq-answer a {\n    color: #111;\n    font-weight: 600;\n    text-decoration: underline;\n    text-underline-offset: 3px;\n  }\n\n  .desceci-faq-answer a:hover {\n    color: #4d8f2f;\n  }\n\n  .desceci-faq-cta {\n    margin-top: 38px;\n    padding: 32px 28px;\n    background: #f6f7f6;\n    text-align: center;\n  }\n\n  .desceci-faq-cta h3 {\n    margin: 0 0 8px;\n    color: #111;\n    font-size: 21px;\n    line-height: 1.35;\n    font-weight: 600;\n  }\n\n  .desceci-faq-cta p {\n    max-width: 620px;\n    margin: 0 auto 22px;\n    color: #666;\n    font-size: 14px;\n    line-height: 1.65;\n  }\n\n  .desceci-faq-buttons {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: center;\n    gap: 10px;\n  }\n\n  .desceci-faq-button {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 48px;\n    padding: 0 22px;\n    background: #111;\n    border: 1px solid #111;\n    color: #fff !important;\n    text-decoration: none !important;\n    font-size: 11.5px;\n    font-weight: 700;\n    letter-spacing: .04em;\n    text-transform: uppercase;\n    transition: all .2s ease;\n  }\n\n  .desceci-faq-button:hover {\n    background: #fff;\n    color: #111 !important;\n  }\n\n  .desceci-faq-button.secondary {\n    background: #fff;\n    color: #111 !important;\n  }\n\n  .desceci-faq-button.secondary:hover {\n    background: #111;\n    color: #fff !important;\n  }\n\n  @media screen and (max-width: 749px) {\n\n    .desceci-faq {\n      padding: 50px 16px;\n    }\n\n    .desceci-faq-header {\n      margin-bottom: 28px;\n    }\n\n    .desceci-faq-header h2 {\n      font-size: 27px;\n    }\n\n    .desceci-faq-item summary {\n      padding: 19px 42px 19px 0;\n      font-size: 15.5px;\n    }\n\n    .desceci-faq-answer {\n      padding: 0 35px 20px 0;\n      font-size: 14px;\n    }\n\n    .desceci-faq-cta {\n      padding: 26px 20px;\n    }\n\n    .desceci-faq-buttons {\n      flex-direction: column;\n    }\n\n    .desceci-faq-button {\n      width: 100%;\n      box-sizing: border-box;\n    }\n  }\n</style>\n\n<section class=\"desceci-faq\">\n\n  <div class=\"desceci-faq-header\">\n\n    <div class=\"desceci-faq-eyebrow\">\n      DTF TRANSFER FAQ\n    </div>\n\n    <h2>Frequently Asked Questions</h2>\n\n    <p>\n      Everything you need to know before ordering and pressing\n      custom DTF transfers from DESCECI.\n    </p>\n\n  </div>\n\n  <div class=\"desceci-faq-list\">\n\n    <details class=\"desceci-faq-item\">\n\n      <summary>What is a DTF transfer?</summary>\n\n      <div class=\"desceci-faq-answer\">\n        <p>\n          A DTF (Direct-to-Film) transfer is a full-color printed\n          heat transfer designed to be applied to compatible garments\n          using a heat press. The artwork is printed onto transfer film,\n          prepared with adhesive, and supplied ready for application.\n          Learn more in our\n          <a href=\"/blogs/news/what-is-dtf-transfer-a-complete-guide-to-direct-to-film-printing-for-custom-apparel\">\n            complete DTF transfer guide\n          </a>.\n        </p>\n      </div>\n\n    </details>\n\n    <details class=\"desceci-faq-item\">\n\n      <summary>What fabrics can I use DTF transfers on?</summary>\n\n      <div class=\"desceci-faq-answer\">\n        <p>\n          DTF transfers can be used on many common apparel fabrics,\n          including cotton, polyester, and cotton/poly blends.\n          They are commonly used for T-shirts, hoodies, sweatshirts,\n          tote bags, workwear, team apparel, and other compatible\n          fabric products.\n        </p>\n      </div>\n\n    </details>\n\n    <details class=\"desceci-faq-item\">\n\n      <summary>What temperature should I use for DTF transfers?</summary>\n\n      <div class=\"desceci-faq-answer\">\n        <p>\n          For DESCECI DTF transfers, a starting range of\n          <strong>300–320°F (149–160°C)</strong> for approximately\n          <strong>8–10 seconds</strong> with\n          <strong>medium pressure</strong> is recommended.\n          Heat presses and fabrics can vary, so adjust your settings\n          when necessary. For detailed instructions, read our\n          <a href=\"/blogs/news/how-to-press-dtf-transfers\">\n            DTF heat press settings guide\n          </a>.\n        </p>\n      </div>\n\n    </details>\n\n    <details class=\"desceci-faq-item\">\n\n      <summary>How long do DTF transfers last?</summary>\n\n      <div class=\"desceci-faq-answer\">\n        <p>\n          DTF transfer durability depends on proper application,\n          garment material, washing habits, and care. Correctly\n          applied transfers are designed for repeated wear and washing.\n          For better longevity, wash garments inside out in cold water,\n          avoid bleach, and tumble dry on low when appropriate.\n          Learn more in our\n          <a href=\"/blogs/news/how-long-do-dtf-transfers-last\">\n            DTF transfer durability guide\n          </a>.\n        </p>\n      </div>\n\n    </details>\n\n    <details class=\"desceci-faq-item\">\n\n      <summary>Is there a minimum order?</summary>\n\n      <div class=\"desceci-faq-answer\">\n        <p>\n          No. DESCECI DTF transfers are available with\n          <strong>no minimum order</strong>, making them suitable\n          for individual projects, samples, small businesses,\n          clothing brands, print shops, and larger production runs.\n        </p>\n      </div>\n\n    </details>\n\n    <details class=\"desceci-faq-item\">\n\n      <summary>Which DTF transfer ordering option should I choose?</summary>\n\n      <div class=\"desceci-faq-answer\">\n        <p>\n          Choose\n          <a href=\"/products/products-custom-dtf-transfers-by-size\">\n            DTF Transfers by Size\n          </a>\n          when you have individual designs and want a simple\n          size-based ordering process. Choose\n          <a href=\"/products/custom-dtf-transfers\">\n            Upload Your Gang Sheet\n          </a>\n          when you already have a completed ready-to-print gang sheet.\n          Choose\n          <a href=\"/products/products-dtf-gang-sheet-builder\">\n            Build a Gang Sheet Online\n          </a>\n          when you want to arrange multiple designs yourself using\n          our online gang sheet builder.\n        </p>\n      </div>\n\n    </details>\n\n    <details class=\"desceci-faq-item\">\n\n      <summary>What artwork should I upload?</summary>\n\n      <div class=\"desceci-faq-answer\">\n        <p>\n          For the best print quality, use high-resolution artwork.\n          <strong>300 DPI is recommended</strong>, and a transparent\n          background is preferred when appropriate. If you are ordering\n          a ready-to-print gang sheet, upload your completed gang sheet\n          at the correct sheet dimensions before adding it to your cart.\n        </p>\n      </div>\n\n    </details>\n\n    <details class=\"desceci-faq-item\">\n\n      <summary>What should I do if my DTF transfer is peeling?</summary>\n\n      <div class=\"desceci-faq-answer\">\n        <p>\n          DTF transfer peeling can be related to temperature,\n          pressure, pressing time, fabric type, curing, or application\n          technique. Make sure your heat press reaches the correct\n          temperature and applies even pressure before pressing again.\n          For troubleshooting steps, read our\n          <a href=\"/blogs/news/why-is-my-dtf-transfer-peeling\">\n            DTF transfer peeling guide\n          </a>.\n        </p>\n      </div>\n\n    </details>\n\n  </div>\n\n  <div class=\"desceci-faq-cta\">\n\n    <h3>Ready to Order Your Custom DTF Transfers?</h3>\n\n    <p>\n      Choose the ordering method that works best for your\n      artwork, quantity, and production workflow.\n    </p>\n\n    <div class=\"desceci-faq-buttons\">\n\n      <a\n        href=\"/products/products-custom-dtf-transfers-by-size\"\n        class=\"desceci-faq-button\">\n        Shop by Size\n      </a>\n\n      <a\n        href=\"/products/custom-dtf-transfers\"\n        class=\"desceci-faq-button secondary\">\n        Upload Gang Sheet\n      </a>\n\n      <a\n        href=\"/products/products-dtf-gang-sheet-builder\"\n        class=\"desceci-faq-button secondary\">\n        Build a Gang Sheet\n      </a>\n\n    </div>\n\n  </div>\n\n</section>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
    },
