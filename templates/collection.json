      "settings": {
        "custom_liquid": "<style>\n  /* ===============================\n     DESCECI - HOW TO ORDER DTF\n     =============================== */\n\n  .desceci-how {\n    background: #f7f8f7;\n    padding: 72px 24px;\n    font-family: inherit;\n  }\n\n  .desceci-how-inner {\n    max-width: 1280px;\n    margin: 0 auto;\n  }\n\n  /* HEADER */\n  .desceci-how-header {\n    max-width: 760px;\n    margin: 0 auto 42px;\n    text-align: center;\n  }\n\n  .desceci-how-eyebrow {\n    margin-bottom: 10px;\n    color: #4d8f2f;\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: .1em;\n    text-transform: uppercase;\n  }\n\n  .desceci-how-header h2 {\n    margin: 0 0 14px;\n    color: #111;\n    font-size: 32px;\n    line-height: 1.25;\n    font-weight: 600;\n  }\n\n  .desceci-how-header p {\n    max-width: 680px;\n    margin: 0 auto;\n    color: #666;\n    font-size: 16px;\n    line-height: 1.7;\n  }\n\n  /* GRID */\n  .desceci-how-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 22px;\n  }\n\n  /* CARD */\n  .desceci-how-card {\n    overflow: hidden;\n    background: #fff;\n    border: 1px solid #e5e5e5;\n    border-radius: 8px;\n    transition:\n      transform .2s ease,\n      box-shadow .2s ease;\n  }\n\n  .desceci-how-card:hover {\n    transform: translateY(-4px);\n    box-shadow: 0 12px 30px rgba(0,0,0,.07);\n  }\n\n  /* IMAGE */\n  .desceci-how-image {\n    position: relative;\n    width: 100%;\n    aspect-ratio: 4 / 3;\n    overflow: hidden;\n    background: #eee;\n  }\n\n  .desceci-how-image img {\n    display: block;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    transition: transform .35s ease;\n  }\n\n  .desceci-how-card:hover img {\n    transform: scale(1.025);\n  }\n\n  /* NUMBER */\n  .desceci-how-number {\n    position: absolute;\n    left: 18px;\n    bottom: 18px;\n\n    display: flex;\n    align-items: center;\n    justify-content: center;\n\n    width: 44px;\n    height: 44px;\n\n    background: #111;\n    border-radius: 50%;\n\n    color: #fff;\n    font-size: 14px;\n    font-weight: 700;\n  }\n\n  /* CONTENT */\n  .desceci-how-content {\n    padding: 26px 25px 28px;\n  }\n\n  .desceci-how-label {\n    margin-bottom: 7px;\n    color: #4d8f2f;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: .09em;\n    text-transform: uppercase;\n  }\n\n  .desceci-how-content h3 {\n    margin: 0 0 11px;\n    color: #111;\n    font-size: 21px;\n    line-height: 1.3;\n    font-weight: 600;\n  }\n\n  .desceci-how-content p {\n    margin: 0;\n    color: #666;\n    font-size: 14.5px;\n    line-height: 1.7;\n  }\n\n  /* CTA AREA */\n  .desceci-how-cta {\n    margin-top: 34px;\n    text-align: center;\n  }\n\n  .desceci-how-cta p {\n    margin: 0 0 16px;\n    color: #555;\n    font-size: 14px;\n  }\n\n  .desceci-how-button {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 50px;\n    padding: 0 28px;\n\n    background: #111;\n    border: 1px solid #111;\n\n    color: #fff !important;\n    text-decoration: none !important;\n\n    font-size: 13px;\n    font-weight: 600;\n    letter-spacing: .04em;\n    text-transform: uppercase;\n\n    transition: all .2s ease;\n  }\n\n  .desceci-how-button:hover {\n    background: #fff;\n    color: #111 !important;\n  }\n\n  /* TABLET */\n  @media screen and (max-width: 990px) {\n\n    .desceci-how-grid {\n      grid-template-columns: 1fr;\n      max-width: 680px;\n      margin: 0 auto;\n    }\n\n  }\n\n  /* MOBILE */\n  @media screen and (max-width: 749px) {\n\n    .desceci-how {\n      padding: 50px 16px;\n    }\n\n    .desceci-how-header {\n      margin-bottom: 30px;\n    }\n\n    .desceci-how-header h2 {\n      font-size: 27px;\n    }\n\n    .desceci-how-header p {\n      font-size: 15px;\n    }\n\n    .desceci-how-content {\n      padding: 22px 20px 24px;\n    }\n\n    .desceci-how-content h3 {\n      font-size: 20px;\n    }\n\n    .desceci-how-button {\n      width: 100%;\n      box-sizing: border-box;\n    }\n\n  }\n</style>\n\n\n<section class=\"desceci-how\">\n\n  <div class=\"desceci-how-inner\">\n\n\n    <!-- HEADER -->\n    <div class=\"desceci-how-header\">\n\n      <div class=\"desceci-how-eyebrow\">\n        SIMPLE ORDERING PROCESS\n      </div>\n\n      <h2>\n        How to Order DTF Transfers\n      </h2>\n\n      <p>\n        From artwork to finished apparel, getting custom\n        DTF transfers from DESCECI is simple.\n      </p>\n\n    </div>\n\n\n    <!-- STEPS -->\n    <div class=\"desceci-how-grid\">\n\n\n      <!-- STEP 01 -->\n      <div class=\"desceci-how-card\">\n\n        <div class=\"desceci-how-image\">\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/1030/0420/9521/files/Choose_Upload.png?v=1789713425\"\n            alt=\"Upload artwork to order custom DTF transfers\"\n            loading=\"lazy\"\n            width=\"600\"\n            height=\"450\">\n\n          <div class=\"desceci-how-number\">\n            01\n          </div>\n\n        </div>\n\n        <div class=\"desceci-how-content\">\n\n          <div class=\"desceci-how-label\">\n            Choose Your Order Method\n          </div>\n\n          <h3>\n            Choose & Upload\n          </h3>\n\n          <p>\n            Shop transfers by size, upload a completed gang sheet,\n            or use our online Gang Sheet Builder. Upload your artwork\n            and choose the quantity you need.\n          </p>\n\n        </div>\n\n      </div>\n\n\n      <!-- STEP 02 -->\n      <div class=\"desceci-how-card\">\n\n        <div class=\"desceci-how-image\">\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/1030/0420/9521/files/We_Print_Your_Transfers.png?v=1789713424\"\n            alt=\"Professional DTF transfer printing production process\"\n            loading=\"lazy\"\n            width=\"600\"\n            height=\"450\">\n\n          <div class=\"desceci-how-number\">\n            02\n          </div>\n\n        </div>\n\n        <div class=\"desceci-how-content\">\n\n          <div class=\"desceci-how-label\">\n            Professional Production\n          </div>\n\n          <h3>\n            We Print Your Transfers\n          </h3>\n\n          <p>\n            Your artwork is produced as a vibrant, ready-to-press\n            DTF transfer with sharp details and consistent color\n            for custom apparel production.\n          </p>\n\n        </div>\n\n      </div>\n\n\n      <!-- STEP 03 -->\n      <div class=\"desceci-how-card\">\n\n        <div class=\"desceci-how-image\">\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/1030/0420/9521/files/Heat_Press_Wear.png?v=1789713425\"\n            alt=\"Applying ready-to-press DTF transfer to a T-shirt with a heat press\"\n            loading=\"lazy\"\n            width=\"600\"\n            height=\"450\">\n\n          <div class=\"desceci-how-number\">\n            03\n          </div>\n\n        </div>\n\n        <div class=\"desceci-how-content\">\n\n          <div class=\"desceci-how-label\">\n            Ready to Apply\n          </div>\n\n          <h3>\n            Heat Press & Wear\n          </h3>\n\n          <p>\n            Position your transfer, apply it with a heat press,\n            peel according to the instructions, and finish your\n            custom T-shirt, hoodie, tote bag, or other apparel.\n          </p>\n\n        </div>\n\n      </div>\n\n\n    </div>\n\n\n    <!-- CTA -->\n    <div class=\"desceci-how-cta\">\n\n      <p>\n        Ready to start your next custom apparel project?\n      </p>\n\n      <a\n        class=\"desceci-how-button\"\n        href=\"/collections/dtf-transfer\">\n        Shop DTF Transfers →\n      </a>\n\n    </div>\n\n\n  </div>\n\n</section>",
