    "custom_liquid_Wt8gWD": {
      "type": "custom-liquid",
      "name": "DTF Heat Press Settings",
      "settings": {
        "custom_liquid": "<style>\n  .desceci-press-settings {\n    max-width: 1280px;\n    margin: 0 auto;\n    padding: 72px 24px;\n    font-family: inherit;\n  }\n\n  .desceci-press-header {\n    max-width: 760px;\n    margin: 0 auto 42px;\n    text-align: center;\n  }\n\n  .desceci-press-eyebrow {\n    margin-bottom: 10px;\n    color: #4d8f2f;\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: .1em;\n    text-transform: uppercase;\n  }\n\n  .desceci-press-header h2 {\n    margin: 0 0 14px;\n    color: #111;\n    font-size: 32px;\n    line-height: 1.25;\n    font-weight: 600;\n  }\n\n  .desceci-press-header p {\n    margin: 0;\n    color: #666;\n    font-size: 15.5px;\n    line-height: 1.7;\n  }\n\n  .desceci-settings-grid {\n    display: grid;\n    grid-template-columns: repeat(5, 1fr);\n    gap: 14px;\n    margin-bottom: 46px;\n  }\n\n  .desceci-setting-card {\n    padding: 25px 18px;\n    border: 1px solid #e3e3e3;\n    background: #fff;\n    text-align: center;\n  }\n\n  .desceci-setting-label {\n    margin-bottom: 9px;\n    color: #777;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n  }\n\n  .desceci-setting-value {\n    color: #111;\n    font-size: 21px;\n    line-height: 1.3;\n    font-weight: 600;\n  }\n\n  .desceci-setting-sub {\n    margin-top: 5px;\n    color: #777;\n    font-size: 12px;\n    line-height: 1.4;\n  }\n\n  .desceci-press-bottom {\n    display: grid;\n    grid-template-columns: 1.2fr .8fr;\n    gap: 28px;\n    align-items: stretch;\n  }\n\n  .desceci-press-steps {\n    padding: 34px;\n    background: #f6f7f6;\n  }\n\n  .desceci-press-steps h3 {\n    margin: 0 0 25px;\n    color: #111;\n    font-size: 23px;\n    line-height: 1.3;\n    font-weight: 600;\n  }\n\n  .desceci-step {\n    display: flex;\n    gap: 17px;\n    margin-bottom: 19px;\n  }\n\n  .desceci-step:last-child {\n    margin-bottom: 0;\n  }\n\n  .desceci-step-number {\n    flex: 0 0 30px;\n    width: 30px;\n    height: 30px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background: #111;\n    color: #fff;\n    font-size: 12px;\n    font-weight: 700;\n    border-radius: 50%;\n  }\n\n  .desceci-step-content strong {\n    display: block;\n    margin-bottom: 3px;\n    color: #111;\n    font-size: 15px;\n    font-weight: 600;\n  }\n\n  .desceci-step-content p {\n    margin: 0;\n    color: #666;\n    font-size: 14px;\n    line-height: 1.6;\n  }\n\n  .desceci-press-guide {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    padding: 40px;\n    background: #111;\n    color: #fff;\n  }\n\n  .desceci-press-guide h3 {\n    margin: 0 0 14px;\n    color: #fff;\n    font-size: 24px;\n    line-height: 1.35;\n    font-weight: 600;\n  }\n\n  .desceci-press-guide p {\n    margin: 0 0 26px;\n    color: #ddd;\n    font-size: 14.5px;\n    line-height: 1.7;\n  }\n\n  .desceci-press-guide a {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    align-self: flex-start;\n    min-height: 48px;\n    padding: 0 22px;\n    background: #fff;\n    border: 1px solid #fff;\n    color: #111 !important;\n    text-decoration: none !important;\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: .05em;\n    text-transform: uppercase;\n    transition: all .2s ease;\n  }\n\n  .desceci-press-guide a:hover {\n    background: transparent;\n    color: #fff !important;\n  }\n\n  .desceci-press-note {\n    margin-top: 22px;\n    color: #777;\n    font-size: 12.5px;\n    line-height: 1.6;\n    text-align: center;\n  }\n\n  @media screen and (max-width: 990px) {\n    .desceci-settings-grid {\n      grid-template-columns: repeat(3, 1fr);\n    }\n\n    .desceci-press-bottom {\n      grid-template-columns: 1fr;\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    .desceci-press-settings {\n      padding: 50px 16px;\n    }\n\n    .desceci-press-header h2 {\n      font-size: 27px;\n    }\n\n    .desceci-settings-grid {\n      grid-template-columns: repeat(2, 1fr);\n      gap: 10px;\n    }\n\n    .desceci-setting-card {\n      padding: 21px 12px;\n    }\n\n    .desceci-setting-value {\n      font-size: 18px;\n    }\n\n    .desceci-press-steps,\n    .desceci-press-guide {\n      padding: 26px 20px;\n    }\n\n    .desceci-press-guide a {\n      width: 100%;\n      box-sizing: border-box;\n    }\n  }\n</style>\n\n<section class=\"desceci-press-settings\">\n\n  <div class=\"desceci-press-header\">\n\n    <div class=\"desceci-press-eyebrow\">\n      DTF PRESSING GUIDE\n    </div>\n\n    <h2>DTF Heat Press Settings</h2>\n\n    <p>\n      Start with these recommended settings when applying DESCECI\n      DTF transfers. Heat press performance and fabric types can vary,\n      so testing is recommended before full production.\n    </p>\n\n  </div>\n\n  <div class=\"desceci-settings-grid\">\n\n    <div class=\"desceci-setting-card\">\n      <div class=\"desceci-setting-label\">Temperature</div>\n      <div class=\"desceci-setting-value\">300–320°F</div>\n      <div class=\"desceci-setting-sub\">149–160°C</div>\n    </div>\n\n    <div class=\"desceci-setting-card\">\n      <div class=\"desceci-setting-label\">Press Time</div>\n      <div class=\"desceci-setting-value\">8–10 Sec</div>\n      <div class=\"desceci-setting-sub\">Recommended starting point</div>\n    </div>\n\n    <div class=\"desceci-setting-card\">\n      <div class=\"desceci-setting-label\">Pressure</div>\n      <div class=\"desceci-setting-value\">Medium</div>\n      <div class=\"desceci-setting-sub\">Use even pressure</div>\n    </div>\n\n    <div class=\"desceci-setting-card\">\n      <div class=\"desceci-setting-label\">Peel</div>\n      <div class=\"desceci-setting-value\">Hot Peel</div>\n      <div class=\"desceci-setting-sub\">Peel as directed</div>\n    </div>\n\n    <div class=\"desceci-setting-card\">\n      <div class=\"desceci-setting-label\">Final Press</div>\n      <div class=\"desceci-setting-value\">5–10 Sec</div>\n      <div class=\"desceci-setting-sub\">For final finish</div>\n    </div>\n\n  </div>\n\n  <div class=\"desceci-press-bottom\">\n\n    <div class=\"desceci-press-steps\">\n\n      <h3>How to Press Your DTF Transfer</h3>\n\n      <div class=\"desceci-step\">\n        <div class=\"desceci-step-number\">1</div>\n        <div class=\"desceci-step-content\">\n          <strong>Preheat Your Heat Press</strong>\n          <p>\n            Set your heat press to approximately 300–320°F\n            (149–160°C).\n          </p>\n        </div>\n      </div>\n\n      <div class=\"desceci-step\">\n        <div class=\"desceci-step-number\">2</div>\n        <div class=\"desceci-step-content\">\n          <strong>Position the Transfer</strong>\n          <p>\n            Place the DTF transfer in the desired position on\n            your garment.\n          </p>\n        </div>\n      </div>\n\n      <div class=\"desceci-step\">\n        <div class=\"desceci-step-number\">3</div>\n        <div class=\"desceci-step-content\">\n          <strong>Press the Transfer</strong>\n          <p>\n            Apply medium, even pressure for approximately\n            8–10 seconds.\n          </p>\n        </div>\n      </div>\n\n      <div class=\"desceci-step\">\n        <div class=\"desceci-step-number\">4</div>\n        <div class=\"desceci-step-content\">\n          <strong>Peel the Film</strong>\n          <p>\n            Peel the carrier film according to the recommended\n            hot-peel application method.\n          </p>\n        </div>\n      </div>\n\n      <div class=\"desceci-step\">\n        <div class=\"desceci-step-number\">5</div>\n        <div class=\"desceci-step-content\">\n          <strong>Final Press</strong>\n          <p>\n            Press the design again for approximately 5–10 seconds\n            to help improve the final finish.\n          </p>\n        </div>\n      </div>\n\n    </div>\n\n    <div class=\"desceci-press-guide\">\n\n      <h3>Want Better Pressing Results?</h3>\n\n      <p>\n        Temperature, time, and pressure can affect adhesion and finish.\n        Our complete DTF pressing guide explains how to dial in your\n        heat press and troubleshoot common application problems.\n      </p>\n\n      <a href=\"/blogs/news/how-to-press-dtf-transfers\">\n        Read the DTF Press Guide →\n      </a>\n\n    </div>\n\n  </div>\n\n  <div class=\"desceci-press-note\">\n    Press settings are general starting recommendations. Fabric,\n    transfer size, and equipment can affect final results.\n    Test settings before completing a full garment or production run.\n  </div>\n\n</section>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
