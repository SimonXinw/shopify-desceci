    "image_with_text_kVm9Hh": {
      "type": "image-with-text",
      "blocks": {
        "heading_C9faiQ": {
          "type": "heading",
          "settings": {
            "heading": "What Are DTF Transfers?",
            "heading_size": "h1"
          }
        },
        "text_R9kbqM": {
          "type": "text",
          "settings": {
            "text": "<p>DTF (Direct-to-Film) transfers are a simple and versatile way to create professional-quality custom apparel.</p><p>Your artwork is printed in full color onto specialized transfer film and prepared for heat application. Once your transfer arrives, simply position it on your garment, heat press, peel, and you're done.</p><p>Unlike traditional vinyl, DTF transfers require no cutting or weeding and are ideal for detailed artwork, small text, gradients, and vibrant colors.</p>",
            "text_style": "body"
          }
        },
        "button_KVBQTr": {
          "type": "button",
          "disabled": true,
