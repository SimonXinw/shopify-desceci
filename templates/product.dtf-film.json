      "settings": {
        "custom_liquid": "<style>\n  .desceci-film-workflow-section {\n    width: 100%;\n    padding: 72px 20px;\n    background: #ffffff;\n    font-family: Helvetica, Arial, sans-serif;\n  }\n\n  .desceci-film-workflow-wrapper {\n    max-width: 1240px;\n    margin: 0 auto;\n  }\n\n  .desceci-film-workflow-heading {\n    max-width: 760px;\n    margin: 0 auto 42px;\n    text-align: center;\n  }\n\n  .desceci-film-workflow-eyebrow {\n    margin: 0 0 12px;\n    color: #5c9143;\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 1.6px;\n    text-transform: uppercase;\n  }\n\n  .desceci-film-workflow-heading h2 {\n    margin: 0 0 16px;\n    color: #15243a;\n    font-size: 36px;\n    font-weight: 700;\n    line-height: 1.2;\n  }\n\n  .desceci-film-workflow-heading p {\n    margin: 0;\n    color: #697586;\n    font-size: 16px;\n    line-height: 1.65;\n  }\n\n  .desceci-film-workflow-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 18px;\n  }\n\n  .desceci-film-workflow-card {\n    min-height: 245px;\n    padding: 30px 24px;\n    border-radius: 8px;\n  }\n\n  .desceci-film-workflow-card:nth-child(1) {\n    background: #eef6f8;\n  }\n\n  .desceci-film-workflow-card:nth-child(2) {\n    background: #f2f6eb;\n  }\n\n  .desceci-film-workflow-card:nth-child(3) {\n    background: #f8f4e9;\n  }\n\n  .desceci-film-workflow-card:nth-child(4) {\n    background: #f2eef8;\n  }\n\n  .desceci-film-workflow-card h3 {\n    margin: 0 0 16px;\n    color: #15243a;\n    font-size: 21px;\n    font-weight: 700;\n    line-height: 1.3;\n  }\n\n  .desceci-film-workflow-card p {\n    margin: 0;\n    color: #697586;\n    font-size: 15px;\n    line-height: 1.7;\n  }\n\n  .desceci-film-workflow-label {\n    display: inline-block;\n    margin-top: 26px;\n    padding: 7px 12px;\n    border-radius: 3px;\n    background: rgba(255, 255, 255, .72);\n    color: #5c9143;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: .6px;\n    text-transform: uppercase;\n  }\n\n  @media screen and (max-width: 989px) {\n    .desceci-film-workflow-grid {\n      grid-template-columns: repeat(2, 1fr);\n    }\n  }\n\n  @media screen and (max-width: 600px) {\n    .desceci-film-workflow-section {\n      padding: 52px 16px;\n    }\n\n    .desceci-film-workflow-heading h2 {\n      font-size: 29px;\n    }\n\n    .desceci-film-workflow-heading p {\n      font-size: 15px;\n    }\n\n    .desceci-film-workflow-grid {\n      grid-template-columns: 1fr;\n      gap: 14px;\n    }\n\n    .desceci-film-workflow-card {\n      min-height: auto;\n      padding: 27px 22px;\n    }\n  }\n</style>\n\n<section class=\"desceci-film-workflow-section\">\n  <div class=\"desceci-film-workflow-wrapper\">\n\n    <div class=\"desceci-film-workflow-heading\">\n      <p class=\"desceci-film-workflow-eyebrow\">\n        HOW IT WORKS\n      </p>\n\n      <h2>\n        How to Use DTF Transfer Film\n      </h2>\n\n      <p>\n        Follow these four basic steps to create clean, vibrant, and durable DTF transfers.\n      </p>\n    </div>\n\n    <div class=\"desceci-film-workflow-grid\">\n\n      <div class=\"desceci-film-workflow-card\">\n        <h3>Print Your Design</h3>\n\n        <p>\n          Print your artwork on the coated side of the DTF film. Make sure the film is positioned correctly before printing.\n        </p>\n\n        <span class=\"desceci-film-workflow-label\">\n          Print\n        </span>\n      </div>\n\n      <div class=\"desceci-film-workflow-card\">\n        <h3>Apply DTF Powder</h3>\n\n        <p>\n          Apply hot melt powder evenly over the printed areas while the ink is still wet.\n        </p>\n\n        <span class=\"desceci-film-workflow-label\">\n          Powder\n        </span>\n      </div>\n\n      <div class=\"desceci-film-workflow-card\">\n        <h3>Cure the Powder</h3>\n\n        <p>\n          Melt the powder evenly using your curing oven, shaker, or recommended curing method.\n        </p>\n\n        <span class=\"desceci-film-workflow-label\">\n          Cure\n        </span>\n      </div>\n\n      <div class=\"desceci-film-workflow-card\">\n        <h3>Heat Press the Transfer</h3>\n\n        <p>\n          Press the finished transfer onto the garment using the recommended temperature, time, and pressure.\n        </p>\n\n        <span class=\"desceci-film-workflow-label\">\n          Press\n        </span>\n      </div>\n\n    </div>\n  </div>\n</section>",
