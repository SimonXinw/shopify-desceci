ight: 1.5;\n  }\n\n  .desceci-powder-specs__label {\n    background: #edf3f6;\n    color: #15243a;\n    font-weight: 700;\n  }\n\n  .desceci-powder-specs__value {\n    color: #697586;\n  }\n\n  .desceci-powder-specs__note {\n    margin: 20px 0 0;\n    color: #697586;\n    font-size: 13px;\n    line-height: 1.6;\n    text-align: center;\n  }\n\n  @media screen and (max-width: 650px) {\n    .desceci-powder-specs {\n      padding: 55px 16px;\n    }\n\n    .desceci-powder-specs__heading h2 {\n      font-size: 29px;\n    }\n\n    .desceci-powder-specs__heading p {\n      font-size: 15px;\n    }\n\n    .desceci-powder-specs__highlight {\n      grid-template-columns: 1fr;\n      gap: 10px;\n    }\n\n    .desceci-powder-specs__row {\n      grid-template-columns: 1fr;\n    }\n\n    .desceci-powder-specs__label {\n      padding-bottom: 7px;\n      font-size: 14px;\n    }\n\n    .desceci-powder-specs__value {\n      padding-top: 7px;\n      padding-bottom: 17px;\n      font-size: 14px;\n    }\n  }\n</style>\n\n<section class=\"desceci-powder-specs\">\n  <div class=\"desceci-powder-specs__wrapper\">\n\n    <div class=\"desceci-powder-specs__heading\">\n      <p class=\"desceci-powder-specs__eyebrow\">\n        PRODUCT DETAILS\n      </p>\n\n      <h2>\n        DTF Powder Specifications\n      </h2>\n\n      <p>\n        A reliable hot melt adhesive powder for everyday DTF printing and transfer production.\n      </p>\n    </div>\n\n    <div class=\"desceci-powder-specs__highlight\">\n\n      <div class=\"desceci-powder-specs__highlight-item\">\n        <strong>1 kg</strong>\n        <span>Package Size</span>\n      </div>\n\n      <div class=\"desceci-powder-specs__highlight-item\">\n        <strong>Hot Melt</strong>\n        <span>Adhesive Type</span>\n      </div>\n\n      <div class=\"desceci-powder-specs__highlight-item\">\n        <strong>Fine</strong>\n        <span>Powder Texture</span>\n      </div>\n\n    </div>\n\n    <div class=\"desceci-powder-specs__table\">\n\n      <div class=\"desceci-powder-specs__row\">\n        <div class=\"desceci-powder-specs__label\">\n          Product Type\n        </div>\n\n        <div class=\"desceci-powder-specs__value\">\n          DTF Hot Melt Adhesive Powder\n        </div>\n      </div>\n\n      <div class=\"desceci-powder-specs__row\">\n        <div class=\"desceci-powder-specs__label\">\n          Package Weight\n        </div>\n\n        <div class=\"desceci-powder-specs__value\">\n          1 kg / 1000 g\n        </div>\n      </div>\n\n      <div class=\"desceci-powder-specs__row\">\n        <div class=\"desceci-powder-specs__label\">\n          Application\n        </div>\n\n        <div class=\"desceci-powder-specs__value\">\n          Direct-to-Film transfer printing\n        </div>\n      </div>\n\n      <div class=\"desceci-powder-specs__row\">\n        <div class=\"desceci-powder-specs__label\">\n          Recommended Materials\n        </div>\n\n        <div class=\"desceci-powder-specs__value\">\n          Cotton, polyester, and fabric blends\n        </div>\n      </div>\n\n      <div class=\"desceci-powder-specs__row\">\n        <div class=\"desceci-powder-specs__label\">\n          Production Workflow\n        </div>\n\n        <div class=\"desceci-powder-specs__value\">\n          Print → Apply Powder → Cure → Heat Press\n        </div>\n      </div>\n\n    </div>\n\n    <p class=\"desceci-powder-specs__note\">\n      Product settings may vary depending on your film, ink, curing equipment, and garment material.\n    </p>\n\n  </div>\n</section>",
