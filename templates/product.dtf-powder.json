;\n    }\n\n    .desceci-powder-audience__arrow {\n      grid-column: 2 / 3;\n      grid-row: 1 / 3;\n    }\n  }\n</style>\n\n<section class=\"desceci-powder-audience\">\n  <div class=\"desceci-powder-audience__wrapper\">\n\n    <div class=\"desceci-powder-audience__heading\">\n      <p class=\"desceci-powder-audience__eyebrow\">\n        MADE FOR YOUR WORKFLOW\n      </p>\n\n      <h2>\n        Who Is This DTF Powder For?\n      </h2>\n\n      <p>\n        From first-time users to daily production teams, DESCECI DTF Powder supports a range of printing workflows.\n      </p>\n    </div>\n\n    <div class=\"desceci-powder-audience__list\">\n\n      <div class=\"desceci-powder-audience__item\">\n        <h3>DTF Beginners</h3>\n\n        <p>\n          A practical choice for creators learning how powder, curing, and heat pressing work together.\n        </p>\n\n        <span class=\"desceci-powder-audience__arrow\">→</span>\n      </div>\n\n      <div class=\"desceci-powder-audience__item\">\n        <h3>Custom Apparel Businesses</h3>\n\n        <p>\n          Helps support repeat orders for shirts, hoodies, uniforms, and branded merchandise.\n        </p>\n\n        <span class=\"desceci-powder-audience__arrow\">→</span>\n      </div>\n\n      <div class=\"desceci-powder-audience__item\">\n        <h3>Print Shops & Production Teams</h3>\n\n        <p>\n          Designed for customers who need reliable powder coverage and consistent production results.\n        </p>\n\n        <span class=\"desceci-powder-audience__arrow\">→</span>\n      </div>\n\n    </div>\n  </div>\n</section>",
