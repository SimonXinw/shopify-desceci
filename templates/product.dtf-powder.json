x 18px;\n    }\n\n    .desceci-powder-process__heading h2 {\n      font-size: 29px;\n    }\n\n    .desceci-powder-process__heading p {\n      font-size: 15px;\n    }\n\n    .desceci-powder-process__line {\n      display: block;\n      padding: 10px 0;\n    }\n\n    .desceci-powder-process__step {\n      padding: 20px 8px;\n    }\n\n    .desceci-powder-process__arrow {\n      transform: rotate(90deg);\n    }\n  }\n</style>\n\n<section class=\"desceci-powder-process\">\n  <div class=\"desceci-powder-process__wrapper\">\n\n    <div class=\"desceci-powder-process__heading\">\n      <p class=\"desceci-powder-process__eyebrow\">\n        HOW DTF POWDER WORKS\n      </p>\n\n      <h2>\n        From Printed Film to Finished Transfer\n      </h2>\n\n      <p>\n        DTF powder creates the adhesive layer that connects your printed design to the garment during heat pressing.\n      </p>\n    </div>\n\n    <div class=\"desceci-powder-process__line\">\n\n      <div class=\"desceci-powder-process__step\">\n        <strong>Print</strong>\n        <span>Print your artwork onto DTF film.</span>\n      </div>\n\n      <div class=\"desceci-powder-process__arrow\">→</div>\n\n      <div class=\"desceci-powder-process__step\">\n        <strong>Apply Powder</strong>\n        <span>Cover the wet ink evenly with hot melt powder.</span>\n      </div>\n\n      <div class=\"desceci-powder-process__arrow\">→</div>\n\n      <div class=\"desceci-powder-process__step\">\n        <strong>Cure</strong>\n        <span>Melt the powder to create the adhesive layer.</span>\n      </div>\n\n      <div class=\"desceci-powder-process__arrow\">→</div>\n\n      <div class=\"desceci-powder-process__step\">\n        <strong>Heat Press</strong>\n        <span>Transfer the finished design onto the garment.</span>\n      </div>\n\n    </div>\n\n    <div class=\"desceci-powder-process__note\">\n      Even powder coverage and proper curing are important for strong adhesion and consistent transfer quality.\n    </div>\n\n  </div>\n</section>",
