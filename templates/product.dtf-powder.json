      "settings": {
        "custom_liquid": "<style>\n  .desceci-powder-tips {\n    width: 100%;\n    padding: 74px 20px;\n    background: #f7f9fc;\n    font-family: Helvetica, Arial, sans-serif;\n  }\n\n  .desceci-powder-tips__wrapper {\n    max-width: 1120px;\n    margin: 0 auto;\n  }\n\n  .desceci-powder-tips__heading {\n    max-width: 760px;\n    margin: 0 auto 40px;\n    text-align: center;\n  }\n\n  .desceci-powder-tips__eyebrow {\n    margin: 0 0 12px;\n    color: #5c9143;\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 1.6px;\n    text-transform: uppercase;\n  }\n\n  .desceci-powder-tips__heading h2 {\n    margin: 0 0 15px;\n    color: #15243a;\n    font-size: 36px;\n    font-weight: 700;\n    line-height: 1.2;\n  }\n\n  .desceci-powder-tips__heading p {\n    margin: 0;\n    color: #697586;\n    font-size: 16px;\n    line-height: 1.65;\n  }\n\n  .desceci-powder-tips__content {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 55px;\n    padding: 35px 40px;\n    border-left: 4px solid #5c9143;\n    background: #ffffff;\n  }\n\n  .desceci-powder-tips__column {\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n\n  .desceci-powder-tips__item {\n    position: relative;\n    margin-bottom: 22px;\n    padding-left: 29px;\n    color: #596777;\n    font-size: 15px;\n    line-height: 1.65;\n  }\n\n  .desceci-powder-tips__item:last-child {\n    margin-bottom: 0;\n  }\n\n  .desceci-powder-tips__item::before {\n    content: \"✓\";\n    position: absolute;\n    top: 0;\n    left: 0;\n    color: #5c9143;\n    font-size: 19px;\n    font-weight: 700;\n  }\n\n  .desceci-powder-tips__item strong {\n    display: block;\n    margin-bottom: 4px;\n    color: #15243a;\n    font-size: 16px;\n    font-weight: 700;\n  }\n\n  @media screen and (max-width: 700px) {\n    .desceci-powder-tips {\n      padding: 55px 18px;\n    }\n\n    .desceci-powder-tips__heading h2 {\n      font-size: 29px;\n    }\n\n    .desceci-powder-tips__heading p {\n      font-size: 15px;\n    }\n\n    .desceci-powder-tips__content {\n      display: block;\n      padding: 27px 22px;\n    }\n\n    .desceci-powder-tips__column + .desceci-powder-tips__column {\n      margin-top: 22px;\n    }\n  }\n</style>\n\n<section class=\"desceci-powder-tips\">\n  <div class=\"desceci-powder-tips__wrapper\">\n\n    <div class=\"desceci-powder-tips__heading\">\n      <p class=\"desceci-powder-tips__eyebrow\">\n        PRODUCTION TIPS\n      </p>\n\n      <h2>\n        Get Better Results with Proper Powder Application\n      </h2>\n\n      <p>\n        Small adjustments in powder coverage, curing, and storage can improve the consistency of your DTF transfers.\n      </p>\n    </div>\n\n    <div class=\"desceci-powder-tips__content\">\n\n      <ul class=\"desceci-powder-tips__column\">\n\n        <li class=\"desceci-powder-tips__item\">\n          <strong>Apply an Even Layer</strong>\n          Spread the powder evenly over all printed areas while the ink is still wet.\n        </li>\n\n        <li class=\"desceci-powder-tips__item\">\n          <strong>Remove Excess Powder</strong>\n          Shake off or reclaim extra powder to help keep the film clean.\n        </li>\n\n        <li class=\"desceci-powder-tips__item\">\n          <strong>Check Powder Coverage</strong>\n          Make sure all printed sections are covered before curing.\n        </li>\n\n      </ul>\n\n      <ul class=\"desceci-powder-tips__column\">\n\n        <li class=\"desceci-powder-tips__item\">\n          <strong>Cure Consistently</strong>\n          Melt the powder evenly according to your equipment and workflow.\n        </li>\n\n        <li class=\"desceci-powder-tips__item\">\n          <strong>Store in a Dry Place</strong>\n          Keep the powder sealed and protected from moisture between uses.\n        </li>\n\n        <li class=\"desceci-powder-tips__item\">\n          <strong>Test Before Production</strong>\n          Test your settings on the chosen film and garment before large runs.\n        </li>\n\n      </ul>\n\n    </div>\n  </div>\n</section>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
