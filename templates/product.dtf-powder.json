    "custom_liquid_caLUHa": {
      "type": "custom-liquid",
      "name": "How DTF Powder Works",
      "settings": {
        "custom_liquid": "<style>\n  .desceci-powder-process {\n    width: 100%;\n    padding: 76px 20px;\n    background: #ffffff;\n    font-family: Helvetica, Arial, sans-serif;\n  }\n\n  .desceci-powder-process__wrapper {\n    max-width: 1180px;\n    margin: 0 auto;\n  }\n\n  .desceci-powder-process__heading {\n    max-width: 760px;\n    margin: 0 auto 45px;\n    text-align: center;\n  }\n\n  .desceci-powder-process__eyebrow {\n    margin: 0 0 12px;\n    color: #5c9143;\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 1.6px;\n    text-transform: uppercase;\n  }\n\n  .desceci-powder-process__heading h2 {\n    margin: 0 0 15px;\n    color: #15243a;\n    font-size: 36px;\n    font-weight: 700;\n    line-height: 1.2;\n  }\n\n  .desceci-powder-process__heading p {\n    margin: 0;\n    color: #697586;\n    font-size: 16px;\n    line-height: 1.65;\n  }\n\n  .desceci-powder-process__line {\n    display: grid;\n    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;\n    align-items: center;\n    gap: 16px;\n    padding: 30px 0;\n    border-top: 1px solid #dfe6eb;\n    border-bottom: 1px solid #dfe6eb;\n  }\n\n  .desceci-powder-process__step {\n    text-align: center;\n  }\n\n  .desceci-powder-process__step strong {\n    display: block;\n    margin-bottom: 10px;\n    color: #15243a;\n    font-size: 19px;\n    font-weight: 700;\n  }\n\n  .desceci-powder-process__step span {\n    display: block;\n    color: #697586;\n    font-size: 14px;\n    line-height: 1.5;\n  }\n\n  .desceci-powder-process__arrow {\n    color: #5c9143;\n    font-size: 27px;\n    font-weight: 700;\n    text-align: center;\n  }\n\n  .desceci-powder-process__note {\n    max-width: 850px;\n    margin: 30px auto 0;\n    padding: 18px 22px;\n    border-left: 3px solid #5c9143;\n    background: #f7f9fc;\n    color: #687586;\n    font-size: 14px;\n    line-height: 1.7;\n    text-align: center;\n  }\n\n  @media screen and (max-width: 800px) {\n    .desceci-powder-process {\n      padding: 56px 18px;\n    }\n\n    .desceci-powder-process__heading h2 {\n      font-size: 29px;\n    }\n\n    .desceci-powder-process__heading p {\n      font-size: 15px;\n    }\n\n    .desceci-powder-process__line {\n      display: block;\n      padding: 10px 0;\n    }\n\n    .desceci-powder-process__step {\n      padding: 20px 8px;\n    }\n\n    .desceci-powder-process__arrow {\n      transform: rotate(90deg);\n    }\n  }\n</style>\n\n<section class=\"desceci-powder-process\">\n  <div class=\"desceci-powder-process__wrapper\">\n\n    <div class=\"desceci-powder-process__heading\">\n      <p class=\"desceci-powder-process__eyebrow\">\n        HOW DTF POWDER WORKS\n      </p>\n\n      <h2>\n        From Printed Film to Finished Transfer\n      </h2>\n\n      <p>\n        DTF powder creates the adhesive layer that connects your printed design to the garment during heat pressing.\n      </p>\n    </div>\n\n    <div class=\"desceci-powder-process__line\">\n\n      <div class=\"desceci-powder-process__step\">\n        <strong>Print</strong>\n        <span>Print your artwork onto DTF film.</span>\n      </div>\n\n      <div class=\"desceci-powder-process__arrow\">→</div>\n\n      <div class=\"desceci-powder-process__step\">\n        <strong>Apply Powder</strong>\n        <span>Cover the wet ink evenly with hot melt powder.</span>\n      </div>\n\n      <div class=\"desceci-powder-process__arrow\">→</div>\n\n      <div class=\"desceci-powder-process__step\">\n        <strong>Cure</strong>\n        <span>Melt the powder to create the adhesive layer.</span>\n      </div>\n\n      <div class=\"desceci-powder-process__arrow\">→</div>\n\n      <div class=\"desceci-powder-process__step\">\n        <strong>Heat Press</strong>\n        <span>Transfer the finished design onto the garment.</span>\n      </div>\n\n    </div>\n\n    <div class=\"desceci-powder-process__note\">\n      Even powder coverage and proper curing are important for strong adhesion and consistent transfer quality.\n    </div>\n\n  </div>\n</section>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
