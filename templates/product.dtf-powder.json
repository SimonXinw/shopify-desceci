    "custom_liquid_9HbVRr": {
      "type": "custom-liquid",
      "name": "Final Call to Action",
      "settings": {
        "custom_liquid": "<style>\n  .desceci-powder-final-cta {\n    width: 100%;\n    padding: 72px 20px 82px;\n    background: #f7f9fc;\n    font-family: Helvetica, Arial, sans-serif;\n  }\n\n  .desceci-powder-final-cta__box {\n    max-width: 1080px;\n    margin: 0 auto;\n    padding: 48px 35px;\n    border: 1px solid #dfe7df;\n    border-radius: 8px;\n    background: #ffffff;\n    text-align: center;\n  }\n\n  .desceci-powder-final-cta__eyebrow {\n    margin: 0 0 13px;\n    color: #5c9143;\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 1.6px;\n    text-transform: uppercase;\n  }\n\n  .desceci-powder-final-cta h2 {\n    margin: 0 0 15px;\n    color: #15243a;\n    font-size: 35px;\n    font-weight: 700;\n    line-height: 1.2;\n  }\n\n  .desceci-powder-final-cta p {\n    max-width: 680px;\n    margin: 0 auto;\n    color: #697586;\n    font-size: 16px;\n    line-height: 1.7;\n  }\n\n  .desceci-powder-final-cta__buttons {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: center;\n    gap: 13px;\n    margin-top: 28px;\n  }\n\n  .desceci-powder-final-cta__button {\n    min-height: 48px;\n    padding: 0 25px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    border-radius: 4px;\n    font-size: 14px;\n    font-weight: 700;\n    text-decoration: none;\n    cursor: pointer;\n    transition: all .2s ease;\n  }\n\n  .desceci-powder-final-cta__button--primary {\n    border: 1px solid #5c9143;\n    background: #5c9143;\n    color: #ffffff;\n  }\n\n  .desceci-powder-final-cta__button--primary:hover {\n    border-color: #15243a;\n    background: #15243a;\n    color: #ffffff;\n  }\n\n  .desceci-powder-final-cta__button--secondary {\n    border: 1px solid #15243a;\n    background: transparent;\n    color: #15243a;\n  }\n\n  .desceci-powder-final-cta__button--secondary:hover {\n    background: #15243a;\n    color: #ffffff;\n  }\n\n  .desceci-powder-final-cta__message {\n    display: none;\n    margin-top: 16px;\n    color: #5c9143;\n    font-size: 14px;\n    font-weight: 600;\n  }\n\n  @media screen and (max-width: 600px) {\n    .desceci-powder-final-cta {\n      padding: 55px 16px 65px;\n    }\n\n    .desceci-powder-final-cta__box {\n      padding: 38px 20px;\n    }\n\n    .desceci-powder-final-cta h2 {\n      font-size: 29px;\n    }\n\n    .desceci-powder-final-cta p {\n      font-size: 15px;\n    }\n\n    .desceci-powder-final-cta__buttons {\n      display: grid;\n    }\n\n    .desceci-powder-final-cta__button {\n      width: 100%;\n    }\n  }\n</style>\n\n<section class=\"desceci-powder-final-cta\">\n  <div class=\"desceci-powder-final-cta__box\">\n\n    <p class=\"desceci-powder-final-cta__eyebrow\">\n      READY TO PRINT?\n    </p>\n\n    <h2>\n      Choose Reliable DTF Powder for Your Next Production Run\n    </h2>\n\n    <p>\n      Create strong, vibrant, and durable DTF transfers with DESCECI Hot Melt Powder.\n    </p>\n\n    <div class=\"desceci-powder-final-cta__buttons\">\n\n      <button\n        type=\"button\"\n        id=\"desceci-powder-add-to-cart\"\n        class=\"desceci-powder-final-cta__button desceci-powder-final-cta__button--primary\">\n        Add DTF Powder to Cart\n      </button>\n\n      <a\n        href=\"/collections/dtf-consumables\"\n        class=\"desceci-powder-final-cta__button desceci-powder-final-cta__button--secondary\">\n        Shop DTF Consumables\n      </a>\n\n    </div>\n\n    <div\n      id=\"desceci-powder-cart-message\"\n      class=\"desceci-powder-final-cta__message\">\n      Added to cart successfully.\n    </div>\n\n  </div>\n</section>\n\n<script>\n  document.addEventListener('DOMContentLoaded', function () {\n    var addButton = document.getElementById('desceci-powder-add-to-cart');\n    var message = document.getElementById('desceci-powder-cart-message');\n\n    if (!addButton) return;\n\n    addButton.addEventListener('click', function () {\n      var productForm = document.querySelector(\n        'product-form form[action*=\"/cart/add\"], ' +\n        'form.product-form[action*=\"/cart/add\"], ' +\n        'form[action*=\"/cart/add\"]'\n      );\n\n      if (!productForm) {\n        window.location.href = '/products/dtf-powder';\n        return;\n      }\n\n      addButton.disabled = true;\n      addButton.textContent = 'Adding...';\n\n      if (typeof productForm.requestSubmit === 'function') {\n        productForm.requestSubmit();\n      } else {\n        var submitButton = productForm.querySelector(\n          'button[type=\"submit\"], input[type=\"submit\"]'\n        );\n\n        if (submitButton) {\n          submitButton.click();\n        } else {\n          productForm.submit();\n        }\n      }\n\n      setTimeout(function () {\n        addButton.disabled = false;\n        addButton.textContent = 'Add DTF Powder to Cart';\n\n        if (message) {\n          message.style.display = 'block';\n\n          setTimeout(function () {\n            message.style.display = 'none';\n          }, 3000);\n        }\n      }, 800);\n    });\n  });\n</script>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
