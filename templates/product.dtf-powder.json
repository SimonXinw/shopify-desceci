    "custom_liquid_zXhJRY": {
      "type": "custom-liquid",
      "name": "DTF Powder FAQ",
      "settings": {
        "custom_liquid": "<style>\n  .desceci-powder-faq {\n    width: 100%;\n    padding: 76px 20px;\n    background: #15243a;\n    font-family: Helvetica, Arial, sans-serif;\n  }\n\n  .desceci-powder-faq__wrapper {\n    max-width: 900px;\n    margin: 0 auto;\n  }\n\n  .desceci-powder-faq__heading {\n    margin: 0 auto 38px;\n    text-align: center;\n  }\n\n  .desceci-powder-faq__eyebrow {\n    margin: 0 0 12px;\n    color: #a7d58d;\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 1.6px;\n    text-transform: uppercase;\n  }\n\n  .desceci-powder-faq__heading h2 {\n    margin: 0 0 15px;\n    color: #ffffff;\n    font-size: 36px;\n    font-weight: 700;\n    line-height: 1.2;\n  }\n\n  .desceci-powder-faq__heading p {\n    margin: 0;\n    color: #dce5ed;\n    font-size: 16px;\n    line-height: 1.65;\n  }\n\n  .desceci-powder-faq__list {\n    border-top: 1px solid rgba(255, 255, 255, .25);\n  }\n\n  .desceci-powder-faq__item {\n    border-bottom: 1px solid rgba(255, 255, 255, .25);\n  }\n\n  .desceci-powder-faq__item summary {\n    position: relative;\n    padding: 21px 40px 21px 0;\n    cursor: pointer;\n    color: #ffffff;\n    font-size: 16px;\n    font-weight: 700;\n    line-height: 1.5;\n    list-style: none;\n  }\n\n  .desceci-powder-faq__item summary::-webkit-details-marker {\n    display: none;\n  }\n\n  .desceci-powder-faq__item summary::after {\n    content: \"+\";\n    position: absolute;\n    top: 15px;\n    right: 0;\n    color: #a7d58d;\n    font-size: 26px;\n    font-weight: 400;\n  }\n\n  .desceci-powder-faq__item[open] summary::after {\n    content: \"−\";\n  }\n\n  .desceci-powder-faq__item p {\n    margin: 0;\n    padding: 0 35px 22px 0;\n    color: #dce5ed;\n    font-size: 14px;\n    line-height: 1.7;\n  }\n\n  @media screen and (max-width: 600px) {\n    .desceci-powder-faq {\n      padding: 55px 18px;\n    }\n\n    .desceci-powder-faq__heading h2 {\n      font-size: 29px;\n    }\n\n    .desceci-powder-faq__heading p {\n      font-size: 15px;\n    }\n\n    .desceci-powder-faq__item summary {\n      font-size: 15px;\n    }\n  }\n</style>\n\n<section class=\"desceci-powder-faq\">\n  <div class=\"desceci-powder-faq__wrapper\">\n\n    <div class=\"desceci-powder-faq__heading\">\n      <p class=\"desceci-powder-faq__eyebrow\">\n        DTF POWDER FAQ\n      </p>\n\n      <h2>\n        Common Questions About DTF Powder\n      </h2>\n\n      <p>\n        Learn more about application, curing, storage, and compatibility.\n      </p>\n    </div>\n\n    <div class=\"desceci-powder-faq__list\">\n\n      <details class=\"desceci-powder-faq__item\">\n        <summary>\n          What is DTF powder used for?\n        </summary>\n\n        <p>\n          DTF powder acts as the adhesive layer between the printed design and the garment during the heat pressing process.\n        </p>\n      </details>\n\n      <details class=\"desceci-powder-faq__item\">\n        <summary>\n          How should I apply DTF powder?\n        </summary>\n\n        <p>\n          Apply the powder evenly over the printed areas while the ink is still wet, then remove excess powder before curing.\n        </p>\n      </details>\n\n      <details class=\"desceci-powder-faq__item\">\n        <summary>\n          What size package is available?\n        </summary>\n\n        <p>\n          This product is supplied in a 1 kg / 1000 g package.\n        </p>\n      </details>\n\n      <details class=\"desceci-powder-faq__item\">\n        <summary>\n          Can DTF powder be used on cotton and polyester?\n        </summary>\n\n        <p>\n          Yes. DTF powder is commonly used for transfers applied to cotton, polyester, and fabric blends.\n        </p>\n      </details>\n\n      <details class=\"desceci-powder-faq__item\">\n        <summary>\n          How should DTF powder be stored?\n        </summary>\n\n        <p>\n          Keep the powder sealed and store it in a cool, dry place away from moisture.\n        </p>\n      </details>\n\n      <details class=\"desceci-powder-faq__item\">\n        <summary>\n          Does curing temperature vary by equipment?\n        </summary>\n\n        <p>\n          Yes. Curing settings can vary depending on your powder, film, equipment, and production workflow. Test your settings before large production runs.\n        </p>\n      </details>\n\n    </div>\n  </div>\n</section>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
    },
