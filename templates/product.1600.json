      "settings": {
        "custom_liquid": "<style>\n  .desceci-i1600-page {\n    font-family: Helvetica, Arial, sans-serif;\n    color: #15243a;\n  }\n\n  .desceci-i1600-page * {\n    box-sizing: border-box;\n  }\n\n  .desceci-i1600-section {\n    width: 100%;\n    padding: 76px 20px;\n  }\n\n  .desceci-i1600-white {\n    background: #ffffff;\n  }\n\n  .desceci-i1600-gray {\n    background: #f7f9fc;\n  }\n\n  .desceci-i1600-navy {\n    background: #15243a;\n  }\n\n  .desceci-i1600-container {\n    max-width: 1120px;\n    margin: 0 auto;\n  }\n\n  .desceci-i1600-heading {\n    max-width: 800px;\n    margin: 0 auto 42px;\n    text-align: center;\n  }\n\n  .desceci-i1600-eyebrow {\n    margin: 0 0 13px;\n    color: #5c9143;\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 1.8px;\n    text-transform: uppercase;\n  }\n\n  .desceci-i1600-heading h2 {\n    margin: 0 0 16px;\n    color: #15243a;\n    font-size: 36px;\n    line-height: 1.2;\n  }\n\n  .desceci-i1600-heading p {\n    margin: 0;\n    color: #697586;\n    font-size: 16px;\n    line-height: 1.7;\n  }\n\n  /* Core Benefits */\n  .desceci-i1600-benefits {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 16px;\n  }\n\n  .desceci-i1600-benefit {\n    min-height: 190px;\n    padding: 27px 22px;\n    border: 1px solid #e1e7ed;\n    border-radius: 6px;\n    background: #f7f9fc;\n  }\n\n  .desceci-i1600-benefit strong {\n    display: block;\n    margin-bottom: 18px;\n    color: #5c9143;\n    font-size: 27px;\n  }\n\n  .desceci-i1600-benefit h3 {\n    margin: 0 0 10px;\n    color: #15243a;\n    font-size: 17px;\n    line-height: 1.35;\n  }\n\n  .desceci-i1600-benefit p {\n    margin: 0;\n    color: #697586;\n    font-size: 14px;\n    line-height: 1.65;\n  }\n\n  .desceci-i1600-note {\n    max-width: 900px;\n    margin: 30px auto 0;\n    padding: 18px 22px;\n    border-left: 4px solid #5c9143;\n    background: #f7f9fc;\n    color: #697586;\n    font-size: 14px;\n    line-height: 1.7;\n  }\n\n  .des