  gap: 22px;\n    margin-top: 26px;\n    padding: 24px;\n    border-radius: 6px;\n    background: #ffffff;\n  }\n\n  .desceci-xp600-contact h3 {\n    margin: 0 0 7px;\n    color: #15243a;\n    font-size: 19px;\n  }\n\n  .desceci-xp600-contact p {\n    margin: 0;\n    color: #697586;\n    font-size: 14px;\n    line-height: 1.6;\n  }\n\n  .desceci-xp600-button {\n    display: inline-flex;\n    min-height: 46px;\n    align-items: center;\n    justify-content: center;\n    padding: 0 22px;\n    border-radius: 4px;\n    background: #5c9143;\n    color: #ffffff;\n    font-size: 14px;\n    font-weight: 700;\n    text-decoration: none;\n    white-space: nowrap;\n  }\n\n  .desceci-xp600-button:hover {\n    background: #15243a;\n    color: #ffffff;\n  }\n\n  /* Comparison */\n  .desceci-xp600-comparison {\n    overflow-x: auto;\n    border: 1px solid #dce4eb;\n    border-radius: 8px;\n    background: #ffffff;\n  }\n\n  .desceci-xp600-comparison table {\n    width: 100%;\n    min-width: 780px;\n    border-collapse: collapse;\n  }\n\n  .desceci-xp600-comparison th,\n  .desceci-xp600-comparison td {\n    padding: 18px;\n    border-bottom: 1px solid #e4e9ee;\n    text-align: center;\n    font-size: 14px;\n    line-height: 1.55;\n  }\n\n  .desceci-xp600-comparison thead th {\n    background: #15243a;\n    color: #ffffff;\n    font-size: 16px;\n  }\n\n  .desceci-xp600-comparison thead th:first-child,\n  .desceci-xp600-comparison tbody th {\n    background: #eef3f7;\n    color: #15243a;\n    text-align: left;\n    font-weight: 700;\n  }\n\n  .desceci-xp600-comparison tbody td {\n    color: #697586;\n  }\n\n  .desceci-xp600-badge {\n    display: block;\n    width: max-content;\n    margin: 8px auto 0;\n    padding: 4px 8px;\n    border-radius: 3px;\n    background: #e8f1e3;\n    color: #5c9143;\n    font-size: 10px;\n    text-transform: uppercase;\n  }\n\n  /* Maintenance */\n  .desceci-xp600-maintenance {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 18px;\n  }\n\n  .desceci-xp600-maintenance-item {\n    display: grid;\n    grid-template-columns: 45px 1fr;\n    gap: 16px;\n    padding: 24px;\n    border: 1px solid #e0e6ec;\n    border-radius: 6px;\n    background: #ffffff;\n  }\n\n  .desceci-xp600-maintenance-number {\n    display: flex;\n    width: 40px;\n    height: 40px;\n    align-items: center;\n    justify-content: center;\n    border-radius: 50%;\n    background: #e8f1e3;\n    color: #5c9143;\n    font-size: 13px;\n    font-weight: 700;\n  }\n\n  .desceci-xp600-maintenance-item h3 {\n    margin: 0 0 8px;\n    color: #15243a;\n    font-size: 17px;\n  }\n\n  .desceci-xp600-maintenance-item p {\n    margin: 0;\n    color: #697586;\n    font-size: 14px;\n    line-height: 1.7;\n  }\n\n  /* FAQ */\n  .desceci-xp600-faq {\n    max-width: 920px;\n    margin: 0 auto;\n  }\n\n  .desceci-xp600-faq details {\n    border-top: 1px solid #dfe5ec;\n  }\n\n  .desceci-xp600-faq details:last-child {\n    border-bottom: 1px solid #dfe5ec;\n  }\n\n  .desceci-xp600-faq summary {\n    position: relative;\n    padding: 21px 38px 21px 0;\n    list-style: none;\n    cursor: pointer;\n    color: #15243a;\n    font-size: 16px;\n    font-weight: 700;\n  }\n\n  .desceci-xp600-faq summary::-webkit-details-marker {\n    display: none;\n  }\n\n  .desceci-xp600-faq summary::after {\n    content: \"+\";\n    position: absolute;\n    right: 3px;\n    color: #5c9143;\n    font-size: 24px;\n  }\n\n  .desceci-xp600-faq details[open] summary::after {\n    content: \"−\";\n  }\n\n  .desceci-xp600-faq details p {\n    margin: -3px 0 21px;\n    color: #697586;\n    font-size: 14px;\n    line-height: 1.75;\n  }\n\n  /* CTA */\n  .desceci-xp600-cta {\n    max-width: 1080px;\n    margin: 0 auto;\n    padding: 52px 35px;\n    border-radius: 8px;\n    background: #eef4f8;\n    text-align: center;\n  }\n\n  .desceci-xp600-cta h2 {\n    margin: 0 0 16px;\n    color: #15243a;\n    font-size: 36px;\n    line-height: 1.2;\n  }\n\n  .desceci-xp600-cta p {\n    max-width: 720px;\n    margin: 0 auto;\n    color: #697586;\n    font-size: 16px;\n    line-height: 1.7;\n  }\n\n  .desceci-xp600-cta-buttons {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: center;\n    gap: 13px;\n    margin-top: 28px;\n  }\n\n  .desceci-xp600-secondary {\n    display: inline-flex;\n    min-height: 46px;\n    align-items: center;\n    justify-content: center;\n    padding: 0 22px;\n    border: 1px solid #15243a;\n    border-radius: 4px;\n    color: #15243a;\n    font-size: 14px;\n    font-weight: 700;\n    text-decoration: none;\n  }\n\n  .desceci-xp600-secondary:hover {\n    background: #15243a;\n    color: #ffffff;\n  }\n\n  @media screen and (max-width: 850px) {\n    .desceci-xp600-benefits,\n    .desceci-xp600-steps {\n      grid-template-columns: repeat(2, 1fr);\n    }\n  }\n\n  @media screen and (max-width: 650px) {\n    .desceci-xp600-section {\n      padding: 55px 16px;\n    }\n\n    .desceci-xp600-heading h2,\n    .desceci-xp600-cta h2 {\n      font-size: 29px;\n    }\n\n    .desceci-xp600-benefits,\n    .desceci-xp600-steps,\n    .desceci-xp600-maintenance {\n      grid-template-columns: 1fr;\n    }\n\n    .desceci-xp600-contact {\n      display: block;\n    }\n\n    .desceci-xp600-contact .desceci-xp600-button {\n      width: 100%;\n      margin-top: 18px;\n    }\n\n    .desceci-xp600-cta-buttons {\n      display: grid;\n    }\n\n    .desceci-xp600-cta-buttons a {\n      width: 100%;\n    }\n  }\n</style>\n\n<div class=\"desceci-xp600-page\">\n\n  <!-- 1. Core Benefits -->\n  <section class=\"desceci-xp600-section desceci-xp600-white\">\n    <div class=\"desceci-xp600-container\">\n\n      <div class=\"desceci-xp600-heading\">\n        <p class=\"desceci-xp600-eyebrow\">\n          VERSATILE DTF PRINTHEAD\n        </p>\n\n        <h2>\n          Epson F1080 / XP600 Printhead for Flexible DTF Printing\n        </h2>\n\n        <p>\n          A compact six-channel printhead designed for versatile digital printing,\n          smooth ink output, reliable performance, and flexible color configurations.\n        </p>\n      </div>\n\n      <div class=\"desceci-xp600-benefits\">\n\n        <div class=\"desceci-xp600-benefit\">\n          <strong>1,080</strong>\n          <h3>Precision Nozzles</h3>\n          <p>\n            Six nozzle rows provide smooth and consistent ink placement\n            for everyday DTF printing applications.\n          </p>\n        </div>\n\n        <div class=\"desceci-xp600-benefit\">\n          <strong>6-Color</strong>\n          <h3>Flexible Ink Configuration</h3>\n          <p>\n            Supports configurations of up to six ink colors\n            at up to 180 dpi per color.\n          </p>\n        </div>\n\n        <div class=\"desceci-xp600-benefit\">\n          <strong>25.4 mm</strong>\n          <h3>Compact Print Width</h3>\n          <p>\n            A compact 1-inch effective print width designed\n            for space-efficient printing systems.\n          </p>\n        </div>\n\n        <div class=\"desceci-xp600-benefit\">\n          <strong>46 kHz</strong>\n          <h3>High-Frequency Jetting</h3>\n          <p>\n            Supports a maximum listed jetting frequency of 46 kHz\n            in single-drop operation.\n          </p>\n        </div>\n\n      </div>\n\n      <div class=\"desceci-xp600-note\">\n        <strong>Compatibility Notice:</strong>\n        Please verify your printer model, existing printhead model,\n        ink type, connector configuration, and control system before ordering.\n        F1080/XP600 printheads are not automatically compatible with every printer.\n      </div>\n\n    </div>\n  </section>\n\n  <!-- 2. Technical Specifications -->\n  <section class=\"desceci-xp600-section desceci-xp600-gray\">\n    <div class=\"desceci-xp600-container\">\n\n      <div class=\"desceci-xp600-heading\">\n        <p class=\"desceci-xp600-eyebrow\">\n          TECHNICAL DETAILS\n        </p>\n\n        <h2>\n          Epson F1080 / XP600 Printhead Specifications\n        </h2>\n\n        <p>\n          Review the key technical details before selecting this printhead\n          for your DTF printer system.\n        </p>\n      </div>\n\n      <div class=\"desceci-xp600-table-wrap\">\n        <table class=\"desceci-xp600-table\">\n          <tbody>\n            <tr>\n              <th>Printhead Model</th>\n              <td class=\"desceci-xp600-highlight\">F1080-A1 / XP600</td>\n            </tr>\n\n            <tr>\n              <th>Ink Type</th>\n              <td>AQ Ink</td>\n            </tr>\n\n            <tr>\n              <th>Number of Nozzles</th>\n              <td class=\"desceci-xp600-highlight\">1,080</td>\n            </tr>\n\n            <tr>\n              <th>Nozzle Rows</th>\n              <td>6 Rows</td>\n            </tr>\n\n            <tr>\n              <th>Maximum Ink Colors</th>\n              <td>Up to 6 Colors</td>\n            </tr>\n\n            <tr>\n              <th>Resolution</th>\n              <td>180 dpi / 1 row; 360 dpi / 2 rows</td>\n            </tr>\n\n            <tr>\n              <th>Resolution Per Color</th>\n              <td>Up to 180 dpi per color configuration</td>\n            </tr>\n\n            <tr>\n              <th>Effective Print Width</th>\n              <td class=\"desceci-xp600-highlight\">25.4 mm</td>\n            </tr>\n\n            <tr>\n              <th>Dimensions</th>\n              <td>84.9 × 57.2 × 42.8 mm</td>\n            </tr>\n\n            <tr>\n              <th>Weight</th>\n              <td>60 g</td>\n            </tr>\n\n            <tr>\n              <th>Jetting Frequency</th>\n              <td>46 kHz single / 11.52 kHz multi</td>\n            </tr>\n\n            <tr>\n              <th>Droplet Volume</th>\n              <td>4.5 / 9 / 20 / 40 pl</td>\n            </tr>\n\n            <tr>\n              <th>Recommended Ink Viscosity</th>\n              <td>3–5 mPa·s</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n\n      <div class=\"desceci-xp600-note\">\n        <strong>Important:</strong>\n        Confirm printer compatibility, electronic configuration,\n        connector type, ink system, and installation requirements before ordering.\n      </div>\n\n    </div>\n  </section>\n\n  <!-- 3. Compatibility -->\n  <section class=\"desceci-xp600-section desceci-xp600-navy\">\n    <div class=\"desceci-xp600-container\">\n\n      <div class=\"desceci-xp600-heading\">\n        <p class=\"desceci-xp600-eyebrow\">\n          BEFORE YOU ORDER\n        </p>\n\n        <h2>\n          Confirm Compatibility Before Installation\n        </h2>\n\n        <p>\n          A similar-looking printhead does not always mean it is compatible.\n          Please verify the complete printer configuration before purchasing.\n        </p>\n      </div>\n\n      <div class=\"desceci-xp600-steps\">\n\n        <div class=\"desceci-xp600-step\">\n          <div class=\"desceci-xp600-step-number\">01</div>\n\n          <h3>Check Your Printer Model</h3>\n\n          <p>\n            Confirm that your printer is designed for an F1080 or XP600\n            printhead before placing your order.\n          </p>\n        </div>\n\n        <div class=\"desceci-xp600-step\">\n          <div class=\"desceci-xp600-step-number\">02</div>\n\n          <h3>Verify Ink and Electronics</h3>\n\n          <p>\n            Confirm the ink type, connector, wiring, mainboard,\n            control system, and electronic configuration.\n          </p>\n        </div>\n\n        <div class=\"desceci-xp600-step\">\n          <div class=\"desceci-xp600-step-number\">03</div>\n\n          <h3>Use Professional Installation</h3>\n\n          <p>\n            Proper wiring, flushing, priming, calibration, and nozzle testing\n            are important for stable printhead performance.\n          </p>\n        </div>\n\n      </div>\n\n      <div class=\"desceci-xp600-contact\">\n        <div>\n          <h3>Not Sure Which Printhead You Need?</h3>\n\n          <p>\n            Send us your printer model and current printhead information.\n            Our team can help confirm compatibility before ordering.\n          </p>\n        </div>\n\n        <a\n          href=\"mailto:desceci@outloonk.com?subject=F1080%20XP600%20Compatibility%20Question\"\n          class=\"desceci-xp600-button\">\n          Email Us for Help\n        </a>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- 4. Model Comparison -->\n  <section class=\"desceci-xp600-section desceci-xp600-white\">\n    <div class=\"desceci-xp600-container\">\n\n      <div class=\"desceci-xp600-heading\">\n        <p class=\"desceci-xp600-eyebrow\">\n          CHOOSE THE RIGHT MODEL\n        </p>\n\n        <h2>\n          I3200 vs I1600 vs XP600 Printheads\n        </h2>\n\n        <p>\n          Compare the three common printhead options based on production level,\n          printer configuration, and intended use.\n        </p>\n      </div>\n\n      <div class=\"desceci-xp600-comparison\">\n        <table>\n          <thead>\n            <tr>\n              <th>Comparison</th>\n\n              <th>\n                I3200-A1\n                <span class=\"desceci-xp600-badge\">High Production</span>\n              </th>\n\n              <th>\n                I1600-A1\n                <span class=\"desceci-xp600-badge\">Balanced Choice</span>\n              </th>\n\n              <th>\n                F1080 / XP600\n                <span class=\"desceci-xp600-badge\">Flexible Setup</span>\n              </th>\n            </tr>\n          </thead>\n\n          <tbody>\n            <tr>\n              <th>Best For</th>\n              <td>Professional and high-volume DTF production</td>\n              <td>Small to medium DTF production</td>\n              <td>Compact and flexible printing systems</td>\n            </tr>\n\n            <tr>\n              <th>Nozzle Configuration</th>\n              <td>3,200 nozzles / 8 rows</td>\n              <td>1,600 nozzles / 4 rows</td>\n              <td>1,080 nozzles / 6 rows</td>\n            </tr>\n\n            <tr>\n              <th>Main Advantage</th>\n              <td>High production capability</td>\n              <td>Balanced quality, size, and cost</td>\n              <td>Six-channel flexibility and compact design</td>\n            </tr>\n\n            <tr>\n              <th>Ink Configuration</th>\n              <td>Up to 4 colors</td>\n              <td>Up to 4 colors</td>\n              <td>Up to 6 colors</td>\n            </tr>\n\n            <tr>\n              <th>Recommended User</th>\n              <td>Print shops and growing apparel businesses</td>\n              <td>Small businesses and regular DTF users</td>\n              <td>Users with compatible XP600/F1080 systems</td>\n            </tr>\n\n            <tr>\n              <th>Important Reminder</th>\n              <td>Requires a compatible I3200 printer system</td>\n              <td>Requires a compatible I1600 printer system</td>\n              <td>Requires a compatible F1080/XP600 printer system</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n\n      <div class=\"desceci-xp600-note\">\n        <strong>Model selection guide:</strong>\n        Choose I3200 for high-volume production, I1600 for balanced\n        small-business production, and F1080/XP600 for compact systems\n        that require flexible channel configurations.\n      </div>\n\n    </div>\n  </section>\n\n  <!-- 5. Installation and Maintenance -->\n  <section class=\"desceci-xp600-section desceci-xp600-gray\">\n    <div class=\"desceci-xp600-container\">\n\n      <div class=\"desceci-xp600-heading\">\n        <p class=\"desceci-xp600-eyebrow\">\n          INSTALLATION & CARE\n        </p>\n\n        <h2>\n          Protect Your Printhead Performance\n        </h2>\n\n        <p>\n          Proper preparation and regular maintenance help support stable ink flow,\n          reliable printing, and longer printhead service life.\n        </p>\n      </div>\n\n      <div class=\"desceci-xp600-maintenance\">\n\n        <div class=\"desceci-xp600-maintenance-item\">\n          <div class=\"desceci-xp600-maintenance-number\">01</div>\n\n          <div>\n            <h3>Flush the Ink System</h3>\n\n            <p>\n              Flush incompatible or dried ink from the ink path before installing\n              the new printhead.\n            </p>\n          </div>\n        </div>\n\n        <div class=\"desceci-xp600-maintenance-item\">\n          <div class=\"desceci-xp600-maintenance-number\">02</div>\n\n          <div>\n            <h3>Check Wiring Carefully</h3>\n\n            <p>\n              Confirm connector direction and wiring configuration before\n              powering on the printer.\n            </p>\n          </div>\n        </div>\n\n        <div class=\"desceci-xp600-maintenance-item\">\n          <div class=\"desceci-xp600-maintenance-number\">03</div>\n\n          <div>\n            <h3>Prime and Calibrate</h3>\n\n            <p>\n              Complete priming, nozzle checks, alignment, and calibration before\n              starting production printing.\n            </p>\n          </div>\n        </div>\n\n        <div class=\"desceci-xp600-maintenance-item\">\n          <div class=\"desceci-xp600-maintenance-number\">04</div>\n\n          <div>\n            <h3>Keep the Nozzle Surface Clean</h3>\n\n            <p>\n              Follow the printer manufacturer’s cleaning procedure and prevent\n              ink from drying on the nozzle surface.\n            </p>\n          </div>\n        </div>\n\n      </div>\n\n    </div>\n  </section>\n\n  <!-- 6. FAQ -->\n  <section class=\"desceci-xp600-section desceci-xp600-white\">\n    <div class=\"desceci-xp600-container\">\n\n      <div class=\"desceci-xp600-heading\">\n        <p class=\"desceci-xp600-eyebrow\">\n          F1080 / XP600 SUPPORT\n        </p>\n\n        <h2>\n          Frequently Asked Questions\n        </h2>\n\n        <p>\n          Answers to common questions about the F1080/XP600 printhead,\n          compatibility, installation, and maintenance.\n        </p>\n      </div>\n\n      <div class=\"desceci-xp600-faq\">\n\n        <details>\n          <summary>\n            What is the F1080/XP600 printhead best used for?\n          </summary>\n\n          <p>\n            It is suitable for compatible compact and flexible digital printing\n            systems, including DTF applications that support the F1080 or XP600 configuration.\n          </p>\n        </details>\n\n        <details>\n          <summary>\n            How many nozzles does the F1080/XP600 printhead have?\n          </summary>\n\n          <p>\n            The printhead has 1,080 nozzles arranged across six nozzle rows.\n          </p>\n        </details>\n\n        <details>\n          <summary>\n            How many ink colors can it support?\n          </summary>\n\n          <p>\n            The product specifications support configurations of up to six ink colors,\n            with up to 180 dpi per color depending on the printer configuration.\n          </p>\n        </details>\n\n        <details>\n          <summary>\n            Is this printhead compatible with every XP600 printer?\n          </summary>\n\n          <p>\n            No. Compatibility depends on the exact printer model, mainboard,\n            wiring, connector, firmware, ink system, and electronic configuration.\n          </p>\n        </details>\n\n        <details>\n          <summary>\n            Can I replace an I1600 or I3200 with this printhead?\n          </summary>\n\n          <p>\n            No. I3200, I1600, and F1080/XP600 systems are different printhead\n            configurations. Please confirm compatibility before replacing a printhead.\n          </p>\n        </details>\n\n        <details>\n          <summary>\n            What information should I send for compatibility confirmation?\n          </summary>\n\n          <p>\n            Please send your printer brand and model, current printhead model,\n            ink type, connector information, and clear photos of the printhead\n            and wiring connection.\n          </p>\n        </details>\n\n      </div>\n\n    </div>\n  </section>\n\n  <!-- 7. Final CTA -->\n  <section class=\"desceci-xp600-section desceci-xp600-white\">\n    <div class=\"desceci-xp600-cta\">\n\n      <p class=\"desceci-xp600-eyebrow\">\n        READY TO REPLACE YOUR PRINTHEAD?\n      </p>\n\n      <h2>\n        Choose the Right F1080 / XP600 Printhead\n      </h2>\n\n      <p>\n        Not sure whether this printhead matches your printer?\n        Send us your printer information and our team will help confirm\n        the correct configuration before ordering.\n      </p>\n\n      <div class=\"desceci-xp600-cta-buttons\">\n\n        <a\n          href=\"mailto:desceci@outloonk.com?subject=F1080%20XP600%20Printhead%20Compatibility%20Check\"\n          class=\"desceci-xp600-button\">\n          Confirm Compatibility\n        </a>\n\n        <a\n          href=\"#\"\n          class=\"desceci-xp600-secondary\"\n          onclick=\"window.scrollTo({top: 0, behavior: 'smooth'}); return false;\">\n          Back to Top ↑\n        </a>\n\n      </div>\n\n    </div>\n  </section>\n\n</div>",
