    "collapsible_content_DKAqqj": {
      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_Rd99fT": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What supplies do I need for DTF printing?",
            "icon": "check_mark",
            "row_content": "<p>A typical DTF workflow requires DTF ink, PET transfer film, hot melt adhesive powder, a compatible printer, curing equipment, and a heat press.</p>",
            "page": ""
          }
        },
        "collapsible_row_mbBzKk": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can DESCECI DTF ink work with Epson printheads?",
            "icon": "check_mark",
            "row_content": "<p><br/>Compatibility depends on your printer, printhead model, ink system, and RIP setup. Always confirm compatibility before switching inks.<br/><br/></p>",
            "page": ""
          }
        },
        "collapsible_row_dqnj88": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What is DTF transfer film used for?",
            "icon": "check_mark",
            "row_content": "<p>DTF film is the PET carrier used to receive the printed image before adhesive powder is applied and the transfer is heat pressed onto the garment.</p>",
            "page": ""
          }
        },
        "collapsible_row_pE4VKM": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What does DTF powder do?",
            "icon": "check_mark",
            "row_content": "<p>DTF powder acts as the adhesive layer that bonds the printed design to the garment during heat pressing.</p>",
            "page": ""
          }
        },
        "collapsible_row_DrhyAB": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can I use different brands of ink, film and powder together?",
            "icon": "check_mark",
            "row_content": "<p>It may be possible, but testing is recommended because ink absorption, curing conditions and adhesion can vary between different consumables.</p>",
            "page": ""
          }
        },
        "collapsible_row_YxHMxR": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Do you offer DTF supplies for commercial production?",
            "icon": "check_mark",
            "row_content": "<p>DESCECI offers DTF consumables suitable for businesses ranging from small apparel shops to regular transfer production environments.</p>",
            "page": ""
          }
        }
      },
