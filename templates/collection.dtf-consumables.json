      "settings": {
        "custom_liquid": "<section class=\"desceci-faq\">\n\n\n<div class=\"faq-container\">\n\n\n\n<div class=\"faq-header\">\n\n\n<span>\nDTF SUPPLIES FAQ\n</span>\n\n\n<h2>\nFrequently Asked Questions\n</h2>\n\n\n<p>\nFind answers about DTF ink, transfer film,\npowder, compatibility, and shipping.\n</p>\n\n\n</div>\n\n\n\n\n\n\n<div class=\"faq-list\">\n\n\n\n\n\n<div class=\"faq-item\">\n\n\n<button class=\"faq-question\">\n\nWhat DTF consumables do I need for printing?\n\n<span>+</span>\n\n</button>\n\n\n<div class=\"faq-answer\">\n\n<p>\nA complete DTF printing setup requires\n<a href=\"/products/dtf-ink\">DTF Ink</a>,\n<a href=\"/products/dtf-film\">DTF Film</a>,\nand\n<a href=\"/products/dtf-powder\">DTF Powder</a>.\nThese three materials work together to create\ndurable and vibrant transfers.\n</p>\n\n\n</div>\n\n</div>\n\n\n\n\n\n\n\n<div class=\"faq-item\">\n\n\n<button class=\"faq-question\">\n\nWhich DTF ink works with Epson printers?\n\n<span>+</span>\n\n</button>\n\n\n<div class=\"faq-answer\">\n\n<p>\nDESCECI\n<a href=\"/products/dtf-ink\">DTF Ink</a>\nis designed for professional DTF printing systems\nincluding Epson I3200, I1600, and XP600 platforms.\n\nLearn more:\n<a href=\"/blogs/news/what-is-dtf-ink\">\nWhat Is DTF Ink?\n</a>\n</p>\n\n\n</div>\n\n</div>\n\n\n\n\n\n\n\n<div class=\"faq-item\">\n\n\n<button class=\"faq-question\">\n\nHow do I choose the right DTF film?\n\n<span>+</span>\n\n</button>\n\n\n<div class=\"faq-answer\">\n\n<p>\nChoosing the right\n<a href=\"/products/dtf-film\">\nDTF Film\n</a>\ndepends on your printing workflow and peeling preference.\nPremium transfer film helps achieve sharp details,\nvibrant colors, and smooth release.\n\nLearn more:\n<a href=\"/blogs/news/what-is-dtf-film\">\nDTF Film Guide\n</a>\n</p>\n\n\n</div>\n\n</div>\n\n\n\n\n\n\n\n<div class=\"faq-item\">\n\n\n<button class=\"faq-question\">\n\nWhat does DTF powder do?\n\n<span>+</span>\n\n</button>\n\n\n<div class=\"faq-answer\">\n\n<p>\n<a href=\"/products/dtf-powder\">\nDTF Powder\n</a>\nworks as a hot melt adhesive layer\nthat bonds printed designs to fabric during\nthe heat pressing process.\n\nLearn more:\n<a href=\"/blogs/news/what-is-dtf-powder\">\nDTF Powder Guide\n</a>\n</p>\n\n\n</div>\n\n</div>\n\n\n\n\n\n\n\n<div class=\"faq-item\">\n\n\n<button class=\"faq-question\">\n\nWhere does DESCECI ship DTF supplies from?\n\n<span>+</span>\n\n</button>\n\n\n<div class=\"faq-answer\">\n\n<p>\nDESCECI DTF supplies ship from our California warehouse:\n\n<br><br>\n\n13462 Brooks Dr,\nBaldwin Park, CA 91706 USA\n\n<br><br>\n\nWe provide reliable fulfillment and tracking\nfor customers across the United States.\n</p>\n\n\n</div>\n\n</div>\n\n\n\n\n\n\n</div>\n\n\n</div>\n\n\n</section>\n\n\n\n\n\n<script>\n\ndocument.querySelectorAll('.faq-question')\n.forEach(button=>{\n\n\nbutton.addEventListener('click',()=>{\n\n\nbutton.parentElement.classList.toggle('active');\n\n\n});\n\n\n});\n\n\n</script>\n\n\n\n\n\n\n<style>\n\n\n.desceci-faq{\n\npadding:65px 20px;\n\nbackground:#ffffff;\n\n}\n\n\n\n.faq-container{\n\nmax-width:900px;\n\nmargin:auto;\n\n}\n\n\n\n\n.faq-header{\n\ntext-align:center;\n\nmargin-bottom:40px;\n\n}\n\n\n\n\n.faq-header span{\n\nfont-size:14px;\n\nletter-spacing:2px;\n\nfont-weight:600;\n\ncolor:#61865d;\n\n}\n\n\n\n.faq-header h2{\n\nfont-size:36px;\n\nmargin:12px 0;\n\nfont-weight:700;\n\ncolor:#111827;\n\n}\n\n\n\n.faq-header p{\n\nfont-size:17px;\n\ncolor:#6b7280;\n\nline-height:1.6;\n\n}\n\n\n\n\n.faq-item{\n\nborder-bottom:1px solid #e5e7eb;\n\n}\n\n\n\n\n.faq-question{\n\nwidth:100%;\n\npadding:20px 0;\n\nbackground:none;\n\nborder:none;\n\ndisplay:flex;\n\njustify-content:space-between;\n\nfont-size:18px;\n\nfont-weight:600;\n\ncursor:pointer;\n\ntext-align:left;\n\ncolor:#111827;\n\n}\n\n\n\n.faq-question span{\n\nfont-size:25px;\n\ncolor:#61865d;\n\n}\n\n\n\n.faq-answer{\n\ndisplay:none;\n\npadding-bottom:20px;\n\n}\n\n\n\n.faq-answer p{\n\nfont-size:16px;\n\nline-height:1.7;\n\ncolor:#6b7280;\n\n}\n\n\n\n.faq-answer a{\n\ncolor:#61865d;\n\nfont-weight:600;\n\ntext-decoration:none;\n\n}\n\n\n\n\n.faq-item.active .faq-answer{\n\ndisplay:block;\n\n}\n\n\n\n\n@media(max-width:600px){\n\n\n.faq-header h2{\n\nfont-size:30px;\n\n}\n\n\n.faq-question{\n\nfont-size:16px;\n\n}\n\n\n}\n\n\n</style>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_BFfVpW": {
      "type": "custom-liquid",
      "name": "BLOG",
      "settings": {
        "custom_liquid": "<section class=\"desceci-learning\">\n\n\n<div class=\"learning-container\">\n\n\n<div class=\"learning-header\">\n\n\n<span>\nDTF KNOWLEDGE CENTER\n</span>\n\n\n<h2>\nLearn More About DTF Printing\n</h2>\n\n\n<p>\nExplore DTF printing guides, materials,\nand techniques to improve your production.\n</p>\n\n\n</div>\n\n\n\n\n\n<div class=\"learning-grid\">\n\n\n\n{% assign articles = blogs.news.articles %}\n\n\n\n{% for article in articles limit:3 %}\n\n\n\n\n<div class=\"learning-card\">\n\n\n\n<a href=\"{{ article.url }}\">\n\n\n<div class=\"learning-image\">\n\n\n{% if article.image %}\n\n<img\nsrc=\"{{ article.image | image_url: width:800 }}\"\nalt=\"{{ article.title | escape }}\"\nloading=\"lazy\"\n>\n\n\n{% else %}\n\n<img\nsrc=\"{{ article.featured_image | image_url: width:800 }}\"\nalt=\"{{ article.title | escape }}\"\nloading=\"lazy\"\n>\n\n\n{% endif %}\n\n\n</div>\n\n\n</a>\n\n\n\n\n\n\n<div class=\"learning-content\">\n\n\n\n<h3>\n\n<a href=\"{{ article.url }}\">\n\n{{ article.title }}\n\n</a>\n\n</h3>\n\n\n\n\n\n<p>\n\n{% if article.excerpt != blank %}\n\n{{ article.excerpt | strip_html | truncate:120 }}\n\n{% else %}\n\nExplore our DTF printing guides,\nmaterials, and professional tips.\n\n{% endif %}\n\n\n</p>\n\n\n\n\n\n\n<a href=\"{{ article.url }}\"\nclass=\"learning-btn\">\n\nRead Guide →\n\n</a>\n\n\n\n\n</div>\n\n\n\n\n</div>\n\n\n\n\n{% endfor %}\n\n\n\n\n</div>\n\n\n\n</div>\n\n\n</section>\n\n\n\n\n\n\n\n\n<style>\n\n\n.desceci-learning{\n\n\npadding:70px 20px;\n\nbackground:#f8f9fb;\n\n\n}\n\n\n\n\n\n\n\n.learning-container{\n\n\nmax-width:1200px;\n\nmargin:auto;\n\n\n}\n\n\n\n\n\n\n.learning-header{\n\n\ntext-align:center;\n\nmargin-bottom:45px;\n\n\n}\n\n\n\n\n\n.learning-header span{\n\n\nfont-size:14px;\n\nletter-spacing:2px;\n\nfont-weight:600;\n\ncolor:#61865d;\n\n\n}\n\n\n\n\n\n.learning-header h2{\n\n\nfont-size:36px;\n\nmargin:12px 0;\n\nfont-weight:700;\n\ncolor:#111827;\n\n\n}\n\n\n\n\n\n\n\n.learning-header p{\n\n\nfont-size:17px;\n\ncolor:#6b7280;\n\nmax-width:650px;\n\nmargin:auto;\n\nline-height:1.6;\n\n\n}\n\n\n\n\n\n\n\n.learning-grid{\n\n\ndisplay:grid;\n\ngrid-template-columns:repeat(3,1fr);\n\ngap:30px;\n\n\n}\n\n\n\n\n\n\n.learning-card{\n\n\nbackground:#ffffff;\n\noverflow:hidden;\n\nborder:1px solid #e5e7eb;\n\n\n}\n\n\n\n\n\n.learning-image{\n\n\naspect-ratio:16/9;\n\noverflow:hidden;\n\n\n}\n\n\n\n\n\n\n.learning-image img{\n\n\nwidth:100%;\n\nheight:100%;\n\nobject-fit:cover;\n\ndisplay:block;\n\n\n}\n\n\n\n\n\n\n\n.learning-content{\n\n\npadding:25px;\n\n\n}\n\n\n\n\n\n.learning-content h3{\n\n\nfont-size:22px;\n\nline-height:1.4;\n\nmargin-bottom:12px;\n\n\n}\n\n\n\n.learning-content h3 a{\n\n\ncolor:#111827;\n\ntext-decoration:none;\n\n\n}\n\n\n\n\n\n.learning-content p{\n\n\nfont-size:15px;\n\nline-height:1.7;\n\ncolor:#6b7280;\n\nmin-height:70px;\n\n\n}\n\n\n\n\n\n\n.learning-btn{\n\n\ndisplay:inline-block;\n\nmargin-top:15px;\n\nbackground:#111827;\n\ncolor:white;\n\npadding:12px 25px;\n\ntext-decoration:none;\n\nfont-size:14px;\n\nfont-weight:600;\n\n\n}\n\n\n\n\n\n.learning-btn:hover{\n\n\nopacity:.85;\n\n\n}\n\n\n\n\n\n\n\n\n@media(max-width:900px){\n\n\n.learning-grid{\n\n\ngrid-template-columns:1fr;\n\n\n}\n\n\n\n.learning-header h2{\n\n\nfont-size:30px;\n\n\n}\n\n\n\n}\n\n\n\n</style>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
