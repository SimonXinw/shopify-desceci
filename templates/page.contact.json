      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .desceci-contact-page {\n    width: 100%;\n    background: #ffffff;\n    color: #15243a;\n    font-family: Helvetica, Arial, sans-serif;\n  }\n\n  .desceci-contact-page * {\n    box-sizing: border-box;\n  }\n\n  .desceci-contact-hero {\n    padding: 82px 20px 68px;\n    background: #f7f9fc;\n    text-align: center;\n  }\n\n  .desceci-contact-hero__inner {\n    max-width: 820px;\n    margin: 0 auto;\n  }\n\n  .desceci-contact-eyebrow {\n    margin: 0 0 14px;\n    color: #5c9143;\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 1.8px;\n    text-transform: uppercase;\n  }\n\n  .desceci-contact-hero h1 {\n    margin: 0 0 18px;\n    color: #15243a;\n    font-size: 46px;\n    font-weight: 700;\n    line-height: 1.15;\n  }\n\n  .desceci-contact-hero p {\n    max-width: 700px;\n    margin: 0 auto;\n    color: #697586;\n    font-size: 17px;\n    line-height: 1.75;\n  }\n\n  .desceci-contact-content {\n    max-width: 1120px;\n    margin: 0 auto;\n    padding: 72px 20px 85px;\n  }\n\n  .desceci-contact-section-title {\n    margin: 0 0 30px;\n    color: #15243a;\n    font-size: 30px;\n    line-height: 1.25;\n  }\n\n  .desceci-contact-topics {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 16px;\n    margin-bottom: 68px;\n  }\n\n  .desceci-contact-topic {\n    min-height: 185px;\n    padding: 26px 24px;\n    border: 1px solid #e1e7ed;\n    border-radius: 6px;\n    background: #f7f9fc;\n  }\n\n  .desceci-contact-topic__number {\n    margin-bottom: 18px;\n    color: #5c9143;\n    font-size: 25px;\n    font-weight: 700;\n  }\n\n  .desceci-contact-topic h3 {\n    margin: 0 0 11px;\n    color: #15243a;\n    font-size: 17px;\n    line-height: 1.35;\n  }\n\n  .desceci-contact-topic p {\n    margin: 0;\n    color: #697586;\n    font-size: 14px;\n    line-height: 1.7;\n  }\n\n  .desceci-contact-form-layout {\n    display: grid;\n    grid-template-columns: .8fr 1.2fr;\n    gap: 50px;\n    align-items: start;\n  }\n\n  .desceci-contact-info {\n    padding: 30px 27px;\n    border-radius: 7px;\n    background: #15243a;\n  }\n\n  .desceci-contact-info h2 {\n    margin: 0 0 16px;\n    color: #ffffff;\n    font-size: 28px;\n    line-height: 1.25;\n  }\n\n  .desceci-contact-info > p {\n    margin: 0 0 27px;\n    color: #c7d1df;\n    font-size: 15px;\n    line-height: 1.7;\n  }\n\n  .desceci-contact-info__item {\n    margin-top: 20px;\n    padding-top: 20px;\n    border-top: 1px solid rgba(255, 255, 255, .16);\n  }\n\n  .desceci-contact-info__item strong {\n    display: block;\n    margin-bottom: 6px;\n    color: #9bc477;\n    font-size: 13px;\n    letter-spacing: .5px;\n    text-transform: uppercase;\n  }\n\n  .desceci-contact-info__item span,\n  .desceci-contact-info__item a {\n    color: #ffffff;\n    font-size: 14px;\n    line-height: 1.65;\n    text-decoration: none;\n  }\n\n  .desceci-contact-info__item a:hover {\n    color: #9bc477;\n  }\n\n  .desceci-contact-form-box {\n    padding: 32px;\n    border: 1px solid #e1e7ed;\n    border-radius: 7px;\n    background: #ffffff;\n  }\n\n  .desceci-contact-form-box h2 {\n    margin: 0 0 10px;\n    color: #15243a;\n    font-size: 28px;\n  }\n\n  .desceci-contact-form-box__intro {\n    margin: 0 0 25px;\n    color: #697586;\n    font-size: 14px;\n    line-height: 1.7;\n  }\n\n  .desceci-contact-form__row {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 14px;\n  }\n\n  .desceci-contact-form__field {\n    margin-bottom: 15px;\n  }\n\n  .desceci-contact-form__field label {\n    display: block;\n    margin-bottom: 7px;\n    color: #15243a;\n    font-size: 13px;\n    font-weight: 700;\n  }\n\n  .desceci-contact-form__field input,\n  .desceci-contact-form__field select,\n  .desceci-contact-form__field textarea {\n    width: 100%;\n    border: 1px solid #d7dee6;\n    border-radius: 4px;\n    padding: 13px 14px;\n    background: #ffffff;\n    color: #15243a;\n    font-family: inherit;\n    font-size: 14px;\n  }\n\n  .desceci-contact-form__field input:focus,\n  .desceci-contact-form__field select:focus,\n  .desceci-contact-form__field textarea:focus {\n    outline: none;\n    border-color: #5c9143;\n    box-shadow: 0 0 0 2px rgba(92, 145, 67, .12);\n  }\n\n  .desceci-contact-form__field textarea {\n    min-height: 145px;\n    resize: vertical;\n  }\n\n  .desceci-contact-form__submit {\n    min-height: 48px;\n    padding: 0 28px;\n    border: 0;\n    border-radius: 4px;\n    background: #5c9143;\n    color: #ffffff;\n    font-family: inherit;\n    font-size: 14px;\n    font-weight: 700;\n    cursor: pointer;\n    transition: all .2s ease;\n  }\n\n  .desceci-contact-form__submit:hover {\n    background: #15243a;\n  }\n\n  .desceci-contact-form__success {\n    margin-bottom: 20px;\n    padding: 14px 16px;\n    border-left: 4px solid #5c9143;\n    background: #eef5e9;\n    color: #3e6b2d;\n    font-size: 14px;\n  }\n\n  .desceci-contact-form__errors {\n    margin-bottom: 20px;\n    padding: 14px 16px;\n    border-left: 4px solid #b84a4a;\n    background: #fff1f1;\n    color: #8f3030;\n    font-size: 14px;\n  }\n\n  .desceci-contact-bottom {\n    max-width: 900px;\n    margin: 58px auto 0;\n    padding: 25px 28px;\n    border: 1px solid #dfe7df;\n    border-radius: 6px;\n    background: #f7f9fc;\n    text-align: center;\n  }\n\n  .desceci-contact-bottom h3 {\n    margin: 0 0 8px;\n    color: #15243a;\n    font-size: 20px;\n  }\n\n  .desceci-contact-bottom p {\n    margin: 0;\n    color: #697586;\n    font-size: 14px;\n    line-height: 1.7;\n  }\n\n  .desceci-contact-bottom a {\n    color: #5c9143;\n    font-weight: 700;\n    text-decoration: none;\n  }\n\n  .desceci-contact-bottom a:hover {\n    color: #15243a;\n    text-decoration: underline;\n  }\n\n  @media screen and (max-width: 800px) {\n    .desceci-contact-hero {\n      padding: 60px 18px 50px;\n    }\n\n    .desceci-contact-hero h1 {\n      font-size: 34px;\n    }\n\n    .desceci-contact-hero p {\n      font-size: 15px;\n    }\n\n    .desceci-contact-content {\n      padding: 55px 16px 65px;\n    }\n\n    .desceci-contact-topics,\n    .desceci-contact-form-layout {\n      grid-template-columns: 1fr;\n    }\n\n    .desceci-contact-topics {\n      margin-bottom: 45px;\n    }\n\n    .desceci-contact-form-box {\n      padding: 24px 19px;\n    }\n  }\n\n  @media screen and (max-width: 520px) {\n    .desceci-contact-form__row {\n      grid-template-columns: 1fr;\n      gap: 0;\n    }\n\n    .desceci-contact-form__submit {\n      width: 100%;\n    }\n  }\n</style>\n\n<div class=\"desceci-contact-page\">\n\n  <!-- Hero -->\n  <section class=\"desceci-contact-hero\">\n    <div class=\"desceci-contact-hero__inner\">\n\n      <p class=\"desceci-contact-eyebrow\">\n        CONTACT DESCECI\n      </p>\n\n      <h1>\n        We’re Here to Help\n      </h1>\n\n      <p>\n        Have a question about your DTF transfers, gang sheet, artwork,\n        DTF supplies, printheads, or heat press equipment?\n        Our team is ready to help.\n      </p>\n\n    </div>\n  </section>\n\n  <main class=\"desceci-contact-content\">\n\n    <!-- Help Topics -->\n    <section>\n      <h2 class=\"desceci-contact-section-title\">\n        What Can We Help You With?\n      </h2>\n\n      <div class=\"desceci-contact-topics\">\n\n        <div class=\"desceci-contact-topic\">\n          <div class=\"desceci-contact-topic__number\">01</div>\n\n          <h3>\n            DTF Transfer & Gang Sheet Orders\n          </h3>\n\n          <p>\n            Questions about transfer sizes, quantities, artwork setup,\n            gang sheet uploads, or placing an order.\n          </p>\n        </div>\n\n        <div class=\"desceci-contact-topic\">\n          <div class=\"desceci-contact-topic__number\">02</div>\n\n          <h3>\n            Artwork & File Questions\n          </h3>\n\n          <p>\n            Not sure if your artwork is print-ready?\n            Send us your file question and we can help review the requirements.\n          </p>\n        </div>\n\n        <div class=\"desceci-contact-topic\">\n          <div class=\"desceci-contact-topic__number\">03</div>\n\n          <h3>\n            DTF Supplies & Equipment\n          </h3>\n\n          <p>\n            Need help choosing DTF ink, film, powder, printheads,\n            or heat press equipment? We can help you compare options.\n          </p>\n        </div>\n\n        <div class=\"desceci-contact-topic\">\n          <div class=\"desceci-contact-topic__number\">04</div>\n\n          <h3>\n            Order & Shipping Support\n          </h3>\n\n          <p>\n            Need help with an existing order, shipping status,\n            delivery questions, or order updates?\n          </p>\n        </div>\n\n        <div class=\"desceci-contact-topic\">\n          <div class=\"desceci-contact-topic__number\">05</div>\n\n          <h3>\n            Printhead Compatibility\n          </h3>\n\n          <p>\n            Send your printer model, current printhead model,\n            ink type, and connector information before ordering.\n          </p>\n        </div>\n\n        <div class=\"desceci-contact-topic\">\n          <div class=\"desceci-contact-topic__number\">06</div>\n\n          <h3>\n            Heat Press Configuration\n          </h3>\n\n          <p>\n            Tell us your preferred pressing size, voltage,\n            phase type, and shipping location for configuration help.\n          </p>\n        </div>\n\n      </div>\n    </section>\n\n    <!-- Contact Form -->\n    <section class=\"desceci-contact-form-layout\">\n\n      <div class=\"desceci-contact-info\">\n        <h2>\n          Let’s Find the Right Solution\n        </h2>\n\n        <p>\n          To help us respond faster, please include your order number,\n          printer model, artwork details, or product information whenever possible.\n        </p>\n\n        <div class=\"desceci-contact-info__item\">\n          <strong>Email</strong>\n          <a href=\"mailto:desceci@outlook.com\">\n            desceci@outlook.com\n          </a>\n        </div>\n\n        <div class=\"desceci-contact-info__item\">\n          <strong>DTF Consumables Warehouse</strong>\n          <span>\n            13462 Brooks Dr<br>\n            Baldwin Park, CA 91706<br>\n            United States\n          </span>\n        </div>\n\n        <div class=\"desceci-contact-info__item\">\n          <strong>Response Time</strong>\n          <span>\n            We usually respond within one business day.\n          </span>\n        </div>\n      </div>\n\n      <div class=\"desceci-contact-form-box\">\n\n        <h2>\n          Send Us a Message\n        </h2>\n\n        <p class=\"desceci-contact-form-box__intro\">\n          Complete the form below and our team will get back to you as soon as possible.\n        </p>\n\n        {% form 'contact', id: 'DesceciContactForm' %}\n\n          {% if form.posted_successfully? %}\n            <div class=\"desceci-contact-form__success\">\n              Thanks for contacting us. Your message has been sent successfully.\n            </div>\n          {% endif %}\n\n          {% if form.errors %}\n            <div class=\"desceci-contact-form__errors\">\n              Please check the required fields and try again.\n            </div>\n          {% endif %}\n\n          <div class=\"desceci-contact-form__row\">\n\n            <div class=\"desceci-contact-form__field\">\n              <label for=\"ContactFormName\">\n                Name *\n              </label>\n\n              <input\n                type=\"text\"\n                id=\"ContactFormName\"\n                name=\"contact[name]\"\n                placeholder=\"Your name\"\n                autocomplete=\"name\"\n                required>\n            </div>\n\n            <div class=\"desceci-contact-form__field\">\n              <label for=\"ContactFormEmail\">\n                Email *\n              </label>\n\n              <input\n                type=\"email\"\n                id=\"ContactFormEmail\"\n                name=\"contact[email]\"\n                placeholder=\"you@example.com\"\n                autocomplete=\"email\"\n                required>\n            </div>\n\n          </div>\n\n          <div class=\"desceci-contact-form__field\">\n            <label for=\"ContactFormPhone\">\n              Phone Number\n            </label>\n\n            <input\n              type=\"tel\"\n              id=\"ContactFormPhone\"\n              name=\"contact[phone]\"\n              placeholder=\"Optional\"\n              autocomplete=\"tel\">\n          </div>\n\n          <div class=\"desceci-contact-form__field\">\n            <label for=\"ContactFormTopic\">\n              What Can We Help With?\n            </label>\n\n            <select\n              id=\"ContactFormTopic\"\n              name=\"contact[topic]\">\n\n              <option value=\"\">Select a topic</option>\n              <option value=\"DTF Transfer Order\">DTF Transfer Order</option>\n              <option value=\"Gang Sheet\">Gang Sheet</option>\n              <option value=\"Artwork Question\">Artwork Question</option>\n              <option value=\"DTF Supplies\">DTF Supplies</option>\n              <option value=\"Printhead Compatibility\">Printhead Compatibility</option>\n              <option value=\"Heat Press Configuration\">Heat Press Configuration</option>\n              <option value=\"Order and Shipping Support\">Order and Shipping Support</option>\n\n            </select>\n          </div>\n\n          <div class=\"desceci-contact-form__field\">\n            <label for=\"ContactFormOrder\">\n              Order Number\n            </label>\n\n            <input\n              type=\"text\"\n              id=\"ContactFormOrder\"\n              name=\"contact[order_number]\"\n              placeholder=\"Optional\">\n          </div>\n\n          <div class=\"desceci-contact-form__field\">\n            <label for=\"ContactFormMessage\">\n              Message *\n            </label>\n\n            <textarea\n              id=\"ContactFormMessage\"\n              name=\"contact[body]\"\n              placeholder=\"Tell us how we can help...\"\n              required></textarea>\n          </div>\n\n          <button\n            type=\"submit\"\n            class=\"desceci-contact-form__submit\">\n            Send Message\n          </button>\n\n        {% endform %}\n\n      </div>\n\n    </section>\n\n    <div class=\"desceci-contact-bottom\">\n      <h3>\n        Prefer Email?\n      </h3>\n\n      <p>\n        You can also email us directly at\n        <a href=\"mailto:desceci@outlook.com\">\n          desceci@outlook.com\n        </a>.\n        Please include your order number or product model so we can assist you faster.\n      </p>\n    </div>\n\n  </main>\n\n</div>",
