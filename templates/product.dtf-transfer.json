    "custom_liquid_pDYbWp": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% assign has_specs = false %}\n\n{% if product.metafields.custom.press_temperature.value != blank %}\n  {% assign has_specs = true %}\n{% endif %}\n\n{% if product.metafields.custom.press_time.value != blank %}\n  {% assign has_specs = true %}\n{% endif %}\n\n{% if product.metafields.custom.pressure.value != blank %}\n  {% assign has_specs = true %}\n{% endif %}\n\n{% if product.metafields.custom.peel_method.value != blank %}\n  {% assign has_specs = true %}\n{% endif %}\n\n{% if product.metafields.custom.recommended_fabric.value != blank %}\n  {% assign has_specs = true %}\n{% endif %}\n\n{% if product.metafields.custom.finish.value != blank %}\n  {% assign has_specs = true %}\n{% endif %}\n\n{% if product.metafields.custom.wash_care.value != blank %}\n  {% assign has_specs = true %}\n{% endif %}\n\n\n{% if has_specs %}\n\n<section class=\"dtf-specs\">\n\n  <!-- 标题 -->\n  <div class=\"dtf-specs-header\">\n    <span class=\"dtf-specs-line\"></span>\n\n    <h2>DTF Transfer Specifications</h2>\n\n    <span class=\"dtf-specs-line\"></span>\n  </div>\n\n\n  <!-- 规格表 -->\n  <div class=\"dtf-specs-card\">\n\n    <!-- Press Temperature -->\n    {% if product.metafields.custom.press_temperature.value != blank %}\n      <div class=\"dtf-spec-item\">\n\n        <div class=\"dtf-spec-label\">\n          Press Temperature\n        </div>\n\n        <div class=\"dtf-spec-value\">\n          {{ product.metafields.custom.press_temperature.value }}\n        </div>\n\n      </div>\n    {% endif %}\n\n\n    <!-- Press Time -->\n    {% if product.metafields.custom.press_time.value != blank %}\n      <div class=\"dtf-spec-item\">\n\n        <div class=\"dtf-spec-label\">\n          Press Time\n        </div>\n\n        <div class=\"dtf-spec-value\">\n          {{ product.metafields.custom.press_time.value }}\n        </div>\n\n      </div>\n    {% endif %}\n\n\n    <!-- Pressure -->\n    {% if product.metafields.custom.pressure.value != blank %}\n      <div class=\"dtf-spec-item\">\n\n        <div class=\"dtf-spec-label\">\n          Pressure\n        </div>\n\n        <div class=\"dtf-spec-value\">\n          {{ product.metafields.custom.pressure.value }}\n        </div>\n\n      </div>\n    {% endif %}\n\n\n    <!-- Peel Method -->\n    {% if product.metafields.custom.peel_method.value != blank %}\n      <div class=\"dtf-spec-item\">\n\n        <div class=\"dtf-spec-label\">\n          Peel Method\n        </div>\n\n        <div class=\"dtf-spec-value\">\n          {{ product.metafields.custom.peel_method.value }}\n        </div>\n\n      </div>\n    {% endif %}\n\n\n    <!-- Recommended Fabric -->\n    {% if product.metafields.custom.recommended_fabric.value != blank %}\n      <div class=\"dtf-spec-item\">\n\n        <div class=\"dtf-spec-label\">\n          Recommended Fabric\n        </div>\n\n        <div class=\"dtf-spec-value dtf-fabric-list\">\n\n          {% for fabric in product.metafields.custom.recommended_fabric.value %}\n\n            <span class=\"dtf-tag\">\n              {{ fabric }}\n            </span>\n\n          {% endfor %}\n\n        </div>\n\n      </div>\n    {% endif %}\n\n\n    <!-- Finish -->\n    {% if product.metafields.custom.finish.value != blank %}\n      <div class=\"dtf-spec-item\">\n\n        <div class=\"dtf-spec-label\">\n          Finish\n        </div>\n\n        <div class=\"dtf-spec-value\">\n          {{ product.metafields.custom.finish.value }}\n        </div>\n\n      </div>\n    {% endif %}\n\n\n    <!-- Wash Care -->\n    {% if product.metafields.custom.wash_care.value != blank %}\n      <div class=\"dtf-spec-item\">\n\n        <div class=\"dtf-spec-label\">\n          Wash Care\n        </div>\n\n        <div class=\"dtf-spec-value dtf-wash-care\">\n          {{ product.metafields.custom.wash_care.value | newline_to_br }}\n        </div>\n\n      </div>\n    {% endif %}\n\n  </div>\n\n</section>\n\n\n<style>\n\n/* ================================\n   DTF Specifications\n================================ */\n\n.dtf-specs {\n  width: 100%;\n  max-width: 1200px;\n  margin: 60px auto;\n  padding: 0 20px;\n  box-sizing: border-box;\n}\n\n\n/* ================================\n   Title\n================================ */\n\n.dtf-specs-header {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 24px;\n  margin-bottom: 30px;\n}\n\n.dtf-specs-header h2 {\n  margin: 0;\n  padding: 0;\n  font-size: 28px;\n  line-height: 1.3;\n  font-weight: 600;\n  letter-spacing: -0.4px;\n  color: #151515;\n  white-space: nowrap;\n}\n\n.dtf-specs-line {\n  flex: 1;\n  height: 1px;\n  background: #e4e4e4;\n}\n\n\n/* ================================\n   Specifications Card\n================================ */\n\n.dtf-specs-card {\n  width: 100%;\n  border: 1px solid #e5e5e5;\n  border-radius: 8px;\n  overflow: hidden;\n  background: #ffffff;\n}\n\n\n/* ================================\n   Specification Row\n================================ */\n\n.dtf-spec-item {\n  display: grid;\n  grid-template-columns: 30% 70%;\n  min-height: 64px;\n  border-bottom: 1px solid #eeeeee;\n}\n\n.dtf-spec-item:last-child {\n  border-bottom: none;\n}\n\n\n/* ================================\n   Left Column\n================================ */\n\n.dtf-spec-label {\n  display: flex;\n  align-items: center;\n  padding: 18px 24px;\n  background: #fafafa;\n\n  font-size: 15px;\n  font-weight: 600;\n  line-height: 1.5;\n  color: #222222;\n\n  box-sizing: border-box;\n}\n\n\n/* ================================\n   Right Column\n================================ */\n\n.dtf-spec-value {\n  display: flex;\n  align-items: center;\n\n  padding: 18px 24px;\n\n  font-size: 15px;\n  line-height: 1.7;\n  color: #555555;\n\n  box-sizing: border-box;\n}\n\n\n/* ================================\n   Fabric Tags\n================================ */\n\n.dtf-fabric-list {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.dtf-tag {\n  display: inline-flex;\n  align-items: center;\n\n  padding: 6px 12px;\n\n  border: 1px solid #dddddd;\n  border-radius: 5px;\n\n  background: #ffffff;\n\n  font-size: 14px;\n  line-height: 1.4;\n  color: #444444;\n\n  white-space: nowrap;\n}\n\n\n/* ================================\n   Wash Care\n================================ */\n\n.dtf-wash-care {\n  line-height: 1.8;\n}\n\n\n/* ================================\n   Desktop\n================================ */\n\n@media screen and (min-width: 750px) {\n\n  .dtf-specs {\n    margin-top: 65px;\n    margin-bottom: 65px;\n  }\n\n  .dtf-spec-item:hover .dtf-spec-label {\n    background: #f7f7f7;\n  }\n\n}\n\n\n/* ================================\n   Mobile\n================================ */\n\n@media screen and (max-width: 749px) {\n\n  .dtf-specs {\n    margin: 40px auto;\n    padding: 0 16px;\n  }\n\n\n  /* 标题 */\n  .dtf-specs-header {\n    gap: 0;\n    margin-bottom: 22px;\n  }\n\n  .dtf-specs-header h2 {\n    font-size: 22px;\n    text-align: center;\n    white-space: normal;\n  }\n\n  .dtf-specs-line {\n    display: none;\n  }\n\n\n  /* 手机端改成上下结构 */\n  .dtf-spec-item {\n    display: block;\n    min-height: auto;\n  }\n\n\n  .dtf-spec-label {\n    display: block;\n\n    padding: 14px 16px 5px;\n\n    background: #ffffff;\n\n    font-size: 14px;\n  }\n\n\n  .dtf-spec-value {\n    display: block;\n\n    padding: 4px 16px 16px;\n\n    font-size: 14px;\n  }\n\n\n  /* Fabric */\n  .dtf-fabric-list {\n    gap: 6px;\n  }\n\n  .dtf-tag {\n    padding: 5px 10px;\n    font-size: 13px;\n  }\n\n}\n\n</style>\n\n{% endif %}",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
    },
