    "custom_liquid_pDYbWp": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<div class=\"desceci-product-content\">\n\n  <!-- =========================\n       How to Order\n  ========================== -->\n  <section class=\"desceci-section\">\n\n    <div class=\"desceci-section-title\">\n      <span></span>\n      <h2>How to Order</h2>\n      <span></span>\n    </div>\n\n    <div class=\"desceci-steps\">\n\n      <div class=\"desceci-step\">\n        <div class=\"desceci-step-number\">01</div>\n        <div>\n          <h3>Choose Your Size</h3>\n          <p>Select the transfer size that fits your design.</p>\n        </div>\n      </div>\n\n      <div class=\"desceci-step\">\n        <div class=\"desceci-step-number\">02</div>\n        <div>\n          <h3>Upload Your Artwork</h3>\n          <p>Upload your print-ready design.</p>\n        </div>\n      </div>\n\n      <div class=\"desceci-step\">\n        <div class=\"desceci-step-number\">03</div>\n        <div>\n          <h3>Choose Your Quantity</h3>\n          <p>Order the quantity you need for your project.</p>\n        </div>\n      </div>\n\n      <div class=\"desceci-step\">\n        <div class=\"desceci-step-number\">04</div>\n        <div>\n          <h3>We Print & Ship</h3>\n          <p>We'll print your design and prepare it for heat pressing.</p>\n        </div>\n      </div>\n\n    </div>\n\n    <div class=\"desceci-highlight\">\n      <strong>No weeding. No cutting. Just press and create.</strong>\n    </div>\n\n  </section>\n\n\n  <!-- =========================\n       DTF Specifications\n  ========================== -->\n  {% assign has_specs = false %}\n\n  {% if product.metafields.custom.press_temperature.value != blank %}\n    {% assign has_specs = true %}\n  {% endif %}\n\n  {% if product.metafields.custom.press_time.value != blank %}\n    {% assign has_specs = true %}\n  {% endif %}\n\n  {% if product.metafields.custom.pressure.value != blank %}\n    {% assign has_specs = true %}\n  {% endif %}\n\n  {% if product.metafields.custom.peel_method.value != blank %}\n    {% assign has_specs = true %}\n  {% endif %}\n\n  {% if product.metafields.custom.recommended_fabric.value != blank %}\n    {% assign has_specs = true %}\n  {% endif %}\n\n  {% if product.metafields.custom.finish.value != blank %}\n    {% assign has_specs = true %}\n  {% endif %}\n\n  {% if product.metafields.custom.wash_care.value != blank %}\n    {% assign has_specs = true %}\n  {% endif %}\n\n\n  {% if has_specs %}\n\n  <section class=\"desceci-section\">\n\n    <div class=\"desceci-section-title\">\n      <span></span>\n      <h2>DTF Transfer Specifications</h2>\n      <span></span>\n    </div>\n\n    <div class=\"desceci-spec-card\">\n\n      {% if product.metafields.custom.press_temperature.value != blank %}\n        <div class=\"desceci-spec-row\">\n          <div class=\"desceci-spec-label\">Press Temperature</div>\n          <div class=\"desceci-spec-value\">\n            {{ product.metafields.custom.press_temperature.value }}\n          </div>\n        </div>\n      {% endif %}\n\n      {% if product.metafields.custom.press_time.value != blank %}\n        <div class=\"desceci-spec-row\">\n          <div class=\"desceci-spec-label\">Press Time</div>\n          <div class=\"desceci-spec-value\">\n            {{ product.metafields.custom.press_time.value }}\n          </div>\n        </div>\n      {% endif %}\n\n      {% if product.metafields.custom.pressure.value != blank %}\n        <div class=\"desceci-spec-row\">\n          <div class=\"desceci-spec-label\">Pressure</div>\n          <div class=\"desceci-spec-value\">\n            {{ product.metafields.custom.pressure.value }}\n          </div>\n        </div>\n      {% endif %}\n\n      {% if product.metafields.custom.peel_method.value != blank %}\n        <div class=\"desceci-spec-row\">\n          <div class=\"desceci-spec-label\">Peel Method</div>\n          <div class=\"desceci-spec-value\">\n            {{ product.metafields.custom.peel_method.value }}\n          </div>\n        </div>\n      {% endif %}\n\n      {% if product.metafields.custom.recommended_fabric.value != blank %}\n        <div class=\"desceci-spec-row\">\n          <div class=\"desceci-spec-label\">Recommended Fabric</div>\n\n          <div class=\"desceci-spec-value desceci-fabric\">\n\n            {% for fabric in product.metafields.custom.recommended_fabric.value %}\n              <span>{{ fabric }}</span>\n            {% endfor %}\n\n          </div>\n        </div>\n      {% endif %}\n\n      {% if product.metafields.custom.finish.value != blank %}\n        <div class=\"desceci-spec-row\">\n          <div class=\"desceci-spec-label\">Finish</div>\n          <div class=\"desceci-spec-value\">\n            {{ product.metafields.custom.finish.value }}\n          </div>\n        </div>\n      {% endif %}\n\n      {% if product.metafields.custom.wash_care.value != blank %}\n        <div class=\"desceci-spec-row\">\n          <div class=\"desceci-spec-label\">Wash Care</div>\n          <div class=\"desceci-spec-value\">\n            {{ product.metafields.custom.wash_care.value | newline_to_br }}\n          </div>\n        </div>\n      {% endif %}\n\n    </div>\n\n  </section>\n\n  {% endif %}\n\n\n  <!-- =========================\n       Artwork Requirements\n  ========================== -->\n  <section class=\"desceci-section\">\n\n    <details class=\"desceci-accordion\">\n\n      <summary>\n        <span>Artwork Requirements</span>\n        <span class=\"desceci-plus\">+</span>\n      </summary>\n\n      <div class=\"desceci-accordion-content\">\n\n        <p>\n          For the best print quality, upload high-resolution, print-ready artwork.\n        </p>\n\n        <p>\n          <strong>Recommended file formats:</strong>\n          PNG, PDF, PSD, SVG, EPS, JPG\n        </p>\n\n        <ul>\n          <li>High-resolution artwork is recommended.</li>\n          <li>Transparent backgrounds are recommended for PNG files when appropriate.</li>\n          <li>Please make sure your artwork is sized correctly before uploading.</li>\n          <li>For best results, avoid extremely small text and fine details.</li>\n        </ul>\n\n      </div>\n\n    </details>\n\n  </section>\n\n\n  <!-- =========================\n       Great for Custom Apparel\n  ========================== -->\n  <section class=\"desceci-section\">\n\n    <div class=\"desceci-section-title\">\n      <span></span>\n      <h2>Great for Custom Apparel</h2>\n      <span></span>\n    </div>\n\n    <p class=\"desceci-intro\">\n      Custom DTF transfers are perfect for creating professional apparel,\n      merchandise, and personalized products.\n    </p>\n\n    <div class=\"desceci-use-grid\">\n\n      <div>T-Shirts</div>\n      <div>Hoodies</div>\n      <div>Sweatshirts</div>\n      <div>Tote Bags</div>\n      <div>Workwear</div>\n      <div>Team Apparel</div>\n      <div>Brand Merchandise</div>\n      <div>Promotional Apparel</div>\n\n    </div>\n\n  </section>\n\n\n  <!-- =========================\n       Multiple Designs\n  ========================== -->\n  <section class=\"desceci-gang\">\n\n    <div>\n\n      <span class=\"desceci-eyebrow\">\n        MULTIPLE DESIGNS?\n      </span>\n\n      <h2>Save Space With a DTF Gang Sheet</h2>\n\n      <p>\n        Have multiple designs to print?\n        Arrange several designs on one sheet and maximize your printing area.\n      </p>\n\n    </div>\n\n    <a href=\"/products/custom-dtf-gang-sheet\" class=\"desceci-button\">\n      Create a Gang Sheet\n    </a>\n\n  </section>\n\n\n  <!-- =========================\n       Why DESCECI\n  ========================== -->\n  <section class=\"desceci-section\">\n\n    <div class=\"desceci-section-title\">\n      <span></span>\n      <h2>Why DESCECI DTF Transfers?</h2>\n      <span></span>\n    </div>\n\n    <div class=\"desceci-benefits\">\n\n      <div class=\"desceci-benefit\">\n        <div class=\"desceci-icon\">✓</div>\n        <h3>Vibrant Colors</h3>\n        <p>\n          Rich colors, sharp details, and smooth gradients for professional-looking apparel.\n        </p>\n      </div>\n\n      <div class=\"desceci-benefit\">\n        <div class=\"desceci-icon\">✓</div>\n        <h3>Soft Feel & Strong Durability</h3>\n        <p>\n          A soft-touch finish designed to provide excellent comfort and durability.\n        </p>\n      </div>\n\n      <div class=\"desceci-benefit\">\n        <div class=\"desceci-icon\">✓</div>\n        <h3>Ready to Press</h3>\n        <p>\n          No traditional weeding or cutting required. Simply press, peel, and create.\n        </p>\n      </div>\n\n    </div>\n\n  </section>\n\n\n  <!-- =========================\n       FAQ\n  ========================== -->\n  <section class=\"desceci-section\">\n\n    <div class=\"desceci-section-title\">\n      <span></span>\n      <h2>Custom DTF Transfer FAQ</h2>\n      <span></span>\n    </div>\n\n\n    <div class=\"desceci-faq\">\n\n      <details>\n        <summary>\n          What is a custom DTF transfer?\n          <span>+</span>\n        </summary>\n\n        <div>\n          A custom DTF transfer is your artwork professionally printed onto\n          transfer film and prepared for heat press application.\n        </div>\n      </details>\n\n\n      <details>\n        <summary>\n          Do I need to weed the design?\n          <span>+</span>\n        </summary>\n\n        <div>\n          No. DTF transfers arrive ready for heat press application.\n          There is no traditional vinyl weeding or cutting required.\n        </div>\n      </details>\n\n\n      <details>\n        <summary>\n          Can I order just one transfer?\n          <span>+</span>\n        </summary>\n\n        <div>\n          Yes. DESCECI offers custom DTF transfers with no minimum order requirement.\n        </div>\n      </details>\n\n\n      <details>\n        <summary>\n          What artwork should I upload?\n          <span>+</span>\n        </summary>\n\n        <div>\n          For the best results, upload high-resolution, print-ready artwork.\n          PNG files with a transparent background are recommended when appropriate.\n          We also accept PDF, PSD, SVG, EPS, and JPG files.\n        </div>\n      </details>\n\n\n      <details>\n        <summary>\n          Can I use DTF transfers on hoodies and tote bags?\n          <span>+</span>\n        </summary>\n\n        <div>\n          Yes. DTF transfers work well on many common apparel materials,\n          including cotton, polyester, cotton/poly blends, T-shirts,\n          hoodies, sweatshirts, and tote bags.\n        </div>\n      </details>\n\n    </div>\n\n  </section>\n\n\n  <!-- =========================\n       Quality Guarantee\n  ========================== -->\n  <section class=\"desceci-section\">\n\n    <div class=\"desceci-section-title\">\n      <span></span>\n      <h2>Quality Guarantee</h2>\n      <span></span>\n    </div>\n\n\n    <details class=\"desceci-accordion\">\n\n      <summary>\n        <span>Our Promise to You</span>\n        <span class=\"desceci-plus\">+</span>\n      </summary>\n\n      <div class=\"desceci-guarantee\">\n\n        <div class=\"desceci-guarantee-column\">\n\n          <h3>Eligible for Free Replacement</h3>\n\n          <ul>\n            <li>Printing defects</li>\n            <li>Wrong size or design</li>\n            <li>Damage during transit</li>\n            <li>Missing items</li>\n            <li>Quality failure</li>\n          </ul>\n\n        </div>\n\n\n        <div class=\"desceci-guarantee-column\">\n\n          <h3>Not Eligible for Free Replacement</h3>\n\n          <ul>\n            <li>Artwork issues</li>\n            <li>Customer size or design errors</li>\n            <li>Improper application</li>\n            <li>Fabric incompatibility</li>\n            <li>Normal product variation</li>\n          </ul>\n\n        </div>\n\n      </div>\n\n    </details>\n\n  </section>\n\n</div>\n\n\n<style>\n\n.desceci-product-content {\n  max-width: 1200px;\n  margin: 0 auto;\n  color: #222;\n}\n\n\n/* =========================\n   Section\n========================= */\n\n.desceci-section {\n  margin: 60px 0;\n}\n\n\n/* =========================\n   Section Title\n========================= */\n\n.desceci-section-title {\n  display: flex;\n  align-items: center;\n  gap: 20px;\n  margin-bottom: 30px;\n}\n\n.desceci-section-title span {\n  flex: 1;\n  height: 1px;\n  background: #e5e5e5;\n}\n\n.desceci-section-title h2 {\n  margin: 0;\n  font-size: 28px;\n  line-height: 1.3;\n  font-weight: 600;\n  text-align: center;\n  white-space: nowrap;\n}\n\n\n/* =========================\n   How To Order\n========================= */\n\n.desceci-steps {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  border: 1px solid #e5e5e5;\n  border-radius: 8px;\n  overflow: hidden;\n}\n\n.desceci-step {\n  display: flex;\n  gap: 15px;\n  padding: 28px 22px;\n  border-right: 1px solid #e5e5e5;\n}\n\n.desceci-step:last-child {\n  border-right: none;\n}\n\n.desceci-step-number {\n  font-size: 20px;\n  font-weight: 700;\n  color: #222;\n}\n\n.desceci-step h3 {\n  margin: 0 0 7px;\n  font-size: 15px;\n}\n\n.desceci-step p {\n  margin: 0;\n  font-size: 14px;\n  line-height: 1.6;\n  color: #666;\n}\n\n\n/* =========================\n   Highlight\n========================= */\n\n.desceci-highlight {\n  margin-top: 18px;\n  padding: 18px;\n  text-align: center;\n  background: #f7f7f7;\n  border-radius: 6px;\n  font-size: 15px;\n}\n\n\n/* =========================\n   Specifications\n========================= */\n\n.desceci-spec-card {\n  border: 1px solid #e5e5e5;\n  border-radius: 8px;\n  overflow: hidden;\n}\n\n.desceci-spec-row {\n  display: grid;\n  grid-template-columns: 30% 70%;\n  min-height: 64px;\n  border-bottom: 1px solid #eeeeee;\n}\n\n.desceci-spec-row:last-child {\n  border-bottom: none;\n}\n\n.desceci-spec-label {\n  display: flex;\n  align-items: center;\n  padding: 18px 24px;\n  background: #fafafa;\n  font-size: 15px;\n  font-weight: 600;\n}\n\n.desceci-spec-value {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  padding: 18px 24px;\n  font-size: 15px;\n  line-height: 1.7;\n  color: #555;\n}\n\n.desceci-fabric {\n  gap: 7px;\n}\n\n.desceci-fabric span {\n  display: inline-flex;\n  padding: 5px 11px;\n  border: 1px solid #ddd;\n  border-radius: 5px;\n  background: #fff;\n  font-size: 14px;\n}\n\n\n/* =========================\n   Intro\n========================= */\n\n.desceci-intro {\n  max-width: 850px;\n  margin: 0 auto 25px;\n  text-align: center;\n  font-size: 16px;\n  line-height: 1.8;\n  color: #555;\n}\n\n\n/* =========================\n   Apparel Grid\n========================= */\n\n.desceci-use-grid {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 12px;\n}\n\n.desceci-use-grid div {\n  padding: 16px;\n  text-align: center;\n  border: 1px solid #e5e5e5;\n  border-radius: 6px;\n  font-size: 14px;\n  background: #fff;\n}\n\n\n/* =========================\n   Gang Sheet\n========================= */\n\n.desceci-gang {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 30px;\n  margin: 60px 0;\n  padding: 40px 45px;\n  border-radius: 8px;\n  background: #f7f7f7;\n}\n\n.desceci-eyebrow {\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: 1.5px;\n  color: #666;\n}\n\n.desceci-gang h2 {\n  margin: 8px 0 10px;\n  font-size: 25px;\n}\n\n.desceci-gang p {\n  margin: 0;\n  max-width: 650px;\n  font-size: 15px;\n  line-height: 1.7;\n  color: #555;\n}\n\n.desceci-button {\n  flex-shrink: 0;\n  padding: 14px 25px;\n  background: #222;\n  color: #fff;\n  text-decoration: none;\n  border-radius: 5px;\n  font-size: 14px;\n  font-weight: 600;\n}\n\n.desceci-button:hover {\n  opacity: .85;\n}\n\n\n/* =========================\n   Benefits\n========================= */\n\n.desceci-benefits {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 20px;\n}\n\n.desceci-benefit {\n  padding: 30px 25px;\n  text-align: center;\n  border: 1px solid #e5e5e5;\n  border-radius: 8px;\n}\n\n.desceci-icon {\n  width: 38px;\n  height: 38px;\n  margin: 0 auto 15px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border-radius: 50%;\n  background: #222;\n  color: #fff;\n  font-weight: 700;\n}\n\n.desceci-benefit h3 {\n  margin: 0 0 10px;\n  font-size: 17px;\n}\n\n.desceci-benefit p {\n  margin: 0;\n  font-size: 14px;\n  line-height: 1.7;\n  color: #666;\n}\n\n\n/* =========================\n   Accordion\n========================= */\n\n.desceci-accordion {\n  border: 1px solid #e5e5e5;\n  border-radius: 8px;\n  overflow: hidden;\n}\n\n.desceci-accordion summary {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 20px 24px;\n  cursor: pointer;\n  list-style: none;\n  font-size: 16px;\n  font-weight: 600;\n}\n\n.desceci-accordion summary::-webkit-details-marker {\n  display: none;\n}\n\n.desceci-plus {\n  font-size: 24px;\n  font-weight: 400;\n  transition: transform .2s;\n}\n\n.desceci-accordion[open] .desceci-plus {\n  transform: rotate(45deg);\n}\n\n.desceci-accordion-content {\n  padding: 0 24px 25px;\n  border-top: 1px solid #eeeeee;\n}\n\n.desceci-accordion-content p {\n  font-size: 15px;\n  line-height: 1.8;\n  color: #555;\n}\n\n.desceci-accordion-content li {\n  margin-bottom: 8px;\n  color: #555;\n}\n\n\n/* =========================\n   FAQ\n========================= */\n\n.desceci-faq {\n  border: 1px solid #e5e5e5;\n  border-radius: 8px;\n  overflow: hidden;\n}\n\n.desceci-faq details {\n  border-bottom: 1px solid #eeeeee;\n}\n\n.desceci-faq details:last-child {\n  border-bottom: none;\n}\n\n.desceci-faq summary {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 20px 24px;\n  cursor: pointer;\n  list-style: none;\n  font-size: 15px;\n  font-weight: 600;\n}\n\n.desceci-faq summary::-webkit-details-marker {\n  display: none;\n}\n\n.desceci-faq summary span {\n  font-size: 23px;\n  font-weight: 400;\n}\n\n.desceci-faq details[open] summary span {\n  transform: rotate(45deg);\n}\n\n.desceci-faq details > div {\n  padding: 0 24px 22px;\n  font-size: 15px;\n  line-height: 1.8;\n  color: #666;\n}\n\n\n/* =========================\n   Guarantee\n========================= */\n\n.desceci-guarantee {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 30px;\n  padding: 25px;\n  border-top: 1px solid #eeeeee;\n}\n\n.desceci-guarantee-column {\n  padding: 20px;\n  background: #fafafa;\n  border-radius: 6px;\n}\n\n.desceci-guarantee-column h3 {\n  margin-top: 0;\n  font-size: 16px;\n}\n\n.desceci-guarantee-column li {\n  margin-bottom: 8px;\n  font-size: 14px;\n  color: #555;\n}\n\n\n/* =========================\n   Mobile\n========================= */\n\n@media screen and (max-width: 749px) {\n\n  .desceci-product-content {\n    padding: 0 16px;\n  }\n\n  .desceci-section {\n    margin: 40px 0;\n  }\n\n  .desceci-section-title {\n    gap: 0;\n    margin-bottom: 22px;\n  }\n\n  .desceci-section-title span {\n    display: none;\n  }\n\n  .desceci-section-title h2 {\n    width: 100%;\n    white-space: normal;\n    font-size: 22px;\n  }\n\n\n  /* Steps */\n\n  .desceci-steps {\n    grid-template-columns: 1fr;\n  }\n\n  .desceci-step {\n    border-right: none;\n    border-bottom: 1px solid #e5e5e5;\n    padding: 20px;\n  }\n\n  .desceci-step:last-child {\n    border-bottom: none;\n  }\n\n\n  /* Specifications */\n\n  .desceci-spec-row {\n    display: block;\n  }\n\n  .desceci-spec-label {\n    padding: 14px 16px 5px;\n    background: #fff;\n    font-size: 14px;\n  }\n\n  .desceci-spec-value {\n    padding: 4px 16px 16px;\n    font-size: 14px;\n  }\n\n\n  /* Apparel */\n\n  .desceci-use-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n\n\n  /* Gang */\n\n  .desceci-gang {\n    display: block;\n    margin: 40px 0;\n    padding: 30px 25px;\n  }\n\n  .desceci-gang h2 {\n    font-size: 22px;\n  }\n\n  .desceci-button {\n    display: inline-block;\n    margin-top: 20px;\n  }\n\n\n  /* Benefits */\n\n  .desceci-benefits {\n    grid-template-columns: 1fr;\n  }\n\n\n  /* Guarantee */\n\n  .desceci-guarantee {\n    grid-template-columns: 1fr;\n    gap: 15px;\n    padding: 16px;\n  }\n\n  .desceci-guarantee-column {\n    padding: 18px;\n  }\n\n\n  /* Accordion */\n\n  .desceci-accordion summary,\n  .desceci-faq summary {\n    padding: 17px 16px;\n    font-size: 14px;\n  }\n\n  .desceci-accordion-content,\n  .desceci-faq details > div {\n    padding-left: 16px;\n    padding-right: 16px;\n  }\n\n}\n</style>",
