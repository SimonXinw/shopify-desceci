      "settings": {
        "custom_liquid": "<style>\n  .desceci-i3200-faq {\n    width: 100%;\n    padding: 76px 20px;\n    background: #ffffff;\n    font-family: Helvetica, Arial, sans-serif;\n  }\n\n  .desceci-i3200-faq__container {\n    max-width: 920px;\n    margin: 0 auto;\n  }\n\n  .desceci-i3200-faq__header {\n    margin-bottom: 38px;\n    text-align: center;\n  }\n\n  .desceci-i3200-faq__eyebrow {\n    margin: 0 0 13px;\n    color: #5c9143;\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 1.8px;\n    text-transform: uppercase;\n: uppercase;\n  }\n\n  .desceci-i3200-faq h2 {\n    margin: 0 0 15px;\n    color: #15243a;\n    font-size: 36px;\n    font-weight: 700;\n    line-height: 1.2;\n  }\n\n  .desceci-i3200-faq__intro {\n    margin: 0;\n    color: #697586;\n    font-size: 16px;\n    line-height: 1.7;\n  }\n\n  .desceci-i3200-faq__list {\n    border-top: 1px solid #dfe5ec;\n  }\n\n  .desceci-i3200-faq details {\n    border-bottom: 1px solid #dfe5ec;\n  }\n\n  .desceci-i3200-faq summary {\n    position: relative;\n    padding: 22px 48px 22px 0;\n    color: #15243a;\n    font-size: 16px;\n    font-weight: 700;\n    line-height: 1.5;\n    cursor: pointer;\n    list-style: none;\n  }\n\n  .desceci-i3200-faq summary::-webkit-details-marker {\n    display: none;\n  }\n\n  .desceci-i3200-faq summary::after {\n    content: \"+\";\n    position: absolute;\n    top: 19px;\n    right: 3px;\n    color: #5c9143;\n    font-size: 25px;\n    font-weight: 400;\n    line-height: 1;\n  }\n\n  .desceci-i3200-faq details[open] summary::after {\n    content: \"−\";\n  }\n\n  .desceci-i3200-faq details p {\n    max-width: 800px;\n    margin: -4px 0 22px;\n    padding-right: 30px;\n    color: #697586;\n    font-size: 14px;\n    line-height: 1.75;\n  }\n\n  .desceci-i3200-faq__contact {\n    margin-top: 34px;\n    padding: 22px 24px;\n    border: 1px solid #dfe7df;\n    border-radius: 6px;\n    background: #f7f9fc;\n    text-align: center;\n  }\n\n  .desceci-i3200-faq__contact p {\n    margin: 0;\n    color: #697586;\n    font-size: 14px;\n    line-height: 1.7;\n  }\n\n  .desceci-i3200-faq__contact a {\n    color: #5c9143;\n    font-weight: 700;\n    text-decoration: none;\n  }\n\n  .desceci-i3200-faq__contact a:hover {\n    color: #15243a;\n    text-decoration: underline;\n  }\n\n  @media screen and (max-width: 600px) {\n    .desceci-i3200-faq {\n      padding: 55px 16px;\n    }\n\n    .desceci-i3200-faq h2 {\n      font-size: 29px;\n    }\n\n    .desceci-i3200-faq__intro {\n      font-size: 15px;\n    }\n\n    .desceci-i3200-faq summary {\n      padding: 19px 38px 19px 0;\n      font-size: 15px;\n    }\n\n    .desceci-i3200-faq details p {\n      font-size: 14px;\n    }\n  }\n</style>\n\n<section class=\"desceci-i3200-faq\">\n  <div class=\"desceci-i3200-faq__container\">\n\n    <div class=\"desceci-i3200-faq__header\">\n      <p class=\"desceci-i3200-faq__eyebrow\">\n        I3200-A1 SUPPORT\n      </p>\n\n      <h2>\n        Frequently Asked Questions\n      </h2>\n\n      <p class=\"desceci-i3200-faq__intro\">\n        Find answers to common questions about the Epson I3200-A1 printhead,\n        compatibility, installation, and maintenance.\n      </p>\n    </div>\n\n    <div class=\"desceci-i3200-faq__list\">\n\n      <details>\n        <summary>\n          What type of ink is compatible with the I3200-A1 printhead?\n        </summary>\n\n        <p>\n          The I3200-A1 is designed for compatible aqueous pigment ink systems.\n          Please confirm the ink formulation and recommended viscosity before installation.\n        </p>\n      </details>\n\n      <details>\n        <summary>\n          How many nozzles does the I3200-A1 printhead have?\n        </summary>\n\n        <p>\n          The printhead has 3,200 nozzles arranged across 8 nozzle rows,\n          helping provide consistent ink placement and detailed print output.\n        </p>\n      </details>\n\n      <details>\n        <summary>\n          Is this printhead compatible with every DTF printer?\n        </summary>\n\n        <p>\n          No. Compatibility depends on the printer model, wiring, connector configuration,\n          control system, ink delivery system, and firmware. Always verify the complete\n          printer configuration before ordering.\n        </p>\n      </details>\n\n      <details>\n        <summary>\n          Should the printhead be installed by a professional?\n        </summary>\n\n        <p>\n          Professional installation is recommended. Incorrect wiring, flushing,\n          calibration, or ink setup may damage the printhead and affect print quality.\n        </p>\n      </details>\n\n      <details>\n        <summary>\n          What should I provide if I need help confirming compatibility?\n        </summary>\n\n        <p>\n          Please provide your printer brand and model, existing printhead model,\n          ink type, connector information, and a clear photo of the current printhead\n          or wiring connection.\n        </p>\n      </details>\n\n    </div>\n\n    <div class=\"desceci-i3200-faq__contact\">\n      <p>\n        Still unsure about compatibility?\n        <a href=\"mailto:desceci@outloonk.com?subject=I3200-A1%20Compatibility%20Support\">\n          Email desceci@outloonk.com\n        </a>\n        and our team will help you check before ordering.\n      </p>\n    </div>\n\n  </div>\n</section>",
