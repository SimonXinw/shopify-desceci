    "custom_liquid_mmDmRp": {
      "type": "custom-liquid",
      "name": "产品核心卖点",
      "settings": {
        "custom_liquid": "<style>\n  .desceci-i3200-intro {\n    width: 100%;\n    padding: 76px 20px;\n    background: #ffffff;\n    font-family: Helvetica, Arial, sans-serif;\n  }\n\n  .desceci-i3200-intro__container {\n    max-width: 1180px;\n    margin: 0 auto;\n  }\n\n  .desceci-i3200-intro__header {\n    max-width: 780px;\n    margin: 0 auto 46px;\n    text-align: center;\n  }\n\n  .desceci-i3200-intro__eyebrow {\n    margin: 0 0 13px;\n    color: #5c9143;\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 1.8px;\n    text-transform: uppercase;\n  }\n\n  .desceci-i3200-intro h2 {\n    margin: 0 0 18px;\n    color: #15243a;\n    font-size: 38px;\n    font-weight: 700;\n    line-height: 1.2;\n  }\n\n  .desceci-i3200-intro__subtitle {\n    margin: 0 auto;\n    color: #697586;\n    font-size: 17px;\n    line-height: 1.7;\n  }\n\n  .desceci-i3200-intro__grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 16px;\n  }\n\n  .desceci-i3200-intro__card {\n    min-height: 190px;\n    padding: 27px 22px;\n    border: 1px solid #e1e7ed;\n    border-radius: 6px;\n    background: #f7f9fc;\n  }\n\n  .desceci-i3200-intro__number {\n    margin-bottom: 19px;\n    color: #5c9143;\n    font-size: 27px;\n    font-weight: 700;\n  }\n\n  .desceci-i3200-intro__card h3 {\n    margin: 0 0 11px;\n    color: #15243a;\n    font-size: 17px;\n    font-weight: 700;\n    line-height: 1.35;\n  }\n\n  .desceci-i3200-intro__card p {\n    margin: 0;\n    color: #697586;\n    font-size: 14px;\n    line-height: 1.65;\n  }\n\n  .desceci-i3200-intro__note {\n    max-width: 850px;\n    margin: 38px auto 0;\n    padding: 18px 22px;\n    border-left: 4px solid #5c9143;\n    background: #f7f9fc;\n    color: #697586;\n    font-size: 14px;\n    line-height: 1.7;\n  }\n\n  .desceci-i3200-intro__note strong {\n    color: #15243a;\n  }\n\n  @media screen and (max-width: 900px) {\n    .desceci-i3200-intro__grid {\n      grid-template-columns: repeat(2, 1fr);\n    }\n  }\n\n  @media screen and (max-width: 600px) {\n    .desceci-i3200-intro {\n      padding: 55px 16px;\n    }\n\n    .desceci-i3200-intro__header {\n      margin-bottom: 32px;\n    }\n\n    .desceci-i3200-intro h2 {\n      font-size: 29px;\n    }\n\n    .desceci-i3200-intro__subtitle {\n      font-size: 15px;\n    }\n\n    .desceci-i3200-intro__grid {\n      grid-template-columns: 1fr;\n      gap: 12px;\n    }\n\n    .desceci-i3200-intro__card {\n      min-height: auto;\n    }\n  }\n</style>\n\n<section class=\"desceci-i3200-intro\">\n  <div class=\"desceci-i3200-intro__container\">\n\n    <div class=\"desceci-i3200-intro__header\">\n      <p class=\"desceci-i3200-intro__eyebrow\">\n        PROFESSIONAL DTF PRINTHEAD\n      </p>\n\n      <h2>\n        Epson I3200-A1 Printhead for High-Precision DTF Printing\n      </h2>\n\n      <p class=\"desceci-i3200-intro__subtitle\">\n        Built for demanding DTF production, the I3200-A1 delivers precise ink placement,\n        consistent print quality, and reliable performance for professional printing systems.\n      </p>\n    </div>\n\n    <div class=\"desceci-i3200-intro__grid\">\n\n      <div class=\"desceci-i3200-intro__card\">\n        <div class=\"desceci-i3200-intro__number\">3,200</div>\n        <h3>High-Density Nozzles</h3>\n        <p>\n          Delivers smooth color transitions, detailed images, and consistent ink output.\n        </p>\n      </div>\n\n      <div class=\"desceci-i3200-intro__card\">\n        <div class=\"desceci-i3200-intro__number\">33.8 mm</div>\n        <h3>Effective Print Width</h3>\n        <p>\n          Provides a practical print width for efficient and accurate DTF production.\n        </p>\n      </div>\n\n      <div class=\"desceci-i3200-intro__card\">\n        <div class=\"desceci-i3200-intro__number\">300 / 600</div>\n        <h3>High-Resolution Output</h3>\n        <p>\n          Supports 300 dpi per nozzle row and up to 600 dpi using two rows.\n        </p>\n      </div>\n\n      <div class=\"desceci-i3200-intro__card\">\n        <div class=\"desceci-i3200-intro__number\">4-Color</div>\n        <h3>Professional DTF Printing</h3>\n        <p>\n          Designed for four-color DTF systems using compatible aqueous pigment ink.\n        </p>\n      </div>\n\n    </div>\n\n    <div class=\"desceci-i3200-intro__note\">\n      <strong>Compatibility Notice:</strong>\n      Please confirm your printer model, ink type, connector configuration,\n      and installation requirements before ordering. Professional installation is recommended.\n    </div>\n\n  </div>\n</section>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
