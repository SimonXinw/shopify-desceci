    "custom_liquid_3QUB9M": {
      "type": "custom-liquid",
      "name": "Compatibility & Installation Guide",
      "settings": {
        "custom_liquid": "<style>\n  .desceci-i3200-compatibility {\n    width: 100%;\n    padding: 76px 20px;\n    background: #15243a;\n    font-family: Helvetica, Arial, sans-serif;\n  }\n\n  .desceci-i3200-compatibility__container {\n    max-width: 1120px;\n    margin: 0 auto;\n  }\n\n  .desceci-i3200-compatibility__header {\n    max-width: 760px;\n    margin: 0 auto 42px;\n    text-align: center;\n  }\n\n  .desceci-i3200-compatibility__eyebrow {\n    margin: 0 0 13px;\n    color: #9bc477;\n    font-size: 13px;\n    font-weight: 700;\n    letter-spacing: 1.8px;\n    text-transform: uppercase;\n  }\n\n  .desceci-i3200-compatibility h2 {\n    margin: 0 0 16px;\n    color: #ffffff;\n    font-size: 36px;\n    font-weight: 700;\n    line-height: 1.2;\n  }\n\n  .desceci-i3200-compatibility__intro {\n    margin: 0;\n    color: #c7d1df;\n    font-size: 16px;\n    line-height: 1.7;\n  }\n\n  .desceci-i3200-compatibility__steps {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 18px;\n  }\n\n  .desceci-i3200-compatibility__step {\n    padding: 28px 24px;\n    border: 1px solid rgba(255, 255, 255, 0.16);\n    border-radius: 6px;\n    background: rgba(255, 255, 255, 0.06);\n  }\n\n  .desceci-i3200-compatibility__step-number {\n    display: inline-flex;\n    width: 38px;\n    height: 38px;\n    align-items: center;\n    justify-content: center;\n    margin-bottom: 20px;\n    border-radius: 50%;\n    background: #5c9143;\n    color: #ffffff;\n    font-size: 15px;\n    font-weight: 700;\n  }\n\n  .desceci-i3200-compatibility__step h3 {\n    margin: 0 0 12px;\n    color: #ffffff;\n    font-size: 18px;\n    line-height: 1.35;\n  }\n\n  .desceci-i3200-compatibility__step p {\n    margin: 0;\n    color: #c7d1df;\n    font-size: 14px;\n    line-height: 1.7;\n  }\n\n  .desceci-i3200-compatibility__warning {\n    margin-top: 24px;\n    padding: 20px 24px;\n    border-left: 4px solid #9bc477;\n    background: rgba(255, 255, 255, 0.08);\n    color: #dce5ef;\n    font-size: 14px;\n    line-height: 1.7;\n  }\n\n  .desceci-i3200-compatibility__warning strong {\n    color: #ffffff;\n  }\n\n  @media screen and (max-width: 760px) {\n    .desceci-i3200-compatibility {\n      padding: 55px 16px;\n    }\n\n    .desceci-i3200-compatibility h2 {\n      font-size: 29px;\n    }\n\n    .desceci-i3200-compatibility__intro {\n      font-size: 15px;\n    }\n\n    .desceci-i3200-compatibility__steps {\n      grid-template-columns: 1fr;\n      gap: 12px;\n    }\n  }\n</style>\n\n<section class=\"desceci-i3200-compatibility\">\n  <div class=\"desceci-i3200-compatibility__container\">\n\n    <div class=\"desceci-i3200-compatibility__header\">\n      <p class=\"desceci-i3200-compatibility__eyebrow\">\n        BEFORE YOU ORDER\n      </p>\n\n      <h2>\n        Confirm Compatibility Before Installation\n      </h2>\n\n      <p class=\"desceci-i3200-compatibility__intro\">\n        Printhead compatibility depends on your printer configuration,\n        ink system, wiring, and installation setup.\n      </p>\n    </div>\n\n    <div class=\"desceci-i3200-compatibility__steps\">\n\n      <div class=\"desceci-i3200-compatibility__step\">\n        <span class=\"desceci-i3200-compatibility__step-number\">01</span>\n\n        <h3>Check Your Printer Model</h3>\n\n        <p>\n          Confirm that your printer is designed for an Epson I3200-A1\n          printhead before placing your order.\n        </p>\n      </div>\n\n      <div class=\"desceci-i3200-compatibility__step\">\n        <span class=\"desceci-i3200-compatibility__step-number\">02</span>\n\n        <h3>Verify Ink Compatibility</h3>\n\n        <p>\n          This printhead is intended for compatible aqueous pigment ink\n          systems. Confirm the ink type and recommended viscosity.\n        </p>\n      </div>\n\n      <div class=\"desceci-i3200-compatibility__step\">\n        <span class=\"desceci-i3200-compatibility__step-number\">03</span>\n\n        <h3>Use Professional Installation</h3>\n\n        <p>\n          Proper installation, wiring, flushing, and calibration are\n          important for stable print quality and reliable performance.\n        </p>\n      </div>\n\n    </div>\n\n    <div class=\"desceci-i3200-compatibility__warning\">\n      <strong>Important:</strong>\n      Printheads are precision components. Please compare the model,\n      connector configuration, ink system, and printer settings before ordering.\n      Damage caused by incorrect installation or incompatible ink may not be covered.\n    </div>\n\n  </div>\n</section>",
