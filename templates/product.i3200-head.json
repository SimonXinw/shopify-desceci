}\n\n  @media screen and (max-width: 600px) {\n    .desceci-i3200-intro {\n      padding: 55px 16px;\n    }\n\n    .desceci-i3200-intro__header {\n      margin-bottom: 32px;\n    }\n\n    .desceci-i3200-intro h2 {\n      font-size: 29px;\n    }\n\n    .desceci-i3200-intro__subtitle {\n      font-size: 15px;\n    }\n\n    .desceci-i3200-intro__grid {\n      grid-template-columns: 1fr;\n      gap: 12px;\n    }\n\n    .desceci-i3200-intro__card {\n      min-height: auto;\n    }\n  }\n</style>\n\n<section class=\"desceci-i3200-intro\">\n  <div class=\"desceci-i3200-intro__container\">\n\n    <div class=\"desceci-i3200-intro__header\">\n      <p class=\"desceci-i3200-intro__eyebrow\">\n        PROFESSIONAL DTF PRINTHEAD\n      </p>\n\n      <h2>\n        Epson I3200-A1 Printhead for High-Precision DTF Printing\n      </h2>\n\n      <p class=\"desceci-i3200-intro__subtitle\">\n        Built for demanding DTF production, the I3200-A1 delivers precise ink placement,\n        consistent print quality, and reliable performance for professional printing systems.\n      </p>\n    </div>\n\n    <div class=\"desceci-i3200-intro__grid\">\n\n      <div class=\"desceci-i3200-intro__card\">\n        <div class=\"desceci-i3200-intro__number\">3,200</div>\n        <h3>High-Density Nozzles</h3>\n        <p>\n          Delivers smooth color transitions, detailed images, and consistent ink output.\n        </p>\n      </div>\n\n      <div class=\"desceci-i3200-intro__card\">\n        <div class=\"desceci-i3200-intro__number\">33.8 mm</div>\n        <h3>Effective Print Width</h3>\n        <p>\n          Provides a practical print width for efficient and accurate DTF production.\n        </p>\n      </div>\n\n      <div class=\"desceci-i3200-intro__card\">\n        <div class=\"desceci-i3200-intro__number\">300 / 600</div>\n        <h3>High-Resolution Output</h3>\n        <p>\n          Supports 300 dpi per nozzle row and up to 600 dpi using two rows.\n        </p>\n      </div>\n\n      <div class=\"desceci-i3200-intro__card\">\n        <div class=\"desceci-i3200-intro__number\">4-Color</div>\n        <h3>Professional DTF Printing</h3>\n        <p>\n          Designed for four-color DTF systems using compatible aqueous pigment ink.\n        </p>\n      </div>\n\n    </div>\n\n    <div class=\"desceci-i3200-intro__note\">\n      <strong>Compatibility Notice:</strong>\n      Please confirm your printer model, ink type, connector configuration,\n      and installation requirements before ordering. Professional installation is recommended.\n    </div>\n\n  </div>\n</section>",
