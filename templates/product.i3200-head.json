eci-i3200-specs {\n      padding: 55px 16px;\n    }\n\n    .desceci-i3200-specs h2 {\n      font-size: 29px;\n    }\n\n    .desceci-i3200-specs__intro {\n      font-size: 15px;\n    }\n\n    .desceci-i3200-specs__table th,\n    .desceci-i3200-specs__table td {\n      padding: 14px 13px;\n      font-size: 13px;\n    }\n\n    .desceci-i3200-specs__table th {\n      width: 45%;\n    }\n  }\n</style>\n\n<section class=\"desceci-i3200-specs\">\n  <div class=\"desceci-i3200-specs__container\">\n\n    <div class=\"desceci-i3200-specs__header\">\n      <p class=\"desceci-i3200-specs__eyebrow\">\n        TECHNICAL DETAILS\n      </p>\n\n      <h2>\n        Epson I3200-A1 Printhead Specifications\n      </h2>\n\n      <p class=\"desceci-i3200-specs__intro\">\n        Review the key technical details before selecting the printhead\n        for your DTF printer system.\n      </p>\n    </div>\n\n    <div class=\"desceci-i3200-specs__table-wrap\">\n      <table class=\"desceci-i3200-specs__table\">\n        <tbody>\n          <tr>\n            <th>Printhead Model</th>\n            <td class=\"desceci-i3200-specs__highlight\">I3200-A1</td>\n          </tr>\n\n          <tr>\n            <th>Ink Type</th>\n            <td>Aqueous Pigment Ink</td>\n          </tr>\n\n          <tr>\n            <th>Number of Nozzles</th>\n            <td class=\"desceci-i3200-specs__highlight\">3,200</td>\n          </tr>\n\n          <tr>\n            <th>Nozzle Rows</th>\n            <td>8 Rows</td>\n          </tr>\n\n          <tr>\n            <th>Maximum Ink Colors</th>\n            <td>4 Colors</td>\n          </tr>\n\n          <tr>\n            <th>Resolution</th>\n            <td>300 dpi per row / 600 dpi using two rows</td>\n          </tr>\n\n          <tr>\n            <th>Effective Print Width</th>\n            <td class=\"desceci-i3200-specs__highlight\">33.8 mm</td>\n          </tr>\n\n          <tr>\n            <th>Dimensions</th>\n            <td>69.1 × 59.4 × 35.6 mm</td>\n          </tr>\n\n          <tr>\n            <th>Weight</th>\n            <td>82 g</td>\n          </tr>\n\n          <tr>\n            <th>Grayscale Levels</th>\n            <td>2-level, 3-level, and 4-level grayscale</td>\n          </tr>\n\n          <tr>\n            <th>Recommended Ink Viscosity</th>\n            <td>3–4 mPa·s</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n\n    <p class=\"desceci-i3200-specs__note\">\n      Specifications are provided for reference. Always confirm printer compatibility,\n      connector configuration, and installation requirements before ordering.\n    </p>\n\n  </div>\n</section>",
