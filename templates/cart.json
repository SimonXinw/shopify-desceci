      "settings": {
        "custom_liquid": "{% comment %}\nDESCECI Minimal Cart Rewards\nFor Shopify Custom Liquid\nUSD pricing / DTF transfer collection\n{% endcomment %}\n\n{% assign dc_total = 0 %}\n{% for item in cart.items %}\n  {% assign dc_ok = false %}\n  {% for col in item.product.collections %}\n    {% if col.handle == 'dtf-transfer' %}\n      {% assign dc_ok = true %}\n      {% break %}\n    {% endif %}\n  {% endfor %}\n  {% if dc_ok %}\n    {% assign dc_total = dc_total | plus: item.original_line_price %}\n  {% endif %}\n{% endfor %}\n\n{% assign dc_save = 0 %}\n{% assign dc_code = '' %}\n{% assign dc_next = 2500 %}\n{% assign dc_next_save = 3 %}\n\n{% if dc_total >= 30000 %}\n  {% assign dc_save = 30 %}\n  {% assign dc_code = 'DTF30' %}\n  {% assign dc_next = 0 %}\n{% elsif dc_total >= 15000 %}\n  {% assign dc_save = 15 %}\n  {% assign dc_code = 'DTF15' %}\n  {% assign dc_next = 30000 %}\n  {% assign dc_next_save = 30 %}\n{% elsif dc_total >= 8000 %}\n  {% assign dc_save = 8 %}\n  {% assign dc_code = 'DTF8' %}\n  {% assign dc_next = 15000 %}\n  {% assign dc_next_save = 15 %}\n{% elsif dc_total >= 4000 %}\n  {% assign dc_save = 5 %}\n  {% assign dc_code = 'DTF5' %}\n  {% assign dc_next = 8000 %}\n  {% assign dc_next_save = 8 %}\n{% elsif dc_total >= 2500 %}\n  {% assign dc_save = 3 %}\n  {% assign dc_code = 'DTF3' %}\n  {% assign dc_next = 4000 %}\n  {% assign dc_next_save = 5 %}\n{% endif %}\n\n{% assign dc_applied = false %}\n{% for discount in cart.cart_level_discount_applications %}\n  {% if discount.title == dc_code %}\n    {% assign dc_applied = true %}\n  {% endif %}\n{% endfor %}\n{% for item in cart.items %}\n  {% for allocation in item.line_level_discount_allocations %}\n    {% if allocation.discount_application.title == dc_code %}\n      {% assign dc_applied = true %}\n    {% endif %}\n  {% endfor %}\n{% endfor %}\n\n{% assign dc_progress = 100 %}\n{% if dc_next > 0 %}\n  {% assign dc_progress = dc_total | times: 100 | divided_by: dc_next %}\n  {% if dc_progress > 100 %}\n    {% assign dc_progress = 100 %}\n  {% endif %}\n{% endif %}\n\n<style>\n.dc-mini {\n  max-width: 1100px;\n  margin: 12px auto;\n  padding: 0 16px;\n  font-family: \"Helvetica Neue\", Arial, sans-serif;\n  color: #111827;\n}\n.dc-mini-card {\n  border-top: 1px solid #e5e7eb;\n  border-bottom: 1px solid #e5e7eb;\n  padding: 18px 0;\n  background: #fff;\n}\n.dc-mini-head {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 12px;\n  margin-bottom: 12px;\n}\n.dc-mini-title {\n  margin: 0;\n  font-size: 16px;\n  font-weight: 700;\n  color: #111827;\n}\n.dc-mini-status {\n  color: #15803d;\n  font-size: 13px;\n  font-weight: 600;\n  text-align: right;\n}\n.dc-mini-track {\n  background: #e5e7eb;\n  height: 5px;\n  border-radius: 10px;\n  overflow: hidden;\n}\n.dc-mini-fill {\n  height: 100%;\n  background: #2563eb;\n  border-radius: 10px;\n  transition: width .3s ease;\n}\n.dc-mini-message {\n  font-size: 13px;\n  line-height: 1.6;\n  margin: 12px 0 9px;\n}\n.dc-mini-message strong {\n  color: #1d4ed8;\n}\n.dc-mini-bottom {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 12px;\n  flex-wrap: wrap;\n  font-size: 12px;\n  color: #64748b;\n}\n.dc-mini-code {\n  display: inline-flex;\n  gap: 8px;\n  align-items: center;\n}\n.dc-mini-copy {\n  padding: 4px 10px;\n  border: 1px solid #cbd5e1;\n  border-radius: 5px;\n  background: #fff;\n  color: #111827;\n  font-size: 11px;\n  cursor: pointer;\n}\n.dc-mini-copy:hover {\n  border-color: #2563eb;\n  color: #2563eb;\n}\n.dc-mini-shipping {\n  margin: 12px 0 0;\n  font-size: 12px;\n  color: #64748b;\n}\n.dc-mini-note {\n  margin: 8px 0 0;\n  font-size: 11px;\n  color: #94a3b8;\n  line-height: 1.5;\n}\n@media(max-width:600px) {\n  .dc-mini {padding:0 12px;}\n  .dc-mini-title {font-size:15px;}\n  .dc-mini-status {font-size:12px;}\n  .dc-mini-message {font-size:12px;}\n}\n</style>\n\n<div class=\"dc-mini\"\n  data-dc-mini\n  data-dc-section=\"{{ section.id | escape }}\">\n\n  <div data-dc-inner>\n    {% if cart.item_count > 0 %}\n    <div class=\"dc-mini-card\">\n\n      <div class=\"dc-mini-head\">\n        <h2 class=\"dc-mini-title\">\n          DTF Transfer Savings\n        </h2>\n\n        {% if dc_applied %}\n          <span class=\"dc-mini-status\">\n            &#10003; ${{ dc_save }} Saved\n          </span>\n        {% elsif dc_save > 0 %}\n          <span class=\"dc-mini-status\">\n            ${{ dc_save }} Reward Unlocked\n          </span>\n        {% endif %}\n      </div>\n\n      <div class=\"dc-mini-track\"\n        role=\"progressbar\"\n        aria-label=\"Next discount progress\"\n        aria-valuemin=\"0\"\n        aria-valuemax=\"100\"\n        aria-valuenow=\"{{ dc_progress }}\">\n        <div class=\"dc-mini-fill\"\n          style=\"width:{{ dc_progress }}%\">\n        </div>\n      </div>\n\n      {% if dc_next > 0 %}\n        {% assign dc_missing = dc_next | minus: dc_total %}\n        <p class=\"dc-mini-message\">\n          Add <strong>{{ dc_missing | money }}</strong>\n          more in DTF Transfers to unlock\n          <strong>${{ dc_next_save }} OFF.</strong>\n        </p>\n      {% else %}\n        <p class=\"dc-mini-message\">\n          You've unlocked the highest reward:\n          <strong>$30 OFF!</strong>\n        </p>\n      {% endif %}\n\n      <div class=\"dc-mini-bottom\">\n        {% if dc_save > 0 %}\n          <div class=\"dc-mini-code\">\n            {% if dc_applied %}\n              <span>{{ dc_code }} applied</span>\n            {% else %}\n              <span>Use code: <b>{{ dc_code }}</b></span>\n              <button type=\"button\"\n                class=\"dc-mini-copy\"\n                data-dc-copy=\"{{ dc_code }}\">\n                Copy\n              </button>\n            {% endif %}\n          </div>\n        {% else %}\n          <span>Rewards start at $25</span>\n        {% endif %}\n\n        {% if dc_next > 0 %}\n          <span>Next: {{ dc_next | money }} / ${{ dc_next_save }} OFF</span>\n        {% endif %}\n      </div>\n\n      <p class=\"dc-mini-shipping\">\n        Free U.S. shipping on eligible orders $150+\n      </p>\n\n      <p class=\"dc-mini-note\">\n        One qualifying discount per order.\n        Actual savings and shipping are\n        confirmed at checkout.\n      </p>\n\n    </div>\n    {% endif %}\n  </div>\n</div>\n\n<script>\n(function () {\n  const nodes = document.querySelectorAll('[data-dc-mini]');\n  const root = nodes[nodes.length - 1];\n\n  if (!root || root.dataset.ready === '1') return;\n  root.dataset.ready = '1';\n\n  const id = root.dataset.dcSection;\n  const base = window.Shopify?.routes?.root || '/';\n\n  let lastSignature = '';\n  let busy = false;\n\n  async function refresh() {\n    if (busy || document.hidden || !root.isConnected) return;\n    busy = true;\n\n    try {\n      const response = await fetch(base + 'cart.js', {\n        cache: 'no-store'\n      });\n\n      if (!response.ok) return;\n\n      const cart = await response.json();\n      const signature = JSON.stringify({\n        items: cart.items.map(i => [\n          i.key, i.quantity,\n          i.original_line_price,\n          i.line_price\n        ]),\n        discount: cart.total_discount\n      });\n\n      if (signature === lastSignature) return;\n\n      const url = base + 'cart?section_id=' +\n        encodeURIComponent(id);\n\n      const sectionResponse = await fetch(url, {\n        cache: 'no-store'\n      });\n\n      if (!sectionResponse.ok) return;\n\n      const html = await sectionResponse.text();\n      const doc = new DOMParser().parseFromString(\n        html, 'text/html'\n      );\n\n      const fresh = doc.querySelector('[data-dc-mini]');\n      const source = fresh?.querySelector('[data-dc-inner]');\n      const target = root.querySelector('[data-dc-inner]');\n\n      if (!source || !target) return;\n\n      target.innerHTML = source.innerHTML;\n      lastSignature = signature;\n\n    } catch (error) {\n      console.warn('DESCECI cart rewards:', error);\n    } finally {\n      busy = false;\n    }\n  }\n\n  root.addEventListener('click', async function(event) {\n    const btn = event.target.closest('[data-dc-copy]');\n    if (!btn) return;\n\n    const code = btn.dataset.dcCopy;\n\n    try {\n      await navigator.clipboard.writeText(code);\n      btn.textContent = 'Copied';\n    } catch(e) {\n      btn.textContent = code;\n    }\n  });\n\n  document.addEventListener('change', function(event) {\n    if (event.target.closest('form[action*=\"/cart\"]')) {\n      setTimeout(refresh, 500);\n      setTimeout(refresh, 1500);\n    }\n  });\n\n  const timer = setInterval(function() {\n    if (!root.isConnected) {\n      clearInterval(timer);\n      return;\n    }\n    refresh();\n  }, 2000);\n\n  document.addEventListener('visibilitychange', function() {\n    if (!document.hidden) refresh();\n  });\n\n  refresh();\n})();\n</script>",
