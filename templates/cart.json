        "custom_liquid": "{% comment %}\nDESCECI CART REWARDS\nCustom Liquid - Complete Version\nFive discount tiers + copy codes\nEligible collection: dtf-transfer\nAll thresholds in USD cents\n{% endcomment %}\n\n{% liquid\n  assign dc_total = 0\n\n  for item in cart.items\n    assign dc_eligible = false\n\n    for collection in item.product.collections\n      if collection.handle == 'dtf-transfer'\n        assign dc_eligible = true\n        break\n      endif\n    endfor\n\n    if dc_eligible\n      assign dc_total = dc_total | plus: item.original_line_price\n    endif\n  endfor\n\n  assign dc_reward = 0\n  assign dc_code = ''\n  assign dc_next = 2500\n  assign dc_next_reward = 3\n\n  if dc_total >= 30000\n    assign dc_reward = 30\n    assign dc_code = 'DTF30'\n    assign dc_next = 0\n  elsif dc_total >= 15000\n    assign dc_reward = 15\n    assign dc_code = 'DTF15'\n    assign dc_next = 30000\n    assign dc_next_reward = 30\n  elsif dc_total >= 8000\n    assign dc_reward = 8\n    assign dc_code = 'DTF8'\n    assign dc_next = 15000\n    assign dc_next_reward = 15\n  elsif dc_total >= 4000\n    assign dc_reward = 5\n    assign dc_code = 'DTF5'\n    assign dc_next = 8000\n    assign dc_next_reward = 8\n  elsif dc_total >= 2500\n    assign dc_reward = 3\n    assign dc_code = 'DTF3'\n    assign dc_next = 4000\n    assign dc_next_reward = 5\n  endif\n\n  assign dc_progress = 100\n  assign dc_missing = 0\n\n  if dc_next > 0\n    assign dc_missing = dc_next | minus: dc_total\n    assign dc_progress = dc_total | times: 100 | divided_by: dc_next\n\n    if dc_progress > 100\n      assign dc_progress = 100\n    endif\n  endif\n\n  assign dc_applied = false\n\n  if dc_code != blank\n    for discount in cart.cart_level_discount_applications\n      if discount.title == dc_code\n        assign dc_applied = true\n      endif\n    endfor\n\n    for item in cart.items\n      for allocation in item.line_level_discount_allocations\n        if allocation.discount_application.title == dc_code\n          assign dc_applied = true\n        endif\n      endfor\n    endfor\n  endif\n%}\n\n<style>\n.dc-rewards {\n  max-width: 1080px;\n  margin: 18px auto;\n  padding: 0 16px;\n  font-family: Arial, Helvetica, sans-serif;\n  color: #111827;\n}\n\n.dc-rewards * {\n  box-sizing: border-box;\n}\n\n.dc-rewards-panel {\n  border-top: 1px solid #e5e7eb;\n  border-bottom: 1px solid #e5e7eb;\n  padding: 20px 0;\n}\n\n.dc-rewards-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  margin-bottom: 8px;\n}\n\n.dc-rewards-title {\n  margin: 0;\n  font-size: 18px;\n  font-weight: 700;\n  color: #111827;\n  line-height: 1.4;\n}\n\n.dc-rewards-subtitle {\n  margin: 0 0 18px;\n  font-size: 12px;\n  color: #64748b;\n}\n\n.dc-rewards-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  margin-bottom: 12px;\n  font-size: 13px;\n}\n\n.dc-rewards-amount {\n  font-size: 19px;\n  font-weight: 700;\n  color: #111827;\n  white-space: nowrap;\n}\n\n.dc-rewards-track {\n  height: 6px;\n  width: 100%;\n  overflow: hidden;\n  border-radius: 20px;\n  background: #e5e7eb;\n}\n\n.dc-rewards-fill {\n  height: 100%;\n  border-radius: 20px;\n  background: #4169e1;\n  transition: width .35s ease;\n}\n\n.dc-rewards-status {\n  margin: 14px 0 10px;\n  font-size: 14px;\n  font-weight: 700;\n  color: #16803d;\n}\n\n.dc-rewards-next {\n  margin: 12px 0 0;\n  color: #374151;\n  font-size: 13px;\n  line-height: 1.6;\n}\n\n.dc-rewards-next strong {\n  color: #2563eb;\n}\n\n.dc-rewards-code {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 15px;\n  margin-top: 12px;\n  padding: 13px 15px;\n  border: 1px solid #dbeafe;\n  border-radius: 8px;\n  background: #f8fbff;\n}\n\n.dc-rewards-code-info {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.dc-rewards-code-label {\n  font-size: 11px;\n  color: #64748b;\n}\n\n.dc-rewards-code-value {\n  font-size: 19px;\n  font-weight: 800;\n  letter-spacing: .5px;\n  color: #111827;\n}\n\n.dc-rewards-code-note {\n  font-size: 11px;\n  color: #64748b;\n}\n\n.dc-rewards-copy {\n  border: 1px solid #111827;\n  border-radius: 5px;\n  padding: 10px 15px;\n  background: #111827;\n  color: white;\n  font-size: 12px;\n  font-weight: 600;\n  cursor: pointer;\n  white-space: nowrap;\n  transition: background .2s ease;\n}\n\n.dc-rewards-copy:hover {\n  background: #2563eb;\n  border-color: #2563eb;\n}\n\n.dc-rewards-tiers {\n  margin: 18px 0 0;\n  color: #64748b;\n  font-size: 11px;\n  line-height: 1.9;\n}\n\n.dc-rewards-tiers-label {\n  display: block;\n  margin-bottom: 2px;\n}\n\n.dc-rewards-shipping {\n  margin: 12px 0 0;\n  font-size: 11px;\n  line-height: 1.6;\n  color: #64748b;\n}\n\n.dc-rewards-terms {\n  margin: 7px 0 0;\n  color: #94a3b8;\n  font-size: 10px;\n  line-height: 1.5;\n}\n\n@media(max-width: 600px) {\n  .dc-rewards {\n    padding: 0 12px;\n    margin: 12px auto;\n  }\n\n  .dc-rewards-panel {\n    padding: 15px 0;\n  }\n\n  .dc-rewards-title {\n    font-size: 16px;\n  }\n\n  .dc-rewards-amount {\n    font-size: 17px;\n  }\n\n  .dc-rewards-code {\n    padding: 12px;\n  }\n\n  .dc-rewards-copy {\n    padding: 9px 11px;\n  }\n\n  .dc-rewards-code-value {\n    font-size: 17px;\n  }\n}\n\n@media(prefers-reduced-motion: reduce) {\n  .dc-rewards-fill {\n    transition: none;\n  }\n}\n</style>\n\n<div\n  class=\"dc-rewards\"\n  data-dc-rewards\n  data-section-id=\"{{ section.id | escape }}\"\n>\n  <div data-dc-content>\n\n    {% if cart.item_count > 0 %}\n\n      <div class=\"dc-rewards-panel\">\n\n        <div class=\"dc-rewards-header\">\n          <h2 class=\"dc-rewards-title\">\n            🎁 DTF Transfer Savings\n          </h2>\n        </div>\n\n        <p class=\"dc-rewards-subtitle\">\n          Save up to $30 on Custom DTF Transfers\n        </p>\n\n        <div class=\"dc-rewards-row\">\n          <span>Eligible DTF Transfers</span>\n          <strong class=\"dc-rewards-amount\">\n            {{ dc_total | money }}\n          </strong>\n        </div>\n\n        <div\n          class=\"dc-rewards-track\"\n          role=\"progressbar\"\n          aria-label=\"Next reward progress\"\n          aria-valuemin=\"0\"\n          aria-valuemax=\"100\"\n          aria-valuenow=\"{{ dc_progress }}\"\n        >\n          <div\n            class=\"dc-rewards-fill\"\n            style=\"width: {{ dc_progress }}%;\"\n          ></div>\n        </div>\n\n        {% if dc_reward > 0 %}\n\n          <p class=\"dc-rewards-status\">\n            ✓ You've unlocked ${{ dc_reward }} OFF!\n          </p>\n\n          <div class=\"dc-rewards-code\">\n\n            <div class=\"dc-rewards-code-info\">\n              <span class=\"dc-rewards-code-label\">\n                Your Discount Code\n              </span>\n\n              <strong class=\"dc-rewards-code-value\">\n                {{ dc_code }}\n              </strong>\n\n              <span class=\"dc-rewards-code-note\">\n                {% if dc_applied %}\n                  Discount code applied\n                {% else %}\n                  Copy and enter at checkout\n                {% endif %}\n              </span>\n            </div>\n\n            {% unless dc_applied %}\n              <button\n                type=\"button\"\n                class=\"dc-rewards-copy\"\n                data-copy-discount=\"{{ dc_code }}\"\n                aria-label=\"Copy {{ dc_code }}\"\n              >\n                Copy Code\n              </button>\n            {% endunless %}\n\n          </div>\n\n        {% endif %}\n\n        {% if dc_next > 0 %}\n\n          <p class=\"dc-rewards-next\">\n            Add\n            <strong>{{ dc_missing | money }}</strong>\n            more in DTF Transfers to unlock\n            <strong>${{ dc_next_reward }} OFF</strong>\n          </p>\n\n        {% else %}\n\n          <p class=\"dc-rewards-status\">\n            Maximum $30 reward unlocked!\n          </p>\n\n        {% endif %}\n\n        <div class=\"dc-rewards-tiers\">\n          <span class=\"dc-rewards-tiers-label\">\n            Rewards:\n          </span>\n\n          $25 → $3 OFF &nbsp; | &nbsp;\n          $40 → $5 OFF &nbsp; | &nbsp;\n          $80 → $8 OFF &nbsp; | &nbsp;\n          $150 → $15 OFF &nbsp; | &nbsp;\n          $300 → $30 OFF\n        </div>\n\n        <p class=\"dc-rewards-shipping\">\n          🚚 Free U.S. shipping on eligible orders $150+\n        </p>\n\n        <p class=\"dc-rewards-terms\">\n          DTF Transfers only. One qualifying discount\n          per order. Final eligibility and savings\n          are verified at checkout.\n        </p>\n\n      </div>\n\n    {% endif %}\n\n  </div>\n</div>\n\n<script>\n(function() {\n  const roots = document.querySelectorAll(\n    '[data-dc-rewards]'\n  );\n\n  const root = roots[roots.length - 1];\n\n  if (!root || root.dataset.initialized === 'true') {\n    return;\n  }\n\n  root.dataset.initialized = 'true';\n\n  const sectionId = root.dataset.sectionId;\n  const shopRoot = window.Shopify?.routes?.root || '/';\n\n  let lastSignature = null;\n  let updating = false;\n\n  root.addEventListener('click', async function(event) {\n    const button = event.target.closest(\n      '[data-copy-discount]'\n    );\n\n    if (!button) return;\n\n    const code = button.getAttribute(\n      'data-copy-discount'\n    );\n\n    try {\n      await navigator.clipboard.writeText(code);\n\n      button.textContent = 'Copied!';\n      button.setAttribute(\n        'aria-label',\n        'Discount code copied'\n      );\n\n      setTimeout(function() {\n        if (button.isConnected) {\n          button.textContent = 'Copy Code';\n          button.setAttribute(\n            'aria-label',\n            'Copy ' + code\n          );\n        }\n      }, 2000);\n\n    } catch (error) {\n      button.textContent = code;\n      button.setAttribute(\n        'aria-label',\n        'Select discount code ' + code\n      );\n    }\n  });\n\n  async function refreshRewards() {\n    if (\n      updating ||\n      document.hidden ||\n      !root.isConnected\n    ) {\n      return;\n    }\n\n    updating = true;\n\n    try {\n      const cartResponse = await fetch(\n        shopRoot + 'cart.js',\n        { cache: 'no-store' }\n      );\n\n      if (!cartResponse.ok) return;\n\n      const cart = await cartResponse.json();\n\n      const signature = JSON.stringify({\n        items: cart.items.map(function(item) {\n          return [\n            item.key,\n            item.quantity,\n            item.original_line_price,\n            item.line_price\n          ];\n        }),\n        discount: cart.total_discount\n      });\n\n      if (signature === lastSignature) return;\n\n      if (!sectionId) return;\n\n      const sectionResponse = await fetch(\n        shopRoot + 'cart?section_id=' +\n        encodeURIComponent(sectionId),\n        { cache: 'no-store' }\n      );\n\n      if (!sectionResponse.ok) return;\n\n      const html = await sectionResponse.text();\n\n      const doc = new DOMParser().parseFromString(\n        html,\n        'text/html'\n      );\n\n      const freshRoot = doc.querySelector(\n        '[data-dc-rewards]'\n      );\n\n      const freshContent = freshRoot?.querySelector(\n        '[data-dc-content]'\n      );\n\n      const currentContent = root.querySelector(\n        '[data-dc-content]'\n      );\n\n      if (!freshContent || !currentContent) {\n        return;\n      }\n\n      currentContent.innerHTML = freshContent.innerHTML;\n      lastSignature = signature;\n\n    } catch (error) {\n      console.warn(\n        'DESCECI rewards update:',\n        error\n      );\n    } finally {\n      updating = false;\n    }\n  }\n\n  document.addEventListener(\n    'change',\n    function(event) {\n      if (event.target.closest(\n        'form[action*=\"/cart\"]'\n      )) {\n        setTimeout(refreshRewards, 600);\n        setTimeout(refreshRewards, 1500);\n      }\n    }\n  );\n\n  const timer = setInterval(function() {\n    if (!root.isConnected) {\n      clearInterval(timer);\n      return;\n    }\n\n    refreshRewards();\n  }, 2000);\n\n  document.addEventListener(\n    'visibilitychange',\n    function() {\n      if (!document.hidden) {\n        refreshRewards();\n      }\n    }\n  );\n\n  refreshRewards();\n})();\n</script>",
