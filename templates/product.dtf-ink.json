ft:40px;\n\n\n}\n\n\n\n\n\n.contact-info div{\n\n\nmargin-bottom:22px;\n\n\n}\n\n\n\n\n.contact-info strong{\n\n\nfont-size:15px;\n\ncolor:#111827;\n\n\n}\n\n\n\n\n.contact-info p{\n\n\nmargin:5px 0 0;\n\nfont-size:14px;\n\ncolor:#6b7280;\n\n\n}\n\n\n\n\n\n@media(max-width:800px){\n\n\n.contact-box{\n\n\nflex-direction:column;\n\npadding:35px;\n\nalign-items:flex-start;\n\n\n}\n\n\n\n.contact-info{\n\n\nborder-left:none;\n\nborder-top:1px solid #e5e7eb;\n\npadding-left:0;\n\npadding-top:30px;\n\nwidth:100%;\n\n\n}\n\n\n\n.contact-content h2{\n\n\nfont-size:28px;\n\n\n}\n\n\n}\n\n\n\n</style>",
