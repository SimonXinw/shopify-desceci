gin-bottom:50px;\n\n\n}\n\n\n\n\n.color-header span{\n\n\nfont-size:14px;\n\nletter-spacing:3px;\n\nfont-weight:600;\n\ncolor:#61865d;\n\n\n}\n\n\n\n\n.color-header h2{\n\n\nfont-size:36px;\n\nfont-weight:700;\n\ncolor:#111827;\n\nmargin:12px 0;\n\n\n}\n\n\n\n\n\n.color-header p{\n\n\nfont-size:17px;\n\nline-height:1.6;\n\ncolor:#6b7280;\n\nmax-width:700px;\n\nmargin:auto;\n\n\n}\n\n\n\n\n\n\n.color-layout{\n\n\ndisplay:flex;\n\nalign-items:center;\n\ngap:60px;\n\n\n}\n\n\n\n\n\n.color-image{\n\n\nflex:1;\n\ntext-align:center;\n\n\n}\n\n\n\n\n.color-image img{\n\n\nwidth:100%;\n\nmax-width:520px;\n\nobject-fit:contain;\n\n\n}\n\n\n\n\n\n\n.color-content{\n\n\nflex:1;\n\n\n}\n\n\n\n\n\n.color-item{\n\n\ndisplay:flex;\n\nalign-items:center;\n\ngap:20px;\n\nmargin-bottom:22px;\n\n\n}\n\n\n\n\n\n.color-box{\n\n\nwidth:48px;\n\nheight:48px;\n\nborder-radius:50%;\n\ndisplay:flex;\n\nalign-items:center;\n\njustify-content:center;\n\nfont-size:20px;\n\nfont-weight:700;\n\n\n}\n\n\n\n.cyan{\n\nbackground:#38a5e0;\n\ncolor:white;\n\n}\n\n\n\n.magenta{\n\nbackground:#d94c87;\n\ncolor:white;\n\n}\n\n\n\n.yellow{\n\nbackground:#f2c94c;\n\ncolor:#111;\n\n}\n\n\n\n.black{\n\nbackground:#111827;\n\ncolor:white;\n\n}\n\n\n\n.white{\n\nbackground:white;\n\nborder:1px solid #ddd;\n\ncolor:#111;\n\n}\n\n\n\n.color-item h3{\n\n\nmargin:0 0 5px;\n\nfont-size:20px;\n\ncolor:#111827;\n\n\n}\n\n\n\n\n\n.color-item p{\n\n\nmargin:0;\n\ncolor:#6b7280;\n\nfont-size:15px;\n\n\n}\n\n\n\n\n\n.color-btn{\n\n\ndisplay:block;\n\nwidth:max-content;\n\nmargin:45px auto 0;\n\nbackground:#111827;\n\ncolor:white;\n\npadding:15px 35px;\n\nfont-weight:600;\n\ntext-decoration:none;\n\n\n}\n\n\n\n\n\n@media(max-width:900px){\n\n\n.color-layout{\n\n\nflex-direction:column;\n\n\n}\n\n\n\n.color-header h2{\n\n\nfont-size:30px;\n\n\n}\n\n\n\n}\n\n\n\n</style>",
