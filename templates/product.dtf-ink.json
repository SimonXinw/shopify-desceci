    "custom_liquid_96rzNL": {
      "type": "custom-liquid",
      "name": "faq",
      "settings": {
        "custom_liquid": "<section class=\"desceci-faq\">\n\n\n<div class=\"faq-container\">\n\n\n<div class=\"faq-header\">\n\n\n<span>\nDTF INK FAQ\n</span>\n\n\n<h2>\nFrequently Asked Questions\n</h2>\n\n\n<p>\nEverything you need to know about DESCECI DTF Ink performance,\ncompatibility, and usage.\n</p>\n\n\n</div>\n\n\n\n\n\n<div class=\"faq-list\">\n\n\n\n<div class=\"faq-item\">\n\n<details>\n\n<summary>\nWhat is DTF ink?\n<span>+</span>\n</summary>\n\n\n<div class=\"faq-answer\">\n\nDTF ink is specially formulated ink used for Direct-to-Film printing.\nIt delivers vibrant colors, smooth ink flow, and reliable transfer\nperformance for apparel printing.\n\n</div>\n\n\n</details>\n\n</div>\n\n\n\n\n\n<div class=\"faq-item\">\n\n<details>\n\n<summary>\nWhich printers are compatible with DESCECI DTF ink?\n<span>+</span>\n</summary>\n\n\n<div class=\"faq-answer\">\n\nDESCECI DTF ink is designed for Epson printhead platforms including\nI3200, I1600, F1080, and XP600 printheads.\n\n</div>\n\n\n</details>\n\n</div>\n\n\n\n\n\n\n<div class=\"faq-item\">\n\n<details>\n\n<summary>\nDoes DTF printing require white ink?\n<span>+</span>\n</summary>\n\n\n<div class=\"faq-answer\">\n\nYes. White DTF ink creates the base layer that allows CMYK colors\nto appear bright and accurate on dark and colored fabrics.\n\n</div>\n\n\n</details>\n\n</div>\n\n\n\n\n\n\n<div class=\"faq-item\">\n\n<details>\n\n<summary>\nHow should DTF ink be stored?\n<span>+</span>\n</summary>\n\n\n<div class=\"faq-answer\">\n\nStore DTF ink in a cool, dry place away from direct sunlight.\nShake white ink gently before use to maintain consistent performance.\n\n</div>\n\n\n</details>\n\n</div>\n\n\n\n\n\n\n\n<div class=\"faq-item\">\n\n<details>\n\n<summary>\nHow long does DTF ink last?\n<span>+</span>\n</summary>\n\n\n<div class=\"faq-answer\">\n\nWhen properly stored, unopened DTF ink can typically maintain\nquality for up to 12 months.\n\n</div>\n\n\n</details>\n\n</div>\n\n\n\n\n\n\n<div class=\"faq-item\">\n\n<details>\n\n<summary>\nCan DESCECI DTF ink be used for commercial printing?\n<span>+</span>\n</summary>\n\n\n<div class=\"faq-answer\">\n\nYes. DESCECI DTF ink is designed for small businesses,\napparel brands, and professional DTF printing production.\n\n</div>\n\n\n</details>\n\n</div>\n\n\n\n</div>\n\n\n</div>\n\n\n</section>\n\n\n\n\n\n\n<style>\n\n\n.desceci-faq{\n\npadding:70px 20px;\n\nbackground:#f8fafc;\n\n}\n\n\n\n\n.faq-container{\n\nmax-width:950px;\n\nmargin:auto;\n\n}\n\n\n\n\n.faq-header{\n\ntext-align:center;\n\nmargin-bottom:40px;\n\n}\n\n\n\n\n.faq-header span{\n\nfont-size:12px;\n\nletter-spacing:3px;\n\nfont-weight:600;\n\ncolor:#6f8664;\n\n}\n\n\n\n\n.faq-header h2{\n\nfont-size:36px;\n\nmargin:12px 0;\n\ncolor:#111827;\n\nfont-weight:700;\n\n}\n\n\n\n\n.faq-header p{\n\nfont-size:16px;\n\ncolor:#6b7280;\n\nline-height:1.6;\n\n}\n\n\n\n\n.faq-item{\n\nbackground:#ffffff;\n\nborder:1px solid #e5e7eb;\n\nmargin-bottom:12px;\n\n}\n\n\n\n\n.faq-item summary{\n\nlist-style:none;\n\ncursor:pointer;\n\npadding:22px 25px;\n\nfont-size:17px;\n\nfont-weight:600;\n\ncolor:#111827;\n\ndisplay:flex;\n\njustify-content:space-between;\n\nalign-items:center;\n\n}\n\n\n\n\n.faq-item summary span{\n\nfont-size:24px;\n\nfont-weight:400;\n\n}\n\n\n\n\n.faq-answer{\n\npadding:0 25px 22px;\n\nfont-size:15px;\n\nline-height:1.7;\n\ncolor:#6b7280;\n\n}\n\n\n\ndetails[open] summary span{\n\ntransform:rotate(45deg);\n\n}\n\n\n\n@media(max-width:700px){\n\n.faq-header h2{\n\nfont-size:30px;\n\n}\n\n}\n\n\n</style>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
