    "custom_liquid_BYthXQ": {
      "type": "custom-liquid",
      "name": "Technical Performance & Quality Testing",
      "settings": {
        "custom_liquid": "<section class=\"desceci-ink-testing\">\n  <div class=\"desceci-ink-testing__inner\">\n    \n    <div class=\"desceci-ink-testing__header\">\n      <span class=\"desceci-ink-testing__eyebrow\">DESCECI DTF INK TESTING</span>\n      <h2 class=\"desceci-ink-testing__title\">Technical Performance & Quality Testing</h2>\n      <p class=\"desceci-ink-testing__subtitle\">\n        DESCECI DTF Ink is tested for printing stability, color performance, and transfer reliability.\n      </p>\n    </div>\n\n    <div class=\"desceci-ink-testing__accordion\">\n\n      <!-- 01 -->\n      <details class=\"desceci-test-item\">\n        <summary class=\"desceci-test-summary\">\n          <div class=\"desceci-test-summary__left\">\n            <span class=\"desceci-test-number\">01</span>\n            <div class=\"desceci-test-heading\">\n              <h3>Ink Flow Stability Test</h3>\n              <p>Continuous printing performance</p>\n            </div>\n          </div>\n          <span class=\"desceci-test-toggle\">+</span>\n        </summary>\n\n        <div class=\"desceci-test-content\">\n          <p class=\"desceci-test-intro\">\n            Continuous printing tests ensure smooth ink delivery and stable output performance across CMYK + White ink channels.\n          </p>\n\n          <div class=\"desceci-test-table-wrap\">\n            <table class=\"desceci-test-table\">\n              <tr>\n                <th>Ink Channel</th>\n                <td>C</td>\n                <td>M</td>\n                <td>Y</td>\n                <td>K</td>\n                <td>W</td>\n              </tr>\n              <tr>\n                <th>Cleaning Cycles</th>\n                <td>1</td>\n                <td>1</td>\n                <td>1</td>\n                <td>1</td>\n                <td>1</td>\n              </tr>\n              <tr>\n                <th>100㎡ Printing Test</th>\n                <td>No broken lines, stable output</td>\n                <td>No broken lines, stable output</td>\n                <td>No broken lines, stable output</td>\n                <td>No broken lines, stable output</td>\n                <td>No broken lines, stable output</td>\n              </tr>\n              <tr>\n                <th>Result</th>\n                <td>Pass</td>\n                <td>Pass</td>\n                <td>Pass</td>\n                <td>Pass</td>\n                <td>Pass</td>\n              </tr>\n            </table>\n          </div>\n\n          <ul class=\"desceci-test-points\">\n            <li>CMYK + White ink channels tested</li>\n            <li>100㎡ continuous printing evaluation</li>\n            <li>Stable flow with no broken lines</li>\n            <li>Suitable for long-run DTF production</li>\n          </ul>\n        </div>\n      </details>\n\n      <!-- 02 -->\n      <details class=\"desceci-test-item\">\n        <summary class=\"desceci-test-summary\">\n          <div class=\"desceci-test-summary__left\">\n            <span class=\"desceci-test-number\">02</span>\n            <div class=\"desceci-test-heading\">\n              <h3>Nozzle Stability Test</h3>\n              <p>Standby printhead performance</p>\n            </div>\n          </div>\n          <span class=\"desceci-test-toggle\">+</span>\n        </summary>\n\n        <div class=\"desceci-test-content\">\n          <p class=\"desceci-test-intro\">\n            Evaluated after extended standby periods to confirm smooth restart and stable printhead performance.\n          </p>\n\n          <div class=\"desceci-test-table-wrap\">\n            <table class=\"desceci-test-table narrow\">\n              <tr>\n                <th>Time</th>\n                <td>12 Hours</td>\n                <td>24 Hours</td>\n                <td>36 Hours</td>\n              </tr>\n              <tr>\n                <th>Broken Lines</th>\n                <td>0</td>\n                <td>0</td>\n                <td>0</td>\n              </tr>\n              <tr>\n                <th>Result</th>\n                <td>Pass</td>\n                <td>Pass</td>\n                <td>Pass</td>\n              </tr>\n            </table>\n          </div>\n\n          <ul class=\"desceci-test-points\">\n            <li>12-hour standby test passed</li>\n            <li>24-hour standby test passed</li>\n            <li>36-hour standby test passed</li>\n            <li>Reliable nozzle recovery and ink output</li>\n          </ul>\n        </div>\n      </details>\n\n      <!-- 03 -->\n      <details class=\"desceci-test-item\">\n        <summary class=\"desceci-test-summary\">\n          <div class=\"desceci-test-summary__left\">\n            <span class=\"desceci-test-number\">03</span>\n            <div class=\"desceci-test-heading\">\n              <h3>Color Fastness Performance</h3>\n              <p>Durability after transfer</p>\n            </div>\n          </div>\n          <span class=\"desceci-test-toggle\">+</span>\n        </summary>\n\n        <div class=\"desceci-test-content\">\n          <p class=\"desceci-test-intro\">\n            Tested for post-transfer durability including dry rubbing, wet rubbing, and washing resistance.\n          </p>\n\n          <div class=\"desceci-test-table-wrap\">\n            <table class=\"desceci-test-table narrow\">\n              <tr>\n                <th>Test Item</th>\n                <td>Dry Rubbing</td>\n                <td>Wet Rubbing</td>\n                <td>Wash Resistance</td>\n              </tr>\n              <tr>\n                <th>Grade</th>\n                <td>4</td>\n                <td>3</td>\n                <td>4-5</td>\n              </tr>\n              <tr>\n                <th>Result</th>\n                <td>Pass</td>\n                <td>Pass</td>\n                <td>Pass</td>\n              </tr>\n            </table>\n          </div>\n\n          <ul class=\"desceci-test-points\">\n            <li>Dry rubbing: Grade 4</li>\n            <li>Wet rubbing: Grade 3</li>\n            <li>Wash resistance: Grade 4-5</li>\n            <li>Designed for long-lasting vibrant transfers</li>\n          </ul>\n\n          <p class=\"desceci-test-note\">Grade scale: 0–5, with 5 being the best performance.</p>\n        </div>\n      </details>\n\n      <!-- 04 -->\n      <details class=\"desceci-test-item\">\n        <summary class=\"desceci-test-summary\">\n          <div class=\"desceci-test-summary__left\">\n            <span class=\"desceci-test-number\">04</span>\n            <div class=\"desceci-test-heading\">\n              <h3>Application Compatibility</h3>\n              <p>System-level print application tests</p>\n            </div>\n          </div>\n          <span class=\"desceci-test-toggle\">+</span>\n        </summary>\n\n        <div class=\"desceci-test-content\">\n          <p class=\"desceci-test-intro\">\n            Verified across key DTF application scenarios to ensure reliable production performance.\n          </p>\n\n          <div class=\"desceci-test-table-wrap\">\n            <table class=\"desceci-test-table\">\n              <tr>\n                <th>Test Item</th>\n                <td>Color Density</td>\n                <td>White / Color Compatibility</td>\n                <td>Ink Bleeding Resistance</td>\n                <td>Heavy Ink Load</td>\n                <td>Clean Peel</td>\n              </tr>\n              <tr>\n                <th>Result</th>\n                <td>Pass</td>\n                <td>Pass</td>\n                <td>Pass</td>\n                <td>Pass</td>\n                <td>Pass</td>\n              </tr>\n            </table>\n          </div>\n\n          <ul class=\"desceci-test-points\">\n            <li>Color density performance verified</li>\n            <li>White and color ink compatibility tested</li>\n            <li>Stable under high ink load conditions</li>\n            <li>Clean peeling and reliable transfer results</li>\n          </ul>\n        </div>\n      </details>\n\n    </div>\n  </div>\n</section>\n\n<style>\n  .desceci-ink-testing {\n    padding: 70px 20px;\n    background: #f5f6f8;\n  }\n\n  .desceci-ink-testing__inner {\n    max-width: 1180px;\n    margin: 0 auto;\n  }\n\n  .desceci-ink-testing__header {\n    text-align: center;\n    margin-bottom: 34px;\n  }\n\n  .desceci-ink-testing__eyebrow {\n    display: inline-block;\n    font-size: 13px;\n    letter-spacing: 3px;\n    color: #6f8664;\n    font-weight: 600;\n    margin-bottom: 12px;\n  }\n\n  .desceci-ink-testing__title {\n    margin: 0 0 14px;\n    font-size: 46px;\n    line-height: 1.15;\n    color: #0f172a;\n    font-weight: 700;\n  }\n\n  .desceci-ink-testing__subtitle {\n    max-width: 780px;\n    margin: 0 auto;\n    font-size: 18px;\n    line-height: 1.7;\n    color: #6b7280;\n  }\n\n  .desceci-ink-testing__accordion {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 18px;\n  }\n\n  .desceci-test-item {\n    background: #fff;\n    border: 1px solid #e5e7eb;\n    border-radius: 0;\n    overflow: hidden;\n  }\n\n  .desceci-test-summary {\n    list-style: none;\n    cursor: pointer;\n    padding: 22px 24px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 20px;\n  }\n\n  .desceci-test-summary::-webkit-details-marker {\n    display: none;\n  }\n\n  .desceci-test-summary__left {\n    display: flex;\n    align-items: center;\n    gap: 18px;\n  }\n\n  .desceci-test-number {\n    font-size: 44px;\n    line-height: 1;\n    font-weight: 700;\n    color: #6f8664;\n    min-width: 62px;\n  }\n\n  .desceci-test-heading h3 {\n    margin: 0 0 4px;\n    font-size: 28px;\n    line-height: 1.2;\n    color: #0f172a;\n    font-weight: 700;\n  }\n\n  .desceci-test-heading p {\n    margin: 0;\n    font-size: 15px;\n    color: #6b7280;\n  }\n\n  .desceci-test-toggle {\n    font-size: 28px;\n    line-height: 1;\n    color: #0f172a;\n    font-weight: 400;\n    transition: transform 0.2s ease;\n  }\n\n  .desceci-test-item[open] .desceci-test-toggle {\n    transform: rotate(45deg);\n  }\n\n  .desceci-test-content {\n    padding: 0 24px 24px;\n    border-top: 1px solid #eef1f4;\n  }\n\n  .desceci-test-intro {\n    margin: 18px 0 18px;\n    font-size: 15px;\n    line-height: 1.8;\n    color: #6b7280;\n  }\n\n  .desceci-test-table-wrap {\n    overflow-x: auto;\n    margin-bottom: 18px;\n  }\n\n  .desceci-test-table {\n    width: 100%;\n    border-collapse: collapse;\n    min-width: 560px;\n    font-size: 14px;\n    color: #374151;\n  }\n\n  .desceci-test-table th,\n  .desceci-test-table td {\n    border: 1px solid #e5e7eb;\n    padding: 10px 12px;\n    text-align: left;\n    vertical-align: top;\n  }\n\n  .desceci-test-table th {\n    background: #f8fafc;\n    font-weight: 600;\n    color: #111827;\n    white-space: nowrap;\n  }\n\n  .desceci-test-table.narrow {\n    min-width: 420px;\n  }\n\n  .desceci-test-points {\n    margin: 0;\n    padding-left: 18px;\n  }\n\n  .desceci-test-points li {\n    margin-bottom: 10px;\n    font-size: 15px;\n    line-height: 1.7;\n    color: #374151;\n  }\n\n  .desceci-test-note {\n    margin-top: 14px;\n    font-size: 13px;\n    color: #6b7280;\n  }\n\n  @media (max-width: 990px) {\n    .desceci-ink-testing__accordion {\n      grid-template-columns: 1fr;\n    }\n\n    .desceci-ink-testing__title {\n      font-size: 38px;\n    }\n  }\n\n  @media (max-width: 640px) {\n    .desceci-ink-testing {\n      padding: 50px 16px;\n    }\n\n    .desceci-ink-testing__title {\n      font-size: 30px;\n    }\n\n    .desceci-ink-testing__subtitle {\n      font-size: 16px;\n    }\n\n    .desceci-test-summary {\n      padding: 18px 18px;\n    }\n\n    .desceci-test-summary__left {\n      align-items: flex-start;\n      gap: 14px;\n    }\n\n    .desceci-test-number {\n      font-size: 34px;\n      min-width: 46px;\n    }\n\n    .desceci-test-heading h3 {\n      font-size: 22px;\n    }\n\n    .desceci-test-content {\n      padding: 0 18px 18px;\n    }\n  }\n</style>",
