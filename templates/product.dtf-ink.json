        "custom_liquid": "<section class=\"desceci-related-products\">\n\n\n<div class=\"related-container\">\n\n\n<div class=\"related-header\">\n\n<span>\nRELATED PRODUCTS\n</span>\n\n\n<h2>\nComplete Your DTF Printing Setup\n</h2>\n\n\n<p>\nComplete your DTF workflow with premium materials,\ncompatible printheads, and professional equipment.\n</p>\n\n</div>\n\n\n\n\n\n<div class=\"related-grid\">\n\n\n\n{% assign products = \"dtf-film|dtf-powder|epson-i3200-printhead-for-dtf-printers-sublimation-printer|products-double-station-hydraulic-heat-press\" | split:\"|\" %}\n\n\n\n{% for handle in products %}\n\n\n{% assign related_product = all_products[handle] %}\n\n\n\n{% if related_product != blank %}\n\n\n\n<div class=\"related-card\">\n\n\n<a href=\"{{ related_product.url }}\">\n\n\n\n<div class=\"related-image\">\n\n\n<img\n\nsrc=\"{{ related_product.featured_image | image_url: width:600 }}\"\n\nalt=\"{{ related_product.title }}\"\n\nloading=\"lazy\"\n\n>\n\n\n</div>\n\n\n\n\n\n<div class=\"related-content\">\n\n\n<h3>\n{{ related_product.title }}\n</h3>\n\n\n<span>\nView Product →\n</span>\n\n\n</div>\n\n\n\n</a>\n\n\n</div>\n\n\n\n{% endif %}\n\n\n\n{% endfor %}\n\n\n\n</div>\n\n\n</div>\n\n\n</section>\n\n\n\n\n\n\n\n<style>\n\n\n.desceci-related-products{\n\npadding:65px 20px;\n\nbackground:#ffffff;\n\n}\n\n\n\n.related-container{\n\nmax-width:1200px;\n\nmargin:auto;\n\n}\n\n\n\n\n.related-header{\n\ntext-align:center;\n\nmargin-bottom:45px;\n\n}\n\n\n\n\n.related-header span{\n\nfont-size:12px;\n\nletter-spacing:3px;\n\nfont-weight:600;\n\ncolor:#6f8664;\n\n}\n\n\n\n\n.related-header h2{\n\nfont-size:36px;\n\nfont-weight:700;\n\nline-height:1.25;\n\ncolor:#111827;\n\nmargin:12px 0;\n\n}\n\n\n\n\n.related-header p{\n\nfont-size:16px;\n\nline-height:1.6;\n\ncolor:#6b7280;\n\nmax-width:720px;\n\nmargin:auto;\n\n}\n\n\n\n\n\n.related-grid{\n\ndisplay:grid;\n\ngrid-template-columns:repeat(4,1fr);\n\ngap:22px;\n\n}\n\n\n\n\n.related-card{\n\nborder:1px solid #e5e7eb;\n\nbackground:#ffffff;\n\noverflow:hidden;\n\ntransition:.3s;\n\n}\n\n\n\n\n.related-card:hover{\n\ntransform:translateY(-5px);\n\nbox-shadow:0 12px 30px rgba(0,0,0,.08);\n\n}\n\n\n\n\n.related-card a{\n\ntext-decoration:none;\n\ncolor:inherit;\n\n}\n\n\n\n\n\n.related-image{\n\nheight:230px;\n\nbackground:#f8fafc;\n\ndisplay:flex;\n\nalign-items:center;\n\njustify-content:center;\n\n}\n\n\n\n\n.related-image img{\n\nwidth:100%;\n\nheight:100%;\n\nobject-fit:contain;\n\n}\n\n\n\n\n\n.related-content{\n\npadding:22px;\n\n}\n\n\n\n\n\n.related-content h3{\n\nfont-size:18px;\n\nfont-weight:600;\n\nline-height:1.45;\n\ncolor:#111827;\n\nmargin:0 0 15px;\n\n}\n\n\n\n\n\n.related-content span{\n\nfont-size:15px;\n\nfont-weight:600;\n\ncolor:#6f8664;\n\n}\n\n\n\n\n\n@media(max-width:1000px){\n\n\n.related-grid{\n\ngrid-template-columns:repeat(2,1fr);\n\n}\n\n\n}\n\n\n\n\n\n@media(max-width:600px){\n\n\n.related-grid{\n\ngrid-template-columns:1fr;\n\n}\n\n\n\n.related-header h2{\n\nfont-size:30px;\n\n}\n\n\n}\n\n\n\n</style>",
