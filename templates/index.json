/s/files/1/1030/0420/9521/files/4ccf59c8-c3af-4eab-8369-9a066a335ae9.png?v=1789720761&width=400 400w,\n          https://cdn.shopify.com/s/files/1/1030/0420/9521/files/4ccf59c8-c3af-4eab-8369-9a066a335ae9.png?v=1789720761&width=650 650w,\n          https://cdn.shopify.com/s/files/1/1030/0420/9521/files/4ccf59c8-c3af-4eab-8369-9a066a335ae9.png?v=1789720761&width=800 800w\n          \"\n\n          sizes=\"(max-width: 749px) 92vw, 29vw\"\n\n          width=\"800\"\n          height=\"600\"\n\n          loading=\"lazy\"\n          decoding=\"async\"\n\n          alt=\"Custom DTF transfers and ready-to-press gang sheets by DESCECI\"\n        >\n\n      </div>\n\n    </a>\n\n\n\n    <!-- ================= 02 DTF SUPPLIES ================= -->\n\n    <a\n      href=\"/collections/dtf-consumables\"\n      class=\"desceci-shop-card\"\n      aria-label=\"Shop DTF printing supplies\"\n    >\n\n      <div class=\"desceci-shop-card__content\">\n\n        <div class=\"desceci-shop-card__label\">\n          Printing Supplies\n        </div>\n\n        <h3 class=\"desceci-shop-card__title\">\n          DTF Supplies\n        </h3>\n\n        <p class=\"desceci-shop-card__description\">\n          Professional DTF ink, transfer film,\n          adhesive powder and printing consumables\n          for reliable production.\n        </p>\n\n        <span class=\"desceci-shop-card__cta\">\n          Shop DTF Supplies\n          <span class=\"desceci-shop-card__arrow\">→</span>\n        </span>\n\n      </div>\n\n      <div class=\"desceci-shop-card__media\">\n\n        <img\n          class=\"desceci-shop-card__image\"\n\n          src=\"https://cdn.shopify.com/s/files/1/1030/0420/9521/files/4f7367d2-de8e-4324-b209-07a2cca52f8d.png?v=1789720760&width=650\"\n\n          srcset=\"\n          https://cdn.shopify.com/s/files/1/1030/0420/9521/files/4f7367d2-de8e-4324-b209-07a2cca52f8d.png?v=1789720760&width=400 400w,\n          https://cdn.shopify.com/s/files/1/1030/0420/9521/files/4f7367d2-d