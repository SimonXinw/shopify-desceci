n  color: inherit;\n  text-decoration: none !important;\n\n  transition:\n    transform .2s ease,\n    border-color .2s ease,\n    box-shadow .2s ease;\n}\n\n.desceci-guide:hover {\n  transform: translateY(-2px);\n\n  border-color: #d2d2d2;\n\n  box-shadow: 0 10px 28px rgba(0,0,0,.045);\n}\n\n\n/* ================= NUMBER ================= */\n\n.desceci-guide__number {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  width: 70px;\n  height: 70px;\n\n  border-radius: 50%;\n\n  background: #f4f5f4;\n\n  color: #111;\n\n  font-size: 13px;\n  line-height: 1;\n  font-weight: 700;\n\n  letter-spacing: .04em;\n\n  transition:\n    background .2s ease,\n    color .2s ease;\n}\n\n.desceci-guide:hover\n.desceci-guide__number {\n  background: #111;\n  color: #5ade00;\n}\n\n\n/* ================= CONTENT ================= */\n\n.desceci-guide__content {\n  min-width: 0;\n}\n\n\n/* ================= CATEGORY ================= */\n\n.desceci-guide__category {\n  margin: 0 0 7px;\n\n  color: #58b92e;\n\n  font-size: 8px;\n  line-height: 1.3;\n  font-weight: 700;\n\n  letter-spacing: .09em;\n  text-transform: uppercase;\n}\n\n\n/* ================= TITLE ================= */\n\n.desceci-guide__title {\n  margin: 0 0 7px;\n\n  color: #111;\n\n  font-size: 18px;\n  line-height: 1.25;\n  font-weight: 700;\n\n  letter-spacing: -.015em;\n}\n\n\n/* ================= TEXT ================= */\n\n.desceci-guide__text {\n  max-width: 500px;\n\n  margin: 0 0 13px;\n\n  color: #6c6c6c;\n\n  font-size: 10.5px;\n  line-height: 1.55;\n}\n\n\n/* ================= READ ================= */\n\n.desceci-guide__read {\n  display: inline-flex;\n  align-items: center;\n\n  color: #111;\n\n  font-size: 8px;\n  line-height: 1.3;\n  font-weight: 700;\n\n  letter-spacing: .055em;\n  text-transform: uppercase;\n}\n\n.desceci-guide__read::after {\n  content: \"→\";\n\n  margin-left: 7px;\n\n  color: #58b92e;\n\n  font-size: 14px;\n\n  transition: transform .2s ease;\n}\n\n.desceci-