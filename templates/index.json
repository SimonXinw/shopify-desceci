        "custom_liquid": "<style>\n/* =========================================================\n   DESCECI — HOW IT WORKS\n   Compact / Responsive / SEO Friendly\n   ========================================================= */\n\n.desceci-how {\n  width: 100%;\n  padding: 62px 24px 66px;\n  background: #f6f7f6;\n  box-sizing: border-box;\n}\n\n.desceci-how *,\n.desceci-how *::before,\n.desceci-how *::after {\n  box-sizing: border-box;\n}\n\n.desceci-how__inner {\n  width: 100%;\n  max-width: 1400px;\n  margin: 0 auto;\n}\n\n\n/* ================= HEADER ================= */\n\n.desceci-how__header {\n  max-width: 720px;\n  margin: 0 auto 34px;\n  text-align: center;\n}\n\n.desceci-how__eyebrow {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 9px;\n\n  margin: 0 0 8px;\n\n  color: #555;\n\n  font-size: 9px;\n  line-height: 1.4;\n  font-weight: 700;\n\n  letter-spacing: .12em;\n  text-transform: uppercase;\n}\n\n.desceci-how__eyebrow::before,\n.desceci-how__eyebrow::after {\n  content: \"\";\n\n  width: 22px;\n  height: 2px;\n\n  background: #5ade00;\n}\n\n.desceci-how__title {\n  margin: 0 0 10px;\n\n  color: #111;\n\n  font-size: clamp(32px, 3vw, 44px);\n  line-height: 1.08;\n  font-weight: 700;\n\n  letter-spacing: -.03em;\n}\n\n.desceci-how__intro {\n  max-width: 620px;\n  margin: 0 auto;\n\n  color: #666;\n\n  font-size: 13.5px;\n  line-height: 1.6;\n}\n\n\n/* =========================================================\n   STEPS\n   ========================================================= */\n\n.desceci-how__steps {\n  position: relative;\n\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n\n  gap: 0;\n\n  border: 1px solid #e5e5e5;\n  border-radius: 7px;\n\n  background: #fff;\n\n  overflow: hidden;\n}\n\n\n/* ================= STEP ================= */\n\n.desceci-how__step {\n  position: relative;\n\n  min-width: 0;\n\n  padding: 30px 27px 29px;\n\n  border-right: 1px solid #e5e5e5;\n\n  background: #fff;\n}\n\n.desceci-how__step:last-child {\n  border-right: 0;\n}\n\n.desceci-how__step::before {\n  content: \"\";\n\n  position: absolute;\n\n  top: 0;\n  left: 27px;\n\n  width: 28px;\n  height: 3px;\n\n  background: #5ade00;\n}\n\n\n/* ================= TOP ================= */\n\n.desceci-how__top {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n\n  gap: 15px;\n\n  margin-bottom: 23px;\n}\n\n\n/* ================= ICON ================= */\n\n.desceci-how__icon {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  width: 45px;\n  height: 45px;\n\n  border-radius: 50%;\n\n  background: #f1f2f1;\n\n  color: #111;\n}\n\n.desceci-how__icon svg {\n  width: 21px;\n  height: 21px;\n\n  fill: none;\n  stroke: currentColor;\n\n  stroke-width: 1.7;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n\n/* ================= NUMBER ================= */\n\n.desceci-how__number {\n  color: #c3c3c3;\n\n  font-size: 10px;\n  line-height: 1;\n\n  font-weight: 700;\n\n  letter-spacing: .08em;\n}\n\n\n/* ================= TEXT ================= */\n\n.desceci-how__step-title {\n  margin: 0 0 8px;\n\n  color: #111;\n\n  font-size: 18px;\n  line-height: 1.2;\n  font-weight: 700;\n\n  letter-spacing: -.015em;\n}\n\n.desceci-how__text {\n  margin: 0;\n\n  color: #666;\n\n  font-size: 11px;\n  line-height: 1.55;\n}\n\n\n/* ================= ARROW ================= */\n\n.desceci-how__arrow {\n  position: absolute;\n  z-index: 3;\n\n  top: 50%;\n  right: -13px;\n\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  width: 26px;\n  height: 26px;\n\n  transform: translateY(-50%);\n\n  border: 1px solid #e3e3e3;\n  border-radius: 50%;\n\n  background: #fff;\n\n  color: #5ab92d;\n\n  font-size: 13px;\n  font-weight: 700;\n}\n\n.desceci-how__step:last-child\n.desceci-how__arrow {\n  display: none;\n}\n\n\n/* =========================================================\n   FINAL STEP\n   ========================================================= */\n\n.desceci-how__step--final {\n  background: #111;\n}\n\n.desceci-how__step--final::before {\n  width: 100%;\n  left: 0;\n}\n\n.desceci-how__step--final\n.desceci-how__icon {\n  background: #222;\n  color: #5ade00;\n}\n\n.desceci-how__step--final\n.desceci-how__number {\n  color: #666;\n}\n\n.desceci-how__step--final\n.desceci-how__step-title {\n  color: #fff;\n}\n\n.desceci-how__step--final\n.desceci-how__text {\n  color: #aaa;\n}\n\n\n/* =========================================================\n   CTA BAR\n   ========================================================= */\n\n.desceci-how__bottom {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n\n  gap: 25px;\n\n  margin-top: 15px;\n\n  padding: 18px 22px;\n\n  background: #fff;\n\n  border: 1px solid #e5e5e5;\n}\n\n.desceci-how__bottom-copy {\n  min-width: 0;\n}\n\n.desceci-how__bottom-title {\n  margin: 0 0 3px;\n\n  color: #111;\n\n  font-size: 12.5px;\n  line-height: 1.3;\n  font-weight: 700;\n}\n\n.desceci-how__bottom-text {\n  margin: 0;\n\n  color: #777;\n\n  font-size: 10px;\n  line-height: 1.5;\n}\n\n\n/* ================= CTA ================= */\n\n.desceci-how__cta {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n\n  flex: 0 0 auto;\n\n  min-height: 40px;\n\n  padding: 0 16px;\n\n  background: #111;\n\n  color: #fff !important;\n\n  text-decoration: none !important;\n\n  font-size: 8px;\n  line-height: 1.2;\n  font-weight: 700;\n\n  letter-spacing: .06em;\n  text-transform: uppercase;\n}\n\n.desceci-how__cta span {\n  margin-left: 8px;\n\n  color: #5ade00;\n\n  font-size: 14px;\n\n  transition: transform .2s ease;\n}\n\n.desceci-how__cta:hover span {\n  transform: translateX(4px);\n}\n\n\n/* =========================================================\n   TABLET\n   ========================================================= */\n\n@media screen and (min-width: 750px) and (max-width: 990px) {\n\n  .desceci-how {\n    padding: 56px 30px 60px;\n  }\n\n  .desceci-how__steps {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .desceci-how__step {\n    border-bottom: 1px solid #e5e5e5;\n  }\n\n  .desceci-how__step:nth-child(2) {\n    border-right: 0;\n  }\n\n  .desceci-how__step:nth-child(3),\n  .desceci-how__step:nth-child(4) {\n    border-bottom: 0;\n  }\n\n  .desceci-how__step:nth-child(2)\n  .desceci-how__arrow {\n    display: none;\n  }\n\n}\n\n\n/* =========================================================\n   MOBILE\n   ========================================================= */\n\n@media screen and (max-width: 749px) {\n\n  .desceci-how {\n    padding: 48px 16px 51px;\n  }\n\n\n  /* Header */\n\n  .desceci-how__header {\n    margin-bottom: 22px;\n  }\n\n  .desceci-how__eyebrow {\n    font-size: 8px;\n  }\n\n  .desceci-how__eyebrow::before,\n  .desceci-how__eyebrow::after {\n    display: none;\n  }\n\n  .desceci-how__title {\n    margin-bottom: 9px;\n\n    font-size: 29px;\n    line-height: 1.1;\n  }\n\n  .desceci-how__intro {\n    font-size: 12.5px;\n    line-height: 1.55;\n  }\n\n\n  /* Steps */\n\n  .desceci-how__steps {\n    display: block;\n\n    border: 0;\n\n    background: transparent;\n\n    overflow: visible;\n  }\n\n  .desceci-how__step {\n    display: grid;\n\n    grid-template-columns: 45px 1fr;\n\n    column-gap: 15px;\n\n    min-height: 0;\n\n    margin-bottom: 10px;\n\n    padding: 20px 18px;\n\n    border: 1px solid #e5e5e5 !important;\n    border-radius: 5px;\n\n    background: #fff;\n  }\n\n  .desceci-how__step:last-child {\n    margin-bottom: 0;\n  }\n\n  .desceci-how__step::before {\n    left: 18px;\n\n    width: 28px;\n  }\n\n  .desceci-how__top {\n    display: contents;\n  }\n\n  .desceci-how__icon {\n    grid-column: 1;\n    grid-row: 1 / span 3;\n\n    width: 42px;\n    height: 42px;\n\n    margin: 0;\n  }\n\n  .desceci-how__number {\n    grid-column: 2;\n\n    margin: 0 0 5px;\n  }\n\n  .desceci-how__step-title {\n    grid-column: 2;\n\n    margin-bottom: 5px;\n\n    font-size: 16px;\n  }\n\n  .desceci-how__text {\n    grid-column: 2;\n\n    font-size: 10.5px;\n  }\n\n  .desceci-how__arrow {\n    display: none;\n  }\n\n\n  /* Final */\n\n  .desceci-how__step--final {\n    background: #111;\n    border-color: #111 !important;\n  }\n\n\n  /* Bottom */\n\n  .desceci-how__bottom {\n    display: block;\n\n    margin-top: 11px;\n\n    padding: 18px;\n  }\n\n  .desceci-how__cta {\n    width: 100%;\n\n    margin-top: 14px;\n  }\n\n}\n\n\n/* =========================================================\n   SMALL MOBILE\n   ========================================================= */\n\n@media screen and (max-width: 390px) {\n\n  .desceci-how {\n    padding-left: 13px;\n    padding-right: 13px;\n  }\n\n  .desceci-how__title {\n    font-size: 27px;\n  }\n\n}\n\n\n/* =========================================================\n   ACCESSIBILITY\n   ========================================================= */\n\n@media (prefers-reduced-motion: reduce) {\n\n  .desceci-how__cta span {\n    transition: none;\n  }\n\n}\n</style>\n\n\n<section\n  class=\"desceci-how\"\n  aria-labelledby=\"desceci-how-title\"\n>\n\n<div class=\"desceci-how__inner\">\n\n\n  <!-- =====================================================\n       HEADER\n       ===================================================== -->\n\n  <header class=\"desceci-how__header\">\n\n    <div class=\"desceci-how__eyebrow\">\n      How It Works\n    </div>\n\n    <h2\n      id=\"desceci-how-title\"\n      class=\"desceci-how__title\"\n    >\n      Custom DTF Transfers<br>\n      Made Simple\n    </h2>\n\n    <p class=\"desceci-how__intro\">\n      From your artwork to a finished garment,\n      ordering ready-to-press DTF transfers is simple.\n    </p>\n\n  </header>\n\n\n\n  <!-- =====================================================\n       STEPS\n       ===================================================== -->\n\n  <div class=\"desceci-how__steps\">\n\n\n    <!-- ================= 01 UPLOAD ================= -->\n\n    <article class=\"desceci-how__step\">\n\n      <div class=\"desceci-how__top\">\n\n        <div\n          class=\"desceci-how__icon\"\n          aria-hidden=\"true\"\n        >\n\n          <svg viewBox=\"0 0 24 24\">\n\n            <path d=\"M12 16V4\"></path>\n\n            <path d=\"M8 8l4-4 4 4\"></path>\n\n            <path d=\"M5 13v6h14v-6\"></path>\n\n          </svg>\n\n        </div>\n\n        <span class=\"desceci-how__number\">\n          01\n        </span>\n\n      </div>\n\n\n      <h3 class=\"desceci-how__step-title\">\n        Upload Your Artwork\n      </h3>\n\n      <p class=\"desceci-how__text\">\n        Choose transfers by size, upload a\n        ready-to-print gang sheet, or build\n        your gang sheet online.\n      </p>\n\n\n      <span\n        class=\"desceci-how__arrow\"\n        aria-hidden=\"true\"\n      >\n        →\n      </span>\n\n    </article>\n\n\n\n    <!-- ================= 02 PRINT ================= -->\n\n    <article class=\"desceci-how__step\">\n\n      <div class=\"desceci-how__top\">\n\n        <div\n          class=\"desceci-how__icon\"\n          aria-hidden=\"true\"\n        >\n\n          <svg viewBox=\"0 0 24 24\">\n\n            <path d=\"M6 8V4h12v4\"></path>\n\n            <path d=\"M6 17H4V9h16v8h-2\"></path>\n\n            <path d=\"M7 14h10v6H7z\"></path>\n\n            <path d=\"M17 11h.01\"></path>\n\n          </svg>\n\n        </div>\n\n        <span class=\"desceci-how__number\">\n          02\n        </span>\n\n      </div>\n\n\n      <h3 class=\"desceci-how__step-title\">\n        We Print\n      </h3>\n\n      <p class=\"desceci-how__text\">\n        Your custom DTF transfers are produced\n        with vibrant color, sharp detail and\n        a flexible finish.\n      </p>\n\n\n      <span\n        class=\"desceci-how__arrow\"\n        aria-hidden=\"true\"\n      >\n        →\n      </span>\n\n    </article>\n\n\n\n    <!-- ================= 03 PRESS ================= -->\n\n    <article class=\"desceci-how__step\">\n\n      <div class=\"desceci-how__top\">\n\n        <div\n          class=\"desceci-how__icon\"\n          aria-hidden=\"true\"\n        >\n\n          <svg viewBox=\"0 0 24 24\">\n\n            <path d=\"M5 5h14v8H5z\"></path>\n\n            <path d=\"M8 13v3\"></path>\n\n            <path d=\"M16 13v3\"></path>\n\n            <path d=\"M6 16h12v4H6z\"></path>\n\n            <path d=\"M9 9h6\"></path>\n\n          </svg>\n\n        </div>\n\n        <span class=\"desceci-how__number\">\n          03\n        </span>\n\n      </div>\n\n\n      <h3 class=\"desceci-how__step-title\">\n        Heat Press\n      </h3>\n\n      <p class=\"desceci-how__text\">\n        Apply your transfer at 300–320°F\n        for 8–10 seconds using medium pressure,\n        then hot peel.\n      </p>\n\n\n      <span\n        class=\"desceci-how__arrow\"\n        aria-hidden=\"true\"\n      >\n        →\n      </span>\n\n    </article>\n\n\n\n    <!-- ================= 04 DONE ================= -->\n\n    <article\n      class=\"\n        desceci-how__step\n        desceci-how__step--final\n      \"\n    >\n\n      <div class=\"desceci-how__top\">\n\n        <div\n          class=\"desceci-how__icon\"\n          aria-hidden=\"true\"\n        >\n\n          <svg viewBox=\"0 0 24 24\">\n\n            <circle\n              cx=\"12\"\n              cy=\"12\"\n              r=\"9\"\n            ></circle>\n\n            <path d=\"M8 12l2.5 2.5L16 9\"></path>\n\n          </svg>\n\n        </div>\n\n        <span class=\"desceci-how__number\">\n          04\n        </span>\n\n      </div>\n\n\n      <h3 class=\"desceci-how__step-title\">\n        Done\n      </h3>\n\n      <p class=\"desceci-how__text\">\n        Finish with a 5–10 second final press\n        and your custom apparel is ready\n        to wear, sell or ship.\n      </p>\n\n    </article>\n\n\n  </div>\n\n\n\n  <!-- =====================================================\n       CTA BAR\n       ===================================================== -->\n\n  <div class=\"desceci-how__bottom\">\n\n\n    <div class=\"desceci-how__bottom-copy\">\n\n      <p class=\"desceci-how__bottom-title\">\n        Ready to create your custom DTF transfers?\n      </p>\n\n      <p class=\"desceci-how__bottom-text\">\n        No minimum order. Choose the ordering option\n        that works best for your artwork.\n      </p>\n\n    </div>\n\n\n    <a\n      href=\"/collections/dtf-transfer\"\n      class=\"desceci-how__cta\"\n    >\n      Start Your DTF Order\n\n      <span>\n        →\n      </span>\n    </a>\n\n\n  </div>\n\n\n</div>\n</section>",
