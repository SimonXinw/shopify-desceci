/files/1/1030/0420/9521/files/bb3d9f7b-ef54-4ea1-abc6-8c2618dc9c69.png?v=1789720758&width=650 650w\n          \"\n\n          sizes=\"(max-width: 749px) 52vw, 19vw\"\n\n          width=\"650\"\n          height=\"500\"\n\n          loading=\"lazy\"\n          decoding=\"async\"\n\n          alt=\"Epson I3200 printhead for compatible DTF printers\"\n        >\n\n      </div>\n\n    </a>\n\n\n\n    <!-- ================= 05 HEAT PRESS ================= -->\n\n    <a\n      href=\"/collections/dtf-pres-machine\"\n      class=\"desceci-shop-small\"\n      aria-label=\"Shop DTF heat press machines\"\n    >\n\n      <div class=\"desceci-shop-small__content\">\n\n        <div class=\"desceci-shop-small__label\">\n          Equipment\n        </div>\n\n        <h3 class=\"desceci-shop-small__title\">\n          Heat Press Machines\n        </h3>\n\n        <p class=\"desceci-shop-small__description\">\n          Professional heat press equipment\n          for consistent DTF transfer application.\n        </p>\n\n        <span class=\"desceci-shop-small__cta\">\n          Shop Heat Presses\n        </span>\n\n      </div>\n\n      <div class=\"desceci-shop-small__media\">\n\n        <img\n          class=\"desceci-shop-small__image\"\n\n          src=\"https://cdn.shopify.com/s/files/1/1030/0420/9521/files/3d7c192b-2501-4479-848a-3ee0eb423f43.png?v=1789720759&width=500\"\n\n          srcset=\"\n          https://cdn.shopify.com/s/files/1/1030/0420/9521/files/3d7c192b-2501-4479-848a-3ee0eb423f43.png?v=1789720759&width=300 300w,\n          https://cdn.shopify.com/s/files/1/1030/0420/9521/files/3d7c192b-2501-4479-848a-3ee0eb423f43.png?v=1789720759&width=500 500w,\n          https://cdn.shopify.com/s/files/1/1030/0420/9521/files/3d7c192b-2501-4479-848a-3ee0eb423f43.png?v=1789720759&width=650 650w\n          \"\n\n          sizes=\"(max-width: 749px) 52vw, 19vw\"\n\n          width=\"650\"\n          height=\"650\"\n\n          loading=\"lazy\"\n          decoding=\"async\"\n\n 