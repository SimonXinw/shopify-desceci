      "name": "Why Choose DESCECI",
      "settings": {
        "custom_liquid": "<style>\n/* =========================================================\n   DESCECI — WHY CHOOSE DESCECI\n   Homepage Trust / Benefits Section\n   Responsive / Lightweight / SEO Friendly\n   ========================================================= */\n\n.desceci-why {\n  width: 100%;\n  padding: 70px 24px;\n  background: #fff;\n  box-sizing: border-box;\n}\n\n.desceci-why *,\n.desceci-why *::before,\n.desceci-why *::after {\n  box-sizing: border-box;\n}\n\n.desceci-why__inner {\n  width: 100%;\n  max-width: 1400px;\n  margin: 0 auto;\n}\n\n\n/* ================= HEADER ================= */\n\n.desceci-why__header {\n  display: grid;\n  grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);\n  gap: 70px;\n  align-items: end;\n\n  margin-bottom: 34px;\n}\n\n.desceci-why__eyebrow {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n\n  margin: 0 0 9px;\n\n  color: #444;\n\n  font-size: 9px;\n  line-height: 1.4;\n  font-weight: 700;\n\n  letter-spacing: .12em;\n  text-transform: uppercase;\n}\n\n.desceci-why__eyebrow::before {\n  content: \"\";\n\n  width: 26px;\n  height: 2px;\n\n  background: #5ade00;\n}\n\n.desceci-why__title {\n  margin: 0;\n\n  color: #111;\n\n  font-size: clamp(32px, 3vw, 44px);\n  line-height: 1.08;\n  font-weight: 700;\n\n  letter-spacing: -.03em;\n}\n\n.desceci-why__intro {\n  max-width: 620px;\n  margin: 0;\n\n  color: #666;\n\n  font-size: 14px;\n  line-height: 1.65;\n}\n\n\n/* ================= BENEFITS GRID ================= */\n\n.desceci-why__grid {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n\n  border-top: 1px solid #e5e5e5;\n  border-bottom: 1px solid #e5e5e5;\n}\n\n\n/* ================= BENEFIT ITEM ================= */\n\n.desceci-why__item {\n  position: relative;\n\n  min-width: 0;\n\n  padding: 32px 27px 31px;\n\n  border-right: 1px solid #e5e5e5;\n\n  transition:\n    background .2s ease,\n    transform .2s ease;\n}\n\n.desceci-why__item:first-child {\n  border-left: 1px solid #e5e5e5;\n}\n\n.desceci-why__item::before {\n  content: \"\";\n\n  position: absolute;\n\n  top: -1px;\n  left: 27px;\n\n  width: 30px;\n  height: 3px;\n\n  background: #5ade00;\n\n  transition: width .25s ease;\n}\n\n.desceci-why__item:hover {\n  background: #f8f9f8;\n}\n\n.desceci-why__item:hover::before {\n  width: 55px;\n}\n\n\n/* ================= NUMBER ================= */\n\n.desceci-why__number {\n  margin: 0 0 27px;\n\n  color: #c9c9c9;\n\n  font-size: 11px;\n  line-height: 1;\n\n  font-weight: 700;\n\n  letter-spacing: .08em;\n}\n\n\n/* ================= ICON ================= */\n\n.desceci-why__icon {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  width: 46px;\n  height: 46px;\n\n  margin-bottom: 19px;\n\n  border-radius: 50%;\n\n  background: #f0f1f0;\n\n  color: #111;\n}\n\n.desceci-why__icon svg {\n  width: 22px;\n  height: 22px;\n\n  stroke: currentColor;\n\n  fill: none;\n\n  stroke-width: 1.7;\n\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n\n/* ================= TEXT ================= */\n\n.desceci-why__item-title {\n  margin: 0 0 9px;\n\n  color: #111;\n\n  font-size: 18px;\n  line-height: 1.2;\n\n  font-weight: 700;\n\n  letter-spacing: -.015em;\n}\n\n.desceci-why__text {\n  margin: 0;\n\n  color: #666;\n\n  font-size: 11.5px;\n  line-height: 1.6;\n}\n\n\n/* ================= SHIPPING DETAIL ================= */\n\n.desceci-why__shipping {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n\n  gap: 30px;\n\n  margin-top: 22px;\n\n  padding: 22px 26px;\n\n  background: #f5f6f5;\n}\n\n.desceci-why__shipping-left {\n  display: flex;\n  align-items: center;\n\n  gap: 14px;\n\n  min-width: 0;\n}\n\n.desceci-why__shipping-mark {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  flex: 0 0 38px;\n\n  width: 38px;\n  height: 38px;\n\n  background: #111;\n\n  border-radius: 50%;\n\n  color: #5ade00;\n}\n\n.desceci-why__shipping-mark svg {\n  width: 19px;\n  height: 19px;\n\n  stroke: currentColor;\n  fill: none;\n\n  stroke-width: 1.8;\n\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.desceci-why__shipping-title {\n  margin: 0 0 3px;\n\n  color: #111;\n\n  font-size: 12px;\n  line-height: 1.3;\n\n  font-weight: 700;\n}\n\n.desceci-why__shipping-text {\n  margin: 0;\n\n  color: #777;\n\n  font-size: 10.5px;\n  line-height: 1.45;\n}\n\n.desceci-why__shipping-link {\n  display: inline-flex;\n  align-items: center;\n\n  flex: 0 0 auto;\n\n  color: #111 !important;\n\n  text-decoration: none !important;\n\n  font-size: 9px;\n  line-height: 1.3;\n\n  font-weight: 700;\n\n  letter-spacing: .055em;\n\n  text-transform: uppercase;\n}\n\n.desceci-why__shipping-link::after {\n  content: \"→\";\n\n  margin-left: 8px;\n\n  color: #55a930;\n\n  font-size: 14px;\n\n  transition: transform .2s ease;\n}\n\n.desceci-why__shipping-link:hover::after {\n  transform: translateX(4px);\n}\n\n\n/* ================= TABLET ================= */\n\n@media screen and (min-width: 750px) and (max-width: 990px) {\n\n  .desceci-why {\n    padding: 60px 30px;\n  }\n\n  .desceci-why__header {\n    grid-template-columns: 1fr;\n\n    gap: 17px;\n\n    margin-bottom: 29px;\n  }\n\n  .desceci-why__grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n\n    border-bottom: 0;\n  }\n\n  .desceci-why__item {\n    border-bottom: 1px solid #e5e5e5;\n  }\n\n  .desceci-why__item:nth-child(odd) {\n    border-left: 1px solid #e5e5e5;\n  }\n\n}\n\n\n/* ================= MOBILE ================= */\n\n@media screen and (max-width: 749px) {\n\n  .desceci-why {\n    padding: 50px 16px 52px;\n  }\n\n\n  /* Header */\n\n  .desceci-why__header {\n    display: block;\n\n    margin-bottom: 24px;\n\n    text-align: center;\n  }\n\n  .desceci-why__eyebrow {\n    justify-content: center;\n\n    margin-bottom: 7px;\n\n    font-size: 8px;\n  }\n\n  .desceci-why__eyebrow::before {\n    display: none;\n  }\n\n  .desceci-why__title {\n    margin-bottom: 10px;\n\n    font-size: 29px;\n    line-height: 1.1;\n  }\n\n  .desceci-why__intro {\n    max-width: 430px;\n\n    margin: 0 auto;\n\n    font-size: 12.5px;\n    line-height: 1.55;\n  }\n\n\n  /* Grid */\n\n  .desceci-why__grid {\n    grid-template-columns: 1fr;\n\n    border: 0;\n\n    gap: 10px;\n  }\n\n  .desceci-why__item,\n  .desceci-why__item:first-child {\n    display: grid;\n\n    grid-template-columns: 44px 1fr;\n\n    column-gap: 15px;\n\n    padding: 20px 18px;\n\n    border: 1px solid #e6e6e6;\n\n    background: #fafafa;\n  }\n\n  .desceci-why__item::before {\n    top: -1px;\n    left: 18px;\n\n    width: 28px;\n  }\n\n  .desceci-why__number {\n    display: none;\n  }\n\n  .desceci-why__icon {\n    grid-column: 1;\n    grid-row: 1 / span 2;\n\n    width: 42px;\n    height: 42px;\n\n    margin: 0;\n  }\n\n  .desceci-why__item-title {\n    grid-column: 2;\n\n    margin: 1px 0 5px;\n\n    font-size: 16px;\n  }\n\n  .desceci-why__text {\n    grid-column: 2;\n\n    font-size: 10.8px;\n    line-height: 1.5;\n  }\n\n\n  /* Shipping bar */\n\n  .desceci-why__shipping {\n    display: block;\n\n    margin-top: 11px;\n\n    padding: 18px;\n  }\n\n  .desceci-why__shipping-left {\n    align-items: flex-start;\n  }\n\n  .desceci-why__shipping-link {\n    margin-top: 14px;\n    margin-left: 52px;\n  }\n\n}\n\n\n/* ================= SMALL MOBILE ================= */\n\n@media screen and (max-width: 390px) {\n\n  .desceci-why {\n    padding-left: 13px;\n    padding-right: 13px;\n  }\n\n  .desceci-why__title {\n    font-size: 27px;\n  }\n\n}\n\n\n/* ================= ACCESSIBILITY ================= */\n\n@media (prefers-reduced-motion: reduce) {\n\n  .desceci-why__item,\n  .desceci-why__item::before,\n  .desceci-why__shipping-link::after {\n    transition: none;\n  }\n\n}\n</style>\n\n\n<section\n  class=\"desceci-why\"\n  aria-labelledby=\"desceci-why-title\"\n>\n\n<div class=\"desceci-why__inner\">\n\n\n  <!-- =====================================================\n       HEADER\n       ===================================================== -->\n\n  <header class=\"desceci-why__header\">\n\n    <div>\n\n      <div class=\"desceci-why__eyebrow\">\n        Why DESCECI\n      </div>\n\n      <h2\n        id=\"desceci-why-title\"\n        class=\"desceci-why__title\"\n      >\n        Built for DTF Creators &amp;<br>\n        Print Businesses\n      </h2>\n\n    </div>\n\n\n    <p class=\"desceci-why__intro\">\n      From custom DTF transfers to professional printing\n      supplies, DESCECI helps creators, apparel brands and\n      print shops get reliable products with straightforward\n      ordering and U.S. fulfillment.\n    </p>\n\n  </header>\n\n\n\n  <!-- =====================================================\n       BENEFITS\n       ===================================================== -->\n\n  <div class=\"desceci-why__grid\">\n\n\n    <!-- ================= 01 SHIPPING ================= -->\n\n    <article class=\"desceci-why__item\">\n\n      <div class=\"desceci-why__number\">\n        01\n      </div>\n\n      <div\n        class=\"desceci-why__icon\"\n        aria-hidden=\"true\"\n      >\n\n        <svg viewBox=\"0 0 24 24\">\n\n          <path d=\"M3 6h11v10H3z\"></path>\n\n          <path d=\"M14 9h4l3 3v4h-7z\"></path>\n\n          <circle cx=\"7\" cy=\"18\" r=\"2\"></circle>\n\n          <circle cx=\"18\" cy=\"18\" r=\"2\"></circle>\n\n        </svg>\n\n      </div>\n\n      <div>\n\n        <h3 class=\"desceci-why__item-title\">\n          Fast U.S. Fulfillment\n        </h3>\n\n        <p class=\"desceci-why__text\">\n          Custom DTF transfer orders are fulfilled from\n          Anaheim, California, helping us provide fast\n          and reliable service for U.S. customers.\n        </p>\n\n      </div>\n\n    </article>\n\n\n\n    <!-- ================= 02 NO MINIMUM ================= -->\n\n    <article class=\"desceci-why__item\">\n\n      <div class=\"desceci-why__number\">\n        02\n      </div>\n\n      <div\n        class=\"desceci-why__icon\"\n        aria-hidden=\"true\"\n      >\n\n        <svg viewBox=\"0 0 24 24\">\n\n          <path d=\"M4 7h16\"></path>\n\n          <path d=\"M6 7l1 13h10l1-13\"></path>\n\n          <path d=\"M9 11v5\"></path>\n\n          <path d=\"M15 11v5\"></path>\n\n          <path d=\"M8 7l2-3h4l2 3\"></path>\n\n        </svg>\n\n      </div>\n\n      <div>\n\n        <h3 class=\"desceci-why__item-title\">\n          No Minimum Order\n        </h3>\n\n        <p class=\"desceci-why__text\">\n          Order what your project needs — from a single\n          custom transfer to larger gang sheet orders\n          for ongoing apparel production.\n        </p>\n\n      </div>\n\n    </article>\n\n\n\n    <!-- ================= 03 QUALITY ================= -->\n\n    <article class=\"desceci-why__item\">\n\n      <div class=\"desceci-why__number\">\n        03\n      </div>\n\n      <div\n        class=\"desceci-why__icon\"\n        aria-hidden=\"true\"\n      >\n\n        <svg viewBox=\"0 0 24 24\">\n\n          <path d=\"M12 3l2.4 4.9L20 9l-4 3.9.9 5.5L12 15.8 7.1 18.4 8 12.9 4 9l5.6-1.1z\"></path>\n\n        </svg>\n\n      </div>\n\n      <div>\n\n        <h3 class=\"desceci-why__item-title\">\n          Professional DTF Quality\n        </h3>\n\n        <p class=\"desceci-why__text\">\n          Vibrant color, sharp detail and a soft,\n          flexible finish designed for consistent\n          heat press application.\n        </p>\n\n      </div>\n\n    </article>\n\n\n\n    <!-- ================= 04 SUPPORT ================= -->\n\n    <article class=\"desceci-why__item\">\n\n      <div class=\"desceci-why__number\">\n        04\n      </div>\n\n      <div\n        class=\"desceci-why__icon\"\n        aria-hidden=\"true\"\n      >\n\n        <svg viewBox=\"0 0 24 24\">\n\n          <path d=\"M4 13v-2a8 8 0 0 1 16 0v2\"></path>\n\n          <path d=\"M4 13h3v6H4z\"></path>\n\n          <path d=\"M17 13h3v6h-3z\"></path>\n\n          <path d=\"M17 19c0 1.1-.9 2-2 2h-3\"></path>\n\n        </svg>\n\n      </div>\n\n      <div>\n\n        <h3 class=\"desceci-why__item-title\">\n          Reliable Support\n        </h3>\n\n        <p class=\"desceci-why__text\">\n          If an order has a printing defect, damage,\n          missing items or a production error, our\n          team is here to help make it right.\n        </p>\n\n      </div>\n\n    </article>\n\n\n  </div>\n\n\n\n  <!-- =====================================================\n       FULFILLMENT BAR\n       ===================================================== -->\n\n  <div class=\"desceci-why__shipping\">\n\n\n    <div class=\"desceci-why__shipping-left\">\n\n\n      <div\n        class=\"desceci-why__shipping-mark\"\n        aria-hidden=\"true\"\n      >\n\n        <svg viewBox=\"0 0 24 24\">\n\n          <path d=\"M12 21s7-5.3 7-12a7 7 0 1 0-14 0c0 6.7 7 12 7 12z\"></path>\n\n          <circle cx=\"12\" cy=\"9\" r=\"2.4\"></circle>\n\n        </svg>\n\n      </div>\n\n\n      <div>\n\n        <p class=\"desceci-why__shipping-title\">\n          DTF Transfers Fulfilled from Anaheim, California\n        </p>\n\n        <p class=\"desceci-why__shipping-text\">\n          Orders placed before 2 PM local time are scheduled\n          to ship the same business day. Local pickup is available.\n        </p>\n\n      </div>\n\n\n    </div>\n\n\n    <a\n      href=\"/collections/dtf-transfer\"\n      class=\"desceci-why__shipping-link\"\n    >\n      Shop DTF Transfers\n    </a>\n\n\n  </div>\n\n\n</div>\n</section>",
