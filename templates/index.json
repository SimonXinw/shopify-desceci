      "name": "Shop DTF Transfers & Printing Supplies",
      "settings": {
        "custom_liquid": "<style>\n/* =========================================================\n   DESCECI — SHOP BY CATEGORY\n   Order:\n   01 DTF Transfers\n   02 DTF Supplies\n   03 Custom UV DTF Stickers\n   04 Epson Printheads\n   05 Heat Press Machines\n   Responsive / SEO / Performance Optimized\n   ========================================================= */\n\n.desceci-shop {\n  width: 100%;\n  padding: 76px 24px 82px;\n  background: #fff;\n  box-sizing: border-box;\n}\n\n.desceci-shop * {\n  box-sizing: border-box;\n}\n\n.desceci-shop__inner {\n  width: 100%;\n  max-width: 1400px;\n  margin: 0 auto;\n}\n\n\n/* ================= HEADER ================= */\n\n.desceci-shop__header {\n  margin-bottom: 32px;\n}\n\n.desceci-shop__heading {\n  max-width: 760px;\n}\n\n.desceci-shop__eyebrow {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  margin: 0 0 10px;\n  color: #444;\n  font-size: 10px;\n  line-height: 1.4;\n  font-weight: 700;\n  letter-spacing: .12em;\n  text-transform: uppercase;\n}\n\n.desceci-shop__eyebrow::before {\n  content: \"\";\n  width: 26px;\n  height: 2px;\n  background: #5ade00;\n}\n\n.desceci-shop__title {\n  margin: 0 0 12px;\n  color: #111;\n  font-size: clamp(32px, 3vw, 46px);\n  line-height: 1.08;\n  font-weight: 700;\n  letter-spacing: -.03em;\n}\n\n.desceci-shop__intro {\n  max-width: 680px;\n  margin: 0;\n  color: #666;\n  font-size: 15px;\n  line-height: 1.65;\n}\n\n\n/* ================= TOP GRID ================= */\n\n.desceci-shop__featured {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 16px;\n  margin-bottom: 16px;\n}\n\n\n/* ================= LARGE CARDS ================= */\n\n.desceci-shop-card {\n  position: relative;\n  display: grid;\n  grid-template-columns: 41% 59%;\n  min-height: 365px;\n  overflow: hidden;\n  border: 1px solid #e8e8e8;\n  border-radius: 6px;\n  background: #f7f8f7;\n  color: inherit;\n  text-decoration: none !important;\n  transition:\n    transform .22s ease,\n    box-shadow .22s ease,\n    border-color .22s ease;\n}\n\n.desceci-shop-card::before,\n.desceci-shop-small::before {\n  content: \"\";\n  position: absolute;\n  z-index: 5;\n  top: 0;\n  left: 0;\n  width: 34px;\n  height: 3px;\n  background: #5ade00;\n  transition: width .25s ease;\n}\n\n.desceci-shop-card:hover,\n.desceci-shop-small:hover {\n  transform: translateY(-3px);\n  border-color: #d9d9d9;\n  box-shadow: 0 14px 32px rgba(0,0,0,.06);\n}\n\n.desceci-shop-card:hover::before,\n.desceci-shop-small:hover::before {\n  width: 100%;\n}\n\n\n/* ================= LARGE CARD CONTENT ================= */\n\n.desceci-shop-card__content {\n  position: relative;\n  z-index: 2;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  padding: 36px 8px 36px 34px;\n}\n\n.desceci-shop-card__label,\n.desceci-shop-small__label {\n  margin: 0 0 8px;\n  color: #555;\n  font-size: 9px;\n  line-height: 1.4;\n  font-weight: 700;\n  letter-spacing: .11em;\n  text-transform: uppercase;\n}\n\n.desceci-shop-card__title {\n  margin: 0 0 10px;\n  color: #111;\n  font-size: 30px;\n  line-height: 1.12;\n  font-weight: 700;\n  letter-spacing: -.025em;\n}\n\n.desceci-shop-card__description {\n  max-width: 300px;\n  margin: 0 0 21px;\n  color: #666;\n  font-size: 13.5px;\n  line-height: 1.58;\n}\n\n.desceci-shop-card__cta {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  align-self: flex-start;\n  min-height: 44px;\n  padding: 0 18px;\n  background: #111;\n  border: 1px solid #111;\n  color: #fff;\n  font-size: 10px;\n  line-height: 1.2;\n  font-weight: 700;\n  letter-spacing: .055em;\n  text-transform: uppercase;\n}\n\n.desceci-shop-card__arrow {\n  margin-left: 9px;\n  color: #5ade00;\n  font-size: 16px;\n  transition: transform .2s ease;\n}\n\n.desceci-shop-card:hover .desceci-shop-card__arrow {\n  transform: translateX(4px);\n}\n\n\n/* ================= LARGE IMAGES ================= */\n\n.desceci-shop-card__media {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-width: 0;\n  padding: 18px 16px 18px 0;\n}\n\n.desceci-shop-card__image {\n  display: block;\n  width: 100%;\n  height: auto;\n  max-height: 315px;\n  object-fit: contain;\n  transition: transform .28s ease;\n}\n\n.desceci-shop-card:hover .desceci-shop-card__image {\n  transform: scale(1.025);\n}\n\n\n/* ================= BOTTOM GRID ================= */\n\n.desceci-shop__secondary {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 16px;\n}\n\n\n/* ================= SMALL CARDS ================= */\n\n.desceci-shop-small {\n  position: relative;\n  display: grid;\n  grid-template-columns: 43% 57%;\n  min-height: 265px;\n  overflow: hidden;\n  border: 1px solid #e8e8e8;\n  border-radius: 6px;\n  background: #f7f8f7;\n  color: inherit;\n  text-decoration: none !important;\n  transition:\n    transform .22s ease,\n    box-shadow .22s ease,\n    border-color .22s ease;\n}\n\n.desceci-shop-small__content {\n  position: relative;\n  z-index: 2;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  padding: 25px 0 25px 25px;\n}\n\n.desceci-shop-small__label {\n  font-size: 8px;\n}\n\n.desceci-shop-small__title {\n  margin: 0 0 8px;\n  color: #111;\n  font-size: 21px;\n  line-height: 1.15;\n  font-weight: 700;\n  letter-spacing: -.02em;\n}\n\n.desceci-shop-small__description {\n  margin: 0 0 14px;\n  color: #666;\n  font-size: 11.5px;\n  line-height: 1.5;\n}\n\n.desceci-shop-small__cta {\n  display: inline-flex;\n  align-items: center;\n  align-self: flex-start;\n  color: #111;\n  font-size: 9px;\n  line-height: 1.3;\n  font-weight: 700;\n  letter-spacing: .05em;\n  text-transform: uppercase;\n}\n\n.desceci-shop-small__cta::after {\n  content: \"→\";\n  margin-left: 7px;\n  color: #55a930;\n  font-size: 14px;\n  transition: transform .2s ease;\n}\n\n.desceci-shop-small:hover .desceci-shop-small__cta::after {\n  transform: translateX(4px);\n}\n\n\n/* ================= SMALL IMAGES ================= */\n\n.desceci-shop-small__media {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-width: 0;\n  padding: 10px 12px 10px 2px;\n}\n\n.desceci-shop-small__image {\n  display: block;\n  width: 100%;\n  height: auto;\n  max-height: 240px;\n  object-fit: contain;\n  transition: transform .28s ease;\n}\n\n.desceci-shop-small:hover .desceci-shop-small__image {\n  transform: scale(1.035);\n}\n\n\n/* ================= TABLET ================= */\n\n@media screen and (min-width: 750px) and (max-width: 990px) {\n\n  .desceci-shop {\n    padding: 64px 30px 68px;\n  }\n\n  .desceci-shop-card {\n    grid-template-columns: 44% 56%;\n    min-height: 330px;\n  }\n\n  .desceci-shop-card__content {\n    padding: 28px 6px 28px 25px;\n  }\n\n  .desceci-shop-card__title {\n    font-size: 25px;\n  }\n\n  .desceci-shop-card__description {\n    font-size: 12px;\n  }\n\n  .desceci-shop__secondary {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .desceci-shop-small:last-child {\n    grid-column: span 2;\n  }\n}\n\n\n/* ================= MOBILE ================= */\n\n@media screen and (max-width: 749px) {\n\n  .desceci-shop {\n    padding: 50px 16px 54px;\n  }\n\n  .desceci-shop__header {\n    margin-bottom: 24px;\n    text-align: center;\n  }\n\n  .desceci-shop__heading {\n    max-width: 100%;\n  }\n\n  .desceci-shop__eyebrow {\n    justify-content: center;\n    margin-bottom: 8px;\n    font-size: 8.5px;\n  }\n\n  .desceci-shop__eyebrow::before {\n    display: none;\n  }\n\n  .desceci-shop__title {\n    margin-bottom: 10px;\n    font-size: 29px;\n    line-height: 1.1;\n  }\n\n  .desceci-shop__intro {\n    max-width: 430px;\n    margin: 0 auto;\n    font-size: 13px;\n    line-height: 1.55;\n  }\n\n  .desceci-shop__featured {\n    grid-template-columns: 1fr;\n    gap: 11px;\n    margin-bottom: 11px;\n  }\n\n  .desceci-shop-card {\n    display: flex;\n    flex-direction: column;\n    min-height: 0;\n  }\n\n  .desceci-shop-card__content {\n    order: 1;\n    display: block;\n    padding: 22px 20px 12px;\n  }\n\n  .desceci-shop-card__media {\n    order: 2;\n    min-height: 190px;\n    padding: 0 12px 15px;\n  }\n\n  .desceci-shop-card__label {\n    margin-bottom: 6px;\n    font-size: 8px;\n  }\n\n  .desceci-shop-card__title {\n    margin-bottom: 7px;\n    font-size: 24px;\n  }\n\n  .desceci-shop-card__description {\n    max-width: 100%;\n    margin-bottom: 14px;\n    font-size: 12px;\n  }\n\n  .desceci-shop-card__cta {\n    min-height: 40px;\n    padding: 0 15px;\n    font-size: 9px;\n  }\n\n  .desceci-shop-card__image {\n    max-height: 225px;\n  }\n\n  .desceci-shop__secondary {\n    grid-template-columns: 1fr;\n    gap: 11px;\n  }\n\n  .desceci-shop-small {\n    grid-template-columns: 45% 55%;\n    min-height: 190px;\n  }\n\n  .desceci-shop-small__content {\n    padding: 19px 0 19px 18px;\n  }\n\n  .desceci-shop-small__title {\n    margin-bottom: 7px;\n    font-size: 18px;\n  }\n\n  .desceci-shop-small__description {\n    margin-bottom: 10px;\n    font-size: 10.5px;\n  }\n\n  .desceci-shop-small__image {\n    max-height: 185px;\n  }\n}\n\n\n/* ================= SMALL MOBILE ================= */\n\n@media screen and (max-width: 390px) {\n\n  .desceci-shop {\n    padding-left: 13px;\n    padding-right: 13px;\n  }\n\n  .desceci-shop__title {\n    font-size: 27px;\n  }\n\n  .desceci-shop-small__description {\n    display: none;\n  }\n}\n\n\n/* ================= ACCESSIBILITY ================= */\n\n@media (prefers-reduced-motion: reduce) {\n\n  .desceci-shop-card,\n  .desceci-shop-card::before,\n  .desceci-shop-card__image,\n  .desceci-shop-card__arrow,\n  .desceci-shop-small,\n  .desceci-shop-small::before,\n  .desceci-shop-small__image,\n  .desceci-shop-small__cta::after {\n    transition: none;\n  }\n}\n</style>\n\n\n<section\n  class=\"desceci-shop\"\n  aria-labelledby=\"desceci-shop-title\"\n>\n\n<div class=\"desceci-shop__inner\">\n\n\n  <!-- ================= HEADER ==