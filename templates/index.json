      "settings": {
        "custom_liquid": "<style>\n/* =========================================================\n   DESCECI — HOMEPAGE FAQ\n   Lightweight / Responsive / SEO Friendly\n   ========================================================= */\n\n.desceci-faq {\n  width: 100%;\n  padding: 68px 24px 74px;\n  background: #fff;\n  box-sizing: border-box;\n}\n\n.desceci-faq *,\n.desceci-faq *::before,\n.desceci-faq *::after {\n  box-sizing: border-box;\n}\n\n.desceci-faq__inner {\n  width: 100%;\n  max-width: 1400px;\n  margin: 0 auto;\n}\n\n\n/* =========================================================\n   HEADER\n   ========================================================= */\n\n.desceci-faq__header {\n  display: grid;\n  grid-template-columns: .8fr 1.2fr;\n  gap: 80px;\n  align-items: end;\n\n  margin-bottom: 31px;\n}\n\n.desceci-faq__eyebrow {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n\n  margin: 0 0 8px;\n\n  color: #555;\n\n  font-size: 9px;\n  line-height: 1.4;\n  font-weight: 700;\n\n  letter-spacing: .12em;\n  text-transform: uppercase;\n}\n\n.desceci-faq__eyebrow::before {\n  content: \"\";\n\n  width: 26px;\n  height: 2px;\n\n  background: #5ade00;\n}\n\n.desceci-faq__title {\n  margin: 0;\n\n  color: #111;\n\n  font-size: clamp(32px, 3vw, 44px);\n  line-height: 1.08;\n  font-weight: 700;\n\n  letter-spacing: -.03em;\n}\n\n.desceci-faq__intro {\n  max-width: 650px;\n  margin: 0;\n\n  color: #666;\n\n  font-size: 13.5px;\n  line-height: 1.62;\n}\n\n\n/* =========================================================\n   MAIN\n   ========================================================= */\n\n.desceci-faq__main {\n  display: grid;\n\n  grid-template-columns:\n    minmax(0, .68fr)\n    minmax(0, 1.32fr);\n\n  gap: 18px;\n}\n\n\n/* =========================================================\n   LEFT\n   ========================================================= */\n\n.desceci-faq__help {\n  position: relative;\n\n  display: flex;\n  flex-direction: column;\n\n  min-height: 410px;\n\n  padding: 33px;\n\n  overflow: hidden;\n\n  border-radius: 7px;\n\n  background: #111;\n\n  color: #fff;\n}\n\n.desceci-faq__help::before {\n  content: \"\";\n\n  position: absolute;\n\n  top: 0;\n  left: 0;\n\n  width: 48px;\n  height: 3px;\n\n  background: #5ade00;\n}\n\n.desceci-faq__help::after {\n  content: \"?\";\n\n  position: absolute;\n\n  right: -7px;\n  bottom: -64px;\n\n  color: #1d1d1d;\n\n  font-size: 260px;\n  line-height: 1;\n  font-weight: 700;\n\n  pointer-events: none;\n}\n\n\n/* ================= ICON ================= */\n\n.desceci-faq__help-icon {\n  position: relative;\n  z-index: 2;\n\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  width: 48px;\n  height: 48px;\n\n  margin-bottom: 28px;\n\n  border-radius: 50%;\n\n  background: #222;\n\n  color: #5ade00;\n}\n\n.desceci-faq__help-icon svg {\n  width: 22px;\n  height: 22px;\n\n  fill: none;\n  stroke: currentColor;\n\n  stroke-width: 1.7;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n\n/* ================= COPY ================= */\n\n.desceci-faq__help-label {\n  position: relative;\n  z-index: 2;\n\n  margin: 0 0 8px;\n\n  color: #777;\n\n  font-size: 8px;\n  line-height: 1.4;\n  font-weight: 700;\n\n  letter-spacing: .12em;\n  text-transform: uppercase;\n}\n\n.desceci-faq__help-title {\n  position: relative;\n  z-index: 2;\n\n  margin: 0 0 12px;\n\n  color: #fff;\n\n  font-size: 25px;\n  line-height: 1.15;\n  font-weight: 700;\n\n  letter-spacing: -.02em;\n}\n\n.desceci-faq__help-text {\n  position: relative;\n  z-index: 2;\n\n  max-width: 360px;\n\n  margin: 0 0 25px;\n\n  color: #aaa;\n\n  font-size: 11.5px;\n  line-height: 1.6;\n}\n\n\n/* ================= LINKS ================= */\n\n.desceci-faq__help-links {\n  position: relative;\n  z-index: 2;\n\n  margin-top: auto;\n}\n\n.desceci-faq__help-link {\n  display: flex;\n\n  align-items: center;\n  justify-content: space-between;\n\n  gap: 15px;\n\n  padding: 13px 0;\n\n  border-top: 1px solid #292929;\n\n  color: #fff !important;\n\n  text-decoration: none !important;\n\n  font-size: 9px;\n  line-height: 1.4;\n  font-weight: 700;\n\n  letter-spacing: .04em;\n}\n\n.desceci-faq__help-link span {\n  color: #5ade00;\n\n  font-size: 15px;\n\n  transition: transform .2s ease;\n}\n\n.desceci-faq__help-link:hover span {\n  transform: translateX(4px);\n}\n\n\n/* =========================================================\n   FAQ LIST\n   ========================================================= */\n\n.desceci-faq__list {\n  border-top: 1px solid #ddd;\n}\n\n\n/* ================= ITEM ================= */\n\n.desceci-faq__item {\n  margin: 0;\n\n  border-bottom: 1px solid #ddd;\n\n  background: #fff;\n}\n\n\n/* Remove default marker */\n\n.desceci-faq__question {\n  position: relative;\n\n  display: flex;\n\n  align-items: center;\n\n  min-height: 72px;\n\n  padding: 20px 55px 20px 5px;\n\n  cursor: pointer;\n\n  list-style: none;\n\n  color: #111;\n\n  font-size: 15px;\n  line-height: 1.4;\n  font-weight: 700;\n\n  transition: color .2s ease;\n}\n\n.desceci-faq__question::-webkit-details-marker {\n  display: none;\n}\n\n.desceci-faq__question::marker {\n  display: none;\n}\n\n\n/* ================= PLUS ================= */\n\n.desceci-faq__question::before,\n.desceci-faq__question::after {\n  content: \"\";\n\n  position: absolute;\n\n  top: 50%;\n  right: 7px;\n\n  width: 15px;\n  height: 1.5px;\n\n  background: #111;\n\n  transform: translateY(-50%);\n\n  transition:\n    transform .2s ease,\n    background .2s ease;\n}\n\n.desceci-faq__question::after {\n  transform:\n    translateY(-50%)\n    rotate(90deg);\n}\n\n\n/* Open */\n\n.desceci-faq__item[open]\n.desceci-faq__question {\n  color: #4da928;\n}\n\n.desceci-faq__item[open]\n.desceci-faq__question::after {\n  transform:\n    translateY(-50%)\n    rotate(0);\n}\n\n.desceci-faq__item[open]\n.desceci-faq__question::before {\n  background: #5ade00;\n}\n\n\n/* ================= ANSWER ================= */\n\n.desceci-faq__answer {\n  max-width: 790px;\n\n  padding: 0 55px 22px 5px;\n\n  color: #666;\n\n  font-size: 11.5px;\n  line-height: 1.7;\n}\n\n.desceci-faq__answer p {\n  margin: 0;\n}\n\n.desceci-faq__answer p + p {\n  margin-top: 9px;\n}\n\n\n/* ================= INLINE LINK ================= */\n\n.desceci-faq__answer a {\n  color: #111;\n\n  font-weight: 700;\n\n  text-decoration: underline;\n\n  text-decoration-color: #5ade00;\n  text-underline-offset: 3px;\n}\n\n\n/* =========================================================\n   BOTTOM CTA\n   ========================================================= */\n\n.desceci-faq__bottom {\n  display: flex;\n\n  align-items: center;\n  justify-content: space-between;\n\n  gap: 25px;\n\n  margin-top: 17px;\n\n  padding: 19px 22px;\n\n  border: 1px solid #e5e5e5;\n\n  background: #f7f8f7;\n}\n\n.desceci-faq__bottom-title {\n  margin: 0 0 3px;\n\n  color: #111;\n\n  font-size: 12.5px;\n  line-height: 1.3;\n\n  font-weight: 700;\n}\n\n.desceci-faq__bottom-text {\n  margin: 0;\n\n  color: #777;\n\n  font-size: 10px;\n  line-height: 1.5;\n}\n\n\n/* ================= CTA ================= */\n\n.desceci-faq__cta {\n  display: inline-flex;\n\n  align-items: center;\n  justify-content: center;\n\n  flex: 0 0 auto;\n\n  min-height: 40px;\n\n  padding: 0 16px;\n\n  background: #111;\n\n  color: #fff !important;\n\n  text-decoration: none !important;\n\n  font-size: 8px;\n  line-height: 1.2;\n  font-weight: 700;\n\n  letter-spacing: .06em;\n\n  text-transform: uppercase;\n}\n\n.desceci-faq__cta span {\n  margin-left: 8px;\n\n  color: #5ade00;\n\n  font-size: 14px;\n\n  transition: transform .2s ease;\n}\n\n.desceci-faq__cta:hover span {\n  transform: translateX(4px);\n}\n\n\n/* =========================================================\n   TABLET\n   ========================================================= */\n\n@media screen and (min-width: 750px) and (max-width: 990px) {\n\n  .desceci-faq {\n    padding: 58px 30px 62px;\n  }\n\n  .desceci-faq__header {\n    grid-template-columns: 1fr;\n\n    gap: 15px;\n  }\n\n  .desceci-faq__main {\n    grid-template-columns: 1fr;\n  }\n\n  .desceci-faq__help {\n    min-height: 320px;\n  }\n\n}\n\n\n/* =========================================================\n   MOBILE\n   ========================================================= */\n\n@media screen and (max-width: 749px) {\n\n  .desceci-faq {\n    padding: 49px 16px 52px;\n  }\n\n\n  /* Header */\n\n  .desceci-faq__header {\n    display: block;\n\n    margin-bottom: 23px;\n\n    text-align: center;\n  }\n\n  .desceci-faq__eyebrow {\n    justify-content: center;\n\n    font-size: 8px;\n  }\n\n  .desceci-faq__eyebrow::before {\n    display: none;\n  }\n\n  .desceci-faq__title {\n    margin-bottom: 9px;\n\n    font-size: 29px;\n  }\n\n  .desceci-faq__intro {\n    margin: 0 auto;\n\n    font-size: 12.5px;\n    line-height: 1.55;\n  }\n\n\n  /* Main */\n\n  .desceci-faq__main {\n    grid-template-columns: 1fr;\n\n    gap: 20px;\n  }\n\n\n  /* Help */\n\n  .desceci-faq__help {\n    min-height: 0;\n\n    padding: 25px 21px;\n  }\n\n  .desceci-faq__help-icon {\n    width: 43px;\n    height: 43px;\n\n    margin-bottom: 21px;\n  }\n\n  .desceci-faq__help-title {\n    font-size: 22px;\n  }\n\n  .desceci-faq__help-text {\n    font-size: 11px;\n  }\n\n  .desceci-faq__help-links {\n    margin-top: 22px;\n  }\n\n\n  /* FAQ */\n\n  .desceci-faq__question {\n    min-height: 64px;\n\n    padding:\n      17px\n      42px\n      17px\n      2px;\n\n    font-size: 13px;\n  }\n\n  .desceci-faq__question::before,\n  .desceci-faq__question::after {\n    right: 4px;\n\n    width: 13px;\n  }\n\n  .desceci-faq__answer {\n    padding:\n      0\n      38px\n      18px\n      2px;\n\n    font-size: 10.5px;\n    line-height: 1.65;\n  }\n\n\n  /* Bottom */\n\n  .desceci-faq__bottom {\n    display: block;\n\n    margin-top: 14px;\n\n    padding: 18px;\n  }\n\n  .desceci-faq__cta {\n    width: 100%;\n\n    margin-top: 14px;\n  }\n\n}\n\n\n/* =========================================================\n   SMALL MOBILE\n   ========================================================= */\n\n@media screen and (max-width: 390px) {\n\n  .desceci-faq {\n    padding-left: 13px;\n    padding-right: 13px;\n  }\n\n  .desceci-faq__title {\n    font-size: 27px;\n  }\n\n}\n\n\n/* =========================================================\n   ACCESSIBILITY\n   ========================================================= */\n\n.desceci-faq__question:focus-visible,\n.desceci-faq__cta:focus-visible,\n.desceci-faq__help-link:focus-visible {\n  outline: 2px solid #5ade00;\n  outline-offset: 3px;\n}\n\n@media (prefers-reduced-motion: reduce) {\n\n  .desceci-faq__question::before,\n  .desceci-faq__question::after,\n  .desceci-faq__cta span,\n  .desceci-faq__help-link span {\n    transition: none;\n  }\n\n}\n</style>\n\n\n<section\n  class=\"desceci-faq\"\n  aria-labelledby=\"desceci-faq-title\"\n>\n\n<div class=\"desceci-faq__inner\">\n\n\n  <!-- =====================================================\n       HEADER\n       ===================================================== -->\n\n  <header class=\"desceci-faq__header\">\n\n    <div>\n\n      <div class=\"desceci-faq__eyebrow\">\n        Frequently Asked Questions\n      </div>\n\n      <h2\n        id=\"desceci-faq-title\"\n        class=\"desceci-faq__title\"\n      >\n        DTF Transfer FAQ\n      </h2>\n\n    </div>\n\n\n    <p class=\"desceci-faq__intro\">\n      Find quick answers about custom DTF transfers,\n      gang sheets, artwork requirements, heat press settings,\n      order minimums and U.S. fulfillment.\n    </p>\n\n  </header>\n\n\n\n  <!-- =====================================================\n       MAIN\n       ===================================================== -->\n\n  <div class=\"desceci-faq__main\">\n\n\n    <!-- ===================================================\n         LEFT HELP\n         =================================================== -->\n\n    <aside class=\"desceci-faq__help\">\n\n\n      <div\n        class=\"desceci-faq__help-icon\"\n        aria-hidden=\"true\"\n      >\n\n        <svg viewBox=\"0 0 24 24\">\n\n          <path\n            d=\"M21 15a4 4 0 0 1-4 4H8l-5 2 1.5-4A7 7 0 0 1 3 12c0-4 4-7 9-7s9 3 9 7c0 1.1-.3 2.1-.8 3\"\n          ></path>\n\n          <path d=\"M9.8 10a2.4 2.4 0 1 1 3.3 2.2c-.8.4-1.1.9-1.1 1.6\"></path>\n\n          <path d=\"M12 16h.01\"></path>\n\n        </svg>\n\n      </div>\n\n\n      <div class=\"desceci-faq__help-label\">\n        Need Help?\n      </div>\n\n\n      <h3 class=\"desceci-faq__help-title\">\n        Not Sure Which\n        DTF Option to Choose?\n      </h3>\n\n\n      <p class=\"desceci-faq__help-text\">\n        Choose transfers by size for individual designs,\n        upload a completed gang sheet if your file is\n        print-ready, or use our online builder to arrange\n        multiple designs.\n      </p>\n\n\n      <div class=\"desceci-faq__help-links\">\n\n        <a\n          href=\"/products/products-custom-dtf-transfers-by-size\"\n          class=\"desceci-faq__help-link\"\n        >\n          DTF Transfers by Size\n          <span>→</span>\n        </a>\n\n\n        <a\n          href=\"/products/custom-dtf-transfers\"\n          class=\"desceci-faq__help-link\"\n        >\n          Upload Your Gang Sheet\n          <span>→</span>\n        </a>\n\n\n        <a\n          href=\"/products/products-dtf-gang-sheet-builder\"\n          class=\"desceci-faq__help-link\"\n        >\n          Build a Gang Sheet Online\n          <span>→</span>\n        </a>\n\n      </div>\n\n\n    </aside>\n\n\n\n    <!-- ===================================================\n         FAQ LIST\n         =================================================== -->\n\n    <div class=\"desceci-faq__list\">\n\n\n      <!-- ================= FAQ 01 ================= -->\n\n      <details\n        class=\"desceci-faq__item\"\n        open\n      >\n\n        <summary class=\"desceci-faq__question\">\n          What is a DTF transfer?\n        </summary>\n\n        <div class=\"desceci-faq__answer\">\n\n          <p>\n            A DTF (Direct-to-Film) transfer is a printed\n            design that is transferred onto fabric using\n            heat and pressure. DTF transfers work well for\n            T-shirts, hoodies, sweatshirts, tote bags and\n            many other custom apparel projects.\n          </p>\n\n          <p>\n            New to DTF?\n            <a href=\"/blogs/news/what-is-dtf-transfer-a-complete-guide-to-direct-to-film-printing-for-custom-apparel\">\n              Read our complete DTF transfer guide\n            </a>.\n          </p>\n\n        </div>\n\n      </details>\n\n\n\n      <!-- ================= FAQ 02 ================= -->\n\n      <details class=\"desceci-faq__item\">\n\n        <summary class=\"desceci-faq__question\">\n          How do I order custom DTF transfers?\n        </summary>\n\n        <div class=\"desceci-faq__answer\">\n\n          <p>\n            DESCECI offers three ways to order. Choose\n            DTF transfers by size for individual designs,\n            upload a completed 22.7-inch gang sheet if\n            your artwork is already arranged, or use our\n            online gang sheet builder to arrange multiple\n            designs before ordering.\n          </p>\n\n        </div>\n\n      </details>\n\n\n\n      <!-- ================= FAQ 03 ================= -->\n\n      <details class=\"desceci-faq__item\">\n\n        <summary class=\"desceci-faq__question\">\n          Is there a minimum order for DTF transfers?\n        </summary>\n\n        <div class=\"desceci-faq__answer\">\n\n          <p>\n            No. DESCECI custom DTF transfers have no\n            minimum order requirement, so you can order\n            for a single project or larger apparel\n            production runs.\n          </p>\n\n        </div>\n\n      </details>\n\n\n\n      <!-- ================= FAQ 04 ================= -->\n\n      <details class=\"desceci-faq__item\">\n\n        <summary class=\"desceci-faq__question\">\n          What heat press settings should I use for DTF transfers?\n        </summary>\n\n        <div class=\"desceci-faq__answer\">\n\n          <p>\n            Our recommended starting settings are\n            300–320°F (149–160°C), 8–10 seconds and\n            medium pressure. Use a hot peel, then finish\n            with a second press for approximately\n            5–10 seconds.\n          </p>\n\n          <p>\n            For more details, see our\n            <a href=\"/blogs/news/how-to-press-dtf-transfers\">\n              DTF heat press guide\n            </a>.\n          </p>\n\n        </div>\n\n      </details>\n\n\n\n      <!-- ================= FAQ 05 ================= -->\n\n      <details class=\"desceci-faq__item\">\n\n        <summary class=\"desceci-faq__question\">\n          Can I upload my own ready-to-print gang sheet?\n        </summary>\n\n        <div class=\"desceci-faq__answer\">\n\n          <p>\n            Yes. If your artwork is already arranged,\n            choose the matching 22.7-inch gang sheet\n            size and upload your completed ready-to-print\n            file. For best results, 300 DPI artwork and\n            a transparent background are recommended.\n          </p>\n\n          <p>\n            <a href=\"/products/custom-dtf-transfers\">\n              Upload your ready-to-print gang sheet\n            </a>.\n          </p>\n\n        </div>\n\n      </details>\n\n\n\n      <!-- ================= FAQ 06 ================= -->\n\n      <details class=\"desceci-faq__item\">\n\n        <summary class=\"desceci-faq__question\">\n          What if I don't know how to make a gang sheet?\n        </summary>\n\n        <div class=\"desceci-faq__answer\">\n\n          <p>\n            You don't need to create one manually.\n            Use our online gang sheet builder to upload\n            multiple designs and arrange them on the\n            sheet, or simply order DTF transfers by size\n            if you only need individual designs.\n          </p>\n\n          <p>\n            <a href=\"/products/products-dtf-gang-sheet-builder\">\n              Build a gang sheet online\n            </a>.\n          </p>\n\n        </div>\n\n      </details>\n\n\n\n      <!-- ================= FAQ 07 ================= -->\n\n      <details class=\"desceci-faq__item\">\n\n        <summary class=\"desceci-faq__question\">\n          Where are DESCECI DTF transfer orders fulfilled?\n        </summary>\n\n        <div class=\"desceci-faq__answer\">\n\n          <p>\n            Custom DTF transfer orders are fulfilled from\n            4420 E Miraloma Ave, Suite G, Anaheim,\n            CA 92807, USA.\n          </p>\n\n          <p>\n            Orders placed before 2 PM local time are\n            scheduled to ship the same business day.\n            Orders placed after 2 PM are scheduled to\n            ship the next business day. Local pickup\n            is also available. Carrier transit times vary\n            by destination and shipping service.\n          </p>\n\n        </div>\n\n      </details>\n\n\n\n      <!-- ================= FAQ 08 ================= -->\n\n      <details class=\"desceci-faq__item\">\n\n        <summary class=\"desceci-faq__question\">\n          What should I do if my DTF transfer is peeling?\n        </summary>\n\n        <div class=\"desceci-faq__answer\">\n\n          <p>\n            Peeling can be caused by incorrect temperature,\n            insufficient pressure, pressing time, fabric\n            conditions or other application factors.\n            Check your heat press settings and make sure\n            the transfer receives even pressure.\n          </p>\n\n          <p>\n            See our\n            <a href=\"/blogs/news/why-is-my-dtf-transfer-peeling\">\n              DTF transfer peeling troubleshooting guide\n            </a>\n            for a step-by-step checklist.\n          </p>\n\n        </div>\n\n      </details>\n\n\n    </div>\n\n\n  </div>\n\n\n\n  <!-- =====================================================\n       BOTTOM CTA\n       ===================================================== -->\n\n  <div class=\"desceci-faq__bottom\">\n\n\n    <div>\n\n      <p class=\"desceci-faq__bottom-title\">\n        Ready to order your custom DTF transfers?\n      </p>\n\n      <p class=\"desceci-faq__bottom-text\">\n        Explore all three ordering options and choose\n        the workflow that fits your artwork.\n      </p>\n\n    </div>\n\n\n    <a\n      href=\"/collections/dtf-transfer\"\n      class=\"desceci-faq__cta\"\n    >\n      Shop DTF Transfers\n\n      <span>→</span>\n    </a>\n\n\n  </div>\n\n\n</div>\n</section>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 0
      }
    },
    "custom_liquid_jfnUFm": {
      "type": "custom-liquid",
      "name": "邮件联系",
      "settings": {
        "custom_liquid": "{% assign contact_email = 'desceci@outlook.com' %}\n\n<style>\n/* =========================================================\n   DESCECI — CONTACT SECTION\n   Email Focused / Responsive / Lightweight\n   ========================================================= */\n\n.desceci-contact {\n  width: 100%;\n  padding: 68px 24px 72px;\n  background: #f6f7f6;\n  box-sizing: border-box;\n}\n\n.desceci-contact *,\n.desceci-contact *::before,\n.desceci-contact *::after {\n  box-sizing: border-box;\n}\n\n.desceci-contact__inner {\n  width: 100%;\n  max-width: 1400px;\n  margin: 0 auto;\n}\n\n\n/* =========================================================\n   MAIN\n   ========================================================= */\n\n.desceci-contact__main {\n  position: relative;\n\n  display: grid;\n  grid-template-columns: 1.1fr .9fr;\n\n  overflow: hidden;\n\n  border-radius: 8px;\n\n  background: #111;\n}\n\n\n/* =========================================================\n   LEFT\n   ========================================================= */\n\n.desceci-contact__content {\n  position: relative;\n  z-index: 2;\n\n  padding: 52px 50px;\n}\n\n.desceci-contact__eyebrow {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n\n  margin: 0 0 13px;\n\n  color: #999;\n\n  font-size: 9px;\n  line-height: 1.4;\n  font-weight: 700;\n\n  letter-spacing: .12em;\n  text-transform: uppercase;\n}\n\n.desceci-contact__eyebrow::before {\n  content: \"\";\n\n  width: 27px;\n  height: 2px;\n\n  background: #5ade00;\n}\n\n.desceci-contact__title {\n  max-width: 570px;\n\n  margin: 0 0 15px;\n\n  color: #fff;\n\n  font-size: clamp(32px, 3.3vw, 46px);\n  line-height: 1.06;\n  font-weight: 700;\n\n  letter-spacing: -.035em;\n}\n\n.desceci-contact__text {\n  max-width: 580px;\n\n  margin: 0;\n\n  color: #aaa;\n\n  font-size: 13px;\n  line-height: 1.65;\n}\n\n\n/* =========================================================\n   REASONS\n   ========================================================= */\n\n.desceci-contact__reasons {\n  display: flex;\n  flex-wrap: wrap;\n\n  gap: 8px;\n\n  margin-top: 25px;\n}\n\n.desceci-contact__reason {\n  display: inline-flex;\n  align-items: center;\n\n  min-height: 31px;\n\n  padding: 0 11px;\n\n  border: 1px solid #2d2d2d;\n\n  color: #ccc;\n\n  font-size: 8px;\n  line-height: 1.3;\n  font-weight: 600;\n\n  letter-spacing: .025em;\n}\n\n.desceci-contact__reason::before {\n  content: \"\";\n\n  width: 5px;\n  height: 5px;\n\n  margin-right: 7px;\n\n  border-radius: 50%;\n\n  background: #5ade00;\n}\n\n\n/* =========================================================\n   EMAIL CTA\n   ========================================================= */\n\n.desceci-contact__actions {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n\n  gap: 12px;\n\n  margin-top: 31px;\n}\n\n.desceci-contact__email {\n  display: inline-flex;\n\n  align-items: center;\n  justify-content: center;\n\n  min-height: 47px;\n\n  padding: 0 19px;\n\n  background: #5ade00;\n\n  color: #111 !important;\n\n  text-decoration: none !important;\n\n  font-size: 9px;\n  line-height: 1.2;\n  font-weight: 700;\n\n  letter-spacing: .06em;\n  text-transform: uppercase;\n\n  transition:\n    background .2s ease,\n    transform .2s ease;\n}\n\n.desceci-contact__email:hover {\n  background: #fff;\n\n  transform: translateY(-1px);\n}\n\n.desceci-contact__email svg {\n  width: 17px;\n  height: 17px;\n\n  margin-right: 9px;\n\n  fill: none;\n  stroke: currentColor;\n\n  stroke-width: 1.7;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.desceci-contact__address {\n  color: #aaa;\n\n  font-size: 10px;\n  line-height: 1.4;\n\n  word-break: break-word;\n}\n\n\n/* =========================================================\n   RIGHT\n   ========================================================= */\n\n.desceci-contact__side {\n  position: relative;\n\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n\n  padding: 42px;\n\n  background: #181818;\n\n  border-left: 1px solid #292929;\n}\n\n.desceci-contact__side::after {\n  content: \"@\";\n\n  position: absolute;\n\n  right: -15px;\n  bottom: -75px;\n\n  color: #202020;\n\n  font-size: 270px;\n  line-height: 1;\n  font-weight: 700;\n\n  pointer-events: none;\n}\n\n\n/* =========================================================\n   SIDE TOP\n   ========================================================= */\n\n.desceci-contact__icon {\n  position: relative;\n  z-index: 2;\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  width: 50px;\n  height: 50px;\n\n  margin-bottom: 24px;\n\n  border-radius: 50%;\n\n  background: #252525;\n\n  color: #5ade00;\n}\n\n.desceci-contact__icon svg {\n  width: 23px;\n  height: 23px;\n\n  fill: none;\n  stroke: currentColor;\n\n  stroke-width: 1.7;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.desceci-contact__side-title {\n  position: relative;\n  z-index: 2;\n\n  margin: 0 0 9px;\n\n  color: #fff;\n\n  font-size: 21px;\n  line-height: 1.2;\n  font-weight: 700;\n}\n\n.desceci-contact__side-text {\n  position: relative;\n  z-index: 2;\n\n  max-width: 390px;\n\n  margin: 0;\n\n  color: #929292;\n\n  font-size: 11px;\n  line-height: 1.6;\n}\n\n\n/* =========================================================\n   TIPS\n   ========================================================= */\n\n.desceci-contact__tips {\n  position: relative;\n  z-index: 2;\n\n  margin-top: 23px;\n\n  border-top: 1px solid #2d2d2d;\n}\n\n.desceci-contact__tip {\n  display: grid;\n\n  grid-template-columns: 25px 1fr;\n\n  gap: 10px;\n\n  padding: 11px 0;\n\n  border-bottom: 1px solid #2d2d2d;\n}\n\n.desceci-contact__tip-number {\n  color: #5ade00;\n\n  font-size: 8px;\n  line-height: 1.5;\n  font-weight: 700;\n}\n\n.desceci-contact__tip-text {\n  color: #bbb;\n\n  font-size: 9.5px;\n  line-height: 1.5;\n}\n\n\n/* =========================================================\n   TABLET\n   ========================================================= */\n\n@media screen and (min-width: 750px) and (max-width: 990px) {\n\n  .desceci-contact {\n    padding: 58px 30px 62px;\n  }\n\n  .desceci-contact__main {\n    grid-template-columns: 1fr 1fr;\n  }\n\n  .desceci-contact__content {\n    padding: 40px 34px;\n  }\n\n  .desceci-contact__side {\n    padding: 34px;\n  }\n\n}\n\n\n/* =========================================================\n   MOBILE\n   ========================================================= */\n\n@media screen and (max-width: 749px) {\n\n  .desceci-contact {\n    padding: 48px 16px 52px;\n  }\n\n  .desceci-contact__main {\n    grid-template-columns: 1fr;\n  }\n\n  .desceci-contact__content {\n    padding: 29px 21px 30px;\n  }\n\n  .desceci-contact__eyebrow {\n    font-size: 8px;\n  }\n\n  .desceci-contact__title {\n    margin-bottom: 12px;\n\n    font-size: 29px;\n    line-height: 1.08;\n  }\n\n  .desceci-contact__text {\n    font-size: 11.5px;\n    line-height: 1.6;\n  }\n\n  .desceci-contact__reasons {\n    margin-top: 20px;\n  }\n\n  .desceci-contact__reason {\n    min-height: 29px;\n\n    font-size: 7.5px;\n  }\n\n  .desceci-contact__actions {\n    display: block;\n\n    margin-top: 24px;\n  }\n\n  .desceci-contact__email {\n    width: 100%;\n  }\n\n  .desceci-contact__address {\n    display: block;\n\n    margin-top: 11px;\n\n    text-align: center;\n  }\n\n\n  /* Right */\n\n  .desceci-contact__side {\n    padding: 28px 21px;\n\n    border-top: 1px solid #292929;\n    border-left: 0;\n  }\n\n  .desceci-contact__icon {\n    width: 44px;\n    height: 44px;\n\n    margin-bottom: 19px;\n  }\n\n  .desceci-contact__side-title {\n    font-size: 19px;\n  }\n\n  .desceci-contact__side-text {\n    font-size: 10.5px;\n  }\n\n}\n\n\n/* =========================================================\n   SMALL MOBILE\n   ========================================================= */\n\n@media screen and (max-width: 390px) {\n\n  .desceci-contact {\n    padding-left: 13px;\n    padding-right: 13px;\n  }\n\n  .desceci-contact__title {\n    font-size: 27px;\n  }\n\n}\n\n\n/* =========================================================\n   ACCESSIBILITY\n   ========================================================= */\n\n.desceci-contact__email:focus-visible {\n  outline: 2px solid #fff;\n  outline-offset: 3px;\n}\n\n@media (prefers-reduced-motion: reduce) {\n\n  .desceci-contact__email {\n    transition: none;\n  }\n\n}\n</style>\n\n\n<section\n  class=\"desceci-contact\"\n  aria-labelledby=\"desceci-contact-title\"\n>\n\n<div class=\"desceci-contact__inner\">\n\n\n  <div class=\"desceci-contact__main\">\n\n\n    <!-- ===================================================\n         LEFT\n         =================================================== -->\n\n    <div class=\"desceci-contact__content\">\n\n\n      <div class=\"desceci-contact__eyebrow\">\n        Contact DESCECI\n      </div>\n\n\n      <h2\n        id=\"desceci-contact-title\"\n        class=\"desceci-contact__title\"\n      >\n        Have a Question?<br>\n        Send Us an Email.\n      </h2>\n\n\n      <p class=\"desceci-contact__text\">\n        Need help with a custom DTF transfer order,\n        artwork, gang sheets, printing supplies or\n        an existing order? Send us an email and\n        tell us what you need.\n      </p>\n\n\n      <!-- Reasons -->\n\n      <div class=\"desceci-contact__reasons\">\n\n        <span class=\"desceci-contact__reason\">\n          Artwork Questions\n        </span>\n\n        <span class=\"desceci-contact__reason\">\n          Gang Sheet Help\n        </span>\n\n        <span class=\"desceci-contact__reason\">\n          Order Support\n        </span>\n\n        <span class=\"desceci-contact__reason\">\n          Bulk Orders\n        </span>\n\n        <span class=\"desceci-contact__reason\">\n          DTF Supplies\n        </span>\n\n      </div>\n\n\n      <!-- Email -->\n\n      <div class=\"desceci-contact__actions\">\n\n        <a\n          href=\"mailto:{{ contact_email }}\"\n          class=\"desceci-contact__email\"\n          aria-label=\"Email DESCECI at {{ contact_email }}\"\n        >\n\n          <svg\n            viewBox=\"0 0 24 24\"\n            aria-hidden=\"true\"\n          >\n            <rect\n              x=\"3\"\n              y=\"5\"\n              width=\"18\"\n              height=\"14\"\n              rx=\"2\"\n            ></rect>\n\n            <path d=\"M3 7l9 6 9-6\"></path>\n          </svg>\n\n          Email DESCECI\n\n        </a>\n\n\n        <span class=\"desceci-contact__address\">\n          {{ contact_email }}\n        </span>\n\n      </div>\n\n\n    </div>\n\n\n\n    <!-- ===================================================\n         RIGHT\n         =================================================== -->\n\n    <div class=\"desceci-contact__side\">\n\n\n      <div\n        class=\"desceci-contact__icon\"\n        aria-hidden=\"true\"\n      >\n\n        <svg viewBox=\"0 0 24 24\">\n\n          <rect\n            x=\"3\"\n            y=\"5\"\n            width=\"18\"\n            height=\"14\"\n            rx=\"2\"\n          ></rect>\n\n          <path d=\"M3 7l9 6 9-6\"></path>\n\n        </svg>\n\n      </div>\n\n\n      <h3 class=\"desceci-contact__side-title\">\n        Help Us Help You Faster\n      </h3>\n\n\n      <p class=\"desceci-contact__side-text\">\n        When contacting us about an order or artwork,\n        include the details below so our team can\n        understand your request quickly.\n      </p>\n\n\n      <div class=\"desceci-contact__tips\">\n\n\n        <div class=\"desceci-contact__tip\">\n\n          <span class=\"desceci-contact__tip-number\">\n            01\n          </span>\n\n          <span class=\"desceci-contact__tip-text\">\n            Include your order number if you already placed an order.\n          </span>\n\n        </div>\n\n\n        <div class=\"desceci-contact__tip\">\n\n          <span class=\"desceci-contact__tip-number\">\n            02\n          </span>\n\n          <span class=\"desceci-contact__tip-text\">\n            Attach your artwork or photos when relevant.\n          </span>\n\n        </div>\n\n\n        <div class=\"desceci-contact__tip\">\n\n          <span class=\"desceci-contact__tip-number\">\n            03\n          </span>\n\n          <span class=\"desceci-contact__tip-text\">\n            Tell us the transfer size, quantity or product you need.\n          </span>\n\n        </div>\n\n\n      </div>\n\n\n    </div>\n\n\n  </div>\n\n\n</div>\n</section>",
