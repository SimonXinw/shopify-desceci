        "custom_liquid": "<style>\n/* =========================================================\n   DESCECI — CHOOSE YOUR DTF PATH\n   Ready-to-Press vs Print Your Own\n   Responsive / Lightweight / SEO Friendly\n   ========================================================= */\n\n.desceci-path {\n  width: 100%;\n  padding: 68px 24px 72px;\n  background: #f6f7f6;\n  box-sizing: border-box;\n}\n\n.desceci-path *,\n.desceci-path *::before,\n.desceci-path *::after {\n  box-sizing: border-box;\n}\n\n.desceci-path__inner {\n  width: 100%;\n  max-width: 1400px;\n  margin: 0 auto;\n}\n\n\n/* ================= HEADER ================= */\n\n.desceci-path__header {\n  max-width: 760px;\n  margin: 0 auto 31px;\n  text-align: center;\n}\n\n.desceci-path__eyebrow {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 9px;\n\n  margin: 0 0 8px;\n\n  color: #555;\n  font-size: 9px;\n  line-height: 1.4;\n  font-weight: 700;\n\n  letter-spacing: .12em;\n  text-transform: uppercase;\n}\n\n.desceci-path__eyebrow::before,\n.desceci-path__eyebrow::after {\n  content: \"\";\n  width: 22px;\n  height: 2px;\n  background: #5ade00;\n}\n\n.desceci-path__title {\n  margin: 0 0 11px;\n\n  color: #111;\n\n  font-size: clamp(32px, 3vw, 44px);\n  line-height: 1.08;\n  font-weight: 700;\n\n  letter-spacing: -.03em;\n}\n\n.desceci-path__intro {\n  max-width: 650px;\n  margin: 0 auto;\n\n  color: #666;\n\n  font-size: 14px;\n  line-height: 1.6;\n}\n\n\n/* ================= CHOICE WRAPPER ================= */\n\n.desceci-path__choices {\n  position: relative;\n\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n\n  gap: 16px;\n}\n\n\n/* ================= OR ================= */\n\n.desceci-path__or {\n  position: absolute;\n  z-index: 10;\n\n  top: 50%;\n  left: 50%;\n\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  width: 42px;\n  height: 42px;\n\n  transform: translate(-50%, -50%);\n\n  border: 5px solid #f6f7f6;\n  border-radius: 50%;\n\n  background: #111;\n  color: #fff;\n\n  font-size: 8px;\n  line-height: 1;\n  font-weight: 700;\n\n  letter-spacing: .08em;\n}\n\n\n/* ================= CHOICE CARD ================= */\n\n.desceci-path-card {\n  position: relative;\n\n  display: flex;\n  flex-direction: column;\n\n  min-height: 420px;\n\n  overflow: hidden;\n\n  padding: 36px 38px 34px;\n\n  border: 1px solid #e4e4e4;\n  border-radius: 7px;\n\n  background: #fff;\n\n  color: inherit;\n}\n\n.desceci-path-card--dark {\n  background: #111;\n  border-color: #111;\n}\n\n\n/* ================= TOP ACCENT ================= */\n\n.desceci-path-card::before {\n  content: \"\";\n\n  position: absolute;\n\n  top: 0;\n  left: 0;\n\n  width: 52px;\n  height: 3px;\n\n  background: #5ade00;\n}\n\n\n/* ================= PATH LABEL ================= */\n\n.desceci-path-card__label {\n  margin: 0 0 23px;\n\n  color: #777;\n\n  font-size: 8px;\n  line-height: 1.3;\n  font-weight: 700;\n\n  letter-spacing: .12em;\n  text-transform: uppercase;\n}\n\n.desceci-path-card--dark\n.desceci-path-card__label {\n  color: #999;\n}\n\n\n/* ================= ICON ================= */\n\n.desceci-path-card__icon {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  width: 50px;\n  height: 50px;\n\n  margin-bottom: 18px;\n\n  border-radius: 50%;\n\n  background: #eef0ee;\n\n  color: #111;\n}\n\n.desceci-path-card--dark\n.desceci-path-card__icon {\n  background: #202020;\n  color: #5ade00;\n}\n\n.desceci-path-card__icon svg {\n  width: 24px;\n  height: 24px;\n\n  stroke: currentColor;\n  fill: none;\n\n  stroke-width: 1.7;\n\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n\n/* ================= TITLE ================= */\n\n.desceci-path-card__title {\n  margin: 0 0 10px;\n\n  color: #111;\n\n  font-size: 28px;\n  line-height: 1.12;\n  font-weight: 700;\n\n  letter-spacing: -.025em;\n}\n\n.desceci-path-card--dark\n.desceci-path-card__title {\n  color: #fff;\n}\n\n\n/* ================= DESCRIPTION ================= */\n\n.desceci-path-card__description {\n  max-width: 510px;\n\n  margin: 0 0 22px;\n\n  color: #666;\n\n  font-size: 12.5px;\n  line-height: 1.6;\n}\n\n.desceci-path-card--dark\n.desceci-path-card__description {\n  color: #aaa;\n}\n\n\n/* ================= LIST ================= */\n\n.desceci-path-card__list {\n  display: grid;\n\n  gap: 9px;\n\n  margin: 0 0 27px;\n  padding: 0;\n\n  list-style: none;\n}\n\n.desceci-path-card__list li {\n  position: relative;\n\n  padding-left: 20px;\n\n  color: #444;\n\n  font-size: 11px;\n  line-height: 1.45;\n}\n\n.desceci-path-card__list li::before {\n  content: \"✓\";\n\n  position: absolute;\n\n  top: 0;\n  left: 0;\n\n  color: #55b829;\n\n  font-weight: 800;\n}\n\n.desceci-path-card--dark\n.desceci-path-card__list li {\n  color: #ccc;\n}\n\n.desceci-path-card--dark\n.desceci-path-card__list li::before {\n  color: #5ade00;\n}\n\n\n/* ================= BEST FOR ================= */\n\n.desceci-path-card__best {\n  margin: auto 0 18px;\n\n  padding-top: 18px;\n\n  border-top: 1px solid #e8e8e8;\n\n  color: #777;\n\n  font-size: 10px;\n  line-height: 1.5;\n}\n\n.desceci-path-card__best strong {\n  color: #111;\n}\n\n.desceci-path-card--dark\n.desceci-path-card__best {\n  border-color: #2c2c2c;\n  color: #999;\n}\n\n.desceci-path-card--dark\n.desceci-path-card__best strong {\n  color: #fff;\n}\n\n\n/* ================= CTA ================= */\n\n.desceci-path-card__cta {\n  display: flex;\n\n  align-items: center;\n  justify-content: space-between;\n\n  width: 100%;\n  min-height: 46px;\n\n  padding: 0 17px;\n\n  background: #111;\n  color: #fff !important;\n\n  border: 1px solid #111;\n\n  text-decoration: none !important;\n\n  font-size: 9px;\n  line-height: 1.2;\n  font-weight: 700;\n\n  letter-spacing: .06em;\n  text-transform: uppercase;\n\n  transition:\n    background .2s ease,\n    color .2s ease,\n    border-color .2s ease;\n}\n\n.desceci-path-card--dark\n.desceci-path-card__cta {\n  background: #5ade00;\n\n  border-color: #5ade00;\n\n  color: #111 !important;\n}\n\n.desceci-path-card__arrow {\n  color: #5ade00;\n\n  font-size: 16px;\n\n  transition: transform .2s ease;\n}\n\n.desceci-path-card--dark\n.desceci-path-card__arrow {\n  color: #111;\n}\n\n.desceci-path-card__cta:hover\n.desceci-path-card__arrow {\n  transform: translateX(4px);\n}\n\n.desceci-path-card--dark\n.desceci-path-card__cta:hover {\n  background: #fff;\n  border-color: #fff;\n}\n\n\n/* ================= FOOT NOTE ================= */\n\n.desceci-path__note {\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  gap: 7px;\n\n  margin: 19px 0 0;\n\n  color: #777;\n\n  font-size: 10px;\n  line-height: 1.5;\n\n  text-align: center;\n}\n\n.desceci-path__note-dot {\n  width: 6px;\n  height: 6px;\n\n  border-radius: 50%;\n\n  background: #5ade00;\n}\n\n\n/* ================= TABLET ================= */\n\n@media screen and (min-width: 750px) and (max-width: 990px) {\n\n  .desceci-path {\n    padding: 60px 30px 64px;\n  }\n\n  .desceci-path-card {\n    min-height: 430px;\n\n    padding: 31px 29px;\n  }\n\n  .desceci-path-card__title {\n    font-size: 25px;\n  }\n\n}\n\n\n/* ================= MOBILE ================= */\n\n@media screen and (max-width: 749px) {\n\n  .desceci-path {\n    padding: 49px 16px 52px;\n  }\n\n  .desceci-path__header {\n    margin-bottom: 23px;\n  }\n\n  .desceci-path__eyebrow {\n    font-size: 8px;\n  }\n\n  .desceci-path__eyebrow::before,\n  .desceci-path__eyebrow::after {\n    display: none;\n  }\n\n  .desceci-path__title {\n    margin-bottom: 9px;\n\n    font-size: 29px;\n    line-height: 1.1;\n  }\n\n  .desceci-path__intro {\n    font-size: 12.5px;\n    line-height: 1.55;\n  }\n\n\n  /* Cards */\n\n  .desceci-path__choices {\n    grid-template-columns: 1fr;\n\n    gap: 12px;\n  }\n\n  .desceci-path__or {\n    top: 50%;\n    left: 50%;\n\n    width: 38px;\n    height: 38px;\n\n    border-width: 4px;\n  }\n\n  .desceci-path-card {\n    min-height: 0;\n\n    padding: 25px 21px 22px;\n  }\n\n  .desceci-path-card__label {\n    margin-bottom: 16px;\n  }\n\n  .desceci-path-card__icon {\n    width: 44px;\n    height: 44px;\n\n    margin-bottom: 15px;\n  }\n\n  .desceci-path-card__icon svg {\n    width: 21px;\n    height: 21px;\n  }\n\n  .desceci-path-card__title {\n    font-size: 23px;\n  }\n\n  .desceci-path-card__description {\n    margin-bottom: 18px;\n\n    font-size: 11.5px;\n  }\n\n  .desceci-path-card__list {\n    margin-bottom: 22px;\n  }\n\n  .desceci-path-card__list li {\n    font-size: 10.5px;\n  }\n\n  .desceci-path-card__best {\n    margin-top: 4px;\n  }\n\n  .desceci-path__note {\n    padding: 0 10px;\n\n    font-size: 9.5px;\n  }\n\n}\n\n\n/* ================= SMALL MOBILE ================= */\n\n@media screen and (max-width: 390px) {\n\n  .desceci-path {\n    padding-left: 13px;\n    padding-right: 13px;\n  }\n\n  .desceci-path__title {\n    font-size: 27px;\n  }\n\n}\n\n\n/* ================= REDUCED MOTION ================= */\n\n@media (prefers-reduced-motion: reduce) {\n\n  .desceci-path-card__cta,\n  .desceci-path-card__arrow {\n    transition: none;\n  }\n\n}\n</style>\n\n\n<section\n  class=\"desceci-path\"\n  aria-labelledby=\"desceci-path-title\"\n>\n\n<div class=\"desceci-path__inner\">\n\n\n  <!-- ================= HEADER ================= -->\n\n  <header class=\"desceci-path__header\">\n\n    <div class=\"desceci-path__eyebrow\">\n      Choose Your DTF Workflow\n    </div>\n\n    <h2\n      id=\"desceci-path-title\"\n      class=\"desceci-path__title\"\n    >\n      Ready-to-Press Transfers<br>\n      or Print Your Own?\n    </h2>\n\n    <p class=\"desceci-path__intro\">\n      Whether you want us to print your custom DTF transfers\n      or you run your own DTF printing setup, choose the\n      workflow that fits your business.\n    </p>\n\n  </header>\n\n\n\n  <!-- ================= CHOICES ================= -->\n\n  <div class=\"desceci-path__choices\">\n\n\n    <!-- ===================================================\n         READY TO PRESS\n         =================================================== -->\n\n    <article class=\"desceci-path-card\">\n\n\n      <div class=\"desceci-path-card__label\">\n        We Print. You Press.\n      </div>\n\n\n      <div\n        class=\"desceci-path-card__icon\"\n        aria-hidden=\"true\"\n      >\n\n        <svg viewBox=\"0 0 24 24\">\n\n          <path d=\"M5 5h14v8H5z\"></path>\n\n          <path d=\"M8 13v3\"></path>\n\n          <path d=\"M16 13v3\"></path>\n\n          <path d=\"M6 16h12v4H6z\"></path>\n\n          <path d=\"M9 9h6\"></path>\n\n        </svg>\n\n      </div>\n\n\n      <h3 class=\"desceci-path-card__title\">\n        Ready-to-Press DTF Transfers\n      </h3>\n\n\n      <p class=\"desceci-path-card__description\">\n        No DTF printer required. Send us your artwork,\n        choose how you want to order, and we'll produce\n        your custom transfers ready for heat pressing.\n      </p>\n\n\n      <ul class=\"desceci-path-card__list\">\n\n        <li>\n          Order individual DTF transfers by size\n        </li>\n\n        <li>\n          Upload a completed ready-to-print gang sheet\n        </li>\n\n        <li>\n          Build your gang sheet with our online builder\n        </li>\n\n        <li>\n          Ready to apply with a heat press\n        </li>\n\n      </ul>\n\n\n      <div class=\"desceci-path-card__best\">\n\n        <strong>Best for:</strong>\n        clothing brands, creators, small businesses\n        and shops that don't print DTF in-house.\n\n      </div>\n\n\n      <a\n        href=\"/collections/dtf-transfer\"\n        class=\"desceci-path-card__cta\"\n      >\n\n        Shop DTF Transfers\n\n        <span class=\"desceci-path-card__arrow\">\n          →\n        </span>\n\n      </a>\n\n\n    </article>\n\n\n\n    <!-- ================= OR ================= -->\n\n    <div\n      class=\"desceci-path__or\"\n      aria-hidden=\"true\"\n    >\n      OR\n    </div>\n\n\n\n    <!-- ===================================================\n         PRINT YOUR OWN\n         =================================================== -->\n\n    <article\n      class=\"\n        desceci-path-card\n        desceci-path-card--dark\n      \"\n    >\n\n\n      <div class=\"desceci-path-card__label\">\n        You Print. You Press.\n      </div>\n\n\n      <div\n        class=\"desceci-path-card__icon\"\n        aria-hidden=\"true\"\n      >\n\n        <svg viewBox=\"0 0 24 24\">\n\n          <path d=\"M6 8V4h12v4\"></path>\n\n          <path d=\"M6 17H4V9h16v8h-2\"></path>\n\n          <path d=\"M7 14h10v6H7z\"></path>\n\n          <path d=\"M17 11h.01\"></path>\n\n        </svg>\n\n      </div>\n\n\n      <h3 class=\"desceci-path-card__title\">\n        Print Your Own DTF Transfers\n      </h3>\n\n\n      <p class=\"desceci-path-card__description\">\n        Already operate a DTF printer? Shop professional\n        DTF printing supplies and equipment for your\n        own production workflow.\n      </p>\n\n\n      <ul class=\"desceci-path-card__list\">\n\n        <li>\n          DTF ink for compatible printing systems\n        </li>\n\n        <li>\n          DTF transfer film and adhesive powder\n        </li>\n\n        <li>\n          Epson printheads and printer components\n        </li>\n\n        <li>\n          Heat press equipment for transfer application\n        </li>\n\n      </ul>\n\n\n      <div class=\"desceci-path-card__best\">\n\n        <strong>Best for:</strong>\n        DTF print shops, apparel production businesses\n        and customers with their own printing equipment.\n\n      </div>\n\n\n      <a\n        href=\"/collections/dtf-consumables\"\n        class=\"desceci-path-card__cta\"\n      >\n\n        Shop DTF Supplies\n\n        <span class=\"desceci-path-card__arrow\">\n          →\n        </span>\n\n      </a>\n\n\n    </article>\n\n\n  </div>\n\n\n\n  <!-- ================= NOTE ================= -->\n\n  <p class=\"desceci-path__note\">\n\n    <span\n      class=\"desceci-path__note-dot\"\n      aria-hidden=\"true\"\n    ></span>\n\n    New to DTF printing? Ready-to-press transfers are\n    the simplest way to get started without owning a DTF printer.\n\n  </p>\n\n\n</div>\n</section>",
