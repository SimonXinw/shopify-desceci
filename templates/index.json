      "name": "hero 主图",
      "settings": {
        "custom_liquid": "<style>\n/* =========================================================\n   DESCECI HOMEPAGE HERO\n   FINAL RESPONSIVE VERSION\n   SEO + MOBILE + PERFORMANCE\n   ========================================================= */\n\n.desceci-hero {\n  position: relative;\n  width: 100%;\n  min-height: 660px;\n  overflow: hidden;\n  background: #f4f5f3;\n  font-family: inherit;\n}\n\n\n/* =========================================================\n   HERO IMAGE\n   ========================================================= */\n\n.desceci-hero__media {\n  position: absolute;\n  inset: 0;\n  z-index: 0;\n}\n\n.desceci-hero__media picture,\n.desceci-hero__media img {\n  display: block;\n  width: 100%;\n  height: 100%;\n}\n\n.desceci-hero__media img {\n  object-fit: cover;\n  object-position: center center;\n}\n\n\n/* =========================================================\n   DESKTOP OVERLAY\n   ========================================================= */\n\n.desceci-hero__overlay {\n  position: absolute;\n  inset: 0;\n  z-index: 1;\n\n  pointer-events: none;\n\n  background: linear-gradient(\n    90deg,\n    rgba(247,248,246,.97) 0%,\n    rgba(247,248,246,.93) 27%,\n    rgba(247,248,246,.72) 41%,\n    rgba(247,248,246,.25) 58%,\n    rgba(247,248,246,0) 75%\n  );\n}\n\n\n/* =========================================================\n   CONTENT\n   ========================================================= */\n\n.desceci-hero__inner {\n  position: relative;\n  z-index: 2;\n\n  display: flex;\n  align-items: center;\n\n  width: 100%;\n  max-width: 1440px;\n  min-height: 660px;\n\n  margin: 0 auto;\n\n  padding: 65px 60px;\n\n  box-sizing: border-box;\n}\n\n.desceci-hero__content {\n  width: 100%;\n  max-width: 610px;\n}\n\n\n/* =========================================================\n   EYEBROW\n   ========================================================= */\n\n.desceci-hero__eyebrow {\n  display: flex;\n  align-items: center;\n\n  gap: 10px;\n\n  margin: 0 0 17px;\n\n  color: #333;\n\n  font-size: 11px;\n  line-height: 1.4;\n  font-weight: 700;\n\n  letter-spacing: .11em;\n  text-transform: uppercase;\n}\n\n.desceci-hero__eyebrow::before {\n  content: \"\";\n\n  display: block;\n\n  width: 28px;\n  height: 2px;\n\n  flex: 0 0 28px;\n\n  background: #5ade00;\n}\n\n\n/* =========================================================\n   H1\n   Homepage should only have one H1\n   ========================================================= */\n\n.desceci-hero__title {\n  max-width: 610px;\n\n  margin: 0 0 20px;\n\n  color: #111;\n\n  font-size: clamp(42px, 4.2vw, 64px);\n  line-height: 1.04;\n  font-weight: 700;\n\n  letter-spacing: -.035em;\n}\n\n\n/* =========================================================\n   DESCRIPTION\n   ========================================================= */\n\n.desceci-hero__description {\n  max-width: 560px;\n\n  margin: 0 0 28px;\n\n  color: #505050;\n\n  font-size: 16px;\n  line-height: 1.7;\n}\n\n\n/* =========================================================\n   BUTTONS\n   ========================================================= */\n\n.desceci-hero__buttons {\n  display: flex;\n  flex-wrap: wrap;\n\n  gap: 11px;\n}\n\n.desceci-hero__button {\n  display: inline-flex;\n\n  align-items: center;\n  justify-content: center;\n\n  min-height: 52px;\n\n  padding: 0 25px;\n\n  box-sizing: border-box;\n\n  border: 1px solid #111;\n\n  background: #111;\n\n  color: #fff !important;\n\n  text-decoration: none !important;\n\n  font-size: 11.5px;\n  line-height: 1.2;\n  font-weight: 700;\n\n  letter-spacing: .055em;\n  text-transform: uppercase;\n\n  transition:\n    background .2s ease,\n    border-color .2s ease,\n    color .2s ease;\n}\n\n.desceci-hero__button:hover {\n  background: #5ade00;\n  border-color: #5ade00;\n\n  color: #111 !important;\n}\n\n\n/* SECONDARY BUTTON */\n\n.desceci-hero__button--secondary {\n  background: rgba(255,255,255,.88);\n\n  color: #111 !important;\n}\n\n.desceci-hero__button--secondary:hover {\n  background: #111;\n  border-color: #111;\n\n  color: #fff !important;\n}\n\n\n/* =========================================================\n   TRUST POINTS\n   ========================================================= */\n\n.desceci-hero__trust {\n  display: flex;\n  flex-wrap: wrap;\n\n  gap: 10px 22px;\n\n  max-width: 570px;\n\n  margin-top: 30px;\n  padding-top: 20px;\n\n  border-top: 1px solid rgba(0,0,0,.14);\n}\n\n.desceci-hero__trust-item {\n  position: relative;\n\n  padding-left: 17px;\n\n  color: #333;\n\n  font-size: 11.5px;\n  line-height: 1.45;\n  font-weight: 600;\n}\n\n.desceci-hero__trust-item::before {\n  content: \"✓\";\n\n  position: absolute;\n\n  left: 0;\n  top: 0;\n\n  color: #4d9c2d;\n\n  font-weight: 800;\n}\n\n\n/* =========================================================\n   TABLET\n   750px - 990px\n   ========================================================= */\n\n@media screen and (min-width: 750px) and (max-width: 990px) {\n\n  .desceci-hero,\n  .desceci-hero__inner {\n    min-height: 610px;\n  }\n\n  .desceci-hero__inner {\n    padding: 55px 36px;\n  }\n\n  .desceci-hero__content {\n    max-width: 500px;\n  }\n\n  .desceci-hero__title {\n    max-width: 500px;\n\n    font-size: 46px;\n  }\n\n  .desceci-hero__description {\n    max-width: 460px;\n\n    font-size: 15px;\n  }\n\n  .desceci-hero__overlay {\n    background: linear-gradient(\n      90deg,\n      rgba(247,248,246,.98) 0%,\n      rgba(247,248,246,.92) 40%,\n      rgba(247,248,246,.48) 65%,\n      rgba(247,248,246,.04) 100%\n    );\n  }\n\n}\n\n\n/* =========================================================\n   MOBILE\n   Optimized from actual Shopify preview\n   ========================================================= */\n\n@media screen and (max-width: 749px) {\n\n  .desceci-hero {\n    min-height: 660px;\n\n    background: #f5f6f4;\n  }\n\n\n  /* -------------------------\n     MOBILE IMAGE\n     ------------------------- */\n\n  .desceci-hero__media {\n    top: auto;\n    bottom: 0;\n\n    height: 45%;\n  }\n\n  .desceci-hero__media img {\n    object-fit: cover;\n\n    object-position: center 58%;\n  }\n\n\n  /* -------------------------\n     MOBILE OVERLAY\n     ------------------------- */\n\n  .desceci-hero__overlay {\n    background: linear-gradient(\n      180deg,\n      #f5f6f4 0%,\n      #f5f6f4 49%,\n      rgba(245,246,244,.95) 57%,\n      rgba(245,246,244,.42) 70%,\n      rgba(245,246,244,0) 85%\n    );\n  }\n\n\n  /* -------------------------\n     MOBILE CONTENT\n     ------------------------- */\n\n  .desceci-hero__inner {\n    display: block;\n\n    min-height: 660px;\n\n    padding:\n      30px\n      20px\n      275px;\n\n    box-sizing: border-box;\n  }\n\n  .desceci-hero__content {\n    width: 100%;\n    max-width: 440px;\n\n    margin: 0 auto;\n\n    text-align: center;\n  }\n\n\n  /* -------------------------\n     MOBILE EYEBROW\n     ------------------------- */\n\n  .desceci-hero__eyebrow {\n    justify-content: center;\n\n    margin-bottom: 11px;\n\n    font-size: 9px;\n    line-height: 1.3;\n\n    letter-spacing: .08em;\n  }\n\n  .desceci-hero__eyebrow::before {\n    display: none;\n  }\n\n\n  /* -------------------------\n     MOBILE H1\n     ------------------------- */\n\n  .desceci-hero__title {\n    max-width: 420px;\n\n    margin:\n      0\n      auto\n      13px;\n\n    font-size: 31px;\n    line-height: 1.07;\n\n    letter-spacing: -.025em;\n  }\n\n\n  /* -------------------------\n     MOBILE DESCRIPTION\n     ------------------------- */\n\n  .desceci-hero__description {\n    max-width: 390px;\n\n    margin:\n      0\n      auto\n      18px;\n\n    font-size: 13.5px;\n    line-height: 1.52;\n  }\n\n\n  /* -------------------------\n     MOBILE BUTTONS\n     ------------------------- */\n\n  .desceci-hero__buttons {\n    display: grid;\n\n    grid-template-columns: 1fr;\n\n    gap: 8px;\n\n    width: 100%;\n    max-width: 400px;\n\n    margin: 0 auto;\n  }\n\n  .desceci-hero__button {\n    width: 100%;\n\n    min-height: 46px;\n\n    padding: 0 16px;\n\n    font-size: 11px;\n  }\n\n\n  /* -------------------------\n     MOBILE TRUST\n     2 x 2 layout\n     ------------------------- */\n\n  .desceci-hero__trust {\n    display: grid;\n\n    grid-template-columns:\n      minmax(0,1fr)\n      minmax(0,1fr);\n\n    gap: 7px 12px;\n\n    width: 100%;\n    max-width: 360px;\n\n    margin:\n      16px\n      auto\n      0;\n\n    padding-top: 14px;\n  }\n\n  .desceci-hero__trust-item {\n    padding-left: 15px;\n\n    font-size: 9.5px;\n    line-height: 1.35;\n\n    text-align: left;\n  }\n\n}\n\n\n/* =========================================================\n   SMALL MOBILE\n   ========================================================= */\n\n@media screen and (max-width: 390px) {\n\n  .desceci-hero {\n    min-height: 650px;\n  }\n\n  .desceci-hero__inner {\n    min-height: 650px;\n\n    padding:\n      27px\n      15px\n      270px;\n  }\n\n  .desceci-hero__title {\n    font-size: 29px;\n  }\n\n  .desceci-hero__description {\n    font-size: 13px;\n  }\n\n}\n\n\n/* =========================================================\n   ACCESSIBILITY\n   ========================================================= */\n\n@media (prefers-reduced-motion: reduce) {\n\n  .desceci-hero__button {\n    transition: none;\n  }\n\n}\n</style>\n\n\n<!-- =======================================================\n     DESCECI HOMEPAGE HERO\n     ======================================================= -->\n\n<section\n  class=\"desceci-hero\"\n  aria-labelledby=\"desceci-home-title\"\n>\n\n\n  <!-- =====================================================\n       RESPONSIVE HERO IMAGE\n\n       PERFORMANCE:\n       - Mobile gets mobile image\n       - Desktop gets desktop image\n       - Responsive Shopify CDN sizes\n       - No lazy loading because this is LCP image\n       ===================================================== -->\n\n  <div class=\"desceci-hero__media\">\n\n    <picture>\n\n\n      <!-- ===============================\n           MOBILE HERO IMAGE\n           =============================== -->\n\n      <source\n        media=\"(max-width: 749px)\"\n\n        srcset=\"\n          https://cdn.shopify.com/s/files/1/1030/0420/9521/files/app_hero.png?v=1789718691&width=480 480w,\n          https://cdn.shopify.com/s/files/1/1030/0420/9521/files/app_hero.png?v=1789718691&width=750 750w,\n          https://cdn.shopify.com/s/files/1/1030/0420/9521/files/app_hero.png?v=1789718691&width=900 900w\n        \"\n\n        sizes=\"100vw\"\n      >\n\n\n      <!-- ===============================\n           DESKTOP HERO IMAGE\n           =============================== -->\n\n      <img\n\n        src=\"\n          https://cdn.shopify.com/s/files/1/1030/0420/9521/files/pc_hero.png?v=1789718691&width=1600\n        \"\n\n        srcset=\"\n          https://cdn.shopify.com/s/files/1/1030/0420/9521/files/pc_hero.png?v=1789718691&width=1000 1000w,\n          https://cdn.shopify.com/s/files/1/1030/0420/9521/files/pc_hero.png?v=1789718691&width=1400 1400w,\n          https://cdn.shopify.com/s/files/1/1030/0420/9521/files/pc_hero.png?v=1789718691&width=1600 1600w,\n          https://cdn.shopify.com/s/files/1/1030/0420/9521/files/pc_hero.png?v=1789718691&width=1920 1920w\n        \"\n\n        sizes=\"100vw\"\n\n        alt=\"DESCECI custom DTF transfers and professional DTF printing supplies\"\n\n        width=\"1920\"\n        height=\"1080\"\n\n        fetchpriority=\"high\"\n\n        decoding=\"async\"\n      >\n\n\n    </picture>\n\n  </div>\n\n\n  <!-- =====================================================\n       READABILITY OVERLAY\n       ===================================================== -->\n\n  <div\n    class=\"desceci-hero__overlay\"\n    aria-hidden=\"true\">\n  </div>\n\n\n  <!-- =====================================================\n       CONTENT\n       ===================================================== -->\n\n  <div class=\"desceci-hero__inner\">\n\n\n    <div class=\"desceci-hero__content\">\n\n\n      <!-- ===============================\n           SEO TOPIC\n           =============================== -->\n\n      <div class=\"desceci-hero__eyebrow\">\n\n        DTF Transfers • Supplies • Equipment\n\n      </div>\n\n\n      <!-- ===============================\n           HOMEPAGE H1\n\n           IMPORTANT:\n           Keep this as the only H1\n           on the homepage.\n           =============================== -->\n\n      <h1\n        id=\"desceci-home-title\"\n        class=\"desceci-hero__title\">\n\n        Professional DTF Transfers\n        &amp; Printing Supplies\n\n      </h1>\n\n\n      <!-- ===============================\n           SEO DESCRIPTION\n           =============================== -->\n\n      <p class=\"desceci-hero__description\">\n\n        Custom DTF transfers and professional DTF printing\n        supplies for creators, apparel brands and print\n        businesses.\n\n      </p>\n\n\n      <!-- =================================================\n           INTERNAL LINKS\n           ================================================= -->\n\n      <div class=\"desceci-hero__buttons\">\n\n\n        <!-- DTF TRANSFERS COLLECTION -->\n\n        <a\n          href=\"/collections/dtf-transfer\"\n          class=\"desceci-hero__button\"\n          aria-label=\"Shop custom DTF transfers\">\n\n          Shop DTF Transfers →\n\n        </a>\n\n\n        <!-- DTF SUPPLIES COLLECTION -->\n\n        <a\n          href=\"/collections/dtf-consumables\"\n          class=\"\n            desceci-hero__button\n            desceci-hero__button--secondary\n          \"\n          aria-label=\"Shop professional DTF printing supplies\">\n\n          Shop DTF Supplies →\n\n        </a>\n\n\n      </div>\n\n\n      <!-- =================================================\n           TRUST POINTS\n           ================================================= -->\n\n      <div\n        class=\"desceci-hero__trust\"\n        aria-label=\"DESCECI benefits\"\n      >\n\n\n        <div class=\"desceci-hero__trust-item\">\n\n          No Minimum Order\n\n        </div>\n\n\n        <div class=\"desceci-hero__trust-item\">\n\n          Fast U.S. Fulfillment\n\n        </div>\n\n\n        <div class=\"desceci-hero__trust-item\">\n\n          Professional DTF Quality\n\n        </div>\n\n\n        <div class=\"desceci-hero__trust-item\">\n\n          Reliable Support\n\n        </div>\n\n\n      </div>\n\n\n    </div>\n\n\n  </div>\n\n\n</section>",
