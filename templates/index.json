>\n\n\n      <h2\n        id=\"desceci-supplies-title\"\n        class=\"desceci-supplies__title\"\n      >\n        Professional DTF\n        Printing Supplies\n      </h2>\n\n\n      <p class=\"desceci-supplies__description\">\n        Run your own DTF production? Shop the essential\n        DTF supplies, printer components and heat press\n        equipment you need for a reliable in-house\n        printing workflow.\n      </p>\n\n\n      <div class=\"desceci-supplies__features\">\n\n        <div class=\"desceci-supplies__feature\">\n          DTF Ink\n        </div>\n\n        <div class=\"desceci-supplies__feature\">\n          DTF Transfer Film\n        </div>\n\n        <div class=\"desceci-supplies__feature\">\n          DTF Adhesive Powder\n        </div>\n\n        <div class=\"desceci-supplies__feature\">\n          Epson Printheads\n        </div>\n\n        <div class=\"desceci-supplies__feature\">\n          Heat Press Equipment\n        </div>\n\n        <div class=\"desceci-supplies__feature\">\n          Printing Consumables\n        </div>\n\n      </div>\n\n\n      <a\n        href=\"/collections/dtf-consumables\"\n        class=\"desceci-supplies__cta\"\n      >\n        Shop All DTF Supplies\n\n        <span class=\"desceci-supplies__cta-arrow\">\n          →\n        </span>\n      </a>\n\n\n    </div>\n\n\n\n    <!-- ===================================================\n         RIGHT\n         =================================================== -->\n\n    <div class=\"desceci-supplies__grid\">\n\n\n      <!-- ================= DTF INK ================= -->\n\n      <a\n        href=\"/collections/dtf-consumables\"\n        class=\"desceci-supply\"\n        aria-label=\"Shop DTF ink\"\n      >\n\n        <div class=\"desceci-supply__top\">\n\n          <div\n            class=\"desceci-supply__icon\"\n            aria-hidden=\"true\"\n          >\n            <svg viewBox=\"0 0 24 24\">\n              <path d=\"M12 3s6 7 6 12a6 6 0 0 1-12 0c0-5