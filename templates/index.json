    "custom_liquid_Dd9Yat": {
      "type": "custom-liquid",
      "name": "Featured DTF Products",
      "settings": {
        "custom_liquid": "{% liquid\n  assign by_size = all_products['products-custom-dtf-transfers-by-size']\n  assign upload_gang = all_products['custom-dtf-transfers']\n  assign builder = all_products['products-dtf-gang-sheet-builder']\n%}\n\n<style>\n/* =========================================================\n   DESCECI — FEATURED DTF PRODUCTS\n   Compact Version\n   Responsive / SEO / Performance Optimized\n   ========================================================= */\n\n.desceci-featured {\n  width: 100%;\n  padding: 64px 24px 68px;\n  background: #f6f7f6;\n  box-sizing: border-box;\n}\n\n.desceci-featured *,\n.desceci-featured *::before,\n.desceci-featured *::after {\n  box-sizing: border-box;\n}\n\n.desceci-featured__inner {\n  width: 100%;\n  max-width: 1400px;\n  margin: 0 auto;\n}\n\n\n/* =========================================================\n   HEADER\n   ========================================================= */\n\n.desceci-featured__header {\n  margin-bottom: 27px;\n}\n\n.desceci-featured__heading {\n  max-width: 720px;\n}\n\n.desceci-featured__eyebrow {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n\n  margin: 0 0 8px;\n\n  color: #444;\n\n  font-size: 9px;\n  line-height: 1.4;\n  font-weight: 700;\n\n  letter-spacing: .12em;\n  text-transform: uppercase;\n}\n\n.desceci-featured__eyebrow::before {\n  content: \"\";\n\n  width: 26px;\n  height: 2px;\n\n  background: #5ade00;\n}\n\n.desceci-featured__title {\n  margin: 0 0 10px;\n\n  color: #111;\n\n  font-size: clamp(32px, 3vw, 44px);\n  line-height: 1.08;\n  font-weight: 700;\n\n  letter-spacing: -.03em;\n}\n\n.desceci-featured__intro {\n  max-width: 680px;\n\n  margin: 0;\n\n  color: #666;\n\n  font-size: 14px;\n  line-height: 1.58;\n}\n\n\n/* =========================================================\n   PRODUCT GRID\n   ========================================================= */\n\n.desceci-featured__grid {\n  display: grid;\n\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n\n  gap: 16px;\n\n  align-items: stretch;\n}\n\n\n/* =========================================================\n   PRODUCT CARD\n   ========================================================= */\n\n.desceci-product {\n  position: relative;\n\n  display: flex;\n  flex-direction: column;\n\n  min-width: 0;\n\n  overflow: hidden;\n\n  background: #fff;\n\n  border: 1px solid #e5e5e5;\n  border-radius: 6px;\n\n  color: inherit;\n\n  text-decoration: none !important;\n\n  transition:\n    transform .22s ease,\n    box-shadow .22s ease,\n    border-color .22s ease;\n}\n\n.desceci-product::before {\n  content: \"\";\n\n  position: absolute;\n  z-index: 5;\n\n  top: 0;\n  left: 0;\n\n  width: 36px;\n  height: 3px;\n\n  background: #5ade00;\n\n  transition: width .25s ease;\n}\n\n.desceci-product:hover {\n  transform: translateY(-3px);\n\n  border-color: #d5d5d5;\n\n  box-shadow:\n    0 13px 30px\n    rgba(0, 0, 0, .06);\n}\n\n.desceci-product:hover::before {\n  width: 100%;\n}\n\n\n/* =========================================================\n   IMAGE AREA\n   ========================================================= */\n\n.desceci-product__media {\n  position: relative;\n\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  width: 100%;\n\n  height: 310px;\n\n  overflow: hidden;\n\n  padding: 22px 24px 15px;\n\n  background: #fafafa;\n}\n\n.desceci-product__image {\n  display: block;\n\n  width: 100%;\n  height: 100%;\n\n  object-fit: contain;\n\n  transition: transform .28s ease;\n}\n\n.desceci-product:hover .desceci-product__image {\n  transform: scale(1.02);\n}\n\n\n/* =========================================================\n   BADGES\n   ========================================================= */\n\n.desceci-product__badge {\n  position: absolute;\n  z-index: 3;\n\n  top: 16px;\n  left: 16px;\n\n  padding: 6px 9px;\n\n  background: #111;\n  color: #fff;\n\n  font-size: 7.5px;\n  line-height: 1;\n\n  font-weight: 700;\n\n  letter-spacing: .075em;\n\n  text-transform: uppercase;\n}\n\n.desceci-product__badge--green {\n  background: #8ee45c;\n  color: #111;\n}\n\n\n/* =========================================================\n   PRODUCT CONTENT\n   ========================================================= */\n\n.desceci-product__content {\n  display: flex;\n  flex-direction: column;\n\n  flex: 1;\n\n  padding: 21px 22px 22px;\n}\n\n.desceci-product__step {\n  margin: 0 0 6px;\n\n  color: #777;\n\n  font-size: 8px;\n  line-height: 1.3;\n\n  font-weight: 700;\n\n  letter-spacing: .1em;\n\n  text-transform: uppercase;\n}\n\n.desceci-product__title {\n  margin: 0 0 8px;\n\n  color: #111;\n\n  font-size: 22px;\n  line-height: 1.15;\n\n  font-weight: 700;\n\n  letter-spacing: -.025em;\n}\n\n.desceci-product__description {\n  margin: 0 0 13px;\n\n  color: #666;\n\n  font-size: 12px;\n  line-height: 1.52;\n}\n\n\n/* =========================================================\n   BEST FOR\n   ========================================================= */\n\n.desceci-product__best {\n  display: flex;\n\n  align-items: flex-start;\n\n  gap: 8px;\n\n  min-height: 52px;\n\n  margin: 0 0 13px;\n\n  padding: 10px 11px;\n\n  background: #f6f7f6;\n\n  color: #555;\n\n  font-size: 10px;\n  line-height: 1.42;\n}\n\n.desceci-product__best-dot {\n  flex: 0 0 auto;\n\n  width: 6px;\n  height: 6px;\n\n  margin-top: 4px;\n\n  border-radius: 50%;\n\n  background: #74d943;\n}\n\n.desceci-product__best strong {\n  color: #111;\n  font-weight: 700;\n}\n\n\n/* =========================================================\n   PRICE\n   ========================================================= */\n\n.desceci-product__price {\n  margin-top: auto;\n\n  margin-bottom: 13px;\n\n  color: #111;\n\n  font-size: 12px;\n  line-height: 1.3;\n\n  font-weight: 600;\n}\n\n.desceci-product__price-label {\n  margin-right: 4px;\n\n  color: #777;\n\n  font-size: 8px;\n\n  font-weight: 500;\n\n  letter-spacing: .07em;\n\n  text-transform: uppercase;\n}\n\n\n/* =========================================================\n   CTA\n   ========================================================= */\n\n.desceci-product__cta {\n  display: flex;\n\n  align-items: center;\n  justify-content: space-between;\n\n  width: 100%;\n\n  min-height: 42px;\n\n  padding: 0 14px;\n\n  background: #111;\n\n  color: #fff;\n\n  font-size: 8.5px;\n  line-height: 1.2;\n\n  font-weight: 700;\n\n  letter-spacing: .055em;\n\n  text-transform: uppercase;\n}\n\n.desceci-product__arrow {\n  color: #5ade00;\n\n  font-size: 15px;\n\n  transition: transform .2s ease;\n}\n\n.desceci-product:hover .desceci-product__arrow {\n  transform: translateX(4px);\n}\n\n\n/* =========================================================\n   HELP BAR\n   ========================================================= */\n\n.desceci-featured__help {\n  display: flex;\n\n  align-items: center;\n\n  justify-content: space-between;\n\n  gap: 22px;\n\n  margin-top: 16px;\n\n  padding: 18px 22px;\n\n  background: #111;\n}\n\n.desceci-featured__help-content {\n  display: flex;\n\n  align-items: center;\n\n  gap: 14px;\n}\n\n.desceci-featured__help-icon {\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  flex: 0 0 34px;\n\n  width: 34px;\n  height: 34px;\n\n  border-radius: 50%;\n\n  background: #8ee45c;\n\n  color: #111;\n\n  font-size: 15px;\n\n  font-weight: 800;\n}\n\n.desceci-featured__help-title {\n  margin: 0 0 2px;\n\n  color: #fff;\n\n  font-size: 13px;\n  line-height: 1.3;\n\n  font-weight: 700;\n}\n\n.desceci-featured__help-text {\n  margin: 0;\n\n  color: #aaa;\n\n  font-size: 10px;\n  line-height: 1.45;\n}\n\n.desceci-featured__help-link {\n  display: inline-flex;\n\n  align-items: center;\n  justify-content: center;\n\n  flex: 0 0 auto;\n\n  min-height: 38px;\n\n  padding: 0 15px;\n\n  border: 1px solid #444;\n\n  color: #fff !important;\n\n  text-decoration: none !important;\n\n  font-size: 8px;\n  line-height: 1.2;\n\n  font-weight: 700;\n\n  letter-spacing: .055em;\n\n  text-transform: uppercase;\n\n  transition:\n    background .2s ease,\n    border-color .2s ease,\n    color .2s ease;\n}\n\n.desceci-featured__help-link:hover {\n  background: #5ade00;\n\n  border-color: #5ade00;\n\n  color: #111 !important;\n}\n\n\n/* =========================================================\n   TABLET\n   ========================================================= */\n\n@media screen and (min-width: 750px) and (max-width: 990px) {\n\n  .desceci-featured {\n    padding: 58px 30px 62px;\n  }\n\n  .desceci-featured__grid {\n    grid-template-columns:\n      repeat(2, minmax(0, 1fr));\n  }\n\n  .desceci-product__media {\n    height: 290px;\n  }\n\n  .desceci-product:last-child {\n    grid-column: span 2;\n\n    display: grid;\n\n    grid-template-columns:\n      minmax(0, 44%)\n      minmax(0, 56%);\n  }\n\n  .desceci-product:last-child\n  .desceci-product__media {\n    height: 100%;\n\n    min-height: 320px;\n  }\n\n}\n\n\n/* =========================================================\n   MOBILE\n   ========================================================= */\n\n@media screen and (max-width: 749px) {\n\n  .desceci-featured {\n    padding: 48px 16px 52px;\n  }\n\n\n  /* ---------- HEADER ---------- */\n\n  .desceci-featured__header {\n    margin-bottom: 22px;\n\n    text-align: center;\n  }\n\n  .desceci-featured__heading {\n    max-width: 100%;\n  }\n\n  .desceci-featured__eyebrow {\n    justify-content: center;\n\n    margin-bottom: 7px;\n\n    font-size: 8px;\n  }\n\n  .desceci-featured__eyebrow::before {\n    display: none;\n  }\n\n  .desceci-featured__title {\n    margin-bottom: 9px;\n\n    font-size: 29px;\n    line-height: 1.1;\n  }\n\n  .desceci-featured__intro {\n    max-width: 430px;\n\n    margin: 0 auto;\n\n    font-size: 12.5px;\n    line-height: 1.5;\n  }\n\n\n  /* ---------- GRID ---------- */\n\n  .desceci-featured__grid {\n    grid-template-columns: 1fr;\n\n    gap: 11px;\n  }\n\n\n  /* ---------- IMAGE ---------- */\n\n  .desceci-product__media {\n    height: 255px;\n\n    padding: 18px 18px 10px;\n  }\n\n  .desceci-product__badge {\n    top: 14px;\n    left: 14px;\n  }\n\n\n  /* ---------- CONTENT ---------- */\n\n  .desceci-product__content {\n    padding: 18px 18px 19px;\n  }\n\n  .desceci-product__title {\n    font-size: 21px;\n  }\n\n  .desceci-product__description {\n    margin-bottom: 11px;\n\n    font-size: 11.5px;\n  }\n\n  .desceci-product__best {\n    min-height: 0;\n\n    margin-bottom: 11px;\n\n    font-size: 10px;\n  }\n\n  .desceci-product__price {\n    margin-bottom: 11px;\n  }\n\n  .desceci-product__cta {\n    min-height: 41px;\n  }\n\n\n  /* ---------- HELP BAR ---------- */\n\n  .desceci-featured__help {\n    display: block;\n\n    margin-top: 11px;\n\n    padding: 19px 18px;\n  }\n\n  .desceci-featured__help-content {\n    align-items: flex-start;\n  }\n\n  .desceci-featured__help-link {\n    width: 100%;\n\n    margin-top: 15px;\n  }\n\n}\n\n\n/* =========================================================\n   SMALL MOBILE\n   ========================================================= */\n\n@media screen and (max-width: 390px) {\n\n  .desceci-featured {\n    padding-left: 13px;\n    padding-right: 13px;\n  }\n\n  .desceci-featured__title {\n    font-size: 27px;\n  }\n\n  .desceci-product__media {\n    height: 235px;\n  }\n\n}\n\n\n/* =========================================================\n   ACCESSIBILITY\n   ========================================================= */\n\n@media (prefers-reduced-motion: reduce) {\n\n  .desceci-product,\n  .desceci-product::before,\n  .desceci-product__image,\n  .desceci-product__arrow,\n  .desceci-featured__help-link {\n    transition: none;\n  }\n\n}\n</style>\n\n\n<section\n  class=\"desceci-featured\"\n  aria-labelledby=\"desceci-featured-title\"\n>\n\n<div class=\"desceci-featured__inner\">\n\n\n  <!-- =====================================================\n       HEADER\n       ===================================================== -->\n\n  <header class=\"desceci-featured__header\">\n\n    <div class=\"desceci-featured__heading\">\n\n      <div class=\"desceci-featured__eyebrow\">\n        Custom DTF Transfers\n      </div>\n\n      <h2\n        id=\"desceci-featured-title\"\n        class=\"desceci-featured__title\"\n      >\n        Choose How You Want to Order\n      </h2>\n\n      <p class=\"desceci-featured__intro\">\n        Whether you need one ready-to-press design,\n        already have a print-ready gang sheet, or want\n        to build one online, DESCECI makes ordering\n        custom DTF transfers simple.\n      </p>\n\n    </div>\n\n  </header>\n\n\n\n  <!-- =====================================================\n       PRODUCT GRID\n       ===================================================== -->\n\n  <div class=\"desceci-featured__grid\">\n\n\n    <!-- ===================================================\n         01 — DTF TRANSFERS BY SIZE\n         =================================================== -->\n\n    <a\n      href=\"/products/products-custom-dtf-transfers-by-size\"\n      class=\"desceci-product\"\n      aria-label=\"Shop custom DTF transfers by size\"\n    >\n\n      <div class=\"desceci-product__media\">\n\n        <span\n          class=\"\n            desceci-product__badge\n            desceci-product__badge--green\n          \"\n        >\n          Easiest Option\n        </span>\n\n\n        {% if by_size.featured_image %}\n\n          {{\n            by_size.featured_image\n            | image_url: width: 800\n            | image_tag:\n              widths: '320, 480, 640, 800',\n              sizes: '(max-width: 749px) 92vw, 31vw',\n              loading: 'lazy',\n              class: 'desceci-product__image',\n              alt: 'Custom DTF transfers by size ready to press for T-shirts and apparel'\n          }}\n\n        {% endif %}\n\n      </div>\n\n\n      <div class=\"desceci-product__content\">\n\n        <div class=\"desceci-product__step\">\n          Option 01\n        </div>\n\n        <h3 class=\"desceci-product__title\">\n          DTF Transfers by Size\n        </h3>\n\n        <p class=\"desceci-product__description\">\n          Choose the transfer size you need, upload your\n          design and order the exact quantity for your project.\n          No gang sheet setup required.\n        </p>\n\n\n        <div class=\"desceci-product__best\">\n\n          <span class=\"desceci-product__best-dot\"></span>\n\n          <span>\n            <strong>Best for:</strong>\n            logos, chest prints, T-shirt designs\n            and individual artwork.\n          </span>\n\n        </div>\n\n\n        {% if by_size.price > 0 %}\n\n          <div class=\"desceci-product__price\">\n\n            <span class=\"desceci-product__price-label\">\n              From\n            </span>\n\n            {{ by_size.price_min | money }}\n\n          </div>\n\n        {% endif %}\n\n\n        <span class=\"desceci-product__cta\">\n\n          Shop by Size\n\n          <span class=\"desceci-product__arrow\">\n            →\n          </span>\n\n        </span>\n\n      </div>\n\n    </a>\n\n\n\n    <!-- ===================================================\n         02 — UPLOAD YOUR GANG SHEET\n         =================================================== -->\n\n    <a\n      href=\"/products/custom-dtf-transfers\"\n      class=\"desceci-product\"\n      aria-label=\"Upload a ready-to-print DTF gang sheet\"\n    >\n\n      <div class=\"desceci-product__media\">\n\n        <span class=\"desceci-product__badge\">\n          Print-Ready Files\n        </span>\n\n\n        {% if upload_gang.featured_image %}\n\n          {{\n            upload_gang.featured_image\n            | image_url: width: 800\n            | image_tag:\n              widths: '320, 480, 640, 800',\n              sizes: '(max-width: 749px) 92vw, 31vw',\n              loading: 'lazy',\n              class: 'desceci-product__image',\n              alt: 'Upload a ready-to-print custom DTF gang sheet for professional printing'\n          }}\n\n        {% endif %}\n\n      </div>\n\n\n      <div class=\"desceci-product__content\">\n\n        <div class=\"desceci-product__step\">\n          Option 02\n        </div>\n\n        <h3 class=\"desceci-product__title\">\n          Upload Your Gang Sheet\n        </h3>\n\n        <p class=\"desceci-product__description\">\n          Already arranged your artwork? Choose your\n          22.7-inch gang sheet size and upload your completed\n          ready-to-print file for production.\n        </p>\n\n\n        <div class=\"desceci-product__best\">\n\n          <span class=\"desceci-product__best-dot\"></span>\n\n          <span>\n            <strong>Best for:</strong>\n            print shops and customers with\n            completed gang sheet files.\n          </span>\n\n        </div>\n\n\n        {% if upload_gang.price > 0 %}\n\n          <div class=\"desceci-product__price\">\n\n            <span class=\"desceci-product__price-label\">\n              From\n            </span>\n\n            {{ upload_gang.price_min | money }}\n\n          </div>\n\n        {% endif %}\n\n\n        <span class=\"desceci-product__cta\">\n\n          Upload Gang Sheet\n\n          <span class=\"desceci-product__arrow\">\n            →\n          </span>\n\n        </span>\n\n      </div>\n\n    </a>\n\n\n\n    <!-- ===================================================\n         03 — BUILD A GANG SHEET ONLINE\n         =================================================== -->\n\n    <a\n      href=\"/products/products-dtf-gang-sheet-builder\"\n      class=\"desceci-product\"\n      aria-label=\"Build a custom DTF gang sheet online\"\n    >\n\n      <div class=\"desceci-product__media\">\n\n        <span class=\"desceci-product__badge\">\n          Online Builder\n        </span>\n\n\n        {% if builder.featured_image %}\n\n          {{\n            builder.featured_image\n            | image_url: width: 800\n            | image_tag:\n              widths: '320, 480, 640, 800',\n              sizes: '(max-width: 749px) 92vw, 31vw',\n              loading: 'lazy',\n              class: 'desceci-product__image',\n              alt: 'Build a custom DTF gang sheet online with DESCECI Gang Sheet Builder'\n          }}\n\n        {% endif %}\n\n      </div>\n\n\n      <div class=\"desceci-product__content\">\n\n        <div class=\"desceci-product__step\">\n          Option 03\n        </div>\n\n        <h3 class=\"desceci-product__title\">\n          Build a Gang Sheet Online\n        </h3>\n\n        <p class=\"desceci-product__description\">\n          Upload multiple designs, arrange your artwork\n          online and build a custom gang sheet before\n          sending it directly to production.\n        </p>\n\n\n        <div class=\"desceci-product__best\">\n\n          <span class=\"desceci-product__best-dot\"></span>\n\n          <span>\n            <strong>Best for:</strong>\n            multiple designs, maximizing sheet\n            space and flexible layouts.\n          </span>\n\n        </div>\n\n\n        {% if builder.price > 0 %}\n\n          <div class=\"desceci-product__price\">\n\n            <span class=\"desceci-product__price-label\">\n              From\n            </span>\n\n            {{ builder.price_min | money }}\n\n          </div>\n\n        {% endif %}\n\n\n        <span class=\"desceci-product__cta\">\n\n          Build Gang Sheet\n\n          <span class=\"desceci-product__arrow\">\n            →\n          </span>\n\n        </span>\n\n      </div>\n\n    </a>\n\n\n  </div>\n\n\n\n  <!-- =====================================================\n       HELP BAR\n       ===================================================== -->\n\n  <div class=\"desceci-featured__help\">\n\n    <div class=\"desceci-featured__help-content\">\n\n      <div\n        class=\"desceci-featured__help-icon\"\n        aria-hidden=\"true\"\n      >\n        ?\n      </div>\n\n\n      <div>\n\n        <p class=\"desceci-featured__help-title\">\n          Not sure which DTF transfer option you need?\n        </p>\n\n        <p class=\"desceci-featured__help-text\">\n          Compare our custom DTF transfer options\n          and choose the ordering method that works\n          best for your artwork.\n        </p>\n\n      </div>\n\n    </div>\n\n\n    <a\n      href=\"/collections/dtf-transfer\"\n      class=\"desceci-featured__help-link\"\n    >\n      Explore All DTF Transfers&nbsp; →\n    </a>\n\n  </div>\n\n\n</div>\n</section>",
