        "custom_liquid": "<style>\n/* =========================================================\n   DESCECI — EXPLORE DTF SUPPLIES\n   B2B / Print Shop Section\n   Lightweight / Responsive / SEO Friendly\n   ========================================================= */\n\n.desceci-supplies {\n  width: 100%;\n  padding: 68px 24px 72px;\n  background: #fff;\n  box-sizing: border-box;\n}\n\n.desceci-supplies *,\n.desceci-supplies *::before,\n.desceci-supplies *::after {\n  box-sizing: border-box;\n}\n\n.desceci-supplies__inner {\n  width: 100%;\n  max-width: 1400px;\n  margin: 0 auto;\n}\n\n\n/* ================= MAIN ================= */\n\n.desceci-supplies__main {\n  display: grid;\n  grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr);\n  gap: 16px;\n}\n\n\n/* =========================================================\n   LEFT\n   ========================================================= */\n\n.desceci-supplies__intro {\n  position: relative;\n\n  display: flex;\n  flex-direction: column;\n\n  min-height: 430px;\n\n  padding: 38px 36px 34px;\n\n  overflow: hidden;\n\n  background: #111;\n  border-radius: 7px;\n}\n\n.desceci-supplies__intro::before {\n  content: \"\";\n\n  position: absolute;\n\n  top: 0;\n  left: 0;\n\n  width: 55px;\n  height: 3px;\n\n  background: #5ade00;\n}\n\n.desceci-supplies__intro::after {\n  content: \"\";\n\n  position: absolute;\n\n  width: 330px;\n  height: 330px;\n\n  right: -160px;\n  bottom: -165px;\n\n  border: 1px solid #282828;\n  border-radius: 50%;\n}\n\n\n/* ================= EYEBROW ================= */\n\n.desceci-supplies__eyebrow {\n  position: relative;\n  z-index: 2;\n\n  margin: 0 0 17px;\n\n  color: #888;\n\n  font-size: 9px;\n  line-height: 1.4;\n  font-weight: 700;\n\n  letter-spacing: .12em;\n  text-transform: uppercase;\n}\n\n\n/* ================= TITLE ================= */\n\n.desceci-supplies__title {\n  position: relative;\n  z-index: 2;\n\n  max-width: 470px;\n\n  margin: 0 0 16px;\n\n  color: #fff;\n\n  font-size: clamp(32px, 3vw, 43px);\n  line-height: 1.08;\n  font-weight: 700;\n\n  letter-spacing: -.03em;\n}\n\n\n/* ================= DESCRIPTION ================= */\n\n.desceci-supplies__description {\n  position: relative;\n  z-index: 2;\n\n  max-width: 470px;\n\n  margin: 0 0 27px;\n\n  color: #aaa;\n\n  font-size: 12.5px;\n  line-height: 1.65;\n}\n\n\n/* ================= FEATURES ================= */\n\n.desceci-supplies__features {\n  position: relative;\n  z-index: 2;\n\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n\n  gap: 9px 18px;\n\n  margin-bottom: 28px;\n}\n\n.desceci-supplies__feature {\n  position: relative;\n\n  padding-left: 17px;\n\n  color: #ccc;\n\n  font-size: 10px;\n  line-height: 1.45;\n}\n\n.desceci-supplies__feature::before {\n  content: \"\";\n\n  position: absolute;\n\n  top: 5px;\n  left: 0;\n\n  width: 6px;\n  height: 6px;\n\n  border-radius: 50%;\n\n  background: #5ade00;\n}\n\n\n/* ================= MAIN CTA ================= */\n\n.desceci-supplies__cta {\n  position: relative;\n  z-index: 2;\n\n  display: inline-flex;\n\n  align-items: center;\n  justify-content: space-between;\n\n  align-self: flex-start;\n\n  min-width: 190px;\n  min-height: 44px;\n\n  margin-top: auto;\n\n  padding: 0 16px;\n\n  background: #5ade00;\n\n  color: #111 !important;\n\n  text-decoration: none !important;\n\n  font-size: 9px;\n  line-height: 1.2;\n  font-weight: 700;\n\n  letter-spacing: .055em;\n  text-transform: uppercase;\n\n  transition:\n    background .2s ease,\n    color .2s ease;\n}\n\n.desceci-supplies__cta:hover {\n  background: #fff;\n}\n\n.desceci-supplies__cta-arrow {\n  margin-left: 20px;\n\n  font-size: 16px;\n\n  transition: transform .2s ease;\n}\n\n.desceci-supplies__cta:hover\n.desceci-supplies__cta-arrow {\n  transform: translateX(4px);\n}\n\n\n/* =========================================================\n   RIGHT GRID\n   ========================================================= */\n\n.desceci-supplies__grid {\n  display: grid;\n\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n\n  gap: 16px;\n}\n\n\n/* ================= SUPPLY ITEM ================= */\n\n.desceci-supply {\n  position: relative;\n\n  display: flex;\n  flex-direction: column;\n\n  min-width: 0;\n\n  padding: 25px;\n\n  border: 1px solid #e5e5e5;\n  border-radius: 7px;\n\n  background: #f8f9f8;\n\n  color: inherit;\n  text-decoration: none !important;\n\n  transition:\n    transform .2s ease,\n    background .2s ease,\n    border-color .2s ease,\n    box-shadow .2s ease;\n}\n\n.desceci-supply:hover {\n  transform: translateY(-2px);\n\n  background: #fff;\n\n  border-color: #d7d7d7;\n\n  box-shadow: 0 10px 25px rgba(0,0,0,.04);\n}\n\n.desceci-supply::before {\n  content: \"\";\n\n  position: absolute;\n\n  top: -1px;\n  left: 25px;\n\n  width: 28px;\n  height: 3px;\n\n  background: #5ade00;\n\n  transition: width .22s ease;\n}\n\n.desceci-supply:hover::before {\n  width: 50px;\n}\n\n\n/* ================= SUPPLY TOP ================= */\n\n.desceci-supply__top {\n  display: flex;\n\n  align-items: center;\n  justify-content: space-between;\n\n  gap: 15px;\n\n  margin-bottom: 25px;\n}\n\n\n/* ================= ICON ================= */\n\n.desceci-supply__icon {\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  width: 43px;\n  height: 43px;\n\n  border: 1px solid #e5e5e5;\n  border-radius: 50%;\n\n  background: #fff;\n\n  color: #111;\n}\n\n.desceci-supply__icon svg {\n  width: 20px;\n  height: 20px;\n\n  fill: none;\n  stroke: currentColor;\n\n  stroke-width: 1.7;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n\n/* ================= NUMBER ================= */\n\n.desceci-supply__number {\n  color: #bbb;\n\n  font-size: 8px;\n  line-height: 1;\n\n  font-weight: 700;\n\n  letter-spacing: .08em;\n}\n\n\n/* ================= COPY ================= */\n\n.desceci-supply__title {\n  margin: 0 0 7px;\n\n  color: #111;\n\n  font-size: 18px;\n  line-height: 1.2;\n  font-weight: 700;\n\n  letter-spacing: -.015em;\n}\n\n.desceci-supply__text {\n  margin: 0 0 17px;\n\n  color: #666;\n\n  font-size: 10.5px;\n  line-height: 1.55;\n}\n\n\n/* ================= LINK ================= */\n\n.desceci-supply__link {\n  display: inline-flex;\n\n  align-items: center;\n\n  margin-top: auto;\n\n  color: #111;\n\n  font-size: 8px;\n  line-height: 1.3;\n\n  font-weight: 700;\n\n  letter-spacing: .055em;\n  text-transform: uppercase;\n}\n\n.desceci-supply__link::after {\n  content: \"→\";\n\n  margin-left: 7px;\n\n  color: #55b72c;\n\n  font-size: 14px;\n\n  transition: transform .2s ease;\n}\n\n.desceci-supply:hover\n.desceci-supply__link::after {\n  transform: translateX(4px);\n}\n\n\n/* =========================================================\n   PRINTHEAD WIDE ITEM\n   ========================================================= */\n\n.desceci-supply--wide {\n  grid-column: span 2;\n\n  display: grid;\n\n  grid-template-columns:\n    minmax(0, 1fr)\n    auto;\n\n  align-items: center;\n\n  gap: 30px;\n\n  min-height: 135px;\n}\n\n.desceci-supply--wide\n.desceci-supply__top {\n  margin-bottom: 14px;\n}\n\n.desceci-supply--wide\n.desceci-supply__content {\n  max-width: 520px;\n}\n\n.desceci-supply--wide\n.desceci-supply__link {\n  align-self: center;\n\n  margin: 0;\n\n  padding: 11px 14px;\n\n  border: 1px solid #ddd;\n\n  background: #fff;\n}\n\n\n/* =========================================================\n   BOTTOM BAR\n   ========================================================= */\n\n.desceci-supplies__bottom {\n  display: flex;\n\n  align-items: center;\n  justify-content: space-between;\n\n  gap: 25px;\n\n  margin-top: 16px;\n\n  padding: 18px 22px;\n\n  border: 1px solid #e5e5e5;\n\n  background: #fff;\n}\n\n.desceci-supplies__bottom-title {\n  margin: 0 0 3px;\n\n  color: #111;\n\n  font-size: 12.5px;\n  line-height: 1.3;\n\n  font-weight: 700;\n}\n\n.desceci-supplies__bottom-text {\n  margin: 0;\n\n  color: #777;\n\n  font-size: 10px;\n  line-height: 1.5;\n}\n\n.desceci-supplies__bottom-link {\n  display: inline-flex;\n\n  align-items: center;\n\n  flex: 0 0 auto;\n\n  color: #111 !important;\n\n  text-decoration: none !important;\n\n  font-size: 8px;\n  line-height: 1.3;\n\n  font-weight: 700;\n\n  letter-spacing: .055em;\n\n  text-transform: uppercase;\n}\n\n.desceci-supplies__bottom-link::after {\n  content: \"→\";\n\n  margin-left: 8px;\n\n  color: #55b72c;\n\n  font-size: 14px;\n}\n\n\n/* =========================================================\n   TABLET\n   ========================================================= */\n\n@media screen and (min-width: 750px) and (max-width: 990px) {\n\n  .desceci-supplies {\n    padding: 60px 30px 64px;\n  }\n\n  .desceci-supplies__main {\n    grid-template-columns: 1fr;\n  }\n\n  .desceci-supplies__intro {\n    min-height: 350px;\n  }\n\n}\n\n\n/* =========================================================\n   MOBILE\n   ========================================================= */\n\n@media screen and (max-width: 749px) {\n\n  .desceci-supplies {\n    padding: 49px 16px 52px;\n  }\n\n\n  /* Main */\n\n  .desceci-supplies__main {\n    grid-template-columns: 1fr;\n\n    gap: 11px;\n  }\n\n\n  /* Intro */\n\n  .desceci-supplies__intro {\n    min-height: 0;\n\n    padding: 27px 22px 24px;\n  }\n\n  .desceci-supplies__eyebrow {\n    margin-bottom: 12px;\n\n    font-size: 8px;\n  }\n\n  .desceci-supplies__title {\n    margin-bottom: 12px;\n\n    font-size: 29px;\n    line-height: 1.1;\n  }\n\n  .desceci-supplies__description {\n    margin-bottom: 20px;\n\n    font-size: 11.5px;\n    line-height: 1.55;\n  }\n\n  .desceci-supplies__features {\n    grid-template-columns: 1fr;\n\n    gap: 7px;\n\n    margin-bottom: 22px;\n  }\n\n  .desceci-supplies__cta {\n    width: 100%;\n\n    margin-top: 0;\n  }\n\n\n  /* Product grid */\n\n  .desceci-supplies__grid {\n    grid-template-columns: 1fr;\n\n    gap: 10px;\n  }\n\n  .desceci-supply {\n    padding: 20px 19px;\n  }\n\