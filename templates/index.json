      "settings": {
        "custom_liquid": "<style>\n/* =========================================================\n   DESCECI — U.S. FULFILLMENT & SUPPORT\n   Responsive / Lightweight / SEO Friendly\n   ========================================================= */\n\n.desceci-us {\n  width: 100%;\n  padding: 68px 24px 72px;\n  background: #fff;\n  box-sizing: border-box;\n}\n\n.desceci-us *,\n.desceci-us *::before,\n.desceci-us *::after {\n  box-sizing: border-box;\n}\n\n.desceci-us__inner {\n  width: 100%;\n  max-width: 1400px;\n  margin: 0 auto;\n}\n\n\n/* ================= HEADER ================= */\n\n.desceci-us__header {\n  display: grid;\n  grid-template-columns: .9fr 1.1fr;\n  gap: 70px;\n  align-items: end;\n\n  margin-bottom: 30px;\n}\n\n.desceci-us__eyebrow {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n\n  margin: 0 0 8px;\n\n  color: #444;\n\n  font-size: 9px;\n  line-height: 1.4;\n  font-weight: 700;\n\n  letter-spacing: .12em;\n  text-transform: uppercase;\n}\n\n.desceci-us__eyebrow::before {\n  content: \"\";\n\n  width: 26px;\n  height: 2px;\n\n  background: #5ade00;\n}\n\n.desceci-us__title {\n  margin: 0;\n\n  color: #111;\n\n  font-size: clamp(32px, 3vw, 44px);\n  line-height: 1.08;\n  font-weight: 700;\n\n  letter-spacing: -.03em;\n}\n\n.desceci-us__intro {\n  max-width: 620px;\n  margin: 0;\n\n  color: #666;\n\n  font-size: 14px;\n  line-height: 1.62;\n}\n\n\n/* ================= MAIN GRID ================= */\n\n.desceci-us__grid {\n  display: grid;\n\n  grid-template-columns:\n    minmax(0, .82fr)\n    minmax(0, 1.18fr);\n\n  gap: 16px;\n}\n\n\n/* =========================================================\n   LEFT — LOCATION\n   ========================================================= */\n\n.desceci-us__location {\n  position: relative;\n\n  display: flex;\n  flex-direction: column;\n\n  min-height: 390px;\n\n  overflow: hidden;\n\n  padding: 34px;\n\n  background: #111;\n\n  border-radius: 7px;\n\n  color: #fff;\n}\n\n.desceci-us__location::before {\n  content: \"\";\n\n  position: absolute;\n\n  top: 0;\n  left: 0;\n\n  width: 48px;\n  height: 3px;\n\n  background: #5ade00;\n}\n\n\n/* Decorative circle */\n\n.desceci-us__location::after {\n  content: \"\";\n\n  position: absolute;\n\n  right: -95px;\n  bottom: -115px;\n\n  width: 300px;\n  height: 300px;\n\n  border: 1px solid #292929;\n  border-radius: 50%;\n}\n\n\n/* ================= LOCATION ICON ================= */\n\n.desceci-us__pin {\n  position: relative;\n  z-index: 2;\n\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  width: 50px;\n  height: 50px;\n\n  margin-bottom: 30px;\n\n  border-radius: 50%;\n\n  background: #202020;\n\n  color: #5ade00;\n}\n\n.desceci-us__pin svg {\n  width: 24px;\n  height: 24px;\n\n  fill: none;\n  stroke: currentColor;\n\n  stroke-width: 1.7;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n\n/* ================= LOCATION COPY ================= */\n\n.desceci-us__location-label {\n  position: relative;\n  z-index: 2;\n\n  margin: 0 0 8px;\n\n  color: #888;\n\n  font-size: 8px;\n  line-height: 1.3;\n  font-weight: 700;\n\n  letter-spacing: .12em;\n  text-transform: uppercase;\n}\n\n.desceci-us__location-title {\n  position: relative;\n  z-index: 2;\n\n  margin: 0 0 13px;\n\n  color: #fff;\n\n  font-size: 28px;\n  line-height: 1.13;\n  font-weight: 700;\n\n  letter-spacing: -.025em;\n}\n\n.desceci-us__address {\n  position: relative;\n  z-index: 2;\n\n  margin: 0;\n\n  color: #aaa;\n\n  font-size: 12px;\n  line-height: 1.65;\n}\n\n\n/* ================= LOCATION FOOT ================= */\n\n.desceci-us__location-foot {\n  position: relative;\n  z-index: 2;\n\n  margin-top: auto;\n  padding-top: 24px;\n\n  border-top: 1px solid #2b2b2b;\n}\n\n.desceci-us__location-foot strong {\n  display: block;\n\n  margin-bottom: 4px;\n\n  color: #fff;\n\n  font-size: 11px;\n  line-height: 1.4;\n}\n\n.desceci-us__location-foot span {\n  color: #888;\n\n  font-size: 10px;\n  line-height: 1.5;\n}\n\n\n/* =========================================================\n   RIGHT — SERVICE GRID\n   ========================================================= */\n\n.desceci-us__services {\n  display: grid;\n\n  grid-template-columns:\n    repeat(2, minmax(0, 1fr));\n\n  gap: 16px;\n}\n\n\n/* ================= SERVICE CARD ================= */\n\n.desceci-us-service {\n  position: relative;\n\n  min-width: 0;\n\n  padding: 27px;\n\n  border: 1px solid #e5e5e5;\n  border-radius: 7px;\n\n  background: #f8f9f8;\n\n  transition:\n    background .2s ease,\n    border-color .2s ease,\n    transform .2s ease;\n}\n\n.desceci-us-service:hover {\n  transform: translateY(-2px);\n\n  background: #fff;\n\n  border-color: #d7d7d7;\n}\n\n\n/* ================= SERVICE NUMBER ================= */\n\n.desceci-us-service__top {\n  display: flex;\n\n  align-items: center;\n  justify-content: space-between;\n\n  gap: 15px;\n\n  margin-bottom: 24px;\n}\n\n.desceci-us-service__icon {\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  width: 42px;\n  height: 42px;\n\n  border-radius: 50%;\n\n  background: #fff;\n\n  border: 1px solid #e5e5e5;\n\n  color: #111;\n}\n\n.desceci-us-service__icon svg {\n  width: 20px;\n  height: 20px;\n\n  fill: none;\n  stroke: currentColor;\n\n  stroke-width: 1.7;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.desceci-us-service__number {\n  color: #bbb;\n\n  font-size: 9px;\n  line-height: 1;\n\n  font-weight: 700;\n\n  letter-spacing: .08em;\n}\n\n\n/* ================= SERVICE COPY ================= */\n\n.desceci-us-service__title {\n  margin: 0 0 7px;\n\n  color: #111;\n\n  font-size: 17px;\n  line-height: 1.2;\n\n  font-weight: 700;\n\n  letter-spacing: -.015em;\n}\n\n.desceci-us-service__text {\n  margin: 0;\n\n  color: #666;\n\n  font-size: 11px;\n  line-height: 1.55;\n}\n\n\n/* ================= GREEN DETAIL ================= */\n\n.desceci-us-service__detail {\n  display: inline-flex;\n\n  align-items: center;\n\n  gap: 6px;\n\n  margin-top: 12px;\n\n  color: #333;\n\n  font-size: 9px;\n  line-height: 1.4;\n\n  font-weight: 700;\n}\n\n.desceci-us-service__detail::before {\n  content: \"\";\n\n  width: 6px;\n  height: 6px;\n\n  border-radius: 50%;\n\n  background: #5ade00;\n}\n\n\n/* =========================================================\n   SUPPORT BAR\n   ========================================================= */\n\n.desceci-us__support {\n  display: flex;\n\n  align-items: center;\n  justify-content: space-between;\n\n  gap: 25px;\n\n  margin-top: 16px;\n\n  padding: 20px 24px;\n\n  border: 1px solid #e5e5e5;\n\n  background: #fff;\n}\n\n.desceci-us__support-copy {\n  min-width: 0;\n}\n\n.desceci-us__support-title {\n  margin: 0 0 4px;\n\n  color: #111;\n\n  font-size: 13px;\n  line-height: 1.3;\n\n  font-weight: 700;\n}\n\n.desceci-us__support-text {\n  margin: 0;\n\n  color: #777;\n\n  font-size: 10px;\n  line-height: 1.5;\n}\n\n\n/* ================= CTA ================= */\n\n.desceci-us__cta {\n  display: inline-flex;\n\n  align-items: center;\n  justify-content: center;\n\n  flex: 0 0 auto;\n\n  min-height: 40px;\n\n  padding: 0 16px;\n\n  background: #111;\n\n  color: #fff !important;\n\n  text-decoration: none !important;\n\n  font-size: 8px;\n  line-height: 1.2;\n\n  font-weight: 700;\n\n  letter-spacing: .06em;\n\n  text-transform: uppercase;\n}\n\n.desceci-us__cta span {\n  margin-left: 8px;\n\n  color: #5ade00;\n\n  font-size: 14px;\n\n  transition: transform .2s ease;\n}\n\n.desceci-us__cta:hover span {\n  transform: translateX(4px);\n}\n\n\n/* =========================================================\n   TABLET\n   ========================================================= */\n\n@media screen and (min-width: 750px) and (max-width: 990px) {\n\n  .desceci-us {\n    padding: 60px 30px 64px;\n  }\n\n  .desceci-us__header {\n    grid-template-columns: 1fr;\n\n    gap: 16px;\n\n    margin-bottom: 27px;\n  }\n\n  .desceci-us__grid {\n    grid-template-columns: 1fr;\n  